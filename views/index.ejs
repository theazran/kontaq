  /* ───────────── Meta Cost Monitor ───────────── */
  const COST_LABEL = { marketing: 'Marketing', utility: 'Utility', authentication: 'Authentication', authentication_international: 'Authentication (internasional)', service: 'Service', marketing_lite: 'Marketing Lite', referral_conversion: 'Referral (iklan klik-ke-WA)' };
  const RATE_CATS = ['marketing', 'utility', 'authentication', 'authentication_international', 'marketing_lite'];
  function fmtMoney(n, cur) {
    if (!cur) return fmtNum(Math.round(n * 100) / 100);
    try { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: cur, maximumFractionDigits: cur === 'IDR' ? 0 : 2 }).format(n); } catch (e) { return cur + ' ' + fmtNum(n); }
  }
  async function loadCostCard(month) {
    const el = $('#cost-card'); if (!el) return;
    S.costMonth = month || S.costMonth || new Date().toISOString().slice(0, 7);
    let c;
    try { c = await api('GET', '/api/costs?month=' + S.costMonth); } catch (e) { el.innerHTML = `<div class="p-4 text-xs danger-ink">${esc(e.message)}</div>`; return; }
    if (!$('#cost-card')) return;
    S.cost = c;
    const cur = c.currency, money = (n) => fmtMoney(n, cur);
    const budget = c.settings.budget, used = budget ? c.spent / budget : 0, pctUsed = Math.round(used * 100);
    const alertAt = (c.settings.alertPct || 80) / 100;
    const state = !budget ? null : used >= 1 ? { cls: 'badge-red', label: 'Melebihi anggaran', color: 'var(--danger)' } : used >= alertAt ? { cls: 'badge-amber', label: 'Mendekati batas', color: 'var(--warn)' } : { cls: 'badge-green', label: 'Aman', color: 'var(--accent)' };
    const projOver = budget && c.projected > budget;
    const badge = state && state.label === 'Aman' && projOver && c.isCurrent ? { cls: 'badge-amber', label: 'Proyeksi melebihi anggaran' } : state;
    const months = Array.from({ length: 6 }, (_, i) => { const d = new Date(); d.setUTCDate(1); d.setUTCMonth(d.getUTCMonth() - i); return d.toISOString().slice(0, 7); });
    const monthName = (m) => new Date(m + '-01T00:00:00Z').toLocaleDateString('id-ID', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const hasMeta = c.meta?.hasData;
    // Grafik harian: biaya resmi Meta bila ada, selain itu jumlah pesan berbayar dari webhook
    const series = hasMeta ? c.meta.daily.map((d) => ({ date: d.date, v: d.cost })) : c.webhook.daily.map((d) => ({ date: d.date, v: d.count }));
    const max = Math.max(...series.map((d) => d.v), 0) || 1;
    const fmtV = (n) => (hasMeta ? money(n) : fmtNum(n) + ' pesan');
    const cats = [...new Set([...Object.keys(c.webhook.byCategory), ...Object.keys(c.meta?.byCategory || {})])].sort((a, b) => (COST_LABEL[a] ? 0 : 1) - (COST_LABEL[b] ? 0 : 1) || a.localeCompare(b));
    const tileC = (label, value, sub, extra = '') => `<div class="surface-2 rounded-md p-3 min-w-0"><div class="text-[11px] ink-3">${label}</div><div class="text-lg font-semibold tracking-tight mt-0.5 truncate">${value}</div><div class="text-[11px] ink-3 mt-0.5 leading-snug">${sub}</div>${extra}</div>`;
    $('#cost-card').innerHTML = `
      <div class="card-h flex-wrap">
        <div class="min-w-0"><div class="card-t flex items-center gap-2">Meta Cost Monitor ${badge ? `<span class="badge ${badge.cls}"><span class="dot"></span>${badge.label}</span>` : ''}</div>
          <div class="text-[11px] ink-3">Biaya pesan WhatsApp Cloud API · ${cur ? esc(cur) : 'mata uang belum diketahui'}</div></div>
        <div class="flex items-center gap-2 flex-wrap">
          <select class="select h-8 text-xs w-40" id="cost-month" aria-label="Pilih bulan">${months.map((m) => `<option value="${m}" ${m === c.month ? 'selected' : ''}>${esc(monthName(m))}</option>`).join('')}</select>
          <button class="btn btn-sm" id="cost-sync" title="Ambil biaya resmi dari Meta">${ICON.refresh} Sinkronkan</button>
          <button class="btn btn-sm" id="cost-settings">${ICON.gear} Anggaran & tarif</button>
        </div>
      </div>
      <div class="p-4 space-y-4">
        ${c.meta?.error ? `<div class="rounded-md px-3 py-2 text-xs" style="background:var(--danger-soft);color:var(--danger)">Sinkronisasi gagal (${esc(fmtDT(c.meta.syncedAt))}): ${esc(c.meta.error)}</div>` : ''}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          ${tileC('Biaya resmi Meta', hasMeta ? money(c.meta.total) : '—', hasMeta ? `${fmtNum(c.meta.volume)} pesan · sinkron ${esc(fmtDT(c.meta.syncedAt))}` : c.meta ? 'Belum ada data dari Meta' : 'Klik Sinkronkan')}
          ${tileC('Estimasi realtime', Object.keys(c.settings.rates || {}).length ? money(c.webhook.estimate) : '—', Object.keys(c.settings.rates || {}).length ? `${fmtNum(c.webhook.billable)} pesan berbayar × tarif` : `${fmtNum(c.webhook.billable)} pesan berbayar · isi tarif`)}
          ${tileC('Anggaran bulan ini', budget ? `${pctUsed}%` : '—', budget ? `${money(c.spent)} dari ${money(budget)}` : 'Belum diatur',
            budget ? `<div class="h-1.5 rounded-full mt-2 overflow-hidden" style="background:var(--border)" role="progressbar" aria-valuenow="${pctUsed}" aria-valuemin="0" aria-valuemax="100" aria-label="Pemakaian anggaran"><div class="h-full rounded-full" style="width:${Math.min(100, pctUsed)}%;background:${state.color}"></div></div>` : '')}
          ${tileC(c.isCurrent ? 'Proyeksi akhir bulan' : 'Total bulan ini', c.spent || c.projected ? money(c.projected) : '—', c.isCurrent ? `hari ke-${c.daysElapsed} dari ${c.daysInMonth}${projOver ? ' · <span class="danger-ink">melebihi anggaran</span>' : ''}` : (c.spentSource === 'meta' ? 'dari data Meta' : 'dari estimasi'))}
        </div>
        <div>
          <div class="flex items-center justify-between mb-2"><div class="text-xs font-medium">${hasMeta ? 'Biaya per hari (Meta)' : 'Pesan berbayar per hari (webhook)'}</div><button class="btn btn-ghost btn-sm" id="cost-table-toggle">Tabel</button></div>
          <div id="cost-chart-wrap"><div class="bar-chart" style="height:120px" id="cost-chart" role="img" aria-label="${hasMeta ? 'Biaya per hari' : 'Pesan berbayar per hari'}">
            ${series.map((d) => `<div class="bar-col" data-tip="${esc(fmtDate(new Date(d.date)))}|${esc(fmtV(d.v))}"><div class="bar" style="max-width:14px;height:${(d.v / max) * 100}%;background:var(--accent)"></div></div>`).join('')}
          </div><div class="flex justify-between text-[10px] ink-3 mt-2 border-t bd pt-1.5"><span>1 ${esc(monthName(c.month))}</span><span>maks ${esc(fmtV(Math.max(...series.map((d) => d.v), 0)))}/hari</span><span>${c.daysInMonth}</span></div></div>
          <div id="cost-chart-table" class="hidden max-h-56 overflow-y-auto scroll-thin"><table class="tbl"><thead><tr><th>Tanggal</th><th class="text-right">${hasMeta ? 'Biaya' : 'Pesan berbayar'}</th></tr></thead><tbody>${series.map((d) => `<tr><td>${esc(fmtDate(new Date(d.date)))}</td><td class="text-right">${esc(fmtV(d.v))}</td></tr>`).join('')}</tbody></table></div>
        </div>
        <div class="overflow-x-auto border bd rounded-md"><table class="tbl"><thead><tr><th>Kategori</th><th class="text-right">Berbayar</th><th class="text-right">Gratis</th><th class="text-right">Tarif</th><th class="text-right">Estimasi</th><th class="text-right">Biaya Meta</th></tr></thead><tbody>
          ${cats.map((k) => { const w = c.webhook.byCategory[k] || { billable: 0, free: 0 }, mc = c.meta?.byCategory?.[k], rate = Number(c.settings.rates?.[k]) || 0;
            return `<tr><td>${esc(COST_LABEL[k] || k)}</td><td class="text-right">${fmtNum(w.billable)}</td><td class="text-right ink-3">${fmtNum(w.free)}</td><td class="text-right ink-3">${rate ? money(rate) : '—'}</td><td class="text-right">${rate ? money(w.billable * rate) : '—'}</td><td class="text-right">${mc ? money(mc.cost) : '—'}</td></tr>`; }).join('') || '<tr><td colspan="6" class="ink-3">Belum ada pesan dengan info biaya pada bulan ini.</td></tr>'}
        </tbody></table></div>
        <p class="hint">Biaya resmi diambil dari Meta Pricing Analytics: mencakup <b>semua</b> pesan dari WABA ini (termasuk yang dikirim di luar Kontaq) dan bisa tertunda dari Meta. Estimasi realtime menghitung pesan berbayar dari webhook status (pesan layanan dalam jendela 24 jam umumnya gratis) dikalikan tarif yang Anda isi; tarif resmi per negara ada di <a class="accent-ink underline" href="https://developers.facebook.com/docs/whatsapp/pricing" target="_blank" rel="noopener noreferrer">halaman harga Meta</a>.</p>
      </div>`;
    $('#cost-month').addEventListener('change', (e) => loadCostCard(e.target.value));
    $('#cost-sync').addEventListener('click', (e) => busy(e.currentTarget, async () => { const r = await api('POST', '/api/costs/sync', { month: c.month }); toast(`Sinkron: ${r.points} titik data dari Meta.`); }).then(() => loadCostCard()));
    $('#cost-settings').addEventListener('click', costSettingsModal);
    $('#cost-table-toggle').addEventListener('click', (e) => {
      const showTable = $('#cost-chart-table').classList.toggle('hidden') === false;
      $('#cost-chart-wrap').classList.toggle('hidden', showTable); e.target.textContent = showTable ? 'Grafik' : 'Tabel';
    });
    const tip = $('#chart-tip');
    $$('#cost-chart .bar-col').forEach((col) => {
      col.addEventListener('mousemove', (e) => { const [d, val] = col.dataset.tip.split('|'); tip.innerHTML = `<b>${esc(d)}</b><br>${esc(val)}`; tip.classList.remove('hidden'); tip.style.left = e.clientX + 12 + 'px'; tip.style.top = e.clientY - 36 + 'px'; });
      col.addEventListener('mouseleave', () => tip.classList.add('hidden'));
    });
  }
  function costSettingsModal() {
    const c = S.cost, st = c.settings, cur = st.currency || c.defaultCurrency || '';
    modal('Anggaran & tarif Meta', `<form id="f-cost" class="space-y-4">
      <div class="grid sm:grid-cols-3 gap-3">
        <div><label class="label">Mata uang</label><input class="input uppercase" name="currency" maxlength="3" value="${esc(st.currency)}" placeholder="${esc(c.defaultCurrency || 'IDR')}"><p class="hint">Kosongkan untuk memakai mata uang WABA${c.defaultCurrency ? ' (' + esc(c.defaultCurrency) + ')' : ''}.</p></div>
        <div><label class="label">Anggaran per bulan</label><input class="input" type="number" min="0" step="any" name="budget" value="${st.budget || ''}" placeholder="0 = tanpa anggaran"></div>
        <div><label class="label">Peringatan pada (%)</label><input class="input" type="number" min="1" max="100" name="alertPct" value="${st.alertPct || 80}"></div>
      </div>
      <div><div class="label">Tarif per pesan berbayar${cur ? ' (' + esc(cur) + ')' : ''}</div>
        <div class="grid sm:grid-cols-2 gap-3">${RATE_CATS.map((k) => `<div><label class="text-xs ink-2" for="rate-${k}">${esc(COST_LABEL[k])}</label><input class="input mt-1" id="rate-${k}" type="number" min="0" step="any" name="rate_${k}" value="${st.rates?.[k] || ''}" placeholder="0"></div>`).join('')}</div>
        <p class="hint">Isi sesuai tarif Meta untuk negara penerima Anda (mis. Indonesia). Dipakai untuk estimasi realtime; biaya resmi tetap diambil dari Meta.</p></div>
    </form>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="cost-save">Simpan</button>' });
    $('#cost-save').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const d = formData($('#f-cost'));
      await api('PUT', '/api/costs/settings', { currency: d.currency, budget: d.budget, alertPct: d.alertPct, rates: Object.fromEntries(RATE_CATS.map((k) => [k, d['rate_' + k]])) });
      closeModal(); toast('Pengaturan biaya disimpan.'); loadCostCard();
    }));
  }

  /* ───────────── Inbox ───────────── */
  async function loadConvs() {
    const f = S.inbox.filter;
    S.inbox.convs = await api('GET', `/api/conversations?q=${encodeURIComponent(f.q)}&scope=${f.scope}&status=${f.status}`);
    renderNav();
  }
  const callbackOk = (k) => k?.callPermission?.status === 'accept' && (k.callPermission.permanent || !k.callPermission.expiresAt || k.callPermission.expiresAt > Date.now());
  function avatar(k, size = 32, cls = '') {
    const id = k?.id || k?.contactId;
    const st = size !== 32 ? `style="width:${size}px;height:${size}px;font-size:${Math.max(10, Math.round(size * 0.34))}px"` : '';
    return `<span class="avatar ${cls}" ${st}>${k?.avatarV && id ? `<img src="/api/contacts/${id}/avatar?v=${k.avatarV}" alt="" loading="lazy">` : initials(contactName(k))}</span>`;
  }
  // Perkecil foto di browser (potong persegi, maks 256px, JPEG) sebelum diunggah
  async function resizeImage(file, max = 256) {
    const img = await createImageBitmap(file);
    const s = Math.min(img.width, img.height), out = Math.min(max, s);
    const c = document.createElement('canvas'); c.width = c.height = out;
    c.getContext('2d').drawImage(img, (img.width - s) / 2, (img.height - s) / 2, s, s, 0, 0, out, out);
    return c.toDataURL('image/jpeg', 0.85);
  }
  // Ringkasan profil (di-cache 30 detik agar panel info tidak memanggil API terus-menerus)
  async function getProfile(contactId, fresh) {
    S.profiles = S.profiles || {};
    const hit = S.profiles[contactId];
    if (hit && !fresh && Date.now() - hit.at < 30000) return hit.data;
    const data = await api('GET', `/api/contacts/${contactId}/profile`);
    S.profiles[contactId] = { data, at: Date.now() };
    return data;
  }
  function profileStatsHtml(p) {
    const s = p.stats, cv = p.conversation;
    const row = (k, val) => `<div class="flex justify-between gap-3"><span class="ink-3">${k}</span><span class="text-right">${val}</span></div>`;
    return row('Pelanggan sejak', esc(fmtDate(s.since)))
      + (cv ? row('Pesan', `${fmtNum(s.messagesIn)} masuk · ${fmtNum(s.messagesOut)} keluar`) : '')
      + (s.lastInboundAt ? row('Pesan terakhir', esc(fmtDT(s.lastInboundAt))) : '')
      + row('Panggilan', `${fmtNum(s.calls)}${s.missed ? ` · <span class="danger-ink">${s.missed} tak terjawab</span>` : ''}`)
      + (s.lastCallAt ? row('Panggilan terakhir', esc(fmtDT(s.lastCallAt))) : '')
      + (cv ? row('Ditangani', esc(cv.assignedName || 'Belum ditugaskan')) : '')
      + row('Opt-in marketing', p.contact.optIn ? '<span class="accent-ink">Ya</span>' : 'Tidak');
  }
  // Status mengetik antar-CS (via Socket.IO). Arah pelanggan → CS tidak tersedia di Cloud API.
  S.typing = {};
  const typingNames = (convId) => Object.values(S.typing[convId] || {}).map((t) => t.name);
  function emitTyping(convId) {
    S.typingEmitAt = S.typingEmitAt || {};
    if (Date.now() - (S.typingEmitAt[convId] || 0) < 3000) return;
    S.typingEmitAt[convId] = Date.now();
    socket.emit('typing', { conversationId: convId, toCustomer: pref('typingCustomer') });
  }
  function renderTyping() {
    const el = $('#typing-line'); if (!el) return;
    const names = typingNames(S.inbox.activeId);
    el.innerHTML = names.length ? `<span class="typing-dots"><i></i><i></i><i></i></span>${esc(names.join(', '))} sedang mengetik…` : '';
    el.classList.toggle('on', names.length > 0);
  }
  function setTyping(convId, userId, t) {
    const had = !!S.typing[convId]?.[userId];
    if (t) (S.typing[convId] = S.typing[convId] || {})[userId] = t; else if (S.typing[convId]) delete S.typing[convId][userId];
    if (had !== !!t || t) { if (S.view === 'inbox') renderConvList(); if (convId === S.inbox.activeId) renderTyping(); }
  }
  setInterval(() => {
    for (const [cid, users] of Object.entries(S.typing)) for (const [uid, t] of Object.entries(users)) if (Date.now() - t.seen > 6000) setTyping(cid, uid, null);
  }, 1000);
  const activeConv = () => S.inbox.convs.find((c) => c.id === S.inbox.activeId) || S.inbox.activeConv;
  const contactName = (c) => c?.name || c?.waName || '+' + (c?.phone || '');

  async function viewInbox(convId) {
    const v = $('#view');
    v.className = 'flex-1 min-h-0 overflow-hidden';
    S.inbox.activeId = convId || (isMobile() ? null : S.inbox.activeId);
    renderNav();
    v.innerHTML = `<div class="h-full flex">
      <section id="ib-list" class="w-full md:w-80 flex-none border-r bd surface flex-col ${S.inbox.activeId ? 'hidden md:flex' : 'flex'}">
        <div class="p-3 space-y-2 border-b bd">
          <input class="input" id="ib-q" placeholder="Cari nama, nomor, label…" value="${esc(S.inbox.filter.q)}" aria-label="Cari percakapan">
          <div class="flex items-center gap-2">
            <div class="seg" id="ib-scope">${[['all', 'Semua'], ['mine', 'Saya'], ['unassigned', 'Belum']].map(([k, l]) => `<button data-v="${k}" class="${S.inbox.filter.scope === k ? 'active' : ''}">${l}</button>`).join('')}</div>
            <select class="select h-7 text-xs flex-1" id="ib-status" aria-label="Filter status">${[['open', 'Terbuka'], ['pending', 'Menunggu'], ['closed', 'Selesai'], ['all', 'Semua status']].map(([k, l]) => `<option value="${k}" ${S.inbox.filter.status === k ? 'selected' : ''}>${l}</option>`).join('')}</select>
          </div>
        </div>
        <div id="ib-convs" class="flex-1 overflow-y-auto scroll-thin"></div>
      </section>
      <section id="ib-chat" class="flex-1 min-w-0 flex-col ${S.inbox.activeId ? 'flex' : 'hidden md:flex'}"></section>
      <aside id="ib-info" class="hidden flex-none surface overflow-y-auto scroll-thin fixed inset-0 z-40 md:inset-auto md:right-0 md:top-14 md:bottom-0 md:w-72 md:border-l bd md:z-20 xl:static xl:z-auto"></aside>
    </div>`;
    let t;
    $('#ib-q').addEventListener('input', (e) => { clearTimeout(t); t = setTimeout(async () => { S.inbox.filter.q = e.target.value; await loadConvs().catch(fail); renderConvList(); }, 250); });
    $$('#ib-scope button').forEach((b) => b.addEventListener('click', async () => { S.inbox.filter.scope = b.dataset.v; $$('#ib-scope button').forEach((x) => x.classList.toggle('active', x === b)); await loadConvs().catch(fail); renderConvList(); }));
    $('#ib-status').addEventListener('change', async (e) => { S.inbox.filter.status = e.target.value; await loadConvs().catch(fail); renderConvList(); });
    if (!S.users.length) S.users = await api('GET', '/api/users').catch(() => []);
    await loadConvs().catch(fail);
    renderConvList();
    if (S.inbox.activeId) openConv(S.inbox.activeId); else renderChatEmpty();
  }
  function renderConvList() {
    const el = $('#ib-convs'); if (!el) return;
    const rows = S.inbox.convs;
    el.innerHTML = rows.length ? rows.map((c) => `<a href="#/inbox/${c.id}" class="conv-item ${c.id === S.inbox.activeId ? 'active' : ''}">
      <div class="flex gap-2.5">
        ${avatar(c.contact)}
        <div class="min-w-0 flex-1">
          <div class="flex items-baseline gap-2"><span class="font-medium truncate flex-1">${esc(contactName(c.contact))}</span><span class="text-[11px] ink-3 flex-none">${relTime(c.lastMessageAt)}</span></div>
          <div class="flex items-center gap-2 mt-0.5">${typingNames(c.id).length ? `<span class="text-xs accent-ink truncate flex-1">${esc(typingNames(c.id).join(', '))} mengetik…</span>` : `<span class="text-xs ink-3 truncate flex-1">${esc(c.preview || 'Belum ada pesan')}</span>`}${c.unread ? `<span class="badge badge-green">${c.unread}</span>` : ''}</div>
          <div class="flex items-center gap-1.5 mt-1 text-[11px] ink-3">
            ${c.windowOpen ? '<span class="accent-ink" title="Jendela layanan 24 jam aktif">● 24j</span>' : '<span title="Di luar jendela 24 jam">○ 24j</span>'}
            <span>·</span><span class="truncate">${c.assignedName ? esc(c.assignedName) : 'Belum ditugaskan'}</span>
            ${callbackOk(c.contact) ? '<span class="badge badge-green" style="height:1rem;font-size:10px" title="Bersedia ditelepon balik">📞 telepon balik</span>' : ''}
            ${(c.contact.labels || []).slice(0, 2).map((l) => `<span class="badge" style="height:1rem;font-size:10px">${esc(l)}</span>`).join('')}
          </div>
        </div>
      </div></a>`).join('') : '<div class="empty">Tidak ada percakapan.<br><span class="text-xs">Pesan masuk dari webhook akan muncul di sini.</span></div>';
  }
  function renderChatEmpty() {
    const el = $('#ib-chat'); if (!el) return;
    el.innerHTML = '<div class="flex-1 flex items-center justify-center chat-bg"><div class="empty">Pilih percakapan untuk mulai membalas.</div></div>';
    $('#ib-info').classList.add('hidden');
  }
  async function openConv(id) {
    let data;
    try { data = await api('GET', `/api/conversations/${id}`); } catch (e) { fail(e); S.inbox.activeId = null; location.hash = '#/inbox'; return; }
    if (S.view !== 'inbox' || S.inbox.activeId !== id) return;
    S.inbox.activeConv = data.conversation; S.inbox.messages = data.messages; S.inbox.replyTo = null;
    const i = S.inbox.convs.findIndex((c) => c.id === id);
    if (i >= 0) S.inbox.convs[i] = data.conversation;
    renderChat(); renderInfo(); renderConvList();
    if (data.conversation.unread) api('POST', `/api/conversations/${id}/read`).then(() => { const c = activeConv(); if (c) c.unread = 0; renderConvList(); renderNav(); }).catch(() => {});
  }
  function windowLabel(c) {
    if (!c.windowOpen) return '<span class="badge badge-amber" title="Hanya template yang bisa dikirim">Di luar jendela 24 jam</span>';
    const left = c.windowExpiresAt - Date.now(), h = Math.floor(left / 3600e3), m = Math.floor((left % 3600e3) / 60e3);
    return `<span class="badge badge-green" title="Pesan bebas boleh dikirim sampai ${esc(fmtDT(c.windowExpiresAt))}">Jendela ${h}j ${m}m</span>`;
  }
  function renderChat() {
    const c = activeConv(), el = $('#ib-chat'); if (!c || !el) return;
    const canAssignOthers = S.isAdmin;
    const assignOpts = [`<option value="">Belum ditugaskan</option>`, ...S.users.filter((u) => u.active && (canAssignOthers || u.id === S.user.id || u.id === c.assignedTo)).map((u) => `<option value="${u.id}" ${c.assignedTo === u.id ? 'selected' : ''}>${esc(u.name)}</option>`)].join('');
    el.innerHTML = `
      <div class="h-14 flex-none surface border-b bd flex items-center gap-2 px-3">
        <a href="#/inbox" class="btn btn-ghost btn-icon md:hidden" aria-label="Kembali" data-back>${ICON.back}</a>
        <button type="button" id="cv-name" class="flex items-center gap-2 min-w-0 flex-1 text-left" aria-label="Lihat info kontak">
        ${avatar(c.contact)}
        <div class="min-w-0 flex-1">
          <div class="font-medium truncate">${esc(contactName(c.contact))}</div>
          <div class="text-[11px] ink-3 flex items-center gap-2"><span class="mono hidden sm:inline">+${esc(c.contact.phone)}</span>${windowLabel(c)}</div>
        </div></button>
        <select class="select h-7 text-xs w-28 hidden sm:block" id="cv-status" aria-label="Status percakapan">${[['open', 'Terbuka'], ['pending', 'Menunggu'], ['closed', 'Selesai']].map(([k, l]) => `<option value="${k}" ${c.status === k ? 'selected' : ''}>${l}</option>`).join('')}</select>
