        <textarea id="cmp-text" rows="1" class="textarea flex-1 max-h-40" style="border-radius:1.125rem;padding-left:.875rem" placeholder="${isTouch ? 'Ketik pesan' : 'Ketik pesan  (Enter kirim, Shift+Enter baris baru)'}" aria-label="Pesan">${esc(draft)}</textarea>
        <button type="button" class="cmp-send" id="cmp-send"></button>
      </div>
      <div id="cmp-pop"></div></div>`;
    const ta = $('#cmp-text'), btn = $('#cmp-send');
    const grow = () => { ta.style.height = 'auto'; ta.style.height = Math.min(160, ta.scrollHeight) + 'px'; };
    // Seperti WhatsApp: tombol mikrofon saat kosong, tombol kirim saat ada teks
    const syncBtn = () => { const has = !!ta.value.trim(); btn.innerHTML = has ? ICON.send : ICON.mic; btn.title = has ? 'Kirim' : 'Rekam pesan suara'; btn.setAttribute('aria-label', btn.title); btn.dataset.mode = has ? 'send' : 'mic'; };
    ta.addEventListener('input', () => { grow(); syncBtn(); if (ta.value.trim()) emitTyping(c.id); }); grow(); syncBtn();
    ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && !isTouch) { e.preventDefault(); if (ta.value.trim()) btn.click(); } });
    ta.addEventListener('paste', (e) => { const files = [...(e.clipboardData?.files || [])]; if (files.length) { e.preventDefault(); openMediaComposer(files); } });
    btn.addEventListener('click', (e) => {
      if (btn.dataset.mode === 'mic') return startRecording(c);
      const body = ta.value.trim(); if (!body) return;
      busy(e.currentTarget, async () => { await sendMsg({ type: 'text', body }); ta.value = ''; grow(); syncBtn(); if (isTouch) ta.focus(); });
    });
    $('#cmp-unreply')?.addEventListener('click', () => { S.inbox.replyTo = null; renderComposer(); });
    $$('[data-pop]', el).forEach((b) => b.addEventListener('click', () => togglePop(b.dataset.pop)));
    if (!isTouch) ta.focus();
  }
  // Popover di atas composer: emoji, lampiran, stiker. Klik di luar / Esc untuk menutup.
  function togglePop(kind) {
    const host = $('#cmp-pop'); if (!host) return;
    const open = host.dataset.kind === kind;
    closePop();
    if (open) return;
    host.dataset.kind = kind;
    $$(`[data-pop="${kind === 'sticker' ? 'attach' : kind}"]`).forEach((b) => b.setAttribute('aria-expanded', 'true'));
    if (kind === 'attach') {
      host.innerHTML = `<div class="pop att-menu" role="menu">${ATTACH.map((a) => (a === '-' ? '<div class="att-sep"></div>' : `<button type="button" class="att-item" role="menuitem" data-att="${a[0]}"><span class="att-ic" style="background:${a[3]}">${ICON[a[2]]}</span>${a[1]}</button>`)).join('')}</div>`;
      host.querySelector('[data-att]').focus();
      host.querySelectorAll('[data-att]').forEach((b) => b.addEventListener('click', () => { const k = b.dataset.att; if (k !== 'sticker') closePop(); attachAction(k); }));
    } else if (kind === 'emoji') {
      host.innerHTML = `<div class="pop emoji-pop">${emojiPickerHtml()}</div>`;
      bindEmojiPicker(host, (e) => { const ta = $('#cmp-text'); ta.setRangeText(e, ta.selectionStart, ta.selectionEnd, 'end'); ta.dispatchEvent(new Event('input')); ta.focus(); });
    } else if (kind === 'sticker') {
      host.innerHTML = '<div class="pop sticker-pop"><div class="p-4 text-xs ink-3">Memuat stiker…</div></div>';
      loadStickers();
    }
    setTimeout(() => document.addEventListener('mousedown', popOutside, true), 0);
    document.addEventListener('keydown', popEsc);
  }
  function popOutside(e) { if (!e.target.closest('#cmp-pop') && !e.target.closest('[data-pop]')) closePop(); }
  function popEsc(e) { if (e.key === 'Escape') closePop(); }
  function closePop() {
    const host = $('#cmp-pop'); if (host) { host.innerHTML = ''; delete host.dataset.kind; }
    $$('[data-pop]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    document.removeEventListener('mousedown', popOutside, true); document.removeEventListener('keydown', popEsc);
  }
  const emojiPickerHtml = () => `<div class="emoji-tabs">${Object.keys(EMOJI).map((k, i) => `<button type="button" data-etab="${k}" class="${i ? '' : 'active'}">${k}</button>`).join('')}</div>
    <div class="emoji-grid" data-egrid>${EMOJI['😀'].split(' ').map((e) => `<button type="button" data-emo="${e}">${e}</button>`).join('')}</div>`;
  function bindEmojiPicker(root, pick) {
    root.addEventListener('click', (e) => {
      const tab = e.target.closest('[data-etab]'), emo = e.target.closest('[data-emo]');
      if (tab) { $$('[data-etab]', root).forEach((b) => b.classList.toggle('active', b === tab)); root.querySelector('[data-egrid]').innerHTML = EMOJI[tab.dataset.etab].split(' ').map((x) => `<button type="button" data-emo="${x}">${x}</button>`).join(''); }
      if (emo) pick(emo.dataset.emo);
