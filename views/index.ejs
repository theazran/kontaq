    ({ dashboard: viewDashboard, inbox: () => viewInbox(arg), contacts: viewContacts, templates: viewTemplates, campaigns: viewCampaigns, messagelog: viewMessageLog, autoreply: viewAutoReply, flows: () => viewFlows(arg), groups: () => viewGroups(arg), waflows: () => viewWaFlows(arg), csat: viewCsat, reminders: viewReminders, calls: viewCalls, attendance: () => viewAttendance(arg), settings: () => viewSettings(arg) })[S.view]();
