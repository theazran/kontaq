        ${statusBadge(c.status)}</div>`).join('') || '<div class="empty">Belum ada panggilan.</div>';
      $('#cl-rows').innerHTML = rows.map((c) => `<tr><td class="text-xs whitespace-nowrap">${fmtDT(c.startedAt)}</td><td>${esc(c.contactName || '—')} <span class="mono text-xs ink-3">+${esc(c.phone)}</span></td><td class="text-xs">${c.direction === 'USER_INITIATED' ? 'Masuk' : 'Keluar'}</td><td>${statusBadge(c.status)}</td><td class="text-xs">${c.duration ? Math.floor(c.duration / 60) + 'm ' + (c.duration % 60) + 'd' : '—'}</td><td class="text-xs">${esc(c.answeredName || '—')}</td></tr>`).join('') || '<tr><td colspan="6"><div class="empty">Belum ada panggilan.</div></td></tr>';
    }).catch(fail);
    try {
