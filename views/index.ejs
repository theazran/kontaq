        }
        if (isField(c)) {
          if (!p.name) err('Nama field wajib diisi.', s, c);
          else if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(p.name)) err(`Nama field "${p.name}" hanya boleh huruf, angka, dan garis bawah.`, s, c);
          else if (names.has(p.name)) err(`Nama field "${p.name}" sudah dipakai di layar ${names.get(p.name).title || names.get(p.name).id}. Nama harus unik di seluruh flow.`, s, c);
          if (p.name) names.set(p.name, s);
        }
        if (p.options) {
          const d = def.props.find((x) => x.t === 'options');
          if (p.options.length < d.lo) err(`Minimal ${d.lo} pilihan.`, s, c);
          if (p.options.length > d.hi) err(`Maksimal ${d.hi} pilihan.`, s, c);
          const oid = new Set();
          p.options.forEach((o, i) => {
            if (!o.title.trim()) err(`Pilihan ${i + 1}: judul wajib diisi.`, s, c);
            if (o.title.length > 30) err(`Pilihan "${o.title.slice(0, 20)}…": judul maksimal 30 karakter.`, s, c);
            if ((o.description || '').length > 300) err(`Pilihan ${i + 1}: deskripsi maksimal 300 karakter.`, s, c);
            if (!o.id) err(`Pilihan ${i + 1}: ID wajib diisi.`, s, c); else if (oid.has(o.id)) err(`ID pilihan "${o.id}" ganda.`, s, c);
            oid.add(o.id);
          });
          const iv = p['init-value'];
          if (iv && !(Array.isArray(iv) ? iv : [iv]).every((x) => oid.has(x))) err('Nilai bawaan tidak ada di daftar pilihan.', s, c);
        }
        const lo = Number(p['min-selected-items']), hi = Number(p['max-selected-items']);
        if (p['min-selected-items'] !== undefined && p['min-selected-items'] !== '' && p['max-selected-items'] !== undefined && p['max-selected-items'] !== '' && lo > hi) err('Min. dipilih tidak boleh lebih dari maks. dipilih.', s, c);
        if (p.options && hi > p.options.length) err('Maks. dipilih melebihi jumlah pilihan.', s, c);
        if (p['min-chars'] !== undefined && p['max-chars'] !== undefined && p['min-chars'] !== '' && p['max-chars'] !== '' && Number(p['min-chars']) > Number(p['max-chars'])) err('Min. karakter melebihi maks. karakter.', s, c);
        if (p.pattern) { try { new RegExp(p.pattern); } catch (e) { err('Pola regex tidak valid: ' + e.message, s, c); } if (!p['helper-text']) err('Pola regex wajib disertai teks bantuan.', s, c); }
        if (p['min-date'] && p['max-date'] && p['min-date'] > p['max-date']) err('Tanggal paling awal setelah tanggal paling akhir.', s, c);
        if (p['unavailable-dates'] && String(p['unavailable-dates']).split(',').map((x) => x.trim()).filter(Boolean).some((x) => !/^\d{4}-\d{2}-\d{2}$/.test(x))) err('Tanggal tidak tersedia harus berformat YYYY-MM-DD.', s, c);
        if (c.type === 'Image') {
          if (!p.src) err('Unggah gambar.', s, c);
          else if (p.src.length * 0.75 > 300 * 1024) err('Gambar maksimal 300 KB.', s, c);
        }
        if (p.link) {
          if (p.link.kind === 'navigate' && (!p.link.next || !info.byUid.has(p.link.next))) err('Pilih layar tujuan tautan.', s, c);
          if (p.link.kind === 'open_url') {
            if (!vge(v, '6.0')) err('Membuka URL membutuhkan Flow JSON 6.0+.', s, c);
            if (!/^https?:\/\/[^\s/]+\.[^\s]+$/.test(p.link.url || '')) err('URL tautan tidak valid.', s, c);
          }
        }
        // Referensi ${data.x} / ${form.x} di teks
        for (const t of [p.text, p.label, p.description, p['helper-text']].filter((x) => typeof x === 'string')) {
          for (const [, kind, n] of t.matchAll(/\$\{(data|form)\.([A-Za-z0-9_]+)\}/g)) {
            if (kind === 'data' && !info.carry.get(s.uid).has(n)) err(`\${data.${n}} tidak tersedia di layar ini (bukan isian layar sebelumnya).`, s, c);
            if (kind === 'form' && !own.has(n)) err(`\${form.${n}} bukan field di layar ini.`, s, c);
          }
        }
      }
    }
    if (info.cycle) err(`Navigasi berputar: ${info.cycle.map((u) => info.byUid.get(u).id).join(' → ')}. Meta biasanya menolak putaran pada flow tanpa endpoint.`, info.byUid.get(info.cycle[0]), null, 'warn');
    const size = JSON.stringify(wfbToJson(m)).length;
    if (size > 3 * 1024 * 1024) err('Flow JSON melebihi 3 MB (biasanya karena gambar). Kurangi atau perkecil gambar.');
    return out;
  }

  /* State & helper */
  const wb = () => S.wfb;
  const wScreen = (u = wb().sel.s) => wb().m.screens.find((s) => s.uid === u);
  const wComp = (s = wScreen(), u = wb().sel.c) => s?.children.find((c) => c.uid === u);
  function wfbInit(f, text, { dirty = false } = {}) {
    const r = wfbFromJson(text ?? f.json ?? '');
    const readOnly = f.status !== 'DRAFT';
    if (r.error || !r.m.screens.length) {
      const m = r.m && r.m.screens.length ? r.m : { version: '7.3', extra: {}, screens: [] };
      if (!m.screens.length) m.screens.push(wfbNewScreen(m, 'Formulir', true));
      S.wfb = { flowId: f.id, m, src: f.json, unsupported: r.unsupported || [], parseError: r.error || null, readOnly: false, dirty: dirty || !!r.error, sel: { s: m.screens[0].uid, c: null }, pane: 'edit', sim: null, pv: {}, catOpen: false };
    } else {
      S.wfb = { flowId: f.id, m: r.m, src: f.json, unsupported: r.unsupported, parseError: null, readOnly: r.unsupported.length > 0,
        dirty, sel: { s: r.m.screens[0].uid, c: null }, pane: 'edit', sim: null, pv: {}, catOpen: false };
    }
    S.wfb.locked = readOnly; // status flow: hanya DRAFT yang dapat diubah
    S.wfb.meta = { name: f.name, category: (f.categories || [])[0] || 'OTHER' };
  }
  function uniqName(base, except) {
    const used = new Set(wb().m.screens.flatMap((s) => s.children.filter((c) => isField(c) && c.uid !== except).map((c) => c.p.name)));
    let b = slugify(base) || 'jawaban'; if (/^\d/.test(b)) b = 'f_' + b; b = b.slice(0, 40);
    let n = b, i = 2; while (used.has(n)) n = `${b}_${i++}`;
    return n;
  }
  function uniqScreenId(base, except, m = wb().m) {
    const used = new Set(m.screens.filter((s) => s.uid !== except).map((s) => s.id));
    let b = slugify(base).toUpperCase().replace(/[0-9]/g, '').replace(/_+/g, '_').replace(/^_|_$/g, '') || 'LAYAR';
    if (b === 'SUCCESS') b = 'SUKSES';
    b = b.slice(0, 40);
    let n = b, i = 0; while (used.has(n)) n = `${b}_${String.fromCharCode(65 + (i % 26)).repeat(1 + Math.floor(i++ / 26))}`;
    return n;
  }
  function wfbNewScreen(m, title, terminal) {
    const uid = wuid('s');
    const s = { uid, id: '', idAuto: true, title, success: true, extra: {}, children: [],
      footer: { label: terminal ? 'Kirim' : 'Lanjut', action: terminal ? 'complete' : 'navigate', next: null, extraPayload: {}, rest: {} } };
    s.id = uniqScreenId(title, uid, m);
    return s;
  }
  function wfbNewComp(type) {
    const def = WFB_COMP[type], c = { uid: wuid('c'), type, p: def.make() };
    if (def.f) { c.p.name = uniqName(c.p.label, c.uid); c.p.nameAuto = true; }
    return c;
  }

  /* Render: tata letak 3 panel */
  function wfbEnsure(f) {
    const b = S.wfb;
    if (!b || b.flowId !== f.id || (!b.dirty && b.src !== f.json)) { const meta = b?.flowId === f.id && wfbMetaDirty() ? b.meta : null; wfbInit(f); if (meta) S.wfb.meta = meta; return; }
    b.locked = f.status !== 'DRAFT';
    if (!wfbMetaDirty()) b.meta = { name: f.name, category: (f.categories || [])[0] || 'OTHER' };
  }
  function wfbTab() {
    const f = S.wfd.flow;
