        }).join('') || '<div class="p-4 text-xs ink-3">Belum ada peserta. Bagikan tautan undangan di tab Undangan.</div>'}</div>
      </section>
    </div>`;
    if (!act) return;
    const decide = (action, ids) => busy(null, async () => {
      if (!ids.length) throw new Error('Pilih permintaan bergabung terlebih dahulu.');
