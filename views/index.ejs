        <div><label class="label">Label</label><input class="input" name="labels" value="${esc((k.labels || []).join(', '))}" placeholder="vip, prospek"><p class="hint">Pisahkan dengan koma.</p></div>
        <div><label class="label">Catatan kontak</label><textarea class="textarea" name="notes" rows="2" maxlength="2000">${esc(k.notes)}</textarea></div>
        <label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" name="optIn" ${k.optIn ? 'checked' : ''}> Sudah opt-in menerima pesan marketing</label>
        <button class="btn btn-sm w-full" type="submit">Simpan kontak</button>
      </form>
      <div class="p-4">
        <div class="flex items-center justify-between mb-2"><div class="text-xs font-semibold">Catatan internal</div><span class="text-[11px] ink-3">tidak terlihat pelanggan</span></div>
        <div class="space-y-2 mb-3">${(c.notes || []).slice().reverse().map((n) => `<div class="note-item"><div class="whitespace-pre-wrap">${esc(n.text)}</div><div class="flex items-center justify-between mt-1 text-[10px] ink-3"><span>${esc(n.userName)} · ${fmtDT(n.at)}</span>${n.userId === S.user.id || S.isAdmin ? `<button data-del-note="${n.id}" class="hover:underline">Hapus</button>` : ''}</div></div>`).join('') || '<p class="text-xs ink-3">Belum ada catatan.</p>'}</div>
        <form id="f-note" class="space-y-2"><textarea class="textarea" name="text" rows="2" placeholder="Tambah catatan untuk tim…" required maxlength="2000"></textarea><button class="btn btn-sm w-full" type="submit">Tambah catatan</button></form>
      </div>`;
    getProfile(k.id).then((p) => { const el2 = $('#info-stats'); if (el2 && activeConv()?.contact.id === k.id) el2.innerHTML = profileStatsHtml(p); }).catch(() => { const el2 = $('#info-stats'); if (el2) el2.innerHTML = '<div class="ink-3">Profil tidak dapat dimuat.</div>'; });
