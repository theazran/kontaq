      <section id="ib-chat" class="flex-1 min-w-0 flex-col ${S.inbox.activeId ? 'flex' : 'hidden md:flex'}"></section>
      <aside id="ib-info" class="hidden flex-none surface overflow-y-auto scroll-thin fixed inset-0 z-40 md:inset-auto md:right-0 md:top-14 md:bottom-0 md:w-72 md:border-l bd md:z-20 xl:static xl:z-auto"></aside>
    </div>`;
    let t;
