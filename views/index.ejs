          <span class="flex-1 min-w-0 truncate">${esc(c.name || c.waName || 'Tanpa nama')} <span class="ink-3">+${esc(c.phone)}</span></span>${inGroup.has(c.phone) ? '<span class="text-[11px] ink-3">sudah anggota</span>' : ''}</label>`).join('') || '<div class="p-3 text-xs ink-3">Tidak ada kontak.</div>';
