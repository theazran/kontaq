  // Browser memblokir audio sampai ada sentuhan/klik pertama: buka kunci AudioContext saat itu
  function audioCtx() {
    if (!S.audio) { try { S.audio = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return null; } }
