                <div><label class="label" for="fe-cd">Jalankan ulang di percakapan yang sama setelah (menit)</label><input class="input" type="number" min="0" max="10080" id="fe-cd" value="${s.cooldownMin}">
                  <p class="hint">0 = dijalankan untuk setiap pesan masuk.</p></div>
                <div class="grid grid-cols-2 gap-2">
                  <div><label class="label" for="fe-from">Aktif mulai</label><input class="input" type="date" id="fe-from" value="${esc(s.activeFrom)}"></div>
                  <div><label class="label" for="fe-until">Sampai</label><input class="input" type="date" id="fe-until" value="${esc(s.activeUntil)}"></div>
                </div>
                <p class="hint -mt-1">Kosongkan untuk aktif terus. Zona waktu ${esc(S.fl.timezone)} (mengikuti Auto reply). Untuk jam tertentu, pakai kondisi <b>Jadwal</b>.</p>
                <div><label class="label" for="fe-cw">Kata pembatal saat menunggu jawaban</label><input class="input" id="fe-cw" value="${esc((s.cancelWords || ['batal']).join(', '))}" placeholder="batal">
                  <p class="hint">Dipakai langkah <b>Tanya pelanggan</b> dan <b>Kirim WhatsApp Flow</b>. Pisahkan dengan koma.</p></div>
                <div><label class="label" for="fe-ct">Pesan setelah dibatalkan</label><input class="input" id="fe-ct" maxlength="500" value="${esc(s.cancelText || 'Baik, permintaan dibatalkan.')}"></div>
              </div></section>
            <section class="card"><div class="card-h"><div class="min-w-0"><div class="card-t">Uji flow</div><div class="text-[11px] ink-3">Memakai isian saat ini, termasuk yang belum disimpan. Tidak ada pesan yang dikirim.</div></div></div>
              <div class="p-4 space-y-2.5">
                <input class="input" id="fe-t-text" placeholder="Contoh pesan, mis. berapa harga paket pro?" aria-label="Contoh pesan pelanggan">
                <div class="grid grid-cols-2 gap-2">
                  <select class="select" id="fe-t-type" aria-label="Jenis pesan">${Object.entries(FL_MSG).map(([k, l]) => `<option value="${k}">${l}</option>`).join('')}</select>
                  <input class="input" id="fe-t-labels" placeholder="Label kontak" aria-label="Label kontak, pisahkan dengan koma">
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <select class="select" id="fe-t-day" aria-label="Hari simulasi"><option value="">Hari ini</option>${AR_DAYS.map((d, i) => `<option value="${i}">${d}</option>`).join('')}</select>
                  <input class="input" type="time" id="fe-t-time" aria-label="Jam simulasi (kosong = sekarang)">
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                  <label class="flex items-center gap-2 text-xs ink-2"><input type="checkbox" class="check" id="fe-t-new"> Kontak baru</label>
                  <label class="flex items-center gap-2 text-xs ink-2"><input type="checkbox" class="check" id="fe-t-assigned"> Sudah ditugaskan</label>
                </div>
                <div><label class="label" for="fe-t-answers">Jawaban uji <span class="ink-3 font-normal">(untuk langkah Tanya pelanggan, satu per baris)</span></label>
                  <textarea class="textarea text-xs" id="fe-t-answers" rows="2" placeholder="1&#10;atau 21-10-2026"></textarea></div>
                <label class="flex items-center gap-2 text-xs ink-2"><input type="checkbox" class="check" id="fe-t-live" checked> Panggil API sungguhan (hanya GET)</label>
                <button class="btn w-full" id="fe-t-go">Jalankan uji</button>
                <div id="fe-t-out"></div>
              </div></section>
            ${f.id ? `<section class="card"><div class="card-h"><div class="card-t">Riwayat jalan</div><button class="btn btn-ghost btn-sm" id="fe-runs-refresh">${ICON.refresh}</button></div>
              <div id="fe-runs" class="max-h-[28rem] overflow-y-auto scroll-thin">${flRunsHtml(S.fe.runs, false)}</div></section>` : ''}
          </aside>
        </div>
      </div>
    </div>`;
    renderFlowCanvas();
    bindFlowEditor();
  }
  function bindFlowEditor() {
    const root = $('#fe-root'), f = S.fe.flow;
    const markDirty = () => { S.fe.dirty = true; $('#fe-savebar').classList.remove('hidden'); };
    $('#fe-name').addEventListener('input', (e) => { f.name = e.target.value; markDirty(); });
    $('#fe-on').addEventListener('change', (e) => { e.target.closest('.switch').classList.toggle('on', e.target.checked); f.enabled = e.target.checked; markDirty(); });
    $('#fe-settings').addEventListener('input', () => {
      Object.assign(f.settings, { pauseIfHumanMin: Number($('#fe-pause').value), cooldownMin: Number($('#fe-cd').value), activeFrom: $('#fe-from').value, activeUntil: $('#fe-until').value,
        cancelWords: $('#fe-cw').value.split(',').map((w) => w.trim()).filter(Boolean), cancelText: $('#fe-ct').value });
      markDirty();
    });
    $('#fe-canvas').addEventListener('click', async (e) => {
      const del = e.target.closest('[data-fl-del]');
      if (del) return flDelete(del.dataset.flDel);
      const add = e.target.closest('[data-fl-add]');
      if (add) { const [pid, port] = add.dataset.flAdd.split(':'); return flPickStep(pid, port); }
      const ed = e.target.closest('[data-fl-edit]');
      if (ed) { const n = f.nodes[ed.dataset.flEdit]; flStepModal(n, (cfg) => { n.cfg = cfg; }); }
    });
    $('#fe-canvas').addEventListener('keydown', (e) => { if ((e.key === 'Enter' || e.key === ' ') && e.target.dataset.flEdit) { e.preventDefault(); e.target.click(); } });
    $('#fe-reset').addEventListener('click', () => { if (f.id) viewFlowEditor(f.id); else location.hash = '#/flows'; });
    $('#fe-save').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const body = { ...f, name: $('#fe-name').value };
      const saved = f.id ? await api('PUT', '/api/flows/' + encodeURIComponent(f.id), body) : await api('POST', '/api/flows', body);
      S.fe = { flow: { id: saved.id, name: saved.name, enabled: saved.enabled, root: saved.root, nodes: saved.nodes, settings: saved.settings }, runs: saved.runs || [], dirty: false, hit: null };
      if (!f.id) history.replaceState(null, '', '#/flows/' + saved.id);
      renderFlowEditor(); toast(saved.enabled ? 'Flow disimpan dan aktif.' : 'Flow disimpan (nonaktif).');
    }));
    $('#fe-t-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const t = await api('POST', '/api/flows/test', {
        flow: { ...f, name: $('#fe-name').value || 'Uji' }, text: $('#fe-t-text').value, msgType: $('#fe-t-type').value, labels: $('#fe-t-labels').value,
        day: $('#fe-t-day').value, time: $('#fe-t-time').value, newContact: $('#fe-t-new').checked, assigned: $('#fe-t-assigned').checked,
        answers: $('#fe-t-answers').value, liveApi: $('#fe-t-live').checked,
      });
      S.fe.hit = new Set(t.steps.map((s) => s.nodeId)); renderFlowCanvas();
      const bubble = (p) => `<div class="basis-full pl-5 mt-1"><div class="chat-bg rounded-md p-2"><div class="bubble out">${p.image ? `<img src="/api/autoreply/media/${esc(p.image)}" alt="" class="mb-1">` : ''}${waFormat(p.text)}${(p.buttons || []).map((b) => `<span class="ib-btn">${esc(b)}</span>`).join('')}<div class="meta"><span>⚡ Flow</span></div></div></div></div>`;
      const preview = (s) => [...(s.previews || []), ...(s.preview ? [s.preview] : [])].map((p) => (p.text !== undefined ? bubble(p)
        : p.note ? `<div class="basis-full pl-5 mt-1 text-[11px] ink-3 italic whitespace-pre-line">${esc(p.note)}</div>`
        : p.json ? `<details class="basis-full pl-5 mt-1"><summary class="text-[11px] ink-3 cursor-pointer">Respons API</summary><pre class="mono text-[10px] surface-2 rounded p-2 mt-1 whitespace-pre-wrap break-all max-h-40 overflow-y-auto">${esc(p.json)}</pre></details>` : '')).join('');
      const vars = Object.entries(t.vars || {});
      $('#fe-t-out').innerHTML = `<div class="text-[11px] ink-3 mb-1.5">Simulasi ${esc(AR_DAYS[t.clock.day])} ${esc(t.clock.time)} · ${t.actions ? `${t.actions} aksi` : 'tidak ada aksi — flow berikutnya / Auto reply akan dicek'}${t.waitingAnswer ? ' · <b class="ink-2">menunggu jawaban</b>' : ''}</div>
        <ol class="space-y-1.5">${t.steps.map((s) => flStepLine(s).replace('</li>', preview(s) + '</li>').replace('<li class="flex gap-2', '<li class="flex flex-wrap gap-x-2')).join('')}</ol>
        ${vars.length ? `<details class="mt-2"><summary class="text-[11px] ink-3 cursor-pointer">Variabel (${vars.length})</summary><div class="mt-1 space-y-0.5">${vars.map(([k, v]) => `<div class="text-[11px] break-all"><span class="kbd">${esc(k)}</span> <span class="ink-2">${esc(String(v ?? ''))}</span></div>`).join('')}</div></details>` : ''}`;
    }));
    $('#fe-t-text').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('#fe-t-go').click(); });
    const reloadRuns = async () => { S.fe.runs = await api('GET', '/api/flows/runs?flowId=' + encodeURIComponent(f.id)); $('#fe-runs').innerHTML = flRunsHtml(S.fe.runs, false); };
    $('#fe-runs-refresh')?.addEventListener('click', (e) => busy(e.currentTarget, reloadRuns));
    root.addEventListener('click', (e) => { const c = e.target.closest('[data-fl-cancel]'); if (c) flCancelRun(c.dataset.flCancel, reloadRuns); });
  }
  async function flDelete(id) {
    const f = S.fe.flow, n = f.nodes[id], [pid, port] = flParent(id);
    let keep = n.next;
    if (FL_PORTS[n.type]) {
      // Langkah bercabang: cabang pertama dipertahankan, cabang lain ikut terhapus
      const [[first, firstLabel], ...others] = FL_PORTS[n.type];
      const lost = others.reduce((t, [p]) => t + flCount(n[p]), 0);
      const what = n.type === 'condition' ? 'kondisi' : 'langkah';
      if (!await confirmBox(lost ? `Hapus ${what} ini? Langkah di cabang "${firstLabel}" dipertahankan; ${lost} langkah di cabang "${others.map((o) => o[1]).join('", "')}" ikut terhapus.` : `Hapus ${what} ini? Langkah di cabang "${firstLabel}" dipertahankan.`, 'Hapus', true)) return;
      others.forEach(([p]) => flDrop(n[p])); keep = n[first];
    }
    f.nodes[pid][port] = keep || null;
    delete f.nodes[id];
    flChanged();
  }
  function flPickStep(parentId, port) {
    modal('Tambah langkah', `<div class="grid sm:grid-cols-2 gap-2">${Object.entries(FL_STEP).map(([k, s]) => `<button type="button" class="fl-pick" data-pick="${k}">
        <span class="fl-ic">${ICON[s.icon]}</span><span class="min-w-0"><span class="block text-[13px] font-medium">${s.label}</span><span class="block text-[11px] ink-3 mt-0.5">${s.desc}</span></span></button>`).join('')}</div>`, { wide: true });
    $$('#modal-root [data-pick]').forEach((b) => b.addEventListener('click', () => {
      const type = b.dataset.pick;
      flStepModal({ type, cfg: flDefaultCfg(type) }, (cfg) => {
        const nodes = S.fe.flow.nodes, p = nodes[parentId], id = flId(), child = p[port] || null;
        // Langkah lama di posisi ini menjadi lanjutan langkah baru (cabang pertama bila langkah baru bercabang)
        const [first, ...others] = flPorts(type);
        nodes[id] = { id, type, cfg, [first]: child, ...Object.fromEntries(others.map((o) => [o, null])) };
        p[port] = id;
      });
    }));
  }

  /* Form konfigurasi per jenis langkah */
  function flCondFields(c) {
    switch (c.kind) {
      case 'keyword': return `<div class="grid sm:grid-cols-[11rem_1fr] gap-3">
          <div><label class="label">Cocok bila pesan</label><select class="select" name="match">${Object.entries(AR_MATCH).map(([k, l]) => `<option value="${k}" ${c.match === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
          <div><label class="label">Kata kunci (pisahkan dengan koma)</label><input class="input" name="keywords" value="${esc((c.keywords || []).join(', '))}" placeholder="harga, promo, paket"></div></div>
        <p class="hint">"Mengandung kata" mencocokkan kata utuh tanpa membedakan huruf besar/kecil. Tombol yang ditekan pelanggan masuk sebagai teks judul tombol, jadi bisa dicek dengan <i>Sama persis</i>.</p>`;
      case 'schedule': return `<div><div class="label">Hari</div><div class="flex flex-wrap gap-x-3 gap-y-1.5">${AR_DAYS.map((d, i) => `<label class="flex items-center gap-1.5 text-[13px]"><input type="checkbox" class="check" name="days" value="${i}" ${c.days.includes(i) ? 'checked' : ''}>${d}</label>`).join('')}</div></div>
        <div class="grid grid-cols-2 gap-3 max-w-xs"><div><label class="label">Dari jam</label><input class="input" type="time" name="start" value="${esc(c.start)}"></div><div><label class="label">Sampai jam</label><input class="input" type="time" name="end" value="${esc(c.end)}"></div></div>
        <p class="hint">Zona waktu ${esc(S.fl.timezone)}. Rentang melewati tengah malam (mis. 22:00–06:00) didukung.</p>`;
      case 'business_hours': {
        const open = S.fl.hours.filter((h) => h.enabled);
        return `<div class="surface-2 rounded-md px-3 py-2 text-xs ink-2">${open.length ? open.map((h) => `${AR_DAYS[h.day]} ${h.open}–${h.close}`).join(' · ') : 'Belum ada hari kerja yang diatur.'}</div>
          <p class="hint">Memakai jadwal jam kerja di menu <a href="#/autoreply" class="underline">Auto reply</a> (berlaku walau Auto reply nonaktif).</p>`;
      }
      case 'label': return `<div><label class="label">Kontak memiliki label</label><input class="input" name="label" list="fl-labels" maxlength="32" value="${esc(c.label)}" placeholder="VIP">
        <datalist id="fl-labels">${(S.fl.labels || []).map((l) => `<option value="${esc(l)}">`).join('')}</datalist></div>`;
      case 'new_contact': return `<div class="max-w-xs"><label class="label">Dianggap baru bila tidak mengirim pesan selama (hari)</label><input class="input" type="number" min="1" max="365" name="days" value="${c.days}"></div>`;
      case 'message_type': return `<div><div class="label">Jenis pesan masuk</div><div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">${Object.entries(FL_MSG).map(([k, l]) => `<label class="flex items-center gap-1.5 text-[13px]"><input type="checkbox" class="check" name="types" value="${k}" ${c.types.includes(k) ? 'checked' : ''}>${l}</label>`).join('')}</div></div>`;
      case 'assigned': return '<p class="text-xs ink-2">Ya bila percakapan sudah ditugaskan ke agen; Tidak bila masih di antrean.</p>';
      case 'variable': return `<div class="grid sm:grid-cols-[1fr_12rem_1fr] gap-3">
          <div><label class="label">Variabel</label><input class="input mono" name="path" list="fl-vars" value="${esc(c.path)}" placeholder="hasil.data.length">${flVarsList()}</div>
          <div><label class="label">Operator</label><select class="select" name="op">${Object.entries(FL_OPS).map(([k, l]) => `<option value="${k}" ${c.op === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
          <div id="var-value" class="${['empty', 'not_empty'].includes(c.op) ? 'hidden' : ''}"><label class="label">Nilai</label><input class="input" name="value" value="${esc(c.value)}" placeholder="0"></div></div>
        <p class="hint">Gunakan titik untuk isi JSON, mis. <span class="kbd">hasil.data.length</span> = jumlah data, <span class="kbd">hasil_error</span> = pesan error API. Angka dibandingkan sebagai angka; teks tanpa membedakan huruf besar/kecil.</p>`;
      default: return '';
    }
  }
  // Variabel yang dibuat langkah lain di flow ini (saran isian)
  function flVarsList() {
    const vars = new Set(['name', 'phone', 'today', 'pesan']);
    for (const n of Object.values(S.fe?.flow.nodes || {})) {
      if (n.type === 'ask' && n.cfg.var) { vars.add(n.cfg.var); vars.add(n.cfg.var + '_label'); }
      if (n.type === 'waflow' && n.cfg.var) vars.add(n.cfg.var);
      if (n.type === 'api' && n.cfg.saveAs) ['', '_status', '_error'].forEach((x) => vars.add(n.cfg.saveAs + x));
    }
    return `<datalist id="fl-vars">${[...vars].map((v) => `<option value="${esc(v)}">`).join('')}</datalist>`;
  }
  const FL_VAR_HINT = 'Variabel: <span class="kbd">{{name}}</span> <span class="kbd">{{nama_variabel}}</span> <span class="kbd">{{respons.field}}</span>. Filter: <span class="kbd">|tanggal</span> <span class="kbd">|jam</span> <span class="kbd">|rupiah</span> <span class="kbd">|default:-</span>.';
  function flAskFields(c) {
    if (c.input === 'choice') return `<div><label class="label">Pilihan (1–10), satu per baris: <span class="kbd">Judul | nilai</span></label>
        <textarea class="textarea mono text-xs" name="choices" rows="4" placeholder="Pidana | pidana&#10;Perdata | perdata">${esc((c.choices || []).map((x) => (x.value && x.value !== x.title ? `${x.title} | ${x.value}` : x.title)).join('\n'))}</textarea>
        <p class="hint">Judul maks. 24 karakter (20 bila ≤ 3 pilihan, ditampilkan sebagai tombol; lebih dari 3 menjadi daftar). Nilai disimpan ke variabel; bila kosong memakai judul.</p></div>
      <div class="max-w-xs"><label class="label">Teks tombol daftar</label><input class="input" name="button" maxlength="20" value="${esc(c.button || 'Pilih')}"></div>`;
    if (c.input === 'date') return `<div class="grid sm:grid-cols-3 gap-3">
        <div><label class="label">Jumlah tanggal ditawarkan</label><input class="input" type="number" min="1" max="9" name="days" value="${c.days}"></div>
        <div><label class="label">Teks tombol tanggal lain</label><input class="input" name="otherLabel" maxlength="20" value="${esc(c.otherLabel)}"></div>
        <div><label class="label">Teks tombol daftar</label><input class="input" name="button" maxlength="20" value="${esc(c.button || 'Pilih tanggal')}"></div></div>
      <div class="flex flex-wrap gap-x-4 gap-y-1.5">
        <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="includeToday" ${c.includeToday ? 'checked' : ''}> Termasuk hari ini</label>
        <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="skipWeekends" ${c.skipWeekends ? 'checked' : ''}> Lewati Sabtu & Minggu</label></div>
      <div><label class="label">Pesan meminta tanggal (setelah "${esc(c.otherLabel)}")</label><textarea class="textarea" name="otherPrompt" rows="2" maxlength="1024">${esc(c.otherPrompt)}</textarea></div>
      <p class="hint">Tanggal + "${esc(c.otherLabel)}" ≤ 3 dikirim sebagai tombol, selebihnya sebagai daftar pilihan. Pelanggan juga boleh mengetik tanggal: <span class="kbd">21-10-2026</span> <span class="kbd">21/10/2026</span> <span class="kbd">2026-10-21</span> <span class="kbd">21 okt</span> <span class="kbd">besok</span>. Nilai disimpan sebagai <b>YYYY-MM-DD</b>.</p>`;
    return `<div class="grid sm:grid-cols-3 gap-3">
        <div><label class="label">Panjang minimal</label><input class="input" type="number" min="1" max="200" name="minLength" value="${c.minLength}"></div>
        <div><label class="label">Panjang maksimal</label><input class="input" type="number" min="1" max="500" name="maxLength" value="${c.maxLength}"></div>
        <div><label class="label">Format</label><select class="select" name="format">${Object.entries(FL_FORMAT).map(([k, l]) => `<option value="${k}" ${c.format === k ? 'selected' : ''}>${esc(l)}</option>`).join('')}</select></div></div>`;
  }
  function flFormHtml(type, c) {
    switch (type) {
      case 'condition': return `<div class="max-w-xs"><label class="label">Jenis kondisi</label><select class="select" name="kind">${Object.entries(FL_COND).map(([k, l]) => `<option value="${k}" ${c.kind === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
        <div id="cond-fields" class="space-y-3">${flCondFields(c)}</div>
        <p class="hint">Bila kondisi terpenuhi flow lanjut ke cabang <b>Ya</b>, bila tidak ke cabang <b>Tidak</b>.</p>`;
      case 'send': {
        const r = c.repeat || { path: '', item: '', perMessage: 5, max: 30, more: '' };
        return `<div><label class="label">${c.repeat ? 'Judul tiap pesan' : 'Teks pesan'}</label><textarea class="textarea" name="text" rows="4" maxlength="4096" placeholder="Halo {{name}}, …">${esc(c.text)}</textarea>
          <p class="hint">${FL_VAR_HINT} Format WhatsApp: *tebal* _miring_. Pesan hanya dikirim selama jendela layanan 24 jam masih terbuka.</p></div>
        <div class="rounded-md border bd p-3 space-y-3">
          <label class="flex items-center gap-2 text-[13px] font-medium"><input type="checkbox" class="check" name="repeatOn" ${c.repeat ? 'checked' : ''}> Kirim daftar dari variabel (mis. hasil API)</label>
          <div id="fl-repeat" class="${c.repeat ? '' : 'hidden'} space-y-3">
            <div class="grid sm:grid-cols-[1fr_7rem_7rem] gap-3">
              <div><label class="label">Daftar</label><input class="input mono" name="rPath" list="fl-vars" value="${esc(r.path)}" placeholder="hasil.data">${flVarsList()}</div>
              <div><label class="label">Item per pesan</label><input class="input" type="number" min="1" max="20" name="rPer" value="${r.perMessage}"></div>
              <div><label class="label">Maks. item</label><input class="input" type="number" min="1" max="100" name="rMax" value="${r.max}"></div></div>
            <div><label class="label">Format tiap item</label><textarea class="textarea mono text-xs" name="rItem" rows="4" placeholder="*{{no}}. {{item.nama}}*&#10;{{item.tanggal|tanggal}}">${esc(r.item)}</textarea>
              <p class="hint"><span class="kbd">{{item.field}}</span> isi item, <span class="kbd">{{no}}</span> nomor urut. Di judul: <span class="kbd">{{page}}</span>/<span class="kbd">{{pages}}</span>, <span class="kbd">{{count}}</span>. Maks. 10 pesan per daftar; daftar kosong dilewati tanpa pesan.</p></div>
            <div><label class="label">Bila daftar dipotong (opsional)</label><input class="input" name="rMore" maxlength="500" value="${esc(r.more)}" placeholder="…dan {{rest}} data lainnya."></div>
          </div>
        </div>
        <div id="fl-extras" class="${c.repeat ? 'hidden' : ''}">${replyExtrasHtml('fl', c)}</div>`;
      }
      case 'ask': return `<div><label class="label">Pertanyaan</label><textarea class="textarea" name="text" rows="4" maxlength="1024" placeholder="Silakan ketik …">${esc(c.text)}</textarea><p class="hint">${FL_VAR_HINT}</p></div>
        <div class="grid sm:grid-cols-2 gap-3">
          <div><label class="label">Simpan jawaban ke variabel</label><input class="input mono" name="var" maxlength="40" value="${esc(c.var)}" placeholder="kata_kunci"></div>
          <div><label class="label">Jenis jawaban</label><select class="select" name="input">${Object.entries(FL_INPUT).map(([k, l]) => `<option value="${k}" ${c.input === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div></div>
        <div id="ask-fields" class="space-y-3">${flAskFields(c)}</div>
        <div><label class="label">Pesan bila jawaban tidak valid</label><textarea class="textarea" name="invalidText" rows="2" maxlength="1024">${esc(c.invalidText)}</textarea></div>
        <div class="grid grid-cols-2 gap-3 max-w-md">
          <div><label class="label">Kesempatan ulang</label><input class="input" type="number" min="0" max="3" name="retries" value="${c.retries}"></div>
          <div><label class="label">Batas waktu menjawab (menit)</label><input class="input" type="number" min="1" max="1380" name="timeoutMinutes" value="${c.timeoutMinutes}"></div></div>
        <p class="hint">Flow berhenti sampai pelanggan membalas. Hasil: <span class="kbd">{{${esc(c.var || 'variabel')}}}</span> dan <span class="kbd">{{${esc(c.var || 'variabel')}_label}}</span>. Cabang <b>Tidak valid</b> dijalankan setelah kesempatan ulang habis; bila tidak dijawab sampai batas waktu, flow berakhir tanpa pesan. Pelanggan dapat membatalkan dengan kata pembatal di Pengaturan flow.</p>`;
      case 'waflow': {
        const list = (S.fl?.waFlows || []).filter((x) => x.status !== 'DEPRECATED');
        const cur = list.find((x) => x.id === c.flowId) || list[0];
        return list.length ? `<div class="grid sm:grid-cols-2 gap-3">
            <div><label class="label">WhatsApp Flow</label><select class="select" name="flowId">${list.map((x) => `<option value="${esc(x.id)}" ${x.id === cur?.id ? 'selected' : ''}>${esc(x.name)} — ${esc(WF_STATUS[x.status]?.[1] || x.status)}</option>`).join('')}</select></div>
            <div><label class="label">Screen pertama</label><input class="input mono" name="screen" list="fl-screens" maxlength="80" value="${esc(c.screen)}" placeholder="${esc(cur?.screens?.[0]?.id ? 'Otomatis: ' + cur.screens[0].id : 'ID screen, mis. MULAI')}"><datalist id="fl-screens">${(cur?.screens || []).map((s) => `<option value="${esc(s.id)}">`).join('')}</datalist></div></div>
          <div><label class="label">Teks pesan</label><textarea class="textarea" name="text" rows="3" maxlength="1024">${esc(c.text)}</textarea><p class="hint">${FL_VAR_HINT}</p></div>
          <div class="grid sm:grid-cols-3 gap-3">
            <div><label class="label">Teks tombol <span class="ink-3 font-normal">(maks. 30)</span></label><input class="input" name="cta" maxlength="30" value="${esc(c.cta)}"></div>
            <div><label class="label">Header <span class="ink-3 font-normal">(opsional)</span></label><input class="input" name="header" maxlength="60" value="${esc(c.header)}"></div>
            <div><label class="label">Footer <span class="ink-3 font-normal">(opsional)</span></label><input class="input" name="footer" maxlength="60" value="${esc(c.footer)}"></div></div>
          <div class="grid grid-cols-2 gap-3 max-w-md">
            <div><label class="label">Simpan isian ke variabel</label><input class="input mono" name="var" maxlength="40" value="${esc(c.var)}"></div>
            <div><label class="label">Batas waktu mengisi (menit)</label><input class="input" type="number" min="1" max="1380" name="timeoutMinutes" value="${c.timeoutMinutes}"></div></div>
          <p class="hint">Flow berhenti sampai pelanggan mengirim formulir. Isian tersedia sebagai <span class="kbd">{{${esc(c.var || 'formulir')}.nama_field}}</span> (nama field = kunci <i>payload</i> di Footer Flow JSON). Bila tidak diisi sampai batas waktu, cabang <b>Tidak diisi</b> dijalankan (mis. kirim pengingat). Formulir hanya dikirim dalam jendela 24 jam; hanya flow berstatus <b>Terbit</b> yang dapat dikirim ke pelanggan.</p>`
          : '<div class="empty">Belum ada WhatsApp Flow.<br><a href="#/waflows" class="accent-ink" data-act="modal-close">Buat atau sinkronkan di menu WhatsApp Flows</a></div>';
      }
      case 'api': return `<div class="grid grid-cols-[6.5rem_1fr] gap-3">
          <div><label class="label">Method</label><select class="select" name="method"><option ${c.method === 'GET' ? 'selected' : ''}>GET</option><option ${c.method === 'POST' ? 'selected' : ''}>POST</option></select></div>
          <div><label class="label">URL</label><input class="input mono text-xs" name="url" maxlength="1000" value="${esc(c.url)}" placeholder="https://api.contoh.id/cari?q={{kata_kunci}}" list="fl-vars">${flVarsList()}</div></div>
        <p class="hint -mt-1">Hanya HTTPS. Nilai variabel di URL otomatis di-encode (spasi, &, ?, dll.). Nama host tidak boleh berisi variabel; alamat jaringan lokal/privat ditolak.</p>
        <div><label class="label">Header (opsional) — satu per baris: <span class="kbd">Nama: nilai</span></label>
          <textarea class="textarea mono text-xs" name="headers" rows="2" placeholder="Authorization: Bearer {{secret.API_KEY}}">${esc((c.headers || []).map((h) => `${h.name}: ${h.value}`).join('\n'))}</textarea>
          <p class="hint">Kredensial ditulis sebagai <span class="kbd">{{secret.NAMA}}</span> dan dikelola di <b>Kredensial API</b> pada daftar flow. Nilainya terenkripsi dan tidak pernah tampil di log maupun browser.</p></div>
        <div id="api-body" class="${c.method === 'POST' ? '' : 'hidden'}"><label class="label">Body JSON</label><textarea class="textarea mono text-xs" name="body" rows="3" placeholder='{"q": "{{kata_kunci}}"}'>${esc(c.body || '')}</textarea></div>
        <div class="grid sm:grid-cols-3 gap-3">
          <div><label class="label">Simpan respons sebagai</label><input class="input mono" name="saveAs" maxlength="40" value="${esc(c.saveAs)}" placeholder="hasil"></div>
          <div><label class="label">Field penanda berhasil <span class="ink-3 font-normal">(opsional)</span></label><input class="input mono" name="okPath" value="${esc(c.okPath)}" placeholder="status"></div>
          <div><label class="label">Bernilai</label><input class="input mono" name="okValue" value="${esc(c.okValue)}" placeholder="success"></div></div>
        <div class="max-w-[10rem]"><label class="label">Timeout (detik)</label><input class="input" type="number" min="1" max="20" name="timeoutSec" value="${c.timeoutSec}"></div>
        <p class="hint">Cabang <b>Berhasil</b>: HTTP 2xx, respons JSON, dan field penanda (bila diisi) bernilai sesuai. Selain itu cabang <b>Gagal</b> (waktu habis, HTTP 4xx/5xx, bukan JSON). Tersedia <span class="kbd">{{${esc(c.saveAs || 'hasil')}.field}}</span>, <span class="kbd">{{${esc(c.saveAs || 'hasil')}_status}}</span>, <span class="kbd">{{${esc(c.saveAs || 'hasil')}_error}}</span>. Gunakan "Uji flow" untuk melihat struktur respons asli.</p>`;
      case 'assign': return `<div><label class="label">Teruskan ke</label><select class="select" name="mode">${Object.entries(FL_ASSIGN).map(([k, l]) => `<option value="${k}" ${c.mode === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
        <div id="assign-user" class="${c.mode === 'user' ? '' : 'hidden'}"><label class="label">Agen</label><select class="select" name="userId"><option value="">Pilih agen…</option>${S.users.filter((u) => u.active).map((u) => `<option value="${esc(u.id)}" ${c.userId === u.id ? 'selected' : ''}>${esc(u.name)}${u.role === 'admin' ? ' (admin)' : ''}</option>`).join('')}</select></div>
        <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="onlyIfUnassigned" ${c.onlyIfUnassigned ? 'checked' : ''}> Hanya bila percakapan belum ditugaskan</label>
        <p class="hint">Mode otomatis memilih dari pengguna aktif berperan agen (atau semua pengguna aktif bila belum ada agen). Agen menerima notifikasi penugasan seperti biasa.</p>`;
      case 'label': return `<div class="grid sm:grid-cols-[10rem_1fr] gap-3"><div><label class="label">Aksi</label><select class="select" name="remove"><option value="0">Tambah label</option><option value="1" ${c.remove ? 'selected' : ''}>Hapus label</option></select></div>
        <div><label class="label">Label</label><input class="input" name="label" list="fl-labels" maxlength="32" value="${esc(c.label)}" placeholder="Prospek"><datalist id="fl-labels">${(S.fl.labels || []).map((l) => `<option value="${esc(l)}">`).join('')}</datalist></div></div>`;
      case 'status': return `<div class="max-w-xs"><label class="label">Jadikan status percakapan</label><select class="select" name="status">${Object.entries(FL_STATUS).map(([k, l]) => `<option value="${k}" ${c.status === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>`;
      case 'note': return `<div><label class="label">Catatan</label><textarea class="textarea" name="text" rows="3" maxlength="2000" placeholder="Pelanggan menanyakan harga, mohon follow-up.">${esc(c.text)}</textarea>
        <p class="hint">Tidak dikirim ke pelanggan. ${FL_VAR_HINT}</p></div>`;
      case 'delay': {
        const hours = c.minutes % 60 === 0;
        return `<div class="grid grid-cols-[1fr_8rem] gap-2 max-w-xs"><div><label class="label">Tunggu selama</label><input class="input" type="number" min="1" name="amount" value="${hours ? c.minutes / 60 : c.minutes}"></div>
          <div><label class="label">Satuan</label><select class="select" name="unit"><option value="m">Menit</option><option value="h" ${hours ? 'selected' : ''}>Jam</option></select></div></div>
        <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="cancelOnReply" ${c.cancelOnReply ? 'checked' : ''}> Batalkan bila pelanggan mengirim pesan lagi atau CS membalas</label>
        <p class="hint">Maksimal 23 jam. Setelah menunggu, pesan hanya dikirim bila jendela layanan 24 jam masih terbuka.</p>`;
      }
      default: return '';
    }
  }
  function flReadForm(type, form) {
    const fd = new FormData(form), d = Object.fromEntries(fd), err = (m) => { throw new Error(m); };
    switch (type) {
      case 'condition': {
        const c = { kind: d.kind };
        if (d.kind === 'keyword') { c.match = d.match; c.keywords = d.keywords.split(',').map((k) => k.trim()).filter(Boolean); if (!c.keywords.length) err('Isi minimal satu kata kunci.'); }
        if (d.kind === 'schedule') { c.days = fd.getAll('days').map(Number); c.start = d.start; c.end = d.end; if (!c.days.length) err('Pilih minimal satu hari.'); if (!c.start || !c.end || c.start === c.end) err('Isi jam mulai dan selesai yang berbeda.'); }
        if (d.kind === 'label') { c.label = d.label.trim(); if (!c.label) err('Isi nama label.'); }
        if (d.kind === 'new_contact') c.days = Number(d.days);
        if (d.kind === 'message_type') { c.types = fd.getAll('types'); if (!c.types.length) err('Pilih minimal satu jenis pesan.'); }
        if (d.kind === 'variable') { c.path = d.path.trim(); c.op = d.op; c.value = d.value ?? ''; if (!c.path) err('Isi nama variabel.'); }
        return c;
      }
      case 'send': {
        const text = d.text.trim();
        if (fd.has('repeatOn')) {
          const repeat = { path: d.rPath.trim(), item: d.rItem.trim(), perMessage: Number(d.rPer), max: Number(d.rMax), more: d.rMore.trim() };
          if (!repeat.path) err('Isi variabel daftar, mis. hasil.data.');
          if (!repeat.item) err('Isi format tiap item.');
          if (Math.ceil(repeat.max / repeat.perMessage) > 10) err('Maksimal 10 pesan per daftar: naikkan item per pesan atau turunkan jumlah maksimal.');
          if (!text) err('Isi judul tiap pesan.');
          return { text, image: null, buttons: [], repeat };
        }
        const buttons = readButtons('fl', form), image = S.flDraftImage || null;
        if (!text && !image) err('Isi teks pesan atau pilih gambar.');
        if (buttons.length && !text) err('Teks pesan wajib diisi bila memakai tombol.');
        if ((image || buttons.length) && text.length > 1024) err(`Teks maksimal 1024 karakter bila memakai gambar atau tombol (sekarang ${text.length}).`);
        if (new Set(buttons.map((t) => t.toLowerCase())).size !== buttons.length) err('Teks tombol harus berbeda satu sama lain.');
        return { text, image, buttons };
      }
      case 'ask': {
        const c = { text: d.text.trim(), var: d.var.trim(), input: d.input, invalidText: d.invalidText.trim(), retries: Number(d.retries), timeoutMinutes: Number(d.timeoutMinutes) };
        if (!c.text) err('Isi pertanyaan.');
        if (!/^[a-z_][a-z0-9_]{0,39}$/i.test(c.var)) err('Nama variabel hanya huruf, angka, dan garis bawah (mis. kata_kunci).');
        if (c.input === 'text') Object.assign(c, { minLength: Number(d.minLength), maxLength: Number(d.maxLength), format: d.format });
        if (c.input === 'choice') {
          c.choices = d.choices.split('\n').map((l) => l.split('|')).filter((p) => p[0].trim()).map(([t, ...v]) => ({ title: t.trim(), value: v.join('|').trim() || t.trim() }));
          if (!c.choices.length || c.choices.length > 10) err('Isi 1–10 pilihan.');
          const long = c.choices.find((x) => x.title.length > (c.choices.length <= 3 ? 20 : 24));
          if (long) err(`Judul "${long.title}" terlalu panjang.`);
          c.button = d.button.trim() || 'Pilih';
        }
        if (c.input === 'date') Object.assign(c, { days: Number(d.days), includeToday: fd.has('includeToday'), skipWeekends: fd.has('skipWeekends'), otherLabel: d.otherLabel.trim(), otherPrompt: d.otherPrompt.trim(), button: d.button.trim() || 'Pilih tanggal' });
        return c;
      }
      case 'waflow': {
        if (!d.flowId) err('Pilih WhatsApp Flow (buat atau sinkronkan di menu WhatsApp Flows).');
        const c = { flowId: d.flowId, screen: d.screen, text: d.text.trim(), cta: d.cta.trim(), header: d.header.trim(), footer: d.footer.trim(), var: d.var.trim(), timeoutMinutes: Number(d.timeoutMinutes) };
        if (!c.text || !c.cta) err('Isi teks pesan dan teks tombol.');
        if (!/^[a-z_][a-z0-9_]{0,39}$/i.test(c.var)) err('Nama variabel hanya huruf, angka, dan garis bawah (mis. formulir).');
        return c;
      }
      case 'api': {
        const headers = d.headers.split('\n').map((l) => l.trim()).filter(Boolean).map((l) => { const i = l.indexOf(':'); if (i < 1) err(`Header "${l}" harus berformat Nama: nilai.`); return { name: l.slice(0, i).trim(), value: l.slice(i + 1).trim() }; });
        const c = { method: d.method, url: d.url.trim(), headers, body: d.method === 'POST' ? d.body.trim() : '', saveAs: d.saveAs.trim(), okPath: d.okPath.trim(), okValue: d.okValue.trim(), timeoutSec: Number(d.timeoutSec) };
        if (!/^https:\/\//i.test(c.url)) err('URL harus diawali https://');
        if (!c.saveAs) err('Isi nama variabel untuk menyimpan respons.');
        return c;
      }
      case 'assign': if (d.mode === 'user' && !d.userId) err('Pilih agen.'); return { mode: d.mode, userId: d.mode === 'user' ? d.userId : undefined, onlyIfUnassigned: fd.has('onlyIfUnassigned') };
      case 'label': if (!d.label.trim()) err('Isi nama label.'); return { label: d.label.trim(), remove: d.remove === '1' };
      case 'status': return { status: d.status };
      case 'note': if (!d.text.trim()) err('Isi catatan.'); return { text: d.text.trim() };
      case 'delay': {
        const minutes = Math.round(Number(d.amount) * (d.unit === 'h' ? 60 : 1));
        if (!(minutes >= 1 && minutes <= 1380)) err('Durasi tunggu harus antara 1 menit dan 23 jam.');
        return { minutes, cancelOnReply: fd.has('cancelOnReply') };
      }
      default: return {};
    }
  }
  function flStepModal(node, apply) {
    let cfg = structuredClone(node.cfg);
    S.flDraftImage = node.type === 'send' ? cfg.image || null : null;
    modal(`${node.id ? 'Ubah' : 'Tambah'}: ${FL_STEP[node.type].label}`, `<form id="f-step" class="space-y-3" novalidate>${flFormHtml(node.type, cfg)}</form>`,
      { wide: ['send', 'condition', 'label', 'ask', 'api', 'waflow'].includes(node.type), footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="step-ok">Terapkan</button>' });
    const form = $('#f-step');
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('change', (e) => {
      const t = e.target;
      if (t.name === 'kind') { cfg = { kind: t.value, ...flCondDefaults(t.value) }; $('#cond-fields').innerHTML = flCondFields(cfg); }
      if (t.name === 'op') $('#var-value')?.classList.toggle('hidden', ['empty', 'not_empty'].includes(t.value));
      if (t.name === 'input') $('#ask-fields').innerHTML = flAskFields({ ...FL_ASK_DEFAULTS, ...cfg, input: t.value });
      if (t.name === 'method') $('#api-body').classList.toggle('hidden', t.value !== 'POST');
      if (t.name === 'flowId' && node.type === 'waflow') {
        const x = (S.fl?.waFlows || []).find((w) => w.id === t.value);
        $('#fl-screens').innerHTML = (x?.screens || []).map((s) => `<option value="${esc(s.id)}">`).join('');
        form.screen.placeholder = x?.screens?.[0]?.id ? 'Otomatis: ' + x.screens[0].id : 'ID screen, mis. MULAI';
      }
      if (t.name === 'repeatOn') { $('#fl-repeat').classList.toggle('hidden', !t.checked); $('#fl-extras').classList.toggle('hidden', t.checked); }
      if (t.name === 'mode') $('#assign-user').classList.toggle('hidden', t.value !== 'user');
      if (t.dataset.arImg === 'fl') busy(null, async () => { const key = await uploadArImage(t.files[0]); if (key) { S.flDraftImage = key; $('#fl-img').innerHTML = imgPickerHtml('fl', key); } });
    });
    form.addEventListener('click', (e) => { if (e.target.closest('[data-ar-img-del="fl"]')) { S.flDraftImage = null; $('#fl-img').innerHTML = imgPickerHtml('fl', null); } });
    $('#step-ok').addEventListener('click', () => {
      try { apply(flReadForm(node.type, form)); closeModal(); flChanged(); toast('Langkah diterapkan — klik Simpan.'); } catch (e) { fail(e); }
    });
  }

  /* ───────────── WhatsApp Flows (Meta) ─────────────
   * Formulir interaktif resmi WhatsApp. Flow JSON disusun di sini (atau di WhatsApp Manager) dan divalidasi oleh Meta;
   * pratinjau memakai tautan pratinjau resmi Meta. Flow yang sudah terbit tidak dapat diubah — gandakan untuk versi baru.
   */
  const WF_STATUS = { DRAFT: ['amber', 'Draf'], PUBLISHED: ['green', 'Terbit'], DEPRECATED: ['', 'Nonaktif'], BLOCKED: ['red', 'Diblokir'], THROTTLED: ['amber', 'Dibatasi'] };
  const WF_CAT = { SIGN_UP: 'Pendaftaran', SIGN_IN: 'Masuk akun', APPOINTMENT_BOOKING: 'Janji temu', LEAD_GENERATION: 'Prospek', CONTACT_US: 'Hubungi kami', CUSTOMER_SUPPORT: 'Layanan pelanggan', SURVEY: 'Survei', OTHER: 'Lainnya' };
  const wfBadge = (s) => { const [c, l] = WF_STATUS[s] || ['', s || '—']; return `<span class="badge ${c ? 'badge-' + c : ''}"><span class="dot"></span>${esc(l)}</span>`; };
  const wfFooter = (label, fields) => ({ type: 'Footer', label, 'on-click-action': { name: 'complete', payload: Object.fromEntries(fields.map((f) => [f, `\${form.${f}}`])) } });
  // Contoh Flow JSON statis (tanpa endpoint): satu layar, data dikirim saat pelanggan menekan tombol di footer
  const WF_STARTERS = {
    blank: ['Kosong', ['OTHER'], { version: '7.3', screens: [{ id: 'MULAI', title: 'Formulir', terminal: true, success: true, layout: { type: 'SingleColumnLayout', children: [
      { type: 'TextHeading', text: 'Judul formulir' }, { type: 'TextBody', text: 'Tulis petunjuk singkat di sini.' },
      { type: 'TextInput', name: 'jawaban', label: 'Jawaban', 'input-type': 'text', required: true }, wfFooter('Kirim', ['jawaban'])] } }] }],
    contact: ['Formulir kontak', ['CONTACT_US'], { version: '7.3', screens: [{ id: 'KONTAK', title: 'Hubungi kami', terminal: true, success: true, layout: { type: 'SingleColumnLayout', children: [
      { type: 'TextSubheading', text: 'Isi data berikut, tim kami akan segera menghubungi Anda.' },
      { type: 'TextInput', name: 'nama', label: 'Nama lengkap', 'input-type': 'text', required: true },
      { type: 'TextInput', name: 'email', label: 'Email', 'input-type': 'email', required: false },
      { type: 'TextArea', name: 'pesan', label: 'Pesan', required: true }, wfFooter('Kirim', ['nama', 'email', 'pesan'])] } }] }],
    survey: ['Survei kepuasan', ['SURVEY'], { version: '7.3', screens: [{ id: 'SURVEI', title: 'Survei singkat', terminal: true, success: true, layout: { type: 'SingleColumnLayout', children: [
      { type: 'TextSubheading', text: 'Bagaimana pengalaman Anda dengan layanan kami?' },
      { type: 'RadioButtonsGroup', name: 'nilai', label: 'Penilaian', required: true, 'data-source': [
