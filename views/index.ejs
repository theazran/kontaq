      </tbody></table></div>
      <p class="hint">Status template diperbarui otomatis melalui webhook <span class="kbd">message_template_status_update</span>.</p>
    </div>`;
    $$('#tp-filter button').forEach((b) => b.addEventListener('click', () => { S.templates.filter = b.dataset.v; viewTemplates(); }));
    $('#tp-sync').addEventListener('click', (e) => busy(e.currentTarget, async () => { Object.assign(S.templates, await api('POST', '/api/templates/sync'), { loaded: true }); toast(`${S.templates.rows.length} template disinkronkan.`); viewTemplates(); }));
    $('#tp-new')?.addEventListener('click', templateCreateModal);
    $$('[data-view]').forEach((b) => b.addEventListener('click', () => {
      const t = S.templates.rows.find((x) => String(x.id) === b.dataset.view);
      modal(`${t.name} · ${t.language}`, `<div class="grid md:grid-cols-2 gap-4"><div class="space-y-2 text-xs">
        <div class="flex justify-between"><span class="ink-3">Kategori</span><span>${esc(t.category)}</span></div>
        <div class="flex justify-between"><span class="ink-3">Status</span>${statusBadge(t.status)}</div>
        <div class="flex justify-between"><span class="ink-3">ID</span><span class="mono">${esc(t.id)}</span></div>
        <div class="flex justify-between"><span class="ink-3">Format parameter</span><span>${esc(t.parameter_format || 'POSITIONAL')}</span></div>
        <details class="pt-2"><summary class="cursor-pointer ink-2">Komponen (JSON)</summary><pre class="kbd block p-2 mt-2 overflow-x-auto text-[11px]">${esc(JSON.stringify(t.components, null, 2))}</pre></details>
      </div><div>${tplPreview(t)}</div></div>`, { wide: true });
