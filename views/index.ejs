    S.call = { id: null, direction: 'BUSINESS_INITIATED', status: 'connecting', contactId: contact.id, contactName: contact.name, phone: contact.phone };
    renderCallBar();
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } });
