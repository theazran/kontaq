        ${rows.map((t) => `<tr>
          <td class="font-medium mono text-xs">${esc(t.name)}</td><td class="text-xs">${esc(t.category)}</td><td class="text-xs">${esc(t.language)}</td>
          <td>${statusBadge(t.status)}${t.rejected_reason && t.rejected_reason !== 'NONE' ? `<div class="text-[11px] danger-ink mt-0.5">${esc(t.rejected_reason)}</div>` : ''}</td>
          <td class="text-xs">${esc(t.quality_score?.score || '—')}</td>
          <td class="max-w-[22rem] truncate ink-2 text-xs">${esc(comp(t, 'BODY')?.text || '')}</td>
