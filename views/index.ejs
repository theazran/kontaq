      </div>
      <div class="card overflow-x-auto"><table class="tbl"><thead><tr><th>Nama</th><th>Kategori</th><th>Bahasa</th><th>Status</th><th>Kualitas</th><th>Isi</th><th></th></tr></thead><tbody>
        ${rows.map((t) => `<tr>
          <td class="font-medium mono text-xs">${esc(t.name)}</td><td class="text-xs">${esc(t.category)}</td><td class="text-xs">${esc(t.language)}</td>
          <td>${statusBadge(t.status)}${t.rejected_reason && t.rejected_reason !== 'NONE' ? `<div class="text-[11px] danger-ink mt-0.5">${esc(t.rejected_reason)}</div>` : ''}</td>
          <td class="text-xs">${esc(t.quality_score?.score || '—')}</td>
          <td class="max-w-[22rem] truncate ink-2 text-xs">${esc(comp(t, 'BODY')?.text || '')}</td>
          <td class="text-right whitespace-nowrap"><button class="btn btn-sm btn-ghost" data-view="${esc(t.id)}">Lihat</button>${S.isAdmin ? ` <button class="btn btn-sm btn-ghost btn-danger" data-del="${esc(t.id)}">Hapus</button>` : ''}</td></tr>`).join('') || `<tr><td colspan="7"><div class="empty">Belum ada template. Klik <b>Sinkronkan dari Meta</b> untuk memuat template dari WABA.</div></td></tr>`}
      </tbody></table></div>
      <p class="hint">Status template diperbarui otomatis melalui webhook <span class="kbd">message_template_status_update</span>.</p>
    </div>`;
    $$('#tp-filter button').forEach((b) => b.addEventListener('click', () => { S.templates.filter = b.dataset.v; viewTemplates(); }));
    $('#tp-sync').addEventListener('click', (e) => busy(e.currentTarget, async () => { Object.assign(S.templates, await api('POST', '/api/templates/sync'), { loaded: true }); toast(`${S.templates.rows.length} template disinkronkan.`); viewTemplates(); }));
    $('#tp-new')?.addEventListener('click', templateCreateModal);
    $$('[data-view]').forEach((b) => b.addEventListener('click', () => {
      const t = S.templates.rows.find((x) => String(x.id) === b.dataset.view);
      modal(`${t.name} · ${t.language}`, `<div class="grid md:grid-cols-2 gap-4"><div class="space-y-2 text-xs">
        <div class="flex justify-between"><span class="ink-3">Kategori</span><span>${esc(t.category)}</span></div>
        <div class="flex justify-between"><span class="ink-3">Status</span>${statusBadge(t.status)}</div>
        <div class="flex justify-between"><span class="ink-3">ID</span><span class="mono">${esc(t.id)}</span></div>
        <div class="flex justify-between"><span class="ink-3">Format parameter</span><span>${esc(t.parameter_format || 'POSITIONAL')}</span></div>
        <details class="pt-2"><summary class="cursor-pointer ink-2">Komponen (JSON)</summary><pre class="kbd block p-2 mt-2 overflow-x-auto text-[11px]">${esc(JSON.stringify(t.components, null, 2))}</pre></details>
      </div><div>${tplPreview(t)}</div></div>`, { wide: true });
    }));
    $$('[data-del]').forEach((b) => b.addEventListener('click', async () => {
      const t = S.templates.rows.find((x) => String(x.id) === b.dataset.del);
      if (await confirmBox(`Hapus template "${t.name}" (${t.language}) dari Meta? Nama yang sama tidak dapat dipakai ulang selama 30 hari.`, 'Hapus', true))
        busy(null, async () => { await api('DELETE', `/api/templates/${encodeURIComponent(t.name)}?id=${encodeURIComponent(t.id)}`); S.templates.rows = S.templates.rows.filter((x) => x.id !== t.id); toast('Template dihapus.'); viewTemplates(); });
    }));
