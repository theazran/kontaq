  function emojiModal(pick) {
    modal('Pilih emoji', `<div id="emo-m">${emojiPickerHtml()}</div>`);
    bindEmojiPicker($('#emo-m'), (e) => { closeModal(); pick(e); });
  }
  function attachAction(k) {
    const c = activeConv();
    ({
      document: () => pickFiles('', 'document'), media: () => pickFiles('image/*,video/*'), audio: () => pickFiles('audio/*', 'audio'),
      camera: () => (isTouch ? pickFiles('image/*', null, false, 'environment') : cameraModal()),
      location: locationPicker, contact: contactPicker, sticker: () => togglePop('sticker'),
      waflow: () => waFlowSendModal(c), buttons: buttonsModal, list: listModal, template: () => templateSendModal(c),
    })[k]();
  }
  function pickFiles(accept, force, multiple = true, capture) {
    const inp = document.createElement('input');
    inp.type = 'file'; if (accept) inp.accept = accept; inp.multiple = multiple; if (capture) inp.setAttribute('capture', capture);
    inp.addEventListener('change', () => { if (inp.files.length) openMediaComposer([...inp.files], { force }); });
    inp.click();
