      $('#gi-results').innerHTML = r.rows.slice(0, 30).map((c) => `<label class="flex items-center gap-2 px-3 py-2 border-b bd last:border-0 text-[13px] ${inGroup.has(c.phone) ? 'opacity-60' : ''}">
