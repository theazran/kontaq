  const WFB_VERSIONS = ['7.3', '7.2', '7.1', '7.0', '6.3', '6.2', '6.1', '6.0', '5.1', '5.0'];
  const vge = (v, min) => { const [a, b] = String(v).split('.').map(Number), [c, d] = String(min).split('.').map(Number); return a > c || (a === c && b >= d); };
  let wfbSeq = 0;
  const wuid = (p) => p + (++wfbSeq).toString(36) + Math.random().toString(36).slice(2, 6);
  const wic = (d) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
  const slugify = (s) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
  const clone = (x) => JSON.parse(JSON.stringify(x));

  const FW = [['', 'Normal'], ['bold', 'Tebal'], ['italic', 'Miring'], ['bold_italic', 'Tebal & miring']];
  const pText = (max, o = {}) => ({ k: 'text', l: 'Teks', t: o.rows ? 'textarea' : 'text', max, req: true, ...o });
  const pLabel = (max, l = 'Label pertanyaan') => ({ k: 'label', l, t: 'text', max, req: true });
  const pName = { k: 'name', t: 'name' };
  const pReq = { k: 'required', l: 'Wajib diisi', t: 'bool' };
  const pHelp = { k: 'helper-text', l: 'Teks bantuan', t: 'text', max: 80 };
  const pDesc = { k: 'description', l: 'Deskripsi', t: 'text', max: 300 };
  const pSens = { k: 'sensitive', l: 'Data sensitif (disamarkan di ringkasan chat)', t: 'bool', min: '5.1' };
  const pFont = [{ k: 'font-weight', l: 'Gaya huruf', t: 'select', opts: FW }, { k: 'strikethrough', l: 'Coret', t: 'bool' }, { k: 'markdown', l: 'Markdown (**tebal**, *miring*, daftar, tautan)', t: 'bool', min: '5.1' }];
  const pSel = [{ k: 'min-selected-items', l: 'Min. dipilih', t: 'number', lo: 0, half: true }, { k: 'max-selected-items', l: 'Maks. dipilih', t: 'number', lo: 1, half: true }];
  const isRange = (p) => p.mode === 'range';
  const pDates = [{ k: 'min-date', l: 'Tanggal paling awal', t: 'date', half: true }, { k: 'max-date', l: 'Tanggal paling akhir', t: 'date', half: true },
    { k: 'unavailable-dates', l: 'Tanggal tidak tersedia', t: 'dates', hint: 'Pisahkan dengan koma, format YYYY-MM-DD.' }];
  const wfbOpts = (titles) => titles.map((t, i) => ({ uid: wuid('o'), id: String(i + 1), title: t, description: '', idAuto: true }));
