    if (S.view !== 'campaigns') return;
    S.campaigns = rows;
    v.innerHTML = `<div class="p-4 md:p-6 max-w-7xl space-y-3">
      <div class="flex items-center gap-2"><p class="text-xs ink-3 flex-1">Campaign mengirim template APPROVED ke kontak terpilih melalui antrean (${BOOT.campaignRate} pesan/detik). Patuhi kebijakan opt-in WhatsApp.</p>
      <button class="btn btn-primary" id="cp-new">${ICON.plus} Campaign baru</button></div>
      <div class="card overflow-x-auto"><table class="tbl"><thead><tr><th>Nama</th><th>Template</th><th>Status</th><th>Progres</th><th class="text-right">Terkirim</th><th class="text-right">Diterima</th><th class="text-right">Dibaca</th><th class="text-right">Gagal</th><th>Dibuat</th><th></th></tr></thead>
      <tbody id="cp-rows">${rows.map(campaignRow).join('') || '<tr><td colspan="10"><div class="empty">Belum ada campaign.</div></td></tr>'}</tbody></table></div>
    </div>`;
