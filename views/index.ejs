  // Layar panggilan: layar penuh di HP, kartu di pojok kanan bawah di desktop
  // Baris pengaturan dengan sakelar; perubahan langsung dikirim ke Meta (POST /{phone-number-id}/settings)
  function renderCallSettings(calling) {
    const el = $('#cl-settings'); if (!el) return;
