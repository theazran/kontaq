          <div>Data dikirim ke Kontaq lewat <span class="kbd">Footer</span> → <span class="kbd">on-click-action: complete</span> → <span class="kbd">payload</span>, mis. <span class="kbd">"nama": "\${form.nama}"</span>. Kunci payload menjadi nama isian di inbox dan CSV.</div>
          <div><a class="underline" href="https://developers.facebook.com/docs/whatsapp/flows/reference/flowjson" target="_blank" rel="noopener noreferrer">Referensi Flow JSON (Meta)</a></div>
        </section>
      </aside>
    </div>`;
    const ta = $('#wf-json');
    const check = () => {
      d.draft = ta.value;
      try { const j = JSON.parse(ta.value); $('#wf-local').innerHTML = `JSON valid · versi ${esc(j.version || '?')} · ${(j.screens || []).length} screen`; $('#wf-local').className = 'px-4 py-2 border-t bd text-[11px] accent-ink'; }
      catch (e) { $('#wf-local').textContent = 'JSON tidak valid: ' + e.message; $('#wf-local').className = 'px-4 py-2 border-t bd text-[11px] danger-ink'; }
    };
    ta.addEventListener('input', check); check(); d.draft = null;
    ta.addEventListener('keydown', (e) => { if (e.key === 'Tab' && !ta.readOnly) { e.preventDefault(); ta.setRangeText('  ', ta.selectionStart, ta.selectionEnd, 'end'); } });
