  // Lightbox gambar: navigasi antar-gambar di percakapan, unduh, Esc untuk menutup
  function openLightbox(msgs, mid) {
    const imgs = msgs.filter((m) => m.type === 'image' && (m.content?.mediaId || m.content?.arImage));
    let i = Math.max(0, imgs.findIndex((m) => m.id === mid));
    const root = document.createElement('div');
    root.className = 'viewer viewer-dark'; root.setAttribute('role', 'dialog'); root.setAttribute('aria-modal', 'true');
    document.body.appendChild(root);
    const srcOf = (m) => (m.content.arImage ? `/api/autoreply/media/${m.content.arImage}` : `/api/media/${encodeURIComponent(m.content.mediaId)}`);
    const draw = () => {
      const m = imgs[i];
      root.innerHTML = `<div class="viewer-h"><div class="min-w-0 flex-1"><div class="text-[13px] font-medium truncate">${esc(m.direction === 'out' ? (m.userName || 'Anda') : contactName(activeConv()?.contact || {}) || m.fromName || 'Pelanggan')}</div><div class="text-[11px] opacity-70">${esc(fmtDT(m.timestamp))} · ${i + 1}/${imgs.length}</div></div>
          ${m.content.mediaId ? `<a class="btn btn-ghost btn-icon text-inherit" href="${srcOf(m)}?download=1" title="Unduh" aria-label="Unduh">${ICON.download}</a>` : ''}
          <button class="btn btn-ghost btn-icon text-inherit" data-lb-x title="Tutup (Esc)" aria-label="Tutup">${ICON.x}</button></div>
        <div class="viewer-main"><img src="${srcOf(m)}" alt="${esc(m.content.caption || 'Gambar')}">
          ${i > 0 ? `<button class="lb-nav left-3" data-lb-prev aria-label="Sebelumnya">${ICON.back}</button>` : ''}
          ${i < imgs.length - 1 ? `<button class="lb-nav right-3" data-lb-next aria-label="Berikutnya">${ICON.chevR}</button>` : ''}</div>
        ${m.content.caption ? `<div class="viewer-f text-center text-[13px]">${waFormat(m.content.caption)}</div>` : ''}`;
    };
    const close = () => { root.remove(); document.removeEventListener('keydown', key); };
    const key = (e) => { if (e.key === 'Escape') close(); if (e.key === 'ArrowLeft' && i > 0) { i--; draw(); } if (e.key === 'ArrowRight' && i < imgs.length - 1) { i++; draw(); } };
    root.addEventListener('click', (e) => {
      if (e.target.closest('[data-lb-x]') || e.target.classList.contains('viewer-main')) close();
      else if (e.target.closest('[data-lb-prev]')) { i--; draw(); } else if (e.target.closest('[data-lb-next]')) { i++; draw(); }
    });
    document.addEventListener('keydown', key);
    draw();
  }

  // Reaksi: bar emoji cepat di dekat pesan; emoji sama dengan reaksi Anda = hapus
  function openReactBar(btn, m) {
    if (!m) return;
    $('.react-bar')?.remove();
    const bar = document.createElement('div');
    bar.className = 'react-bar';
    bar.innerHTML = QUICK_REACTIONS.map((e) => `<button type="button" data-e="${e}" class="${m.myReaction === e ? 'on' : ''}">${e}</button>`).join('') + `<button type="button" class="more" data-more aria-label="Emoji lain">${ICON.plus}</button>`;
    document.body.appendChild(bar);
    const r = btn.getBoundingClientRect(), w = bar.offsetWidth;
    bar.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, r.left + r.width / 2 - w / 2)) + 'px';
    bar.style.top = Math.max(8, r.top - bar.offsetHeight - 6) + 'px';
    const close = (e) => { if (!e || !bar.contains(e.target)) { bar.remove(); document.removeEventListener('mousedown', close, true); } };
    setTimeout(() => document.addEventListener('mousedown', close, true), 0);
    bar.addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      bar.remove(); document.removeEventListener('mousedown', close, true);
      if (b.dataset.more !== undefined) return emojiModal((emo) => sendReaction(m.id, emo === m.myReaction ? '' : emo));
      sendReaction(m.id, b.dataset.e === m.myReaction ? '' : b.dataset.e);
    });
  }
  async function sendReaction(mid, emoji) {
    const c = activeConv(); if (!c) return;
    try {
      const msg = await api('POST', `/api/conversations/${c.id}/messages`, { type: 'reaction', messageId: mid, emoji });
      const i = S.inbox.messages.findIndex((x) => x.id === msg.id);
      if (i >= 0) { S.inbox.messages[i] = msg; renderMessages(); }
    } catch (e) { fail(e); }
  }
  // Kartu kontak: "Kirim pesan" membuka chat (kontak dibuat bila belum ada), "Simpan" menambahkan ke Kontak
  async function contactAction(m, action) {
    const list = (m?.content?.contacts || []).filter((k) => k.phones?.length);
    if (!list.length) return toast('Kontak ini tidak memiliki nomor telepon.', true);
    await busy(null, async () => {
      let first = null, saved = 0;
      for (const k of action === 'chat' ? list.slice(0, 1) : list) {
        const phone = String(k.phones[0]).replace(/\D/g, '');
        const found = (await api('GET', `/api/contacts?q=${encodeURIComponent(phone)}&page=1`)).rows.find((r) => r.phone === phone);
        const contact = found || await api('POST', '/api/contacts', { phone, name: k.name });
        if (!found) saved++;
        first = first || contact;
      }
      if (action === 'chat') { const conv = await api('POST', '/api/conversations', { contactId: first.id }); location.hash = '#/inbox/' + conv.id; }
      else toast(saved ? `${saved} kontak disimpan.` : 'Kontak sudah ada di daftar Kontak.');
    });
  }
  // Geser pesan ke kanan untuk membalas (layar sentuh)
  function bindSwipeReply(el) {
    let row = null, x0 = 0, y0 = 0, dx = 0;
    el.addEventListener('touchstart', (e) => { row = e.target.closest('.msg-row'); if (!row) return; x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; dx = 0; }, { passive: true });
    el.addEventListener('touchmove', (e) => {
      if (!row) return;
      const mx = e.touches[0].clientX - x0, my = e.touches[0].clientY - y0;
      if (dx === 0 && Math.abs(my) > Math.abs(mx)) { row = null; return; }
      dx = Math.max(0, Math.min(80, mx)); row.classList.add('swiping'); row.style.transform = `translateX(${dx}px)`;
    }, { passive: true });
    el.addEventListener('touchend', () => {
      if (!row) return;
      row.classList.remove('swiping'); row.style.transform = '';
      if (dx > 56) { S.inbox.replyTo = row.dataset.mid; renderComposer(); navigator.vibrate?.(15); $('#cmp-text')?.focus(); }
      row = null;
    });
  }
  /* ───────────── Composer ala WhatsApp ───────────── */
