        ${ro ? '' : `<div class="wfb-comp-act"><button class="btn btn-ghost btn-sm btn-icon" data-ca="up" ${i ? '' : 'disabled'} aria-label="Naikkan">${ICON.up}</button><button class="btn btn-ghost btn-sm btn-icon" data-ca="down" ${i < s.children.length - 1 ? '' : 'disabled'} aria-label="Turunkan">${ICON.down}</button><button class="btn btn-ghost btn-sm btn-icon" data-ca="dup" aria-label="Gandakan" title="Gandakan">${ICON.copy}</button><button class="btn btn-ghost btn-sm btn-icon" data-ca="del" aria-label="Hapus" title="Hapus">${ICON.trash}</button></div>`}
