  /* Seret untuk mengurutkan (mouse & sentuh) + keyboard (panah atas/bawah pada pegangan) */
  const WFB_GRIP = '<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg>';
  function wfbSortable(list, itemSel, onMove) {
    if (!list || list.dataset.sortable) return;
    list.dataset.sortable = '1';
    const items = () => [...list.children].filter((x) => x.matches(itemSel));
    list.addEventListener('keydown', (e) => {
      const h = e.target.closest('[data-grip]'); if (!h || !['ArrowUp', 'ArrowDown'].includes(e.key)) return;
      e.preventDefault();
      const it = h.closest(itemSel), from = items().indexOf(it), to = from + (e.key === 'ArrowUp' ? -1 : 1);
      if (to < 0 || to >= items().length) return;
      onMove(from, to);
      requestAnimationFrame(() => { const nh = items()[to]?.querySelector('[data-grip]'); nh?.focus(); });
    });
    list.addEventListener('pointerdown', (e) => {
      const h = e.target.closest('[data-grip]'); if (!h || e.button > 0) return;
      const it = h.closest(itemSel); if (!it || it.parentElement !== list) return;
      e.preventDefault();
      const from = items().indexOf(it), r = it.getBoundingClientRect(), dy = e.clientY - r.top;
      const ghost = it.cloneNode(true);
      Object.assign(ghost.style, { position: 'fixed', left: r.left + 'px', top: r.top + 'px', width: r.width + 'px', zIndex: 80, pointerEvents: 'none' });
      ghost.classList.add('dnd-ghost'); document.body.appendChild(ghost);
      it.classList.add('dnd-ph');
      const scroller = list.closest('.wfb-pane') || $('#view');
      let raf = 0, lastY = e.clientY;
      const move = (ev) => {
        lastY = ev.clientY; ghost.style.top = ev.clientY - dy + 'px';
        const others = items().filter((x) => x !== it);
        const before = others.find((x) => { const b = x.getBoundingClientRect(); return ev.clientY < b.top + b.height / 2; });
        if (before) { if (it.nextElementSibling !== before) list.insertBefore(it, before); }
        else { const last = others[others.length - 1]; if (last && last.nextElementSibling !== it) last.after(it); }
      };
      const tick = () => { // gulir otomatis di dekat tepi
        const b = scroller.getBoundingClientRect();
        if (lastY < b.top + 40) scroller.scrollTop -= 8; else if (lastY > b.bottom - 40) scroller.scrollTop += 8;
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
      const end = () => {
        cancelAnimationFrame(raf);
        document.removeEventListener('pointermove', move); document.removeEventListener('pointerup', end); document.removeEventListener('pointercancel', end);
        ghost.remove(); it.classList.remove('dnd-ph');
        const to = items().indexOf(it);
        if (to !== from) { list.insertBefore(it, items()[from + (from > to ? 1 : 0)] || null); onMove(from, to); }
      };
      document.addEventListener('pointermove', move); document.addEventListener('pointerup', end); document.addEventListener('pointercancel', end);
    });
  }

  /* Header editor: simpan, validasi, terbitkan */
  const wfbMetaDirty = () => { const b = wb(), f = S.wfd?.flow; return !!(b && f && (b.meta.name !== f.name || b.meta.category !== ((f.categories || [])[0] || 'OTHER'))); };
  function wfbJsonText() { return JSON.stringify(wfbToJson(wb().m), null, 2); }
  async function wfbSave({ silent } = {}) {
    const b = wb(), f = S.wfd.flow;
    if (!b.meta.name.trim()) throw new Error('Nama flow wajib diisi.');
    if (wfbMetaDirty()) {
      const cats = b.meta.category === (f.categories || [])[0] ? f.categories : [b.meta.category];
      S.wfd.flow = await api('PATCH', `/api/wa-flows/${encodeURIComponent(f.id)}`, { name: b.meta.name.trim(), categories: cats });
    }
    if (b.dirty && !wfbRO()) {
      const json = wfbJsonText();
      S.wfd.flow = await api('PUT', `/api/wa-flows/${encodeURIComponent(f.id)}/json`, { json });
      b.src = S.wfd.flow.json; b.dirty = false;
    }
    b.meta = { name: S.wfd.flow.name, category: (S.wfd.flow.categories || [])[0] || 'OTHER' };
    const n = S.wfd.flow.validationErrors?.length || 0;
    if (!silent) toast(n ? `Tersimpan. Meta menemukan ${n} error validasi — buka Validasi.` : 'Tersimpan dan lolos validasi Meta.', !!n);
    wfhRender(); wfbRenderStatus(); wfbRenderPreview();
    return n;
  }
  function wfbValidateModal() {
    const b = wb(), f = S.wfd.flow;
