        <div><label class="label">Cocok bila pesan</label><select class="select" name="match">${Object.entries(AR_MATCH).map(([k, l]) => `<option value="${k}" ${x.match === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
        <div><label class="label">Kata kunci (pisahkan dengan koma)</label><input class="input" name="keywords" value="${esc(x.keywords.join(', '))}" required placeholder="harga, price list, berapa"></div>
      </div>
      <p class="hint -mt-1">"Mengandung kata" mencocokkan kata utuh tanpa membedakan huruf besar/kecil: <span class="kbd">harga</span> cocok dengan "Berapa harga paket?" tetapi tidak dengan "hargai".</p>
      <div><label class="label">Teks balasan</label><textarea class="textarea" name="reply" rows="4" maxlength="4096" placeholder="Halo {{name}}, berikut daftar harga kami: …">${esc(x.reply)}</textarea><p class="hint">Variabel: <span class="kbd">{{name}}</span> <span class="kbd">{{phone}}</span>. Format WhatsApp: *tebal* _miring_. Boleh kosong bila hanya mengirim gambar.</p></div>
      ${replyExtrasHtml('rule', x)}
    </form>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="rule-ok">Terapkan</button>' });
    const f = $('#f-rule');
    const drawImg = () => { $('#rule-img').innerHTML = imgPickerHtml('rule', S.ruleDraftImage); };
    f.addEventListener('change', (e) => { if (e.target.dataset.arImg === 'rule') busy(null, async () => { const key = await uploadArImage(e.target.files[0]); if (key) { S.ruleDraftImage = key; drawImg(); } }); });
    f.addEventListener('click', (e) => { if (e.target.closest('[data-ar-img-del="rule"]')) { S.ruleDraftImage = null; drawImg(); } });
    $('#rule-ok').addEventListener('click', () => {
      if (!f.reportValidity()) return;
      const d = formData(f), buttons = readButtons('rule', f), image = S.ruleDraftImage, reply = d.reply.trim();
      if (!reply && !image) return fail(new Error('Isi teks balasan atau pilih gambar.'));
      if (buttons.length && !reply) return fail(new Error('Teks balasan wajib diisi bila memakai tombol.'));
      if ((image || buttons.length) && reply.length > 1024) return fail(new Error(`Teks maksimal 1024 karakter bila memakai gambar atau tombol (sekarang ${reply.length}).`));
      if (new Set(buttons.map((t) => t.toLowerCase())).size !== buttons.length) return fail(new Error('Teks tombol harus berbeda satu sama lain.'));
      S.ar = collectAutoReply();
      const rule = { ...x, name: d.name.trim() || 'Aturan', match: d.match, keywords: d.keywords.split(',').map((k) => k.trim()).filter(Boolean), reply, image, buttons };
      if (i === undefined) S.ar.rules.push(rule); else S.ar.rules[i] = rule;
      S.arDirty = true; closeModal(); renderAutoReply(); toast('Aturan diterapkan — klik Simpan.');
    });
  }

  /* ───────────── Flow otomatis (Automation Flow Builder) ─────────────
   * Flow berbentuk pohon: setiap langkah punya satu langkah sebelumnya (next, atau yes/no untuk kondisi).
   * Validasi akhir & eksekusi ada di server; di sini hanya penyusunan dan pratinjau.
   */
  const FL_STEP = {
    condition: { label: 'Kondisi', icon: 'branch', desc: 'Cabang Ya / Tidak: kata kunci, jadwal, label…' },
    send: { label: 'Kirim pesan', icon: 'send', desc: 'Teks, gambar, dan tombol balasan' },
    assign: { label: 'Teruskan ke agen', icon: 'users', desc: 'Tugaskan ke agen tertentu atau otomatis' },
    label: { label: 'Label kontak', icon: 'tag', desc: 'Tambah atau hapus label kontak' },
    status: { label: 'Ubah status', icon: 'check', desc: 'Terbuka, menunggu, atau selesai' },
    note: { label: 'Catatan internal', icon: 'edit', desc: 'Hanya terlihat oleh tim' },
    delay: { label: 'Tunggu', icon: 'clock', desc: 'Jeda sebelum langkah berikutnya' },
  };
  const FL_COND = { keyword: 'Kata kunci', schedule: 'Jadwal', business_hours: 'Jam kerja', label: 'Label kontak', new_contact: 'Kontak baru', message_type: 'Jenis pesan', assigned: 'Sudah ditugaskan' };
  const FL_MSG = { text: 'Teks', image: 'Gambar', video: 'Video', audio: 'Audio', document: 'Dokumen', sticker: 'Stiker', location: 'Lokasi', reply: 'Balasan tombol/daftar', contacts: 'Kontak' };
  const FL_STATUS = { open: 'Terbuka', pending: 'Menunggu', closed: 'Selesai' };
  const FL_ASSIGN = { least_busy: 'Agen dengan percakapan paling sedikit', round_robin: 'Bergiliran (round-robin)', user: 'Agen tertentu' };
  const FL_RUN = { done: ['green', 'Selesai'], waiting: ['amber', 'Menunggu'], running: ['amber', 'Berjalan'], failed: ['red', 'Gagal'], cancelled: ['', 'Dibatalkan'] };
  const FL_STARTERS = {
    blank: ['Flow kosong', 'Mulai dari pemicu saja.'],
    keyword_agent: ['Kata kunci → balas → teruskan ke agen', 'Pesan berisi "harga"/"promo" dibalas otomatis lalu diteruskan ke agen.'],
    after_hours: ['Jam kerja', 'Di jam kerja diteruskan ke agen; di luar jam kerja dibalas pesan otomatis.'],
    welcome: ['Sambutan kontak baru', 'Kontak baru menerima sambutan dengan tombol pilihan.'],
  };
  const flId = () => 'n' + Math.random().toString(36).slice(2, 10);
  const flMinutes = (m) => (m % 60 ? (m > 60 ? `${Math.floor(m / 60)} jam ${m % 60} menit` : `${m} menit`) : `${m / 60} jam`);
  const flMask = (p) => (p && p.length > 6 ? '+' + p.slice(0, 4) + '•••' + p.slice(-2) : p || '');
  const flCondDefaults = (kind) => ({ keyword: { match: 'contains', keywords: [] }, schedule: { days: [1, 2, 3, 4, 5], start: '08:00', end: '17:00' }, label: { label: '' }, new_contact: { days: 30 }, message_type: { types: ['text'] } }[kind] || {});
  const flDefaultCfg = (type) => ({
    condition: { kind: 'keyword', ...flCondDefaults('keyword') }, send: { text: '', image: null, buttons: [] }, assign: { mode: 'least_busy', onlyIfUnassigned: true },
    label: { label: '', remove: false }, status: { status: 'closed' }, note: { text: '' }, delay: { minutes: 30, cancelOnReply: true },
  }[type] || {});

  function flStarter(kind) {
    const root = flId(), nodes = { [root]: { id: root, type: 'trigger', cfg: {}, next: null } };
    const add = (type, cfg, links = {}) => { const id = flId(); nodes[id] = { id, type, cfg, ...(type === 'condition' ? { yes: null, no: null } : { next: null }), ...links }; return id; };
    let name = 'Flow baru';
    if (kind === 'keyword_agent') {
      name = 'Info harga → teruskan ke agen';
      const assign = add('assign', { mode: 'least_busy', onlyIfUnassigned: true });
      const send = add('send', { text: 'Halo {{name}}, terima kasih sudah bertanya. Agen kami akan segera membantu Anda.', image: null, buttons: [] }, { next: assign });
      nodes[root].next = add('condition', { kind: 'keyword', match: 'contains', keywords: ['harga', 'promo', 'paket'] }, { yes: send });
    } else if (kind === 'after_hours') {
      name = 'Jam kerja';
      const assign = add('assign', { mode: 'round_robin', onlyIfUnassigned: true });
      const lbl = add('label', { label: 'Di luar jam kerja', remove: false });
      const away = add('send', { text: 'Halo {{name}}, kami sedang di luar jam operasional. Pesan Anda akan kami balas pada jam kerja berikutnya.', image: null, buttons: [] }, { next: lbl });
      nodes[root].next = add('condition', { kind: 'business_hours' }, { yes: assign, no: away });
    } else if (kind === 'welcome') {
      name = 'Sambutan kontak baru';
      const send = add('send', { text: 'Halo {{name}}, selamat datang! Silakan pilih topik yang Anda butuhkan:', image: null, buttons: ['Info produk', 'Bantuan'] });
      nodes[root].next = add('condition', { kind: 'new_contact', days: 30 }, { yes: send });
    }
    return { id: null, name, enabled: false, root, nodes, settings: { pauseIfHumanMin: 30, cooldownMin: 0, activeFrom: '', activeUntil: '' } };
  }

  function flSummary(n) {
    const c = n.cfg || {};
    switch (n.type) {
      case 'trigger': return 'Setiap pesan masuk dari pelanggan';
      case 'condition': return ({
        keyword: () => `${AR_MATCH[c.match]}: ${c.keywords.join(', ')}`,
        schedule: () => `${c.days.map((d) => AR_DAYS[d].slice(0, 3)).join(', ')} · ${c.start}–${c.end}`,
        business_hours: () => 'Sesuai jam kerja di Auto reply',
        label: () => `Kontak berlabel "${c.label}"`,
        new_contact: () => `Kontak baru, atau tidak aktif > ${c.days} hari`,
        message_type: () => c.types.map((t) => FL_MSG[t]).join(', '),
        assigned: () => 'Percakapan sudah punya agen',
      }[c.kind] || (() => ''))();
      case 'send': return c.text || (c.image ? '(gambar tanpa teks)' : '');
      case 'assign': return (c.mode === 'user' ? S.users.find((u) => u.id === c.userId)?.name || 'Agen' : FL_ASSIGN[c.mode]) + (c.onlyIfUnassigned ? ' · bila belum ditugaskan' : '');
      case 'label': return `${c.remove ? 'Hapus' : 'Tambah'} "${c.label}"`;
      case 'status': return 'Jadikan ' + FL_STATUS[c.status];
      case 'note': return c.text;
      case 'delay': return flMinutes(c.minutes) + (c.cancelOnReply ? ' · batal bila dibalas' : '');
      default: return '';
    }
  }
  const flStepLine = (s) => `<li class="flex gap-2 text-xs"><span class="${s.ok ? 'accent-ink' : 'danger-ink'} flex-none w-3">${s.ok ? '✓' : '✕'}</span>
    <span class="ink-3 flex-none">${esc(s.type === 'trigger' ? 'Pemicu' : FL_STEP[s.type]?.label || s.type)}</span><span class="ink-2 min-w-0 break-words">${esc(s.log)}</span></li>`;
  function flRunsHtml(runs, showFlow) {
    if (!runs.length) return '<div class="empty">Belum ada riwayat.<br><span class="text-xs">Riwayat dicatat saat flow menjalankan aksi, menunggu, atau gagal.</span></div>';
    return runs.map((r) => {
      const [cls, label] = FL_RUN[r.status] || ['', r.status];
      return `<details class="border-b bd last:border-0"><summary class="px-4 py-2.5 flex items-center gap-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-[13px]">
          <span class="min-w-0 flex-1 truncate">${showFlow ? `<b class="font-medium">${esc(r.flowName)}</b> · ` : ''}${esc(flMask(r.phone))}${r.text ? ` · <span class="ink-3">"${esc(r.text.slice(0, 40))}"</span>` : ''}</span>
          <span class="text-[11px] ink-3 flex-none">${esc(fmtDT(r.startedAt))}</span><span class="badge ${cls ? 'badge-' + cls : ''} flex-none">${label}</span></summary>
        <div class="px-4 pb-3"><ol class="space-y-1">${r.steps.map(flStepLine).join('')}</ol>
          ${r.status === 'waiting' ? `<div class="flex items-center justify-between gap-2 mt-2 text-xs ink-3"><span>Lanjut ${esc(fmtDT(r.resumeAt))}</span><button class="btn btn-sm" data-fl-cancel="${esc(r.id)}">Batalkan</button></div>` : ''}
          ${r.error ? `<div class="text-xs danger-ink mt-2">${esc(r.error)}</div>` : ''}</div></details>`;
    }).join('');
  }
  async function flCancelRun(id, after) {
    if (!await confirmBox('Batalkan run yang sedang menunggu? Langkah berikutnya tidak akan dijalankan.', 'Batalkan run', true)) return;
    await busy(null, async () => { await api('POST', `/api/flows/runs/${encodeURIComponent(id)}/cancel`); toast('Run dibatalkan.'); await after(); });
  }

  /* Daftar flow */
  async function viewFlows(arg) {
    if (arg) return viewFlowEditor(arg);
    const v = $('#view'), tok = location.hash;
    v.innerHTML = '<div class="p-4 md:p-6 max-w-5xl mx-auto"><div class="card p-4 text-xs ink-3">Memuat flow…</div></div>';
    try {
      S.fl = await api('GET', '/api/flows');
      if (!S.users.length) S.users = await api('GET', '/api/users').catch(() => []);
    } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (location.hash !== tok) return;
    renderFlowList();
  }
  function renderFlowList() {
    const a = S.fl, v = $('#view');
    const iconBtn = (attr, icon, label, extra = '') => `<button type="button" class="btn btn-ghost btn-icon btn-sm ${extra}" ${attr} title="${label}" aria-label="${label}">${icon}</button>`;
    v.innerHTML = `<div class="p-4 md:p-6 max-w-5xl mx-auto space-y-4" id="fl-root">
      <section class="card p-4 flex flex-col sm:flex-row sm:items-center gap-3">
        <span class="hidden sm:inline-flex w-9 h-9 rounded-lg items-center justify-center flex-none surface-2">${ICON.flow.replace('<svg', '<svg width="18" height="18"')}</span>
        <div class="flex-1 min-w-0"><div class="font-semibold">Flow otomatis</div>
          <div class="text-xs ink-3 mt-0.5">Susun alur tanpa coding, mis. pesan masuk → cek kata kunci → kirim balasan → teruskan ke agen. Flow dicek dari atas ke bawah; flow pertama yang menjalankan aksi menghentikan pengecekan.</div></div>
        <button class="btn btn-primary flex-none" id="fl-new">${ICON.plus} Flow baru</button>
      </section>
      ${a.autoReplyEnabled ? `<div class="rounded-md px-3 py-2 text-xs" style="background:var(--warn-soft);color:var(--warn)">Auto reply juga aktif. Bila sebuah flow menjalankan aksi untuk suatu pesan, Auto reply tidak dijalankan untuk pesan itu sehingga pelanggan tidak menerima balasan ganda.</div>` : ''}
      <section class="card">
        <div class="card-h"><div class="card-t">Flow (${a.flows.length})</div><span class="text-[11px] ink-3">Zona waktu ${esc(a.timezone)} · ${esc(AR_DAYS[a.now.day])} ${esc(a.now.time)}</span></div>
        <div>${a.flows.map((f, i) => `<div class="px-4 py-3 border-b bd last:border-0 flex gap-3 ${f.enabled ? '' : 'opacity-70'}">
            <div class="pt-0.5">${sw('fl-on-' + f.id, f.enabled, 'Aktifkan ' + f.name)}</div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start gap-2">
                <a href="#/flows/${esc(f.id)}" class="min-w-0 flex-1"><div class="font-medium truncate hover:underline">${esc(f.name)}</div>
                  <div class="text-[11px] ink-3 mt-0.5">${f.steps} langkah · ${f.conditions} kondisi · ${fmtNum(f.stats.runs)}× berjalan${f.stats.lastRunAt ? ' · terakhir ' + esc(fmtDT(f.stats.lastRunAt)) : ''}</div></a>
                <div class="flex items-center -mr-1.5 -mt-1 flex-none">
                  ${iconBtn(`data-fl-up="${i}" ${i === 0 ? 'disabled' : ''}`, ICON.up, 'Naikkan')}
                  ${iconBtn(`data-fl-down="${i}" ${i === a.flows.length - 1 ? 'disabled' : ''}`, ICON.down, 'Turunkan')}
                  ${iconBtn(`data-fl-dup="${esc(f.id)}"`, ICON.copy, 'Duplikat')}
                  <a href="#/flows/${esc(f.id)}" class="btn btn-ghost btn-icon btn-sm" title="Ubah" aria-label="Ubah">${ICON.edit}</a>
                  ${iconBtn(`data-fl-del="${esc(f.id)}"`, ICON.trash, 'Hapus', 'btn-danger')}
                </div>
              </div>
              <div class="flex flex-wrap gap-1 mt-1.5">
                ${f.waiting ? `<span class="badge badge-amber">${f.waiting} menunggu</span>` : ''}
                ${f.settings.activeFrom || f.settings.activeUntil ? `<span class="badge">${ICON.clock.replace('<svg', '<svg width="11" height="11"')} ${esc(f.settings.activeFrom || '…')} – ${esc(f.settings.activeUntil || '…')}</span>` : ''}
                ${f.stats.lastError ? `<span class="badge badge-red" title="${esc(f.stats.lastError.message)}">Gagal terakhir ${esc(fmtDT(f.stats.lastError.at))}</span>` : ''}
              </div>
            </div>
          </div>`).join('') || '<div class="empty">Belum ada flow.<br><span class="text-xs">Klik <b>Flow baru</b> dan pilih contoh untuk memulai.</span></div>'}</div>
      </section>
      <section class="card"><div class="card-h"><div class="card-t">Riwayat terbaru</div><button class="btn btn-ghost btn-sm" id="fl-refresh">${ICON.refresh} Muat ulang</button></div>
        <div>${flRunsHtml(a.runs, true)}</div></section>
    </div>`;
    const root = $('#fl-root');
    $('#fl-new').addEventListener('click', () => {
      modal('Flow baru', `<div class="grid sm:grid-cols-2 gap-2">${Object.entries(FL_STARTERS).map(([k, [t, d]]) => `<button class="fl-pick" data-starter="${k}"><span class="min-w-0"><span class="block text-[13px] font-medium">${esc(t)}</span><span class="block text-[11px] ink-3 mt-0.5">${esc(d)}</span></span></button>`).join('')}</div>
        <p class="hint mt-3">Flow baru tersimpan dalam keadaan nonaktif. Uji dulu, lalu aktifkan.</p>`, { wide: true });
      $$('#modal-root [data-starter]').forEach((b) => b.addEventListener('click', () => { closeModal(); location.hash = '#/flows/new-' + b.dataset.starter; }));
    });
    $('#fl-refresh').addEventListener('click', () => viewFlows());
    root.addEventListener('change', (e) => {
      if (!e.target.id?.startsWith('fl-on-')) return;
      const id = e.target.id.slice(6), on = e.target.checked;
      e.target.closest('.switch').classList.toggle('on', on);
      busy(null, async () => {
        try { await api('PATCH', '/api/flows/' + encodeURIComponent(id), { enabled: on }); toast(on ? 'Flow diaktifkan.' : 'Flow dinonaktifkan.'); }
        finally { await viewFlows(); }
      });
    });
    root.addEventListener('click', async (e) => {
      const b = e.target.closest('button'); if (!b) return;
      const d = b.dataset, ids = a.flows.map((f) => f.id);
      if (d.flCancel) return flCancelRun(d.flCancel, viewFlows);
      if (d.flUp !== undefined || d.flDown !== undefined) {
        const i = Number(d.flUp ?? d.flDown), j = d.flUp !== undefined ? i - 1 : i + 1;
        [ids[i], ids[j]] = [ids[j], ids[i]];
        return busy(b, async () => { await api('PUT', '/api/flows/order', { ids }); await viewFlows(); });
      }
      if (d.flDup) return busy(b, async () => {
        const f = await api('GET', '/api/flows/' + encodeURIComponent(d.flDup));
        const copy = await api('POST', '/api/flows', { name: (f.name + ' (salinan)').slice(0, 80), enabled: false, root: f.root, nodes: f.nodes, settings: f.settings });
        toast('Flow diduplikat (nonaktif).'); location.hash = '#/flows/' + copy.id;
      });
      if (d.flDel) {
        const f = a.flows.find((x) => x.id === d.flDel);
        if (!await confirmBox(`Hapus flow "${f.name}"?${f.waiting ? ` ${f.waiting} run yang sedang menunggu akan dibatalkan.` : ''}`, 'Hapus', true)) return;
        return busy(null, async () => { await api('DELETE', '/api/flows/' + encodeURIComponent(f.id)); toast('Flow dihapus.'); await viewFlows(); });
      }
    });
  }

  /* Editor flow */
  async function viewFlowEditor(arg) {
    const v = $('#view'), tok = location.hash, isNew = arg.startsWith('new');
    v.innerHTML = '<div class="p-4 md:p-6 max-w-7xl mx-auto"><div class="card p-4 text-xs ink-3">Memuat flow…</div></div>';
    let f;
    try {
      if (!S.fl) S.fl = await api('GET', '/api/flows');
      if (!S.users.length) S.users = await api('GET', '/api/users').catch(() => []);
      f = isNew ? flStarter(arg.slice(4)) : await api('GET', '/api/flows/' + encodeURIComponent(arg));
    } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}<br><a href="#/flows" class="underline text-xs">Kembali ke daftar flow</a></div>`; return; }
    if (location.hash !== tok) return;
    S.fe = { flow: { id: f.id, name: f.name, enabled: !!f.enabled, root: f.root, nodes: structuredClone(f.nodes), settings: { ...f.settings } }, runs: f.runs || [], dirty: isNew, hit: null };
    renderFlowEditor();
  }
  const flParent = (id) => {
    for (const n of Object.values(S.fe.flow.nodes)) for (const p of ['next', 'yes', 'no']) if (n[p] === id) return [n.id, p];
    return [null, null];
  };
  const flCount = (id) => { if (!id) return 0; const n = S.fe.flow.nodes[id]; return 1 + (n.type === 'condition' ? flCount(n.yes) + flCount(n.no) : flCount(n.next)); };
  const flDrop = (id) => { if (!id) return; const n = S.fe.flow.nodes[id]; if (n.type === 'condition') { flDrop(n.yes); flDrop(n.no); } else flDrop(n.next); delete S.fe.flow.nodes[id]; };
  const flAddHtml = (id, port) => `<div class="fl-line"></div><button type="button" class="fl-add" data-fl-add="${id}:${port}" title="Tambah langkah di sini" aria-label="Tambah langkah">${ICON.plus}</button><div class="fl-line"></div>`;
  function flNodeHtml(id) {
    const n = S.fe.flow.nodes[id];
    const meta = n.type === 'trigger' ? { label: 'Pesan masuk', icon: 'inbox' } : FL_STEP[n.type];
    const title = n.type === 'condition' ? 'Kondisi · ' + FL_COND[n.cfg.kind] : meta.label;
    const buttons = n.type === 'send' ? n.cfg.buttons || [] : [];
    const card = `<div class="fl-card fl-${n.type} ${S.fe.hit?.has(id) ? 'fl-hit' : ''}" ${n.type === 'trigger' ? '' : `data-fl-edit="${id}" role="button" tabindex="0" aria-label="Ubah langkah ${esc(title)}"`}>
        <div class="flex items-center gap-2"><span class="fl-ic">${ICON[meta.icon]}</span><span class="text-[13px] font-medium flex-1 min-w-0 truncate">${esc(title)}</span>
          ${n.type === 'trigger' ? '<span class="badge">Pemicu</span>' : `<button type="button" class="btn btn-ghost btn-icon btn-sm -mr-1.5 -my-1" data-fl-del="${id}" title="Hapus langkah" aria-label="Hapus langkah">${ICON.trash}</button>`}</div>
        <div class="text-xs ink-3 mt-1 line-clamp-3 break-words whitespace-pre-line">${n.type === 'send' && n.cfg.image ? '🖼 ' : ''}${esc(flSummary(n))}</div>
        ${buttons.length ? `<div class="flex flex-wrap gap-1 mt-1.5">${buttons.map((t) => `<span class="badge" style="color:var(--info)">${esc(t)}</span>`).join('')}</div>` : ''}
      </div>`;
    const tail = (child) => (child ? flNodeHtml(child) : '<div class="fl-end">Selesai</div>');
    if (n.type === 'condition') {
      return `${card}<div class="fl-line"></div><div class="fl-branches">${['yes', 'no'].map((p) => `<div class="fl-branch">
          <span class="fl-tag fl-tag-${p}">${p === 'yes' ? 'Ya' : 'Tidak'}</span>${flAddHtml(id, p)}${tail(n[p])}</div>`).join('')}</div>`;
    }
    return card + flAddHtml(id, 'next') + tail(n.next);
  }
  function renderFlowCanvas() {
    const c = $('#fe-canvas'), keep = c.firstElementChild ? c.scrollLeft : null;
    c.innerHTML = `<div class="fl-tree">${flNodeHtml(S.fe.flow.root)}</div>`;
    // Pohon lebih lebar dari layar (HP): mulai dari tengah agar pemicu terlihat; setelah diubah, posisi gulir dipertahankan
    c.scrollLeft = keep ?? (c.scrollWidth - c.clientWidth) / 2;
  }
  function flChanged() {
    S.fe.dirty = true; S.fe.hit = null;
    $('#fe-savebar').classList.remove('hidden');
    renderFlowCanvas();
  }
  function renderFlowEditor() {
    const f = S.fe.flow, s = f.settings, v = $('#view');
    v.innerHTML = `<div id="fe-root">
      <div id="fe-savebar" class="${S.fe.dirty ? '' : 'hidden'} sticky top-0 z-20 px-4 md:px-6 pt-3">
        <div class="max-w-7xl mx-auto surface border bd rounded-lg shadow-lg px-4 py-2.5 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full flex-none" style="background:var(--warn)"></span>
          <span class="text-[13px] font-medium flex-1 min-w-0 truncate">${f.id ? 'Perubahan belum disimpan' : 'Flow baru belum disimpan'}</span>
