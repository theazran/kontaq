    const costSub = [t.cost.billable ? `${fmtNum(t.cost.billable)} berbayar` : '', t.cost.unknownRate ? `${fmtNum(t.cost.unknownRate)} tanpa tarif` : '', t.cost.noPricing ? `${fmtNum(t.cost.noPricing)} belum ada info` : ''].filter(Boolean).join(' · ');
    v.innerHTML = `<div class="p-4 md:p-6 max-w-7xl space-y-4" id="ml-root">
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
        ${tile('Total pesan keluar', fmtNum(t.all), `${fmtNum(t.requestFailed)} request API gagal`, '')}
        ${tile('Diterima Meta', fmtNum(t.byStatus.accepted), 'menunggu webhook', 'accepted')}
        ${tile('Terkirim', fmtNum(t.byStatus.sent), 'dari server Meta', 'sent')}
        ${tile('Sampai', fmtNum(t.byStatus.delivered), 'di perangkat penerima', 'delivered')}
        ${tile('Dibaca', fmtNum(t.byStatus.read), 'jika tanda baca aktif', 'read')}
        ${tile('Gagal', `<span class="${t.byStatus.failed ? 'danger-ink' : ''}">${fmtNum(t.byStatus.failed)}</span>`, 'request atau webhook', 'failed')}
        ${tile('Estimasi biaya', t.cost.billable && t.cost.unknownRate === t.cost.billable ? '—' : esc(fmtMoney(t.cost.amount, cur)) + (t.cost.unknownRate ? '<span class="text-xs ink-3"> +?</span>' : ''), costSub || 'dari pricing webhook', '')}
      </div>
      <div class="flex flex-wrap gap-1.5 text-[11px]">
        ${Object.entries(src).map(([k, l]) => `<button class="badge ${st.source === k ? 'badge-green' : ''}" data-ml-source="${k}">${esc(l)} <b class="ml-1">${fmtNum(t.bySource[k] || 0)}</b></button>`).join('')}
        <span class="ink-3 self-center ml-1">${Object.entries(t.byType).sort((a, b) => b[1] - a[1]).map(([k, n]) => `${esc(LOG_TYPES[k] || k)} ${fmtNum(n)}`).join(' · ')}</span>
      </div>
      <div class="card p-3 flex flex-wrap items-end gap-2">
        <input class="input w-full sm:w-56" id="ml-q" placeholder="Cari nomor penerima atau Message ID" value="${esc(st.q)}" aria-label="Cari nomor atau Message ID">
        <input class="input w-[9.5rem]" type="date" id="ml-from" value="${esc(st.from)}" aria-label="Dari tanggal">
        <span class="ink-3 text-xs self-center">–</span>
        <input class="input w-[9.5rem]" type="date" id="ml-to" value="${esc(st.to)}" aria-label="Sampai tanggal">
        <select class="select w-36" data-ml="status" aria-label="Status">${opt('', 'Semua status', st.status)}${Object.entries(LOG_STATUS).map(([k, [l]]) => opt(k, l, st.status)).join('')}</select>
        <select class="select w-36" data-ml="type" aria-label="Jenis pesan">${opt('', 'Semua jenis', st.type)}${opt('media', 'Semua media', st.type)}${['text', 'image', 'video', 'audio', 'document', 'template', 'list', 'buttons', 'location', 'call_permission', 'unknown'].map((k) => opt(k, LOG_TYPES[k], st.type)).join('')}</select>
        <select class="select w-36" data-ml="source" aria-label="Sumber">${opt('', 'Semua sumber', st.source)}${Object.entries(src).map(([k, l]) => opt(k, l, st.source)).join('')}</select>
        ${d.options.campaigns.length ? `<select class="select w-40" data-ml="campaignId" aria-label="Campaign">${opt('', 'Semua campaign', st.campaignId)}${d.options.campaigns.map((c) => opt(c.id, c.name, st.campaignId)).join('')}</select>` : ''}
        ${d.options.templates.length ? `<select class="select w-40" data-ml="template" aria-label="Template">${opt('', 'Semua template', st.template)}${d.options.templates.map((x) => opt(x, x, st.template)).join('')}</select>` : ''}
        ${d.options.phoneNumberIds.length > 1 ? `<select class="select w-44" data-ml="phoneNumberId" aria-label="Nomor bisnis">${opt('', 'Semua nomor bisnis', st.phoneNumberId)}${d.options.phoneNumberIds.map((x) => opt(x, x, st.phoneNumberId)).join('')}</select>` : ''}
        <label class="flex items-center gap-1.5 text-xs self-center"><input type="checkbox" class="check" id="ml-failed" ${st.failed ? 'checked' : ''}> Gagal saja</label>
        <div class="flex-1"></div>
        <button class="btn btn-sm btn-ghost" id="ml-reset">Reset</button>
        <button class="btn btn-sm" id="ml-refresh">Muat ulang</button>
        <a class="btn btn-sm" href="/api/message-log/export.csv?${mlogQuery(st, { page: '' })}">Ekspor CSV</a>
      </div>
      <div class="card overflow-x-auto"><table class="tbl"><thead><tr><th>Waktu</th><th>Penerima</th><th>Jenis</th><th>Isi / template</th><th>Sumber</th><th>Message ID</th><th>Status</th><th class="text-right">Biaya</th><th></th></tr></thead><tbody>
        ${d.rows.map((r) => `<tr class="cursor-pointer" data-ml-row="${r.id}">
          <td class="text-xs whitespace-nowrap">${esc(fmtDT(r.at))}</td>
          <td><div class="font-medium truncate max-w-[10rem]">${esc(r.contactName || '—')}</div><div class="mono text-[11px] ink-3">+${esc(r.to)}</div></td>
          <td class="text-xs whitespace-nowrap">${esc(LOG_TYPES[r.type] || r.type)}</td>
          <td class="max-w-[16rem] truncate ${r.summary || r.templateName ? '' : 'ink-3'}" title="${esc(r.templateName || r.summary)}">${r.templateName ? `<span class="mono text-xs">${esc(r.templateName)}</span>` : esc(r.summary) || (r.source === 'external' ? 'Isi tidak tersedia' : '—')}</td>
          <td class="text-xs whitespace-nowrap">${esc(src[r.source] || r.source)}${r.campaignName ? `<div class="text-[11px] ink-3 truncate max-w-[9rem]">${esc(r.campaignName)}</div>` : r.userName ? `<div class="text-[11px] ink-3 truncate max-w-[9rem]">${esc(r.userName)}</div>` : ''}</td>
          <td class="mono text-[11px] ink-3 max-w-[9rem] truncate" title="${esc(r.wamid || '')}">${esc(r.wamid ? '…' + r.wamid.slice(-14) : '—')}</td>
          <td>${logStatusBadge(r.status)}${!r.requestOk ? `<div class="text-[11px] danger-ink">HTTP ${esc(r.httpStatus || '—')}</div>` : ''}</td>
          <td class="text-right text-xs whitespace-nowrap">${logCost(r, cur)}</td>
          <td class="text-right"><button class="btn btn-sm btn-ghost" data-ml-row="${r.id}">Detail</button></td></tr>`).join('') || `<tr><td colspan="9"><div class="empty">${t.all === 0 && !mlogQuery(st, { page: '' }) ? 'Belum ada pesan keluar.' : 'Tidak ada pesan yang cocok dengan filter.'}</div></td></tr>`}
      </tbody></table></div>
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
