      <div><label class="label">Nomor WhatsApp</label><input class="input mono" name="phone" value="${esc(c?.phone || '')}" ${c ? 'disabled' : 'required'} placeholder="6281234567890"><p class="hint">Format internasional tanpa "+" atau spasi.</p></div>
      <div><label class="label">Nama</label><input class="input" name="name" value="${esc(c?.name || '')}" maxlength="120"></div>
      <div><label class="label">Label</label><input class="input" name="labels" value="${esc((c?.labels || []).join(', '))}" placeholder="pelanggan, vip"></div>
      <div><label class="label">Catatan</label><textarea class="textarea" name="notes" rows="3" maxlength="2000">${esc(c?.notes || '')}</textarea></div>
      <label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" name="optIn" ${c?.optIn ? 'checked' : ''}> Kontak telah memberikan opt-in untuk menerima pesan dari bisnis</label>
