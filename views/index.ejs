        </div>`).join('') || '<div class="empty">Belum ada kontak.</div>'}
      </div>
      <div class="card overflow-x-auto hidden sm:block"><table class="tbl"><thead><tr><th>Nama</th><th>Nomor WhatsApp</th><th>Label</th><th>Opt-in</th><th>Catatan</th><th>Diperbarui</th><th></th></tr></thead><tbody>
      ${data.rows.map((c) => `<tr>
        <td><div class="flex items-center gap-2">${avatar(c, 24)}<span class="font-medium">${esc(c.name || c.waName || '—')}</span></div></td>
        <td class="mono text-xs">+${esc(c.phone)}</td>
        <td><div class="flex flex-wrap gap-1">${(c.labels || []).map((l) => `<span class="badge">${esc(l)}</span>`).join('') || '<span class="ink-3">—</span>'}</div></td>
        <td>${c.optIn ? '<span class="badge badge-green">Ya</span>' : '<span class="ink-3 text-xs">Tidak</span>'}</td>
        <td class="max-w-[16rem] truncate ink-2" title="${esc(c.notes)}">${esc(c.notes) || '<span class="ink-3">—</span>'}</td>
        <td class="text-xs ink-3 whitespace-nowrap">${fmtDate(c.updatedAt)}</td>
        <td class="text-right whitespace-nowrap"><button class="btn btn-sm" data-chat="${c.id}">Chat</button> <button class="btn btn-sm btn-ghost" data-edit="${c.id}">Ubah</button>${S.isAdmin ? ` <button class="btn btn-sm btn-ghost btn-danger" data-del="${c.id}">Hapus</button>` : ''}</td></tr>`).join('') || '<tr><td colspan="7"><div class="empty">Belum ada kontak.</div></td></tr>'}
      </tbody></table></div>
      ${pages > 1 ? `<div class="flex items-center justify-end gap-2 text-xs"><button class="btn btn-sm" id="ct-prev" ${st.page <= 1 ? 'disabled' : ''}>Sebelumnya</button><span class="ink-3">Hal. ${st.page} / ${pages}</span><button class="btn btn-sm" id="ct-next" ${st.page >= pages ? 'disabled' : ''}>Berikutnya</button></div>` : ''}
    </div>`;
    const q = $('#ct-q'); if (keepFocus) { q.focus(); q.setSelectionRange(q.value.length, q.value.length); }
    let t; q.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => { st.q = q.value; st.page = 1; viewContacts(); }, 300); });
