    }
    if (t.dataset.ok) {
      const o = c.p.options[Number(t.closest('[data-oi]').dataset.oi)], k = t.dataset.ok;
      if (k === 'title') { o.title = t.value; if (o.idAuto) { const old = o.id; o.id = wfbOptId(c.p.options, t.value, o.uid); $('[data-ok="id"]', t.closest('[data-oi]')).value = o.id; wfbRenameInit(c, old, o.id); } }
      if (k === 'id') { const old = o.id; o.id = t.value.trim(); o.idAuto = false; wfbRenameInit(c, old, o.id); }
