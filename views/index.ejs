  /* ───────────── Real-time ───────────── */
  // Mulai dengan long-polling lalu upgrade ke WebSocket bila proxy mendukung. Urutan ini tetap tersambung
  // di belakang reverse proxy yang tidak meneruskan header Upgrade (mis. Apache tanpa mod_proxy_wstunnel).
  const socket = io({ transports: ['polling', 'websocket'], tryAllTransports: true });
  const live = (ok, text) => { const el = $('#live'); el.className = 'badge ' + (ok ? 'badge-green' : 'badge-amber'); el.innerHTML = `<span class="dot"></span><span>${text}</span>`; };
  socket.on('connect', () => { live(true, 'Live'); checkRingingCall(); if (S.view === 'inbox') loadConvs().then(renderConvList).catch(() => {}); });
  socket.on('disconnect', () => live(false, 'Terputus'));
  socket.on('connect_error', (e) => { live(false, 'Terputus'); if (e.message === 'unauthorized') location.reload(); });
  socket.on('message:new', ({ message, conversation }) => {
    if (message.userId) setTyping(conversation.id, message.userId, null);
    if (message.direction === 'in') {
      const viewing = conversation.id === S.inbox.activeId && S.view === 'inbox' && document.visibilityState === 'visible';
      if (!viewing || pref('soundOpen')) playChime();
      if (conversation.id !== S.inbox.activeId) notifyIncoming(conversation);
    }
    if (conversation.id === S.inbox.activeId) {
      if (!S.inbox.messages.some((m) => m.id === message.id)) { S.inbox.messages.push(message); if (S.view === 'inbox') renderMessages(false); }
      if (message.direction === 'in' && S.view === 'inbox' && document.visibilityState === 'visible') { conversation.unread = 0; api('POST', `/api/conversations/${conversation.id}/read`).catch(() => {}); }
    }
    applyConv(conversation);
  });
  let mlogTimer;
  const mlogLive = () => { if (S.view === 'messagelog' && !$('#modal-root').innerHTML) { clearTimeout(mlogTimer); mlogTimer = setTimeout(viewMessageLog, 1500); } };
  socket.on('message:new', ({ message }) => { if (message.direction === 'out') mlogLive(); });
  socket.on('message:update', mlogLive);
  socket.on('message:update', ({ message }) => {
    const i = S.inbox.messages.findIndex((m) => m.id === message.id);
    if (i >= 0) {
      S.inbox.messages[i] = message;
      const node = $(`[data-mid="${message.id}"]`);
      if (node) node.outerHTML = msgHtml(message);
      $$(`[data-mid="${message.id}"] [data-reply]`).forEach((b) => b.addEventListener('click', () => { S.inbox.replyTo = b.dataset.reply; renderComposer(); }));
    }
  });
  socket.on('conversation:update', applyConv);
  socket.on('typing', (t) => { if (t.userId !== S.user.id) setTyping(t.conversationId, t.userId, { name: t.name, seen: Date.now() }); });
  socket.on('conversation:removed', ({ id }) => {
    if (S.isAdmin) return;
    S.inbox.convs = S.inbox.convs.filter((c) => c.id !== id);
    if (S.inbox.activeId === id) { S.inbox.activeId = null; if (S.view === 'inbox') { toast('Percakapan dialihkan ke agen lain.'); location.hash = '#/inbox'; } }
    if (S.view === 'inbox') renderConvList(); renderNav();
  });
  socket.on('template:update', (t) => {
    const row = S.templates.rows.find((x) => String(x.id) === String(t.id) || (x.name === t.name && x.language === t.language));
    if (row) { row.status = t.status; if (t.reason && t.reason !== 'NONE') row.rejected_reason = t.reason; }
    toast(`Template ${t.name}: ${t.status}`);
    if (S.view === 'templates') viewTemplates();
  });
  socket.on('campaign:update', (c) => {
    const tr = $(`#cp-rows tr[data-cid="${c.id}"]`);
    if (tr && S.view === 'campaigns') tr.outerHTML = campaignRow(c);
  });
  socket.on('call:incoming', showIncomingCall);
  socket.on('call:answer', applyAnswer);
  socket.on('call:update', (c) => {
    if (S.call?.id !== c.id) { if (S.view === 'calls') viewCalls(); return; }
    if (S.call.direction === 'BUSINESS_INITIATED') {
      if (['calling', 'ringing', 'accepted'].includes(c.status)) { if (S.call.status !== 'accepted') { S.call.status = c.status; renderCallBar(); } }
      else { endCallLocal(); toast(c.status === 'rejected' ? 'Pelanggan menolak panggilan.' : 'Panggilan berakhir.'); }
      if (S.view === 'calls') viewCalls();
      return;
    }
    if (c.status === 'accepted' && c.answeredBy !== S.user.id) { endCallLocal(); toast(`Panggilan diangkat oleh ${c.answeredName}.`); }
    else if (!['ringing', 'accepted'].includes(c.status)) { endCallLocal(); toast('Panggilan berakhir.'); }
    if (S.view === 'calls') viewCalls();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') return;
    if (!socket.connected) socket.connect();
    checkRingingCall();
    if (S.view === 'inbox') loadConvs().then(renderConvList).catch(() => {});
  });
  function notifyBrowser(title, body) {
    if (document.visibilityState === 'visible' || !('Notification' in window) || Notification.permission !== 'granted') return;
    try { new Notification(title, { body }); } catch (e) {}
  }
  function notifyIncoming(conv) {
    notifyBrowser(contactName(conv.contact), conv.preview);
    if (document.visibilityState === 'visible' && S.view !== 'inbox') toast(`Pesan baru dari ${contactName(conv.contact)}`);
  }
  document.addEventListener('click', function askNotif() { if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission(); document.removeEventListener('click', askNotif); });
  // Perbarui label sisa jendela 24 jam tiap menit
  setInterval(() => {
    const c = activeConv(); if (!c || S.view !== 'inbox') return;
    const wasOpen = c.windowOpen; c.windowOpen = c.windowExpiresAt > Date.now();
    renderChatHeaderOnly(c); if (wasOpen !== c.windowOpen) renderComposer();
  }, 60000);

  /* ───────────── Mulai ───────────── */
  renderSoundBtn();
  $('#me-name').textContent = S.user.name; $('#me-role').textContent = S.user.role === 'admin' ? 'Admin' : 'Agen'; $('#me-avatar').innerHTML = initials(S.user.name);
  loadConvs().catch(() => {}).finally(renderNav);
  route();
  </script>
<% } %>
</body>
</html>
