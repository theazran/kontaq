  /* Stiker: pustaka bersama + buat dari gambar (512×512 WebP) */
  async function loadStickers() {
    const pop = $('#cmp-pop .sticker-pop'); if (!pop) return;
    try { S.stickers = S.stickers || await api('GET', '/api/stickers'); } catch (e) { pop.innerHTML = `<div class="p-4 text-xs danger-ink">${esc(e.message)}</div>`; return; }
    pop.innerHTML = `<div class="flex items-center justify-between px-3 pt-2.5 text-xs font-medium ink-2">Stiker<label class="btn btn-ghost btn-sm cursor-pointer">${ICON.plus} Buat dari gambar<input type="file" accept="image/*" class="hidden" id="st-new"></label></div>
      <div class="sticker-grid">${S.stickers.map((s) => `<button type="button" data-st="${esc(s.id)}" title="Kirim stiker"><img src="/api/stickers/${esc(s.id)}" alt="Stiker" loading="lazy"></button>`).join('')
        || '<div class="col-span-4 text-xs ink-3 p-2">Belum ada stiker. Buat dari gambar, atau simpan stiker yang dikirim pelanggan (arahkan kursor ke stiker → ＋).</div>'}</div>`;
    pop.querySelectorAll('[data-st]').forEach((b) => b.addEventListener('click', () => busy(b, async () => { await sendMsg({ type: 'sticker', stickerId: b.dataset.st }); closePop(); })));
    $('#st-new').addEventListener('change', (e) => busy(null, async () => {
      const file = e.target.files[0]; if (!file) return;
      const fd = new FormData(); fd.append('file', await makeSticker(file), 'sticker.webp');
      const s = await api('POST', '/api/stickers', fd);
      S.stickers = [s, ...(S.stickers || []).filter((x) => x.id !== s.id)];
      loadStickers(); toast('Stiker dibuat — klik untuk mengirim.');
    }));
  }
  // Ubah gambar menjadi stiker WhatsApp: 512×512 transparan, WebP ≤ 100 KB (WebP 512×512 yang sudah sesuai dipakai apa adanya)
  async function makeSticker(file) {
    if (file.type === 'image/webp' && file.size <= 500 * 1024) {
      const ok = await new Promise((r) => { const i = new Image(); i.onload = () => r(i.naturalWidth === 512 && i.naturalHeight === 512); i.onerror = () => r(false); i.src = URL.createObjectURL(file); });
      if (ok) return file;
    }
    const img = await loadImage(file);
    const cv = document.createElement('canvas'); cv.width = cv.height = 512;
    const s = Math.min(512 / img.naturalWidth, 512 / img.naturalHeight), w = img.naturalWidth * s, h = img.naturalHeight * s;
    cv.getContext('2d').drawImage(img, (512 - w) / 2, (512 - h) / 2, w, h);
    for (const q of [0.9, 0.8, 0.7, 0.55, 0.4]) {
      const blob = await new Promise((r) => cv.toBlob(r, 'image/webp', q));
      if (!blob || blob.type !== 'image/webp') throw new Error('Browser ini tidak dapat membuat WebP. Gunakan Chrome/Edge/Firefox, atau unggah file .webp 512×512.');
      if (blob.size <= 100 * 1024) return blob;
    }
    throw new Error('Gambar terlalu detail untuk stiker (maks. 100 KB). Coba gambar yang lebih sederhana.');
  }
  const loadImage = (file) => new Promise((ok, no) => { const i = new Image(); i.onload = () => ok(i); i.onerror = () => no(new Error('Gambar tidak dapat dibaca browser.')); i.src = URL.createObjectURL(file); });

  /* Voice note: rekam → (server mengonversi ke OGG/Opus) → kirim sebagai pesan suara */
  async function startRecording(conv) {
    if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) return fail(new Error('Browser ini tidak mendukung perekaman suara.'));
    let stream;
    try { stream = await navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true } }); }
    catch (e) { return fail(new Error(location.protocol !== 'https:' && !['localhost', '127.0.0.1'].includes(location.hostname) ? 'Mikrofon hanya dapat dipakai lewat HTTPS.' : 'Izin mikrofon ditolak atau mikrofon tidak tersedia.')); }
    const mime = ['audio/ogg;codecs=opus', 'audio/webm;codecs=opus', 'audio/mp4'].find((t) => MediaRecorder.isTypeSupported(t)) || '';
    const rec = new MediaRecorder(stream, { ...(mime ? { mimeType: mime } : {}), audioBitsPerSecond: 32000 });
    const r = { convId: conv.id, rec, stream, chunks: [], elapsed: 0, last: performance.now(), paused: false, bars: [], lastBar: 0 };
    rec.ondataavailable = (e) => { if (e.data.size) r.chunks.push(e.data); };
    try { const ctx = new AudioContext(), an = ctx.createAnalyser(); an.fftSize = 512; ctx.createMediaStreamSource(stream).connect(an); Object.assign(r, { ctx, an }); } catch (e) { /* visual saja */ }
    S.rec = r; closePop();
    rec.start(250);
    $('#composer').innerHTML = `<div class="rec-bar" id="rec-bar">
      <button type="button" class="cmp-icon danger-ink" id="rec-x" title="Batalkan" aria-label="Batalkan rekaman">${ICON.trash}</button>
      <span class="rec-dot"></span><span class="rec-time" id="rec-t">0:00</span><div class="rec-wave" id="rec-w"></div>
      <button type="button" class="cmp-icon" id="rec-p" title="Jeda" aria-label="Jeda rekaman">${ICON.pause}</button>
      <button type="button" class="cmp-send" id="rec-go" title="Kirim pesan suara" aria-label="Kirim pesan suara">${ICON.send}</button></div>`;
    const buf = new Uint8Array(512);
    const loop = () => {
      if (S.rec !== r) return;
      const t = performance.now();
      if (!r.paused) r.elapsed += t - r.last;
      r.last = t;
      $('#rec-t').textContent = fmtSecs(r.elapsed / 1000);
      if (r.an && !r.paused && t - r.lastBar > 90) {
        r.an.getByteTimeDomainData(buf);
        let sum = 0; for (const v of buf) sum += ((v - 128) / 128) ** 2;
        r.bars.push(Math.min(100, 12 + Math.sqrt(sum / buf.length) * 320)); r.lastBar = t;
        $('#rec-w').innerHTML = r.bars.slice(-90).map((h) => `<i style="height:${h}%"></i>`).join('');
      }
      if (r.elapsed > 15 * 60 * 1000) return finishRecording(true); // batas 15 menit
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
    $('#rec-x').addEventListener('click', () => finishRecording(false));
    $('#rec-p').addEventListener('click', (e) => {
      r.paused = !r.paused; r.paused ? rec.pause() : rec.resume();
      $('#rec-bar').classList.toggle('paused', r.paused);
      e.currentTarget.innerHTML = r.paused ? ICON.mic : ICON.pause; e.currentTarget.title = r.paused ? 'Lanjutkan' : 'Jeda';
    });
    $('#rec-go').addEventListener('click', () => finishRecording(true));
  }
  async function finishRecording(send) {
    const r = S.rec; if (!r) return;
    const stopped = new Promise((ok) => { r.rec.onstop = ok; });
    if (r.rec.state !== 'inactive') r.rec.stop();
    await stopped;
    r.stream.getTracks().forEach((t) => t.stop()); r.ctx?.close().catch(() => {});
    S.rec = null;
    const seconds = r.elapsed / 1000;
    if (!send || seconds < 0.7) { renderComposer(); if (send) toast('Rekaman terlalu singkat.', true); return; }
    $('#composer').innerHTML = '<div class="rec-bar"><span class="text-xs ink-2 flex-1 px-2" id="rec-up">Mengirim pesan suara…</span></div>';
    try {
      const type = r.rec.mimeType || r.chunks[0]?.type || 'audio/webm';
      const blob = new Blob(r.chunks, { type });
      const name = type.includes('ogg') ? 'voice.ogg' : type.includes('mp4') ? 'voice.m4a' : 'voice.webm';
      const up = await uploadFile(new File([blob], name, { type: type.split(';')[0] }), 'voice', (p) => { const x = $('#rec-up'); if (x) x.textContent = `Mengunggah pesan suara… ${Math.round(p * 100)}%`; }, { duration: seconds.toFixed(1) });
      await sendMsg({ type: 'audio', mediaId: up.id, mime: up.mime, voice: up.voice, duration: up.duration || seconds, size: up.size });
      if (!up.voice) toast('Browser merekam AAC — dikirim sebagai audio biasa (pesan suara WhatsApp memerlukan Opus).');
    } catch (e) { fail(e); }
    renderComposer();
  }
  // Unggah dengan progres (XHR); kind: image|video|audio|document|sticker|voice
  function uploadFile(file, kind, onProgress, extra = {}) {
    return new Promise((ok, no) => {
      const fd = new FormData(); fd.append('kind', kind);
      Object.entries(extra).forEach(([k, v]) => fd.append(k, v));
      fd.append('file', file, file.name || 'file');
      const x = new XMLHttpRequest(); x.open('POST', '/api/media'); x.setRequestHeader('X-Requested-With', 'kontaq');
      x.upload.onprogress = (e) => { if (e.lengthComputable) onProgress?.(e.loaded / e.total); };
      x.onload = () => { let j = {}; try { j = JSON.parse(x.responseText); } catch (e) {} if (x.status === 401) location.reload(); if (x.status < 300) ok(j); else no(new Error(j.error || 'Unggah gagal (' + x.status + ')')); };
      x.onerror = () => no(new Error('Koneksi terputus saat mengunggah.'));
      x.send(fd);
    });
  }
  async function sendMsg(body) {
    const c = activeConv();
    if (S.inbox.replyTo) body.replyTo = S.inbox.replyTo;
    const msg = await api('POST', `/api/conversations/${c.id}/messages`, body);
    S.inbox.replyTo = null;
    if (S.typingEmitAt) delete S.typingEmitAt[c.id]; // ketikan berikutnya langsung terlihat lagi
    if (!S.inbox.messages.some((m) => m.id === msg.id)) { S.inbox.messages.push(msg); renderMessages(true); }
    if ($('#cmp-unreply')) renderComposer();
    return msg;
  }
  /* ───────────── Pratinjau & kirim media (seperti layar kirim WhatsApp) ───────────── */
  const MEDIA_LIMIT = { image: 5, video: 16, audio: 16, document: 100 };
  const AUDIO_MIMES = ['audio/aac', 'audio/amr', 'audio/mpeg', 'audio/mp4', 'audio/ogg', 'audio/x-m4a'];
  // Jenis kiriman default untuk sebuah file. Format di luar dukungan Meta dikonversi (gambar) atau dikirim sebagai dokumen.
  function classifyFile(f, force) {
    const t = (f.type || '').toLowerCase(), mb = f.size / 1048576;
    if (force === 'document') return { kind: 'document' };
    if (t === 'image/jpeg' || t === 'image/png') return { kind: 'image' };
    if (/^image\/(webp|gif|bmp|avif)$/.test(t)) return { kind: 'image', convert: true, note: 'Dikonversi ke JPEG (format yang didukung WhatsApp).' };
    if (/^image\/(heic|heif)$/.test(t)) return { kind: 'image', convert: true, note: 'Foto HEIC dikonversi ke JPEG bila browser mendukung; bila tidak, kirim sebagai dokumen.' };
    if (t === 'video/mp4' || t === 'video/3gpp') return mb > MEDIA_LIMIT.video ? { kind: 'document', note: 'Video lebih dari 16 MB dikirim sebagai dokumen.' } : { kind: 'video' };
    if (t.startsWith('video/')) return { kind: 'document', note: 'Format video ini tidak didukung WhatsApp sebagai video — dikirim sebagai dokumen.' };
    if (t.startsWith('audio/')) return AUDIO_MIMES.includes(t) && mb <= MEDIA_LIMIT.audio ? { kind: 'audio' } : { kind: 'document', note: 'Format audio ini dikirim sebagai dokumen.' };
    return { kind: 'document' };
  }
  function openMediaComposer(files, opts = {}) {
    const c = activeConv();
    if (!c) return;
    if (!c.windowOpen) return toast('Jendela 24 jam tertutup — hanya template yang dapat dikirim.', true);
    if (S.mc) { addMediaItems(files, opts.force); return; }
    S.mc = { convId: c.id, items: [], active: 0, sending: false };
    const root = document.createElement('div');
    root.className = 'viewer'; root.id = 'mc'; root.setAttribute('role', 'dialog'); root.setAttribute('aria-modal', 'true'); root.setAttribute('aria-label', 'Kirim media');
    document.body.appendChild(root);
    addMediaItems(files, opts.force);
    document.addEventListener('keydown', mcKey);
  }
  function mcKey(e) { if (e.key === 'Escape' && S.mc && !S.mc.sending) closeMediaComposer(); }
  function closeMediaComposer() {
    S.mc?.items.forEach((it) => it.url && URL.revokeObjectURL(it.url));
    S.mc = null; $('#mc')?.remove(); document.removeEventListener('keydown', mcKey);
  }
  function addMediaItems(files, force) {
    const mc = S.mc, firstNew = mc.items.length;
    for (const f of files.slice(0, Math.max(0, 30 - mc.items.length))) {
      const cls = classifyFile(f, force), mb = f.size / 1048576;
      const it = { id: Math.random().toString(36).slice(2), file: f, ...cls, asDoc: cls.kind === 'document', canMedia: cls.kind !== 'document' || (!!f.type && /^(image|video)\//.test(f.type) && !cls.note), caption: '', hd: false, status: '', progress: 0, error: '' };
      if (mb > MEDIA_LIMIT.document) { it.error = 'File lebih dari 100 MB — melebihi batas WhatsApp.'; it.status = 'err'; }
      if (/^(image|video|audio)\//.test(f.type)) it.url = URL.createObjectURL(f);
      mc.items.push(it);
    }
    if (files.length + mc.items.length > 30) toast('Maksimal 30 file per pengiriman.', true);
    mc.active = Math.min(firstNew, mc.items.length - 1); // seperti WhatsApp: tampilkan file pertama yang baru dipilih
    renderMediaComposer();
  }
  function renderMediaComposer() {
    const mc = S.mc, root = $('#mc'); if (!mc || !root) return;
    if (!mc.items.length) return closeMediaComposer();
    const it = mc.items[mc.active], k = it.asDoc ? 'document' : it.kind, conv = S.inbox.convs.find((x) => x.id === mc.convId);
    const ext = (it.file.name.split('.').pop() || 'file').toLowerCase().slice(0, 4);
    const main = k === 'image' && it.url ? `<img src="${it.url}" alt="">`
      : k === 'video' && it.url ? `<video src="${it.url}" controls playsinline></video>`
      : k === 'audio' && it.url ? `<div class="text-center"><span class="aud-file mx-auto" style="width:5rem;height:5rem">${ICON.headphones.replace('<svg', '<svg width="34" height="34"')}</span><div class="mt-3 font-medium">${esc(it.file.name)}</div><audio src="${it.url}" controls class="mt-3"></audio></div>`
      : `<div class="text-center"><span class="doc-ic mx-auto" style="width:5rem;height:6.25rem;font-size:1rem;background:${DOC_COLORS[ext] || '#64748b'}">${esc(ext.toUpperCase())}</span><div class="mt-3 font-medium break-all max-w-md">${esc(it.file.name)}</div><div class="text-xs ink-3 mt-1">${esc(fmtBytes(it.file.size))}${it.file.type ? ' · ' + esc(it.file.type) : ''}</div></div>`;
    const todo = mc.items.filter((x) => x.status !== 'done' && !(x.status === 'err' && x.file.size > MEDIA_LIMIT.document * 1048576)).length;
    root.innerHTML = `<div class="viewer-h">
        <button class="btn btn-ghost btn-icon" data-mc-x title="Tutup (Esc)" aria-label="Tutup" ${mc.sending ? 'disabled' : ''}>${ICON.x}</button>
        <div class="min-w-0 flex-1"><div class="text-[13px] font-medium truncate">${esc(it.file.name)}</div><div class="text-[11px] ink-3">Kirim ke ${esc(contactName(conv?.contact || {}))} · ${esc(fmtBytes(it.file.size))}</div></div>
        ${it.kind === 'image' && !it.asDoc ? `<button class="btn btn-sm ${it.hd ? 'btn-primary' : ''}" data-mc-hd title="Kualitas asli (tanpa kompresi, maks. 5 MB)">HD</button>` : ''}
        ${it.canMedia && !mc.sending ? `<label class="flex items-center gap-1.5 text-xs ink-2 ml-1"><input type="checkbox" class="check" data-mc-doc ${it.asDoc ? 'checked' : ''}> Sebagai dokumen</label>` : ''}
      </div>
      <div class="viewer-main chat-bg">${main}</div>
      <div class="viewer-f surface">
        ${it.note && !it.asDoc === (it.kind !== 'document') ? `<div class="text-[11px] ink-3 mb-2 text-center">${esc(it.note)}</div>` : it.note ? `<div class="text-[11px] ink-3 mb-2 text-center">${esc(it.note)}</div>` : ''}
        ${it.error ? `<div class="text-xs danger-ink mb-2 text-center">${esc(it.error)}</div>` : ''}
        ${k !== 'audio' ? `<div class="max-w-2xl mx-auto mb-3"><input class="input" data-mc-cap maxlength="1024" placeholder="Tambahkan keterangan…" value="${esc(it.caption)}" ${mc.sending ? 'disabled' : ''} aria-label="Keterangan"></div>` : ''}
        <div class="flex items-center gap-3 max-w-4xl mx-auto">
          <div class="thumbs flex-1">${mc.items.map((x, i) => {
            const tk = x.asDoc ? 'document' : x.kind, te = (x.file.name.split('.').pop() || '').toLowerCase().slice(0, 4);
            return `<button type="button" class="thumb ${i === mc.active ? 'active' : ''} ${x.status}" data-mc-i="${i}" title="${esc(x.file.name)}">
              ${tk === 'image' && x.url ? `<img src="${x.url}" alt="">` : tk === 'video' && x.url ? `<video src="${x.url}" muted></video>` : `<span class="text-[10px] font-bold ink-2">${esc(tk === 'audio' ? '🎵' : te.toUpperCase() || 'FILE')}</span>`}
              ${!mc.sending && x.status !== 'done' ? `<span class="x" data-mc-rm="${i}" aria-label="Hapus">${ICON.x}</span>` : ''}
              ${x.status === 'up' ? `<span class="prog"><i style="width:${Math.round(x.progress * 100)}%"></i></span>` : ''}</button>`;
          }).join('')}
            ${!mc.sending ? `<button type="button" class="thumb-add" data-mc-add title="Tambah file" aria-label="Tambah file">${ICON.plus}</button>` : ''}</div>
          <button type="button" class="send-fab" data-mc-send ${mc.sending || !todo ? 'disabled' : ''} aria-label="Kirim">${mc.sending ? '<svg class="spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.2-8.6"/></svg>' : ICON.send}${todo > 1 ? `<span class="n">${todo}</span>` : ''}</button>
        </div>
      </div>`;
    root.querySelector('[data-mc-x]')?.addEventListener('click', closeMediaComposer);
    root.querySelector('[data-mc-hd]')?.addEventListener('click', () => { it.hd = !it.hd; renderMediaComposer(); });
    root.querySelector('[data-mc-doc]')?.addEventListener('change', (e) => { it.asDoc = e.target.checked; renderMediaComposer(); });
    const cap = root.querySelector('[data-mc-cap]');
    cap?.addEventListener('input', () => { it.caption = cap.value; });
    cap?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); root.querySelector('[data-mc-send]')?.click(); } });
    if (cap && !isTouch) cap.focus();
    root.querySelectorAll('[data-mc-i]').forEach((b) => b.addEventListener('click', (e) => {
      const rm = e.target.closest('[data-mc-rm]');
      if (rm) { const i = Number(rm.dataset.mcRm); const [x] = mc.items.splice(i, 1); if (x.url) URL.revokeObjectURL(x.url); mc.active = Math.min(mc.active, mc.items.length - 1); return renderMediaComposer(); }
      mc.active = Number(b.dataset.mcI); renderMediaComposer();
    }));
    root.querySelector('[data-mc-add]')?.addEventListener('click', () => pickFiles(''));
    root.querySelector('[data-mc-send]')?.addEventListener('click', sendMediaItems);
  }
  // Siapkan file: kompresi gambar (standar WhatsApp: sisi terpanjang 1600 px) atau konversi ke JPEG; baca dimensi/durasi
  async function prepareMedia(it) {
    const k = it.asDoc ? 'document' : it.kind, f = it.file, out = { file: f, kind: k, meta: {} };
    if (k === 'image') {
      let img;
      try { img = await loadImage(f); } catch (e) { if (it.convert) { out.kind = 'document'; return out; } throw e; }
      out.meta = { width: img.naturalWidth, height: img.naturalHeight };
      const max = it.hd ? 4096 : 1600, big = Math.max(img.naturalWidth, img.naturalHeight) > max;
      if (it.convert || big || (!it.hd && f.size > 1.5 * 1048576) || f.size > MEDIA_LIMIT.image * 1048576) {
        const s = Math.min(1, max / Math.max(img.naturalWidth, img.naturalHeight));
        const cv = document.createElement('canvas'); cv.width = Math.round(img.naturalWidth * s); cv.height = Math.round(img.naturalHeight * s);
        const g = cv.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, cv.width, cv.height); g.drawImage(img, 0, 0, cv.width, cv.height);
        let blob = null;
        for (const q of it.hd ? [0.92, 0.85, 0.75] : [0.82, 0.72, 0.6]) { blob = await new Promise((r) => cv.toBlob(r, 'image/jpeg', q)); if (blob && blob.size <= MEDIA_LIMIT.image * 1048576) break; }
        if (!blob || blob.size > MEDIA_LIMIT.image * 1048576) throw new Error('Gambar tetap lebih dari 5 MB setelah dikompres — kirim sebagai dokumen.');
        out.file = new File([blob], f.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' });
        out.meta = { width: cv.width, height: cv.height };
      }
    } else if ((k === 'video' || k === 'audio') && it.url) {
      const el = document.createElement(k);
      await new Promise((r) => { el.onloadedmetadata = r; el.onerror = r; el.preload = 'metadata'; el.src = it.url; setTimeout(r, 4000); });
      out.meta = { duration: Number.isFinite(el.duration) ? el.duration : 0, ...(k === 'video' ? { width: el.videoWidth || 0, height: el.videoHeight || 0 } : {}) };
    }
    const lim = MEDIA_LIMIT[out.kind];
    if (out.file.size > lim * 1048576) throw new Error(`${{ image: 'Gambar', video: 'Video', audio: 'Audio', document: 'Dokumen' }[out.kind]} maksimal ${lim} MB.`);
    return out;
  }
  async function sendMediaItems() {
    const mc = S.mc; if (!mc || mc.sending) return;
    mc.sending = true; renderMediaComposer();
    let first = true;
    for (const it of mc.items) {
      if (it.status === 'done' || (it.status === 'err' && it.file.size > MEDIA_LIMIT.document * 1048576)) continue;
      it.status = 'up'; it.error = ''; it.progress = 0; renderMediaComposer();
      try {
        const p = await prepareMedia(it);
        const up = await uploadFile(p.file, p.kind, (x) => { it.progress = x; const bar = $(`#mc [data-mc-i="${mc.items.indexOf(it)}"] .prog i`); if (bar) bar.style.width = Math.round(x * 100) + '%'; });
        if (S.mc !== mc) return;
        if (!first) S.inbox.replyTo = null; // kutipan hanya pada pesan pertama
        await sendMsg({ type: p.kind, mediaId: up.id, mime: up.mime, filename: p.kind === 'document' ? it.file.name : up.filename, caption: p.kind === 'audio' ? '' : it.caption, size: up.size, ...p.meta });
        it.status = 'done'; first = false;
      } catch (e) { it.status = 'err'; it.error = e.message; }
      if (S.mc !== mc) return;
      renderMediaComposer();
    }
    mc.sending = false;
    const failed = mc.items.filter((x) => x.status === 'err');
    if (!failed.length) { closeMediaComposer(); return; }
    mc.active = mc.items.indexOf(failed[0]); renderMediaComposer();
    toast(`${failed.length} file gagal dikirim — periksa pesan di bawah pratinjau, lalu kirim ulang.`, true);
  }
  // Seret & lepas file ke area chat
  function bindChatDrop(el) {
    let depth = 0;
    const ov = () => el.querySelector('#drop-ov'); // dicari ulang: isi chat di-render ulang
    const hasFiles = (e) => [...(e.dataTransfer?.types || [])].includes('Files');
    el.addEventListener('dragenter', (e) => { if (!hasFiles(e)) return; e.preventDefault(); depth++; ov()?.classList.add('on'); });
    el.addEventListener('dragover', (e) => { if (hasFiles(e)) e.preventDefault(); });
    el.addEventListener('dragleave', () => { if (--depth <= 0) { depth = 0; ov()?.classList.remove('on'); } });
    el.addEventListener('drop', (e) => { if (!hasFiles(e)) return; e.preventDefault(); depth = 0; ov()?.classList.remove('on'); openMediaComposer([...e.dataTransfer.files]); });
  }

  /* Kamera (desktop): ambil foto dari webcam */
  async function cameraModal() {
    let stream;
    try { stream = await navigator.mediaDevices.getUserMedia({ video: { width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false }); }
    catch (e) { return fail(new Error('Kamera tidak tersedia atau izin ditolak.')); }
    const stop = () => stream.getTracks().forEach((t) => t.stop());
    modal('Ambil foto', `<div class="rounded-md overflow-hidden bg-black"><video id="cam-v" autoplay playsinline muted class="w-full" style="max-height:60vh"></video></div>`,
      { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="cam-go">' + ICON.camera + ' Ambil foto</button>' });
    const v = $('#cam-v'); v.srcObject = stream;
    const obs = new MutationObserver(() => { if (!document.body.contains(v)) { stop(); obs.disconnect(); } });
    obs.observe($('#modal-root'), { childList: true });
    $('#cam-go').addEventListener('click', async () => {
      const cv = document.createElement('canvas'); cv.width = v.videoWidth; cv.height = v.videoHeight;
      cv.getContext('2d').drawImage(v, 0, 0);
      const blob = await new Promise((r) => cv.toBlob(r, 'image/jpeg', 0.9));
      closeModal();
      openMediaComposer([new File([blob], `foto-${new Date().toISOString().slice(0, 19).replace(/\D/g, '')}.jpg`, { type: 'image/jpeg' })]);
    });
  }

  /* Lokasi: peta OpenStreetMap (Leaflet) + pencarian alamat (Nominatim) + lokasi saat ini */
  const LEAFLET = { v: '1.9.4', css: 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=', js: 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=' };
  function loadLeaflet() {
    if (window.L) return Promise.resolve();
    if (S.leaflet) return S.leaflet;
    S.leaflet = new Promise((ok, no) => {
      const base = `https://unpkg.com/leaflet@${LEAFLET.v}/dist/leaflet`;
      const css = Object.assign(document.createElement('link'), { rel: 'stylesheet', href: base + '.css', integrity: LEAFLET.css, crossOrigin: '' });
      const js = Object.assign(document.createElement('script'), { src: base + '.js', integrity: LEAFLET.js, crossOrigin: '' });
      js.onload = () => ok(); js.onerror = () => { S.leaflet = null; no(new Error('Peta tidak dapat dimuat.')); };
      document.head.append(css, js);
    });
    return S.leaflet;
  }
  const nominatim = (path, q) => fetch(`https://nominatim.openstreetmap.org/${path}?format=jsonv2&accept-language=id&${new URLSearchParams(q)}`).then((r) => { if (!r.ok) throw new Error('Pencarian alamat gagal (' + r.status + ')'); return r.json(); });
  async function locationPicker() {
    modal('Kirim lokasi', `<div class="space-y-3">
      <form id="loc-sf" class="flex gap-2"><input class="input flex-1" id="loc-q" placeholder="Cari tempat atau alamat…" aria-label="Cari lokasi"><button class="btn" type="submit">Cari</button></form>
      <div id="loc-res" class="hidden border bd rounded-md max-h-40 overflow-y-auto scroll-thin"></div>
      <div class="loc-picker" id="loc-map"><div class="p-4 text-xs ink-3">Memuat peta…</div></div>
      <button type="button" class="btn w-full" id="loc-me">${ICON.pin} Pakai lokasi saya saat ini</button>
      <div class="grid sm:grid-cols-2 gap-3">
        <div><label class="label" for="loc-n">Nama tempat</label><input class="input" id="loc-n" maxlength="1000" placeholder="mis. Kantor Pusat"></div>
        <div><label class="label" for="loc-a">Alamat</label><input class="input" id="loc-a" maxlength="1000"></div>
        <div><label class="label" for="loc-lat">Latitude</label><input class="input mono" id="loc-lat" inputmode="decimal" required></div>
        <div><label class="label" for="loc-lng">Longitude</label><input class="input mono" id="loc-lng" inputmode="decimal" required></div>
      </div>
      <p class="hint">Klik peta atau geser penanda untuk memilih titik. Data peta © kontributor OpenStreetMap; pencarian alamat memakai Nominatim.</p>
    </div>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="loc-go">Kirim lokasi</button>' });
    let map = null, marker = null, revTimer = null;
    const set = (lat, lng, { name, address, reverse = true, fly = false } = {}) => {
      $('#loc-lat').value = (+lat).toFixed(6); $('#loc-lng').value = (+lng).toFixed(6);
      if (name !== undefined) $('#loc-n').value = name;
      if (address !== undefined) $('#loc-a').value = address;
      if (marker) { marker.setLatLng([lat, lng]); if (fly) map.setView([lat, lng], 17); }
      if (reverse) {
        clearTimeout(revTimer);
        revTimer = setTimeout(() => nominatim('reverse', { lat, lon: lng, zoom: 18 }).then((r) => {
          if (!$('#loc-a')) return;
          $('#loc-a').value = r.display_name || '';
          if (!$('#loc-n').value) $('#loc-n').value = r.name || (r.display_name || '').split(',')[0];
        }).catch(() => {}), 600);
      }
    };
    try {
      await loadLeaflet();
      if (!$('#loc-map')) return;
      $('#loc-map').innerHTML = '';
      map = L.map('loc-map').setView([-2.5, 118], 5);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map);
      marker = L.marker([-2.5, 118], { draggable: true }).addTo(map);
      marker.on('dragend', () => { const p = marker.getLatLng(); $('#loc-n').value = ''; set(p.lat, p.lng); });
      map.on('click', (e) => { $('#loc-n').value = ''; set(e.latlng.lat, e.latlng.lng); });
      setTimeout(() => map.invalidateSize(), 150);
    } catch (e) {
      $('#loc-map').innerHTML = `<div class="p-4 text-xs ink-3">${esc(e.message)} Isi latitude & longitude secara manual, atau pakai lokasi saat ini.</div>`;
    }
    $('#loc-me').addEventListener('click', (e) => {
      if (!navigator.geolocation) return fail(new Error('Perangkat tidak mendukung lokasi.'));
      const btn = e.currentTarget; btn.disabled = true;
      navigator.geolocation.getCurrentPosition((p) => { btn.disabled = false; $('#loc-n').value = ''; set(p.coords.latitude, p.coords.longitude, { fly: true }); btn.innerHTML = `${ICON.pin} Lokasi saya (akurasi ±${Math.round(p.coords.accuracy)} m)`; },
        (err) => { btn.disabled = false; fail(new Error('Lokasi tidak tersedia: ' + err.message)); }, { enableHighAccuracy: true, timeout: 10000 });
    });
    $('#loc-sf').addEventListener('submit', (e) => {
      e.preventDefault();
      const q = $('#loc-q').value.trim(); if (!q) return;
      busy(e.submitter, async () => {
        const rows = await nominatim('search', { q, limit: 6 });
        const box = $('#loc-res'); box.classList.remove('hidden');
        box.innerHTML = rows.map((r, i) => `<button type="button" class="block w-full text-left px-3 py-2 border-b bd last:border-0 text-xs hover:bg-[var(--surface-2)]" data-r="${i}"><div class="font-medium text-[13px]">${esc(r.name || r.display_name.split(',')[0])}</div><div class="ink-3 truncate">${esc(r.display_name)}</div></button>`).join('') || '<div class="p-3 text-xs ink-3">Tempat tidak ditemukan.</div>';
        box.querySelectorAll('[data-r]').forEach((b) => b.addEventListener('click', () => { const r = rows[b.dataset.r]; set(r.lat, r.lon, { name: r.name || r.display_name.split(',')[0], address: r.display_name, reverse: false, fly: true }); box.classList.add('hidden'); }));
      });
    });
    $('#loc-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const lat = $('#loc-lat').value, lng = $('#loc-lng').value;
      if (!lat || !lng) throw new Error('Pilih titik lokasi di peta, cari alamat, atau pakai lokasi saat ini.');
      await sendMsg({ type: 'location', latitude: lat, longitude: lng, name: $('#loc-n').value, address: $('#loc-a').value });
      closeModal();
    }));
  }

  /* Kontak: pilih dari daftar Kontak Kontaq (kontak WhatsApp) atau isi manual — maks. 10 per pesan */
  function contactPicker() {
    const picked = new Map();
    modal('Kirim kontak', `<div class="space-y-3">
      <div class="tabs">${[['kq', 'Dari Kontak'], ['manual', 'Isi manual']].map(([k, l], i) => `<button type="button" class="tab ${i ? '' : 'active'}" data-ct-tab="${k}">${l}</button>`).join('')}</div>
