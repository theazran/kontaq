  }
  // Bunyi "ding-dong" pendek untuk chat masuk; dibatasi agar rentetan pesan tidak berisik
  function playChime(force) {
    if (!force && (!pref('sound') || S.call || Date.now() - (S.lastChime || 0) < 1500)) return;
    S.lastChime = Date.now();
    const ctx = audioCtx(); if (!ctx) return;
