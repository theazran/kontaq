    el.innerHTML = `<div class="cmp-wrap" id="cmp-wrap">
      ${rep ? `<div class="px-3 pt-2 flex items-center gap-2 text-xs ink-3"><span class="border-l-2 pl-2 truncate flex-1" style="border-color:var(--accent)">Membalas: ${esc(quoteText(rep).slice(0, 100))}</span><button class="btn btn-ghost btn-sm" id="cmp-unreply" aria-label="Batal balas">${ICON.x}</button></div>` : ''}
      <div class="cmp-row" id="cmp-row">
