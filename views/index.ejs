<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#17171a" media="(prefers-color-scheme: dark)">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Kontaq">
  <title>Kontaq</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    (function () {
      var t = null; try { t = localStorage.getItem('kq-theme'); } catch (e) {}
      if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
    })();
  </script>
  <script src="https://cdn.tailwindcss.com/3.4.16"></script>
  <script>tailwind.config = { darkMode: 'class', corePlugins: { preflight: true }, theme: { extend: { fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] } } } };</script>
  <link rel="stylesheet" href="/public/style.css?v=<%= assetVersion %>">
</head>
<body class="h-full text-[13px]">

<% if (!user) { %>
  <!-- ───────────── Masuk / Setup ───────────── -->
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-sm">
      <div class="flex items-center gap-2 mb-8">
        <span class="inline-flex w-7 h-7 rounded-md items-center justify-center" style="background:var(--accent)">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#0b1f12" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.5 8.5 0 1 1 21 11.5z"/></svg>
        </span>
        <span class="text-[15px] font-semibold tracking-tight">Kontaq</span>
      </div>
      <h1 class="text-xl font-semibold tracking-tight"><%= needsSetup ? 'Siapkan akun admin' : 'Masuk' %></h1>
      <p class="ink-3 mt-1 mb-6"><%= needsSetup ? 'Akun pertama otomatis menjadi admin.' : 'Dashboard WhatsApp Cloud API.' %></p>
      <form id="auth-form" class="space-y-3" data-mode="<%= needsSetup ? 'setup' : 'login' %>">
        <% if (needsSetup) { %>
          <div><label class="label" for="f-name">Nama</label><input class="input" id="f-name" name="name" required autocomplete="name"></div>
        <% } %>
        <div><label class="label" for="f-email">Email</label><input class="input" id="f-email" name="email" type="email" required autocomplete="email"></div>
        <div><label class="label" for="f-pass">Kata sandi</label><input class="input" id="f-pass" name="password" type="password" required minlength="<%= needsSetup ? 10 : 1 %>" autocomplete="<%= needsSetup ? 'new-password' : 'current-password' %>">
          <% if (needsSetup) { %><p class="hint">Minimal 10 karakter.</p><% } %></div>
        <p id="auth-err" class="text-xs danger-ink hidden"></p>
        <button class="btn btn-primary w-full h-9" type="submit"><%= needsSetup ? 'Buat akun' : 'Masuk' %></button>
      </form>
    </div>
  </main>
  <script>
    document.getElementById('auth-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      var f = e.target, err = document.getElementById('auth-err');
      var body = Object.fromEntries(new FormData(f));
      err.classList.add('hidden');
      var r = await fetch('/api/' + f.dataset.mode, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'kontaq' }, body: JSON.stringify(body) });
      var j = await r.json().catch(function () { return {}; });
      if (!r.ok) { err.textContent = j.error || 'Gagal.'; err.classList.remove('hidden'); return; }
      location.reload();
    });
  </script>
<% } else { %>
  <!-- ───────────── Aplikasi ───────────── -->
  <div class="flex app-shell overflow-hidden">
    <aside id="sidebar" class="surface border-r bd w-56 flex-none flex-col hidden md:flex fixed md:static inset-y-0 left-0 z-40">
      <div class="h-14 flex items-center gap-2 px-4 border-b bd">
        <span class="inline-flex w-6 h-6 rounded-md items-center justify-center" style="background:var(--accent)">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#0b1f12" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.5 8.5 0 1 1 21 11.5z"/></svg>
        </span>
        <span class="font-semibold tracking-tight text-[14px]">Kontaq</span>
      </div>
      <nav id="nav" class="flex-1 p-2 space-y-0.5 overflow-y-auto"></nav>
      <div class="p-3 border-t bd">
        <div class="flex items-center gap-1.5">
          <span class="avatar" id="me-avatar"></span>
          <div class="min-w-0 flex-1">
            <div class="font-medium truncate" id="me-name"></div>
            <div class="text-[11px] ink-3 capitalize" id="me-role"></div>
          </div>
          <button class="btn btn-ghost btn-icon btn-sm" data-act="sound" id="sound-btn" title="Suara notifikasi" aria-label="Suara notifikasi"></button>
          <button class="btn btn-ghost btn-icon btn-sm" data-act="theme" title="Ganti tema" aria-label="Ganti tema"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
          <button class="btn btn-ghost btn-icon btn-sm" data-act="logout" title="Keluar" aria-label="Keluar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg></button>
        </div>
      </div>
    </aside>
    <div id="sidebar-back" class="fixed inset-0 z-30 bg-black/40 hidden md:hidden" data-act="nav-close"></div>

    <div class="flex-1 min-w-0 flex flex-col">
      <header id="app-header" class="h-14 flex-none surface border-b bd flex items-center gap-3 px-4">
        <button class="btn btn-ghost btn-icon md:hidden" data-act="nav-open" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <h1 id="page-title" class="text-[15px] font-semibold tracking-tight"></h1>
        <div class="flex-1"></div>
        <span id="live" class="badge" title="Status koneksi real-time"><span class="dot"></span><span>Menghubungkan</span></span>
      </header>
      <main id="view" class="flex-1 min-h-0 overflow-y-auto scroll-thin"></main>
      <nav id="tabbar" class="tabbar md:hidden flex-none" aria-label="Navigasi utama"></nav>
    </div>
  </div>

  <div id="call-bar" class="call-sheet hidden" role="dialog" aria-label="Panggilan WhatsApp"></div>
  <audio id="call-audio" autoplay></audio>
  <div id="modal-root"></div>
  <div id="toast-root" class="fixed top-4 right-4 z-[70] space-y-2"></div>
  <div id="chart-tip" class="chart-tip hidden"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
  'use strict';
  const BOOT = <%- JSON.stringify(boot).replace(/</g, '\\u003c') %>;

  /* ───────────── Utilitas ───────────── */
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const initials = (s) => esc(String(s || '?').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '?');
  const fmtTime = (t) => (t ? new Date(t).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '');
  const fmtDate = (t) => (t ? new Date(t).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '—');
  const fmtDT = (t) => (t ? new Date(t).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—');
  const fmtNum = (n) => Number(n || 0).toLocaleString('id-ID');
  const relTime = (t) => {
    if (!t) return '';
    const d = Date.now() - t;
    if (d < 60e3) return 'baru';
    if (d < 3600e3) return Math.floor(d / 60e3) + 'm';
    if (new Date(t).toDateString() === new Date().toDateString()) return fmtTime(t);
    if (d < 7 * 864e5) return new Date(t).toLocaleDateString('id-ID', { weekday: 'short' });
    return new Date(t).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit' });
  };
  // Format teks WhatsApp sederhana: *tebal*, _miring_, ~coret~, tautan
  const waFormat = (s) => esc(s)
    .replace(/\*([^*\n]+)\*/g, '<b>$1</b>').replace(/(^|\s)_([^_\n]+)_/g, '$1<i>$2</i>').replace(/~([^~\n]+)~/g, '<s>$1</s>')
    .replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer" class="underline" style="color:var(--info)">$1</a>')
    .replace(/\n/g, '<br>');

  async function api(method, url, body) {
    const opt = { method, headers: { 'X-Requested-With': 'kontaq' } };
    if (body instanceof FormData) opt.body = body;
    else if (body !== undefined) { opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(body); }
    const r = await fetch(url, opt);
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) { location.reload(); throw new Error(j.error); }
    if (!r.ok) throw new Error(j.error || 'Permintaan gagal (' + r.status + ')');
    return j;
  }
  function toast(msg, err) {
    const el = document.createElement('div');
    el.className = 'toast' + (err ? ' err' : ''); el.textContent = msg; el.setAttribute('role', err ? 'alert' : 'status');
    const root = $('#toast-root'); root.appendChild(el);
    while (root.children.length > 2) root.firstElementChild.remove();
    setTimeout(() => el.remove(), err ? 6000 : 3000);
  }
  const fail = (e) => toast(e.message || String(e), true);
  async function busy(btn, fn) {
    if (btn) { btn.disabled = true; btn.dataset.label = btn.innerHTML; btn.innerHTML = '<svg class="spin" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.2-8.6"/></svg>'; }
    try { return await fn(); } catch (e) { fail(e); } finally { if (btn) { btn.disabled = false; btn.innerHTML = btn.dataset.label; } }
  }

  function modal(title, body, { wide, footer } = {}) {
    closeModal();
    const root = $('#modal-root');
    root.innerHTML = `<div class="modal-back" data-modal-back><div class="modal ${wide ? 'wide' : ''}" role="dialog" aria-modal="true" aria-label="${esc(title)}">
      <div class="card-h"><div class="card-t">${esc(title)}</div><button class="btn btn-ghost btn-icon" data-act="modal-close" aria-label="Tutup">${ICON.x}</button></div>
      <div class="p-4 max-h-[70vh] overflow-y-auto scroll-thin" id="modal-body">${body}</div>
      ${footer ? `<div class="flex justify-end gap-2 px-4 py-3 border-t bd">${footer}</div>` : ''}</div></div>`;
    root.querySelector('[data-modal-back]').addEventListener('mousedown', (e) => { if (e.target.dataset.modalBack !== undefined) closeModal(); });
    const first = root.querySelector('input,select,textarea'); if (first) setTimeout(() => first.focus(), 30);
    return root;
  }
  function closeModal() { $('#modal-root').innerHTML = ''; }
  function confirmBox(text, okLabel = 'Lanjutkan', danger) {
    return new Promise((resolve) => {
      modal('Konfirmasi', `<p class="ink-2">${esc(text)}</p>`, { footer: `<button class="btn" data-c="0">Batal</button><button class="btn ${danger ? 'btn-danger' : 'btn-primary'}" data-c="1">${esc(okLabel)}</button>` });
      $$('#modal-root [data-c]').forEach((b) => b.addEventListener('click', () => { closeModal(); resolve(b.dataset.c === '1'); }));
      $('#modal-root [data-act=modal-close]').addEventListener('click', () => resolve(false));
    });
  }
  const formData = (form) => Object.fromEntries(new FormData(form));

  const ICON = {
    x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>',
    dash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>',
    inbox: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.5 8.5 0 1 1 21 11.5z"/></svg>',
    users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg>',
    tpl: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>',
    send: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>',
    phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>',
    gear: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>',
    clip: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.4 11-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>',
    pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>',
    btns: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/></svg>',
    list: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>',
    info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>',
    back: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>',
    refresh: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M3 21v-5h5"/></svg>',
    plus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>',
    reply: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17 4 12l5-5"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>',
    menu: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>',
    camera: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>',
    image: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>',
    doc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>',
    mic: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></svg>',
    micOff: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 2 20 20M9 9v3a3 3 0 0 0 5.1 2.1M15 9.3V5a3 3 0 0 0-5.9-.6M17 16.9A7 7 0 0 1 5 12v-2m14 0v2c0 .8-.1 1.5-.4 2.2M12 19v3"/></svg>',
    bell: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg>',
    bellOff: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13.7 21a2 2 0 0 1-3.4 0M18.6 13A17.9 17.9 0 0 1 18 8M6.3 6.3A6 6 0 0 0 6 8c0 7-3 9-3 9h14M18 8a6 6 0 0 0-9.3-5M2 2l20 20"/></svg>',
    up: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 15-6-6-6 6"/></svg>',
    down: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>',
    edit: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>',
    trash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>',
    bolt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg>',
    log: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>',
    campaign: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 18-8-8 18-2-8z"/></svg>',
    flow: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><path d="M6.5 10v4a3 3 0 0 0 3 3H14"/></svg>',
    branch: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="2.5"/><circle cx="6" cy="19" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="M12 7.5v3M6 16.5V15a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v1.5"/></svg>',
    clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>',
    tag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z"/><circle cx="7" cy="7" r="1.5"/></svg>',
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>',
    copy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>',
  };
  const tick = (s) => ({
    pending: '<span title="Menunggu">🕓</span>', accepted: '<span class="ink-3" title="Diterima Meta, menunggu konfirmasi webhook">✓</span>', sent: '<span title="Terkirim">✓</span>', delivered: '<span title="Diterima">✓✓</span>',
    read: '<span class="tick-read" title="Dibaca">✓✓</span>', played: '<span class="tick-read" title="Diputar">✓✓</span>', failed: '<span class="danger-ink" title="Gagal">⚠</span>',
  }[s] || '');
  const statusBadge = (s) => {
    const map = { APPROVED: 'green', ACTIVE: 'green', done: 'green', running: 'green', delivered: 'green', read: 'green', open: 'green', ENABLED: 'green',
      PENDING: 'amber', IN_APPEAL: 'amber', paused: 'amber', pending: 'amber', queued: 'amber', PAUSED: 'amber', ringing: 'amber',
      REJECTED: 'red', DISABLED: 'red', failed: 'red', cancelled: 'red', rejected: 'red', FLAGGED: 'red' };
    const label = { accepted: 'Diterima Meta', open: 'Terbuka', pending: 'Menunggu', closed: 'Selesai', draft: 'Draf', running: 'Berjalan', paused: 'Dijeda', done: 'Selesai', cancelled: 'Dibatalkan', queued: 'Antre', sent: 'Terkirim', delivered: 'Diterima', read: 'Dibaca', failed: 'Gagal', skipped: 'Dilewati' }[s] || s;
    return `<span class="badge ${map[s] ? 'badge-' + map[s] : ''}"><span class="dot"></span>${esc(label)}</span>`;
  };

  /* ───────────── State & navigasi ───────────── */
  const S = {
    user: BOOT.user, isAdmin: BOOT.user.role === 'admin', users: [], view: 'dashboard',
    inbox: { convs: [], activeId: null, messages: [], filter: { q: '', scope: 'all', status: 'open' }, showInfo: window.innerWidth >= 1280, replyTo: null },
    templates: { rows: [], syncedAt: 0, loaded: false },
    contacts: { q: '', label: '', page: 1 },
    settingsTab: null,
    call: null, pc: null,
  };
  const VIEWS = [
    { id: 'dashboard', label: 'Dashboard', icon: 'dash' },
    { id: 'inbox', label: 'Inbox', icon: 'inbox' },
    { id: 'contacts', label: 'Kontak', icon: 'users' },
    { id: 'templates', label: 'Template', icon: 'tpl' },
    { id: 'campaigns', label: 'Campaign', icon: 'campaign', admin: true },
    { id: 'messagelog', label: 'Log pesan', icon: 'log', admin: true },
    { id: 'autoreply', label: 'Auto reply', icon: 'bolt', admin: true },
    { id: 'flows', label: 'Flow otomatis', icon: 'flow', admin: true },
    { id: 'calls', label: 'Panggilan', icon: 'phone' },
    { id: 'settings', label: 'Pengaturan', icon: 'gear' },
  ];
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  const isMobile = () => window.innerWidth < 768;
  function renderNav() {
    const unread = S.inbox.convs.reduce((n, c) => n + (c.unread || 0), 0);
    const tabs = [['inbox', 'Chat'], ['calls', 'Panggilan'], ['contacts', 'Kontak'], ['dashboard', 'Ringkasan']];
    const inMenu = !tabs.some(([id]) => id === S.view);
    $('#tabbar').innerHTML = tabs.map(([id, label]) => `<a href="#/${id}" class="tab-item ${S.view === id ? 'active' : ''}">${ICON[VIEWS.find((x) => x.id === id).icon]}<span>${label}</span>${id === 'inbox' && unread ? `<span class="tab-badge">${unread > 99 ? '99+' : unread}</span>` : ''}</a>`).join('')
      + `<button class="tab-item ${inMenu ? 'active' : ''}" data-act="nav-open">${ICON.menu}<span>Lainnya</span></button>`;
    document.body.classList.toggle('chat-open', S.view === 'inbox' && !!S.inbox.activeId);
    $('#nav').innerHTML = VIEWS.filter((v) => !v.admin || S.isAdmin).map((v) => `<a href="#/${v.id}" class="nav-item ${S.view === v.id ? 'active' : ''}">${ICON[v.icon]}<span class="flex-1">${v.label}</span>${v.id === 'inbox' && unread ? `<span class="badge badge-green">${unread}</span>` : ''}</a>`).join('');
  }
  function route() {
    const [view, arg] = location.hash.replace(/^#\/?/, '').split('/');
    closeModal();
    S.view = VIEWS.some((v) => v.id === view && (!v.admin || S.isAdmin)) ? view : 'dashboard';
    $('#page-title').textContent = VIEWS.find((v) => v.id === S.view).label;
    $('#sidebar').classList.add('hidden'); $('#sidebar').classList.remove('flex'); $('#sidebar-back').classList.add('hidden');
    $('#sidebar').classList.toggle('md:flex', true);
    renderNav();
    const v = $('#view'); v.className = 'flex-1 min-h-0 overflow-y-auto scroll-thin';
    ({ dashboard: viewDashboard, inbox: () => viewInbox(arg), contacts: viewContacts, templates: viewTemplates, campaigns: viewCampaigns, messagelog: viewMessageLog, autoreply: viewAutoReply, flows: () => viewFlows(arg), calls: viewCalls, settings: () => viewSettings(arg) })[S.view]();
  }
  window.addEventListener('hashchange', route);

  // Delegasi klik global (data-act)
  const ACT = {
    'modal-close': closeModal,
    'nav-open': () => { $('#sidebar').classList.remove('hidden'); $('#sidebar').classList.add('flex'); $('#sidebar-back').classList.remove('hidden'); },
    'nav-close': () => { $('#sidebar').classList.add('hidden'); $('#sidebar').classList.remove('flex'); $('#sidebar-back').classList.add('hidden'); },
    theme: () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('kq-theme', dark ? 'dark' : 'light'); } catch (e) {}
    },
    callback: (el) => startCallback({ id: el.dataset.contact, name: el.dataset.name, phone: el.dataset.phone }),
    logout: async () => { await api('POST', '/api/logout'); location.reload(); },
    sound: () => { setPref('sound', !pref('sound')); renderSoundBtn(); if (pref('sound')) playChime(true); toast(pref('sound') ? 'Suara notifikasi aktif.' : 'Suara notifikasi dimatikan.'); },
  };
  document.addEventListener('click', (e) => {
    const el = e.target.closest('[data-act]');
    if (el && ACT[el.dataset.act]) { e.preventDefault(); ACT[el.dataset.act](el, e); }
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && $('#modal-root').innerHTML) closeModal(); });

  /* ───────────── Dashboard ───────────── */
  async function viewDashboard() {
    const v = $('#view');
    v.innerHTML = '<div class="empty">Memuat…</div>';
    let st;
    try { st = await api('GET', '/api/stats?days=14'); } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (S.view !== 'dashboard') return;
    const o = st.outbound, outTotal = (o.accepted || 0) + o.sent + o.delivered + o.read + o.failed + (o.pending || 0);
    const pct = (n) => (outTotal ? Math.round((n / outTotal) * 100) : 0);
    const max = Math.max(1, ...st.series.map((d) => Math.max(d.in, d.out)));
    const tile = (label, value, sub) => `<div class="card p-4"><div class="text-xs ink-3">${label}</div><div class="text-2xl font-semibold tracking-tight mt-1">${fmtNum(value)}</div>${sub ? `<div class="text-[11px] ink-3 mt-0.5">${sub}</div>` : ''}</div>`;
    v.innerHTML = `<div class="p-4 md:p-6 space-y-4 max-w-7xl">
      ${!st.connected ? `<div class="card p-3 flex items-center gap-3" style="background:var(--warn-soft);border-color:transparent"><span style="color:var(--warn)">${ICON.info}</span><div class="flex-1 text-[13px]">Koneksi Meta belum dikonfigurasi. Pesan belum dapat dikirim.</div>${S.isAdmin ? '<a class="btn btn-sm" href="#/settings/meta">Atur koneksi</a>' : ''}</div>` : ''}
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
        ${tile('Percakapan terbuka', st.conversations.open, `${fmtNum(st.conversations.pending)} menunggu`)}
        ${tile('Belum ditugaskan', st.conversations.unassigned, 'perlu ditangani')}
        ${tile('Jendela 24 jam aktif', st.conversations.windowOpen, 'bisa dibalas bebas')}
        ${tile('Kontak', st.contacts)}
        ${tile('Template disetujui', st.templates.approved, `dari ${fmtNum(st.templates.total)} template`)}
      </div>
      ${S.isAdmin ? '<section id="cost-card" class="card"><div class="p-4 text-xs ink-3">Memuat biaya Meta…</div></section>' : ''}
      <div class="grid lg:grid-cols-3 gap-4">
        <section class="card lg:col-span-2">
          <div class="card-h"><div><div class="card-t">Volume pesan</div><div class="text-[11px] ink-3">${st.days} hari terakhir</div></div>
            <div class="flex items-center gap-3 text-[11px] ink-2"><span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bar-in"></span>Masuk</span><span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bar-out"></span>Keluar</span>
            <button class="btn btn-ghost btn-sm" id="chart-table-toggle">Tabel</button></div></div>
          <div class="p-4">
            <div id="chart-wrap">
              <div class="bar-chart" id="chart" role="img" aria-label="Grafik pesan masuk dan keluar per hari">
                ${st.series.map((d) => `<div class="bar-col" data-tip="${esc(fmtDate(new Date(d.date)))}|${d.in}|${d.out}"><div class="bar bar-in" style="height:${(d.in / max) * 100}%"></div><div class="bar bar-out" style="height:${(d.out / max) * 100}%"></div></div>`).join('')}
              </div>
              <div class="flex justify-between text-[10px] ink-3 mt-2 border-t bd pt-1.5"><span>${esc(fmtDate(new Date(st.series[0].date)))}</span><span>maks ${fmtNum(max)}/hari</span><span>Hari ini</span></div>
            </div>
            <div id="chart-table" class="hidden max-h-64 overflow-y-auto scroll-thin"><table class="tbl"><thead><tr><th>Tanggal</th><th class="text-right">Masuk</th><th class="text-right">Keluar</th></tr></thead><tbody>${st.series.map((d) => `<tr><td>${esc(fmtDate(new Date(d.date)))}</td><td class="text-right">${d.in}</td><td class="text-right">${d.out}</td></tr>`).join('')}</tbody></table></div>
          </div>
        </section>
        <section class="card">
          <div class="card-h"><div class="card-t">Status pengiriman</div><span class="text-[11px] ink-3">${fmtNum(outTotal)} pesan keluar</span></div>
          <div class="p-4 space-y-3">
            ${[['Diterima Meta', (o.accepted || 0) + (o.pending || 0)], ['Terkirim', o.sent], ['Diterima', o.delivered], ['Dibaca', o.read], ['Gagal', o.failed]].map(([l, n]) => `<div><div class="flex justify-between text-xs mb-1"><span class="ink-2">${l}</span><span class="font-medium">${fmtNum(n)} <span class="ink-3 font-normal">· ${pct(n)}%</span></span></div><div class="h-1.5 rounded-full surface-2 overflow-hidden"><div class="h-full rounded-full" style="width:${pct(n)}%;background:${l === 'Gagal' ? 'var(--danger)' : l === 'Dibaca' ? 'var(--accent)' : 'var(--ink-3)'}"></div></div></div>`).join('')}
            <p class="hint">Status diperbarui dari webhook Meta. "Diterima Meta" berarti request API berhasil tetapi belum ada konfirmasi webhook; "Terkirim" berarti belum ada konfirmasi sampai di perangkat.${S.isAdmin ? ' <a class="accent-ink underline" href="#/messagelog">Lihat log pesan</a>' : ''}</p>
          </div>
        </section>
      </div>
      <div class="grid lg:grid-cols-2 gap-4">
        <section class="card overflow-hidden">
          <div class="card-h"><div class="card-t">Kinerja tim CS</div><span class="text-[11px] ink-3">${st.days} hari</span></div>
          <table class="tbl"><thead><tr><th>Agen</th><th class="text-right">Aktif</th><th class="text-right">Selesai</th><th class="text-right">Pesan dikirim</th></tr></thead>
          <tbody>${st.agents.map((a) => `<tr><td><div class="flex items-center gap-2"><span class="avatar" style="width:1.5rem;height:1.5rem;font-size:10px">${initials(a.name)}</span>${esc(a.name)}</div></td><td class="text-right">${a.open}</td><td class="text-right">${a.closed}</td><td class="text-right">${a.sent}</td></tr>`).join('') || '<tr><td colspan="4" class="ink-3">Belum ada data.</td></tr>'}</tbody></table>
        </section>
        <section class="card overflow-hidden">
          <div class="card-h"><div class="card-t">Campaign terbaru</div>${S.isAdmin ? '<a href="#/campaigns" class="text-xs accent-ink">Lihat semua</a>' : ''}</div>
          <table class="tbl"><thead><tr><th>Nama</th><th>Status</th><th class="text-right">Dibaca</th><th class="text-right">Gagal</th></tr></thead>
          <tbody>${st.campaigns.map((c) => `<tr><td>${esc(c.name)}<div class="text-[11px] ink-3">${fmtNum(c.total)} penerima</div></td><td>${statusBadge(c.status)}</td><td class="text-right">${c.counts.read}</td><td class="text-right">${c.counts.failed}</td></tr>`).join('') || '<tr><td colspan="4" class="ink-3">Belum ada campaign.</td></tr>'}</tbody></table>
        </section>
      </div>
    </div>`;
    const tip = $('#chart-tip');
    $$('#chart .bar-col').forEach((col) => {
      col.addEventListener('mousemove', (e) => {
        const [d, i, o] = col.dataset.tip.split('|');
        tip.innerHTML = `<b>${esc(d)}</b><br>Masuk: ${i}<br>Keluar: ${o}`;
        tip.classList.remove('hidden'); tip.style.left = e.clientX + 12 + 'px'; tip.style.top = e.clientY - 40 + 'px';
      });
      col.addEventListener('mouseleave', () => tip.classList.add('hidden'));
    });
    if (S.isAdmin) loadCostCard();
    $('#chart-table-toggle').addEventListener('click', (e) => {
      const showTable = $('#chart-table').classList.toggle('hidden') === false;
      $('#chart-wrap').classList.toggle('hidden', showTable);
      e.target.textContent = showTable ? 'Grafik' : 'Tabel';
    });
  }

  /* ───────────── Meta Cost Monitor ───────────── */
  const COST_LABEL = { marketing: 'Marketing', utility: 'Utility', authentication: 'Authentication', authentication_international: 'Authentication (internasional)', service: 'Service', marketing_lite: 'Marketing Lite', referral_conversion: 'Referral (iklan klik-ke-WA)' };
  const RATE_CATS = ['marketing', 'utility', 'authentication', 'authentication_international', 'marketing_lite'];
  function fmtMoney(n, cur) {
    if (!cur) return fmtNum(Math.round(n * 100) / 100);
    try { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: cur, maximumFractionDigits: cur === 'IDR' ? 0 : 2 }).format(n); } catch (e) { return cur + ' ' + fmtNum(n); }
  }
  async function loadCostCard(month) {
    const el = $('#cost-card'); if (!el) return;
    S.costMonth = month || S.costMonth || new Date().toISOString().slice(0, 7);
    let c;
    try { c = await api('GET', '/api/costs?month=' + S.costMonth); } catch (e) { el.innerHTML = `<div class="p-4 text-xs danger-ink">${esc(e.message)}</div>`; return; }
    if (!$('#cost-card')) return;
    S.cost = c;
    const cur = c.currency, money = (n) => fmtMoney(n, cur);
    const budget = c.settings.budget, used = budget ? c.spent / budget : 0, pctUsed = Math.round(used * 100);
    const alertAt = (c.settings.alertPct || 80) / 100;
    const state = !budget ? null : used >= 1 ? { cls: 'badge-red', label: 'Melebihi anggaran', color: 'var(--danger)' } : used >= alertAt ? { cls: 'badge-amber', label: 'Mendekati batas', color: 'var(--warn)' } : { cls: 'badge-green', label: 'Aman', color: 'var(--accent)' };
    const projOver = budget && c.projected > budget;
    const badge = state && state.label === 'Aman' && projOver && c.isCurrent ? { cls: 'badge-amber', label: 'Proyeksi melebihi anggaran' } : state;
    const months = Array.from({ length: 6 }, (_, i) => { const d = new Date(); d.setUTCDate(1); d.setUTCMonth(d.getUTCMonth() - i); return d.toISOString().slice(0, 7); });
    const monthName = (m) => new Date(m + '-01T00:00:00Z').toLocaleDateString('id-ID', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const hasMeta = c.meta?.hasData;
    // Grafik harian: biaya resmi Meta bila ada, selain itu jumlah pesan berbayar dari webhook
    const series = hasMeta ? c.meta.daily.map((d) => ({ date: d.date, v: d.cost })) : c.webhook.daily.map((d) => ({ date: d.date, v: d.count }));
    const max = Math.max(...series.map((d) => d.v), 0) || 1;
    const fmtV = (n) => (hasMeta ? money(n) : fmtNum(n) + ' pesan');
    const cats = [...new Set([...Object.keys(c.webhook.byCategory), ...Object.keys(c.meta?.byCategory || {})])].sort((a, b) => (COST_LABEL[a] ? 0 : 1) - (COST_LABEL[b] ? 0 : 1) || a.localeCompare(b));
    const tileC = (label, value, sub, extra = '') => `<div class="surface-2 rounded-md p-3 min-w-0"><div class="text-[11px] ink-3">${label}</div><div class="text-lg font-semibold tracking-tight mt-0.5 truncate">${value}</div><div class="text-[11px] ink-3 mt-0.5 leading-snug">${sub}</div>${extra}</div>`;
    $('#cost-card').innerHTML = `
      <div class="card-h flex-wrap">
        <div class="min-w-0"><div class="card-t flex items-center gap-2">Meta Cost Monitor ${badge ? `<span class="badge ${badge.cls}"><span class="dot"></span>${badge.label}</span>` : ''}</div>
          <div class="text-[11px] ink-3">Biaya pesan WhatsApp Cloud API · ${cur ? esc(cur) : 'mata uang belum diketahui'}</div></div>
        <div class="flex items-center gap-2 flex-wrap">
          <select class="select h-8 text-xs w-40" id="cost-month" aria-label="Pilih bulan">${months.map((m) => `<option value="${m}" ${m === c.month ? 'selected' : ''}>${esc(monthName(m))}</option>`).join('')}</select>
          <button class="btn btn-sm" id="cost-sync" title="Ambil biaya resmi dari Meta">${ICON.refresh} Sinkronkan</button>
          <button class="btn btn-sm" id="cost-settings">${ICON.gear} Anggaran & tarif</button>
        </div>
      </div>
      <div class="p-4 space-y-4">
        ${c.meta?.error ? `<div class="rounded-md px-3 py-2 text-xs" style="background:var(--danger-soft);color:var(--danger)">Sinkronisasi gagal (${esc(fmtDT(c.meta.syncedAt))}): ${esc(c.meta.error)}</div>` : ''}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          ${tileC('Biaya resmi Meta', hasMeta ? money(c.meta.total) : '—', hasMeta ? `${fmtNum(c.meta.volume)} pesan · sinkron ${esc(fmtDT(c.meta.syncedAt))}` : c.meta ? 'Belum ada data dari Meta' : 'Klik Sinkronkan')}
          ${tileC('Estimasi realtime', Object.keys(c.settings.rates || {}).length ? money(c.webhook.estimate) : '—', Object.keys(c.settings.rates || {}).length ? `${fmtNum(c.webhook.billable)} pesan berbayar × tarif` : `${fmtNum(c.webhook.billable)} pesan berbayar · isi tarif`)}
          ${tileC('Anggaran bulan ini', budget ? `${pctUsed}%` : '—', budget ? `${money(c.spent)} dari ${money(budget)}` : 'Belum diatur',
            budget ? `<div class="h-1.5 rounded-full mt-2 overflow-hidden" style="background:var(--border)" role="progressbar" aria-valuenow="${pctUsed}" aria-valuemin="0" aria-valuemax="100" aria-label="Pemakaian anggaran"><div class="h-full rounded-full" style="width:${Math.min(100, pctUsed)}%;background:${state.color}"></div></div>` : '')}
          ${tileC(c.isCurrent ? 'Proyeksi akhir bulan' : 'Total bulan ini', c.spent || c.projected ? money(c.projected) : '—', c.isCurrent ? `hari ke-${c.daysElapsed} dari ${c.daysInMonth}${projOver ? ' · <span class="danger-ink">melebihi anggaran</span>' : ''}` : (c.spentSource === 'meta' ? 'dari data Meta' : 'dari estimasi'))}
        </div>
        <div>
          <div class="flex items-center justify-between mb-2"><div class="text-xs font-medium">${hasMeta ? 'Biaya per hari (Meta)' : 'Pesan berbayar per hari (webhook)'}</div><button class="btn btn-ghost btn-sm" id="cost-table-toggle">Tabel</button></div>
          <div id="cost-chart-wrap"><div class="bar-chart" style="height:120px" id="cost-chart" role="img" aria-label="${hasMeta ? 'Biaya per hari' : 'Pesan berbayar per hari'}">
            ${series.map((d) => `<div class="bar-col" data-tip="${esc(fmtDate(new Date(d.date)))}|${esc(fmtV(d.v))}"><div class="bar" style="max-width:14px;height:${(d.v / max) * 100}%;background:var(--accent)"></div></div>`).join('')}
          </div><div class="flex justify-between text-[10px] ink-3 mt-2 border-t bd pt-1.5"><span>1 ${esc(monthName(c.month))}</span><span>maks ${esc(fmtV(Math.max(...series.map((d) => d.v), 0)))}/hari</span><span>${c.daysInMonth}</span></div></div>
          <div id="cost-chart-table" class="hidden max-h-56 overflow-y-auto scroll-thin"><table class="tbl"><thead><tr><th>Tanggal</th><th class="text-right">${hasMeta ? 'Biaya' : 'Pesan berbayar'}</th></tr></thead><tbody>${series.map((d) => `<tr><td>${esc(fmtDate(new Date(d.date)))}</td><td class="text-right">${esc(fmtV(d.v))}</td></tr>`).join('')}</tbody></table></div>
        </div>
        <div class="overflow-x-auto border bd rounded-md"><table class="tbl"><thead><tr><th>Kategori</th><th class="text-right">Berbayar</th><th class="text-right">Gratis</th><th class="text-right">Tarif</th><th class="text-right">Estimasi</th><th class="text-right">Biaya Meta</th></tr></thead><tbody>
          ${cats.map((k) => { const w = c.webhook.byCategory[k] || { billable: 0, free: 0 }, mc = c.meta?.byCategory?.[k], rate = Number(c.settings.rates?.[k]) || 0;
            return `<tr><td>${esc(COST_LABEL[k] || k)}</td><td class="text-right">${fmtNum(w.billable)}</td><td class="text-right ink-3">${fmtNum(w.free)}</td><td class="text-right ink-3">${rate ? money(rate) : '—'}</td><td class="text-right">${rate ? money(w.billable * rate) : '—'}</td><td class="text-right">${mc ? money(mc.cost) : '—'}</td></tr>`; }).join('') || '<tr><td colspan="6" class="ink-3">Belum ada pesan dengan info biaya pada bulan ini.</td></tr>'}
        </tbody></table></div>
        <p class="hint">Biaya resmi diambil dari Meta Pricing Analytics: mencakup <b>semua</b> pesan dari WABA ini (termasuk yang dikirim di luar Kontaq) dan bisa tertunda dari Meta. Estimasi realtime menghitung pesan berbayar dari webhook status (pesan layanan dalam jendela 24 jam umumnya gratis) dikalikan tarif yang Anda isi; tarif resmi per negara ada di <a class="accent-ink underline" href="https://developers.facebook.com/docs/whatsapp/pricing" target="_blank" rel="noopener noreferrer">halaman harga Meta</a>.</p>
      </div>`;
    $('#cost-month').addEventListener('change', (e) => loadCostCard(e.target.value));
    $('#cost-sync').addEventListener('click', (e) => busy(e.currentTarget, async () => { const r = await api('POST', '/api/costs/sync', { month: c.month }); toast(`Sinkron: ${r.points} titik data dari Meta.`); }).then(() => loadCostCard()));
    $('#cost-settings').addEventListener('click', costSettingsModal);
    $('#cost-table-toggle').addEventListener('click', (e) => {
      const showTable = $('#cost-chart-table').classList.toggle('hidden') === false;
