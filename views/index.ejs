  const ATTACH = [
    ['document', 'Dokumen', 'doc', '#7f66ff'], ['media', 'Foto & video', 'image', '#007bfc'], ['camera', 'Kamera', 'camera', '#ff2e74'],
    ['audio', 'Audio', 'headphones', '#ff8a0c'], ['location', 'Lokasi', 'pin', '#1fa855'], ['contact', 'Kontak', 'user', '#009de2'],
