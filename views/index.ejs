    let timer; q.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(() => reload({ q: q.value.trim() }), 350); });
    $('#ml-from').addEventListener('change', (e) => reload({ from: e.target.value }));
    $('#ml-to').addEventListener('change', (e) => reload({ to: e.target.value }));
    $$('[data-ml]').forEach((s) => s.addEventListener('change', () => reload({ [s.dataset.ml]: s.value })));
    $('#ml-failed').addEventListener('change', (e) => reload({ failed: e.target.checked }));
    $$('[data-ml-status]').forEach((b) => b.addEventListener('click', () => reload({ status: st.status === b.dataset.mlStatus ? '' : b.dataset.mlStatus })));
