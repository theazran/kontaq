  }
  function campaignRow(c) {
    const done = c.total - (c.counts.queued || 0), pct = c.total ? Math.round((done / c.total) * 100) : 0;
    const sent = c.counts.sent + c.counts.delivered + c.counts.read;
    if (c.series) return campaignSeriesRow(c);
    return `<tr data-cid="${c.id}"><td class="font-medium">${esc(c.name)}${c.lastError ? `<div class="text-[11px] danger-ink truncate max-w-[14rem]" title="${esc(c.lastError)}">${esc(c.lastError)}</div>` : ''}</td>
      <td class="mono text-xs">${esc(c.templateName)}</td><td>${statusBadge(c.status)}${campaignWhen(c)}</td>
      <td class="w-32"><div class="h-1.5 rounded-full surface-2 overflow-hidden"><div class="h-full rounded-full" style="width:${pct}%;background:var(--accent)"></div></div><div class="text-[11px] ink-3 mt-0.5">${fmtNum(done)} / ${fmtNum(c.total)}</div></td>
      <td class="text-right">${fmtNum(sent)}</td><td class="text-right">${fmtNum(c.counts.delivered + c.counts.read)}</td><td class="text-right">${fmtNum(c.counts.read)}</td><td class="text-right ${c.counts.failed ? 'danger-ink' : ''}">${fmtNum(c.counts.failed)}</td>
      <td class="text-xs ink-3 whitespace-nowrap">${fmtDT(c.createdAt)}</td><td class="text-right"><button class="btn btn-sm" data-open="${c.id}">Detail</button></td></tr>`;
  }
  function campaignWhen(c) {
    if (c.status === 'scheduled') return `<div class="text-[11px] ink-3 mt-0.5 whitespace-nowrap">${ICON.clock.replace('<svg', '<svg width="10" height="10" style="display:inline;vertical-align:-1px"')} ${fmtTz(c.nextRunAt)}</div>`;
    if (c.waitingWindow) return `<div class="text-[11px] ink-3 mt-0.5 whitespace-nowrap">Menunggu jam kirim ${c.sendWindow.start.replace(':', '.')}</div>`;
    return '';
  }
  function campaignSeriesRow(c) {
    const last = c.runs?.[0];
    return `<tr data-cid="${c.id}"><td class="font-medium">${esc(c.name)} <span class="badge">Berulang</span><div class="text-[11px] ink-3">${esc(c.scheduleText)}</div>${c.lastError ? `<div class="text-[11px] danger-ink truncate max-w-[14rem]" title="${esc(c.lastError)}">${esc(c.lastError)}</div>` : ''}</td>
      <td class="mono text-xs">${esc(c.templateName)}</td><td>${statusBadge(c.status)}${campaignWhen(c)}</td>
      <td class="text-[11px] ink-3">${fmtNum(c.runCount || 0)}× dikirim${c.maxRuns ? ' / ' + c.maxRuns : ''}<div>±${fmtNum(c.previewTotal)} kontak per kirim</div></td>
      <td class="text-right" colspan="4">${last ? `<span class="text-[11px] ink-3">Terakhir: ${fmtNum(last.counts.sent + last.counts.delivered + last.counts.read)} terkirim · ${fmtNum(last.counts.read)} dibaca${last.counts.failed ? ` · <span class="danger-ink">${fmtNum(last.counts.failed)} gagal</span>` : ''}</span>` : '<span class="text-[11px] ink-3">Belum pernah dikirim</span>'}</td>
      <td class="text-xs ink-3 whitespace-nowrap">${fmtDT(c.createdAt)}</td><td class="text-right"><button class="btn btn-sm" data-open="${c.id}">Detail</button></td></tr>`;
  }
  async function campaignModal() {
