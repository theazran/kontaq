          <select class="select" id="cv-status-m" aria-label="Status percakapan">${[['open', 'Terbuka'], ['pending', 'Menunggu'], ['closed', 'Selesai']].map(([v, l]) => `<option value="${v}" ${c.status === v ? 'selected' : ''}>${l}</option>`).join('')}</select>
          <select class="select" id="cv-assign-m" aria-label="Tugaskan ke">${$('#cv-assign')?.innerHTML || ''}</select>
