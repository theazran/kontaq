    if (!p) {
      try { p = S.callProfile = await getProfile(c.contactId, true); } catch (e) { return; }
      if (S.call?.contactId !== c.contactId) return;
      if (!S.call.avatarV && p.contact.avatarV) return renderCallBar();
    }
    const el = $('#call-profile'); if (!el) return;
