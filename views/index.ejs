        ${callbackOk(k) ? `<button class="btn btn-accent btn-sm mt-3" data-act="callback" data-contact="${k.id}" data-name="${esc(k.name || k.waName || '')}" data-phone="${esc(k.phone)}" title="Telepon balik" aria-label="Telepon balik">${ICON.phone} Telepon balik</button>` : ''}
      </div>
      <div class="p-4 border-b bd"><div class="text-xs font-semibold mb-2">Profil pelanggan</div><div id="info-stats" class="text-xs space-y-1.5"><div class="ink-3">Memuat…</div></div></div>
      <div class="p-4 border-b bd" id="info-csat">${csatInfoHtml(c)}</div>
