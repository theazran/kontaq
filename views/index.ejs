            <p class="hint">Pintar: bila pegawai mengirim/membalas pesan ke nomor ini dalam 24 jam terakhir, pengingat dikirim sebagai pesan teks biasa; selain itu memakai template di bawah (WhatsApp mewajibkan template di luar jendela 24 jam).</p></div>
          <div id="att-text-box"><label class="label">Isi pesan teks</label><textarea class="input text-xs" name="text" rows="5" maxlength="4096">${esc(c.text)}</textarea>
            <p class="hint">Variabel: ${varHelp}. Nilai cadangan bila kosong: <span class="kbd">{{cs|default:Tim Kepegawaian}}</span>. Format WhatsApp: *tebal*, _miring_.</p>
            <div class="mt-3 rounded-lg p-3 space-y-3" style="background:var(--surface-2)">
              <div><label class="label">Tombol tambahan</label><select class="select" name="btnMode">${[['none', 'Tidak ada (teks biasa)'], ['link', 'Tombol link'], ['reply', 'Balasan cepat (maks. 3)']].map(([k, l]) => `<option value="${k}" ${c.button.mode === k ? 'selected' : ''}>${l}</option>`).join('')}</select>
                <p class="hint">WhatsApp tidak mengizinkan tombol link dan balasan cepat dalam satu pesan — pilih salah satu.</p></div>
              <div data-btn-for="link" class="grid sm:grid-cols-3 gap-3">
                <div><label class="label">Label tombol</label><input class="input text-xs" name="btnText" maxlength="20" value="${esc(c.button.text)}" placeholder="Login SIKEP"></div>
                <div class="sm:col-span-2"><label class="label">URL (https)</label><input class="input mono text-xs" name="btnUrl" value="${esc(c.button.url)}" placeholder="https://sikep.mahkamahagung.go.id/site/login"></div>
              </div>
              <div data-btn-for="reply" class="grid sm:grid-cols-3 gap-3">${[0, 1, 2].map((i) => `<div><label class="label">Balasan ${i + 1}${i ? ' (opsional)' : ''}</label><input class="input text-xs" name="btnReply${i}" maxlength="20" value="${esc(c.button.replies[i] || '')}" placeholder="${['Sudah presensi', 'Izin / Cuti', 'Dinas luar'][i]}"></div>`).join('')}</div>
              <div data-btn-for="link reply" class="grid gap-3">
                <div><label class="label">Header (opsional, maks. 60)</label><input class="input text-xs" name="btnHeader" maxlength="60" value="${esc(c.button.header || '')}" placeholder="BELUM PRESENSI {{JENIS}}"></div>
                <div><label class="label">Footer (opsional, maks. 60)</label><input class="input text-xs" name="btnFooter" maxlength="60" value="${esc(c.button.footer || '')}" placeholder="Dibalas oleh {{cs|default:Tim Kepegawaian}}"></div>
                <p class="hint">Teks maks. 1024 karakter bila memakai tombol; label tombol maks. 20. Header/footer & URL boleh memakai variabel (URL: {{nip}} dst.). Bila judul dipindah ke header, hapus baris judul dari isi pesan agar tidak dobel. Balasan pegawai masuk ke Inbox (dan membuka jendela 24 jam). Template tidak terpengaruh — tombolnya diatur saat mengajukan template ke Meta.</p>
              </div>
            </div></div>
        </div></section>
        <section class="card"><div class="card-h"><div class="card-t">Template pesan</div></div><div class="p-4 space-y-3">
          <div class="grid sm:grid-cols-3 gap-3">
            <div class="sm:col-span-2"><label class="label">Nama template</label><select class="select" id="att-tpl-name"></select></div>
            <div><label class="label">Bahasa</label><select class="select" id="att-tpl-lang"></select></div>
          </div>
          <div id="att-tpl-vars" class="space-y-3"></div>
        </div></section>
        <section class="card"><div class="card-h"><div class="card-t">Jadwal kirim otomatis</div></div><div class="p-4 space-y-4">
          ${Object.entries(ATT_TYPE).map(([k, l]) => `<div>
            <div class="flex items-center gap-3"><div class="flex-1"><div class="font-medium">Belum presensi ${l.toLowerCase()}</div><div class="text-[11px] ink-3">Dikirim ke pegawai yang belum presensi ${l.toLowerCase()} pada jam berikut.</div></div>
              <label class="switch ${f.schedule[k].enabled ? 'on' : ''}"><input type="checkbox" class="sr-only" data-sch-on="${k}" ${f.schedule[k].enabled ? 'checked' : ''} role="switch" aria-label="Aktifkan jadwal ${l}"><span></span></label></div>
            <div id="att-sch-${k}" class="mt-1"></div></div>`).join('<div class="border-t bd"></div>')}
          <p class="hint">Jam mengikuti zona waktu ${esc(c.timezone)} (Auto reply › jam kerja). Jadwal yang terlewat lebih dari 60 menit (mis. server mati) tidak dikirim.</p>
        </div></section>
      </div>
      <div class="lg:col-span-2 space-y-4">
        <section class="card"><div class="card-h"><div class="card-t">Hari libur</div></div><div class="p-4 space-y-3">
          <p class="text-xs ink-3">Pada tanggal ini pengingat tidak dikirim otomatis (mis. libur nasional, cuti bersama). Kirim manual tetap bisa.</p>
          <div class="flex gap-2"><input type="date" class="input h-8 text-xs flex-1" id="att-skip-date" aria-label="Tanggal libur"><button type="button" class="btn btn-sm" id="att-skip-add">${ICON.plus}<span>Tambah</span></button></div>
          <div id="att-skip-list" class="flex flex-wrap gap-1"></div>
        </div></section>
        <section class="card"><div class="card-h"><div class="card-t">Pegawai</div></div><div class="p-4 space-y-3">
          <label class="flex items-start gap-3"><span class="switch ${c.defaultNotify ? 'on' : ''}"><input type="checkbox" class="sr-only" name="defaultNotify" ${c.defaultNotify ? 'checked' : ''} role="switch" aria-label="Notifikasi aktif untuk pegawai baru"><span></span></span><span class="text-xs"><span class="font-medium block text-[13px]">Pegawai baru otomatis menerima notifikasi</span><span class="ink-3">Berlaku untuk pegawai yang belum pernah diatur. Atur per pegawai di tab Pegawai.</span></span></label>
        </div></section>
        <section class="card"><div class="card-h"><div class="card-t">Sumber data</div></div><div class="p-4 space-y-3">
          <div><label class="label">URL API presensi hari ini</label><input class="input mono text-xs" name="absensiUrl" value="${esc(c.absensiUrl)}" required></div>
          <div><label class="label">URL data pegawai</label><input class="input mono text-xs" name="pegawaiUrl" value="${esc(c.pegawaiUrl)}" required></div>
          <p class="hint">${fmtNum(c.directoryCount)} pegawai tersimpan${c.directoryAt ? ', diperbarui ' + esc(fmtDT(c.directoryAt)) : ''}. Dari data pegawai hanya NIP, nama, jabatan, dan nomor HP yang disimpan. Dicocokkan dengan presensi lewat NIP.</p>
          ${c.directoryError ? `<p class="text-xs danger-ink">${esc(c.directoryError)}</p>` : ''}
          <button type="button" class="btn btn-sm w-full" id="att-dir-refresh">${ICON.refresh}<span>Muat ulang data pegawai</span></button>
        </div></section>
      </div>
      <div class="lg:col-span-5 flex flex-wrap justify-end gap-2"><a class="btn" href="#/settings/addons">Kelola add-on</a><button class="btn btn-primary" type="submit">Simpan pengaturan</button></div>
    </form>`;
    const syncRouting = () => $('#att-text-box').classList.toggle('hidden', $('#att-form').routing.value !== 'smart');
    $('#att-form').routing.addEventListener('change', syncRouting); syncRouting();
    const syncBtn = () => { const m = $('#att-form').btnMode.value; $$('[data-btn-for]').forEach((x) => x.classList.toggle('hidden', !x.dataset.btnFor.split(' ').includes(m))); };
    $('#att-form').btnMode.addEventListener('change', syncBtn); syncBtn();
    renderTpl(); renderSched('datang'); renderSched('pulang'); renderSkip();
    $('#att-tpl-name').addEventListener('change', (ev) => { f.template = { name: ev.target.value, language: '', header: [], body: [] }; renderTpl(); });
    $('#att-tpl-lang').addEventListener('change', (ev) => { f.template.language = ev.target.value; renderTpl(); });
    $$('#att-form .switch input').forEach((i) => i.addEventListener('change', () => i.closest('.switch').classList.toggle('on', i.checked)));
    $$('[data-sch-on]').forEach((i) => i.addEventListener('change', () => { f.schedule[i.dataset.schOn].enabled = i.checked; }));
    $('#att-skip-add').addEventListener('click', () => {
      const d = $('#att-skip-date').value;
      if (d && !f.skipDates.includes(d)) { f.skipDates = [...f.skipDates, d].sort(); renderSkip(); }
      $('#att-skip-date').value = '';
    });
    $('#att-dir-refresh').addEventListener('click', (ev) => busy(ev.currentTarget, async () => {
      const d = await attLoadEmployees(true);
      if (d.directoryError) throw new Error(d.directoryError);
      toast(`Data pegawai diperbarui (${d.employees.filter((e) => e.inDirectory).length} pegawai).`);
      viewAttendance('settings');
    }));
    $('#att-form').addEventListener('submit', (ev) => { ev.preventDefault(); busy(ev.submitter, async () => {
      const fd = ev.target;
      S.att.cfg = await api('PUT', '/api/addons/attendance/config', {
        absensiUrl: fd.absensiUrl.value, pegawaiUrl: fd.pegawaiUrl.value, defaultNotify: fd.defaultNotify.checked,
        template: f.template, schedule: f.schedule, skipDates: f.skipDates, routing: fd.routing.value, text: fd.text.value,
        button: { mode: fd.btnMode.value, text: fd.btnText.value, url: fd.btnUrl.value, header: fd.btnHeader.value, footer: fd.btnFooter.value,
          replies: [0, 1, 2].map((i) => fd['btnReply' + i].value.trim()).filter(Boolean) },
      });
      S.att.emp = null; toast('Pengaturan disimpan.'); viewAttendance('settings');
    }); });
  }

  function viewSettings(tab) {
    const tabs = [S.isAdmin && ['meta', 'Koneksi Meta'], S.isAdmin && ['team', 'Tim CS'], S.isAdmin && ['gateway', 'Gateway WA'], S.isAdmin && ['addons', 'Add-on'], ['security', 'Notifikasi & keamanan'], S.isAdmin && ['audit', 'Audit log']].filter(Boolean);
    const cur = tabs.some((t) => t[0] === tab) ? tab : tabs[0][0];
    $('#view').innerHTML = `<div class="p-4 md:p-6 max-w-5xl space-y-4"><nav class="tabs">${tabs.map(([k, l]) => `<a href="#/settings/${k}" class="tab ${k === cur ? 'active' : ''}">${l}</a>`).join('')}</nav><div id="set-body"></div></div>`;
    ({ meta: setMeta, team: setTeam, gateway: setGateway, addons: setAddons, security: setSecurity, audit: setAudit })[cur]();
  }
  async function setMeta() {
