        <div id="cl-cards" class="sm:hidden"></div>
        <table class="tbl hidden sm:table"><thead><tr><th>Waktu</th><th>Kontak</th><th>Arah</th><th>Status</th><th>Durasi</th><th>Diangkat oleh</th></tr></thead><tbody id="cl-rows"><tr><td colspan="6" class="ink-3">Memuat…</td></tr></tbody></table></section>
    </div>`;
    loadCallbacks();
    api('GET', '/api/calls').then((rows) => {
