      closeModal(); toast(`Template diajukan. Status: ${r.status || 'PENDING'}`);
      S.templates.loaded = false; viewTemplates(true);
    }));
  }

  /* ───────────── Campaign ───────────── */
  async function viewCampaigns() {
    const v = $('#view');
    let rows;
    try { rows = await api('GET', '/api/campaigns'); } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (S.view !== 'campaigns') return;
    S.campaigns = rows;
    v.innerHTML = `<div class="p-4 md:p-6 max-w-7xl space-y-3">
      <div class="flex items-center gap-2"><p class="text-xs ink-3 flex-1">Campaign mengirim template APPROVED ke kontak terpilih melalui antrean (${BOOT.campaignRate} pesan/detik). Patuhi kebijakan opt-in WhatsApp.</p>
      <button class="btn btn-primary" id="cp-new">${ICON.plus} Campaign baru</button></div>
      <div class="card overflow-x-auto"><table class="tbl"><thead><tr><th>Nama</th><th>Template</th><th>Status</th><th>Progres</th><th class="text-right">Terkirim</th><th class="text-right">Diterima</th><th class="text-right">Dibaca</th><th class="text-right">Gagal</th><th>Dibuat</th><th></th></tr></thead>
      <tbody id="cp-rows">${rows.map(campaignRow).join('') || '<tr><td colspan="10"><div class="empty">Belum ada campaign.</div></td></tr>'}</tbody></table></div>
    </div>`;
    $('#cp-new').addEventListener('click', campaignModal);
    $('#cp-rows').addEventListener('click', (e) => { const b = e.target.closest('[data-open]'); if (b) campaignDetail(b.dataset.open); });
  }
  function campaignRow(c) {
    const done = c.total - (c.counts.queued || 0), pct = c.total ? Math.round((done / c.total) * 100) : 0;
    const sent = c.counts.sent + c.counts.delivered + c.counts.read;
    return `<tr data-cid="${c.id}"><td class="font-medium">${esc(c.name)}${c.lastError ? `<div class="text-[11px] danger-ink truncate max-w-[14rem]" title="${esc(c.lastError)}">${esc(c.lastError)}</div>` : ''}</td>
      <td class="mono text-xs">${esc(c.templateName)}</td><td>${statusBadge(c.status)}</td>
      <td class="w-32"><div class="h-1.5 rounded-full surface-2 overflow-hidden"><div class="h-full rounded-full" style="width:${pct}%;background:var(--accent)"></div></div><div class="text-[11px] ink-3 mt-0.5">${fmtNum(done)} / ${fmtNum(c.total)}</div></td>
      <td class="text-right">${fmtNum(sent)}</td><td class="text-right">${fmtNum(c.counts.delivered + c.counts.read)}</td><td class="text-right">${fmtNum(c.counts.read)}</td><td class="text-right ${c.counts.failed ? 'danger-ink' : ''}">${fmtNum(c.counts.failed)}</td>
      <td class="text-xs ink-3 whitespace-nowrap">${fmtDT(c.createdAt)}</td><td class="text-right"><button class="btn btn-sm" data-open="${c.id}">Detail</button></td></tr>`;
  }
  async function campaignModal() {
    const tpls = (await ensureTemplates().catch(() => [])).filter((t) => t.status === 'APPROVED');
    const labels = (await api('GET', '/api/contacts?page=1').catch(() => ({ labels: [] }))).labels;
    if (!tpls.length) return modal('Campaign baru', '<div class="empty">Belum ada template APPROVED. Sinkronkan template di menu Template.</div>');
    modal('Campaign baru', `<form id="f-cp" class="grid md:grid-cols-2 gap-4">
      <div class="space-y-3">
        <div><label class="label">Nama campaign</label><input class="input" name="name" required maxlength="120"></div>
        <div><label class="label">Template</label><select class="select" name="tpl">${tpls.map((t, i) => `<option value="${i}">${esc(t.name)} · ${esc(t.language)} · ${esc(t.category)}</option>`).join('')}</select></div>
        <div id="cp-fields" class="space-y-3"></div>
        <div><label class="label">Target label (kosong = semua kontak)</label><div class="flex flex-wrap gap-x-3 gap-y-1.5">${labels.map((l) => `<label class="flex items-center gap-1.5 text-xs"><input type="checkbox" class="check" name="label" value="${esc(l)}">${esc(l)}</label>`).join('') || '<span class="text-xs ink-3">Belum ada label.</span>'}</div></div>
        <label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" name="optInOnly" checked> Hanya kontak yang sudah opt-in</label>
      </div>
      <div><div class="label">Pratinjau (contoh)</div><div id="cp-prev"></div><p class="hint mt-3">Campaign dibuat sebagai draf. Anda dapat meninjau jumlah penerima sebelum memulai.</p></div>
    </form>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="cp-go">Buat draf</button>' });
    const f = $('#f-cp'), cur = () => tpls[f.tpl.value];
    const draw = () => { $('#cp-fields').innerHTML = tplFieldsHtml(cur(), { campaign: true }); $('#cp-prev').innerHTML = tplPreview(cur(), f); };
    f.tpl.addEventListener('change', draw);
    f.addEventListener('input', (e) => { if (e.target.name !== 'tpl') $('#cp-prev').innerHTML = tplPreview(cur(), f); });
    draw();
    $('#cp-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!f.reportValidity()) return;
      const t = cur();
      const c = await api('POST', '/api/campaigns', { name: f.name.value, templateName: t.name, language: t.language, values: readTplValues(t, f), labels: $$('input[name=label]:checked', f).map((x) => x.value), optInOnly: f.optInOnly.checked });
      closeModal(); toast(`Draf dibuat: ${c.total} penerima.`); await viewCampaigns(); campaignDetail(c.id);
    }));
  }
  async function campaignDetail(id) {
    let c; try { c = await api('GET', `/api/campaigns/${id}`); } catch (e) { return fail(e); }
    const act = (a, label, cls = '') => `<button class="btn ${cls}" data-cact="${a}">${label}</button>`;
    modal(c.name, `<div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2 text-xs">${statusBadge(c.status)}<span class="ink-3">Template <span class="mono">${esc(c.templateName)}</span> · ${esc(c.language)}</span><span class="ink-3">· ${c.labels.length ? 'Label: ' + esc(c.labels.join(', ')) : 'Semua kontak'}${c.optInOnly ? ' · opt-in saja' : ''}</span></div>
      ${c.lastError ? `<div class="text-xs danger-ink">${esc(c.lastError)}</div>` : ''}
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">${[['Total', c.total], ['Antre', c.counts.queued], ['Terkirim', c.counts.sent], ['Diterima', c.counts.delivered], ['Dibaca', c.counts.read], ['Gagal', c.counts.failed]].map(([l, n]) => `<div class="card p-2.5"><div class="text-[11px] ink-3">${l}</div><div class="text-lg font-semibold">${fmtNum(n)}</div></div>`).join('')}</div>
      <div class="card overflow-hidden max-h-72 overflow-y-auto scroll-thin"><table class="tbl"><thead><tr><th>Nomor</th><th>Nama</th><th>Status</th><th>Keterangan</th></tr></thead><tbody>
        ${c.recipients.map((r) => `<tr><td class="mono text-xs">+${esc(r.phone)}</td><td>${esc(r.name)}</td><td>${statusBadge(r.status)}</td><td class="text-[11px] danger-ink">${esc(r.error || '')}</td></tr>`).join('')}
      </tbody></table></div>${c.total > 1000 ? '<p class="hint">Menampilkan 1.000 penerima pertama. Unduh CSV untuk laporan lengkap.</p>' : ''}
    </div>`, { wide: true, footer: `<a class="btn" href="/api/campaigns/${c.id}/export.csv">Unduh laporan CSV</a><div class="flex-1"></div>
      ${['draft', 'paused'].includes(c.status) ? act('start', c.status === 'draft' ? 'Mulai kirim' : 'Lanjutkan', 'btn-primary') : ''}${c.status === 'running' ? act('pause', 'Jeda') : ''}${!['done', 'cancelled'].includes(c.status) ? act('cancel', 'Batalkan', 'btn-danger') : ''}` });
    $$('[data-cact]').forEach((b) => b.addEventListener('click', async () => {
      const a = b.dataset.cact;
      if (a === 'start' && !(await confirmBox(`Kirim template "${c.templateName}" ke ${c.counts.queued} kontak? Pesan template berbayar sesuai tarif Meta.`, 'Kirim'))) return campaignDetail(id);
      if (a === 'cancel' && !(await confirmBox('Batalkan campaign? Penerima yang masih antre akan dilewati.', 'Batalkan', true))) return campaignDetail(id);
      busy(b, async () => { await api('POST', `/api/campaigns/${id}/${a}`); campaignDetail(id); if (S.view === 'campaigns') viewCampaigns(); });
