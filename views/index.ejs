      <div class="p-4 space-y-2"><p class="text-xs ink-2">Komponen ini tidak didukung editor visual dan disalin apa adanya ke Flow JSON.</p><pre class="json-editor surface-2 rounded p-2 text-[11px]" style="min-height:0;max-height:16rem">${esc(JSON.stringify(c.p.json, null, 2))}</pre></div>`;
