          <div class="min-w-0 flex-1"><div class="font-medium truncate">${esc(c.name || c.waName || '—')}</div>
            <div class="text-xs ink-3 mono">+${esc(c.phone)}</div>
            <div class="flex flex-wrap gap-1 mt-1">${c.optIn ? '<span class="badge badge-green">Opt-in</span>' : ''}${(c.labels || []).map((l) => `<span class="badge">${esc(l)}</span>`).join('')}</div></div>
