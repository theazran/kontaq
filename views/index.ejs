    $$('[data-ao-toggle]', el).forEach((i) => i.addEventListener('change', () => busy(null, async () => {
      i.closest('.switch').classList.toggle('on', i.checked);
      try { done(await api('POST', `/api/addons/${i.dataset.aoToggle}/${i.checked ? 'enable' : 'disable'}`)); toast(i.checked ? 'Add-on diaktifkan.' : 'Add-on dinonaktifkan.'); }
      catch (e) { setAddons(); throw e; }
    })));
    $$('[data-ao-delete]', el).forEach((b) => b.addEventListener('click', async () => {
      const a = list.find((x) => x.id === b.dataset.aoDelete);
      if (!await confirmBox(`Hapus add-on "${a.name}"? Seluruh pengaturan, status notifikasi per pegawai, dan riwayat pengiriman akan dihapus. Add-on dapat dipasang lagi kapan saja.`, 'Hapus add-on', true)) return;
      busy(b, async () => { done(await api('DELETE', `/api/addons/${a.id}`)); toast('Add-on dihapus.'); });
    }));
  }

  /* ───────────── Add-on: Pengingat absensi ───────────── */
  const ATT_DAYS = [[1, 'Sen'], [2, 'Sel'], [3, 'Rab'], [4, 'Kam'], [5, 'Jum'], [6, 'Sab'], [0, 'Min']];
  const ATT_TYPE = { datang: 'Datang', pulang: 'Pulang' };
  const attDaysText = (days) => {
    const d = [...days].sort((a, b) => ((a + 6) % 7) - ((b + 6) % 7));
    const names = d.map((x) => ATT_DAYS.find((y) => y[0] === x)[1]);
    const run = d.length > 2 && d.every((x, i) => i === 0 || (x + 6) % 7 === ((d[i - 1] + 6) % 7) + 1);
    return run ? `${names[0]}–${names[names.length - 1]}` : names.join(', ');
  };
  const attSchedText = (s) => (s.enabled && s.slots.length ? s.slots.map((x) => `${attDaysText(x.days)} ${x.time.replace(':', '.')}`).join(' · ') : 'Nonaktif');
  // Jendela layanan 24 jam: di mode pintar pengingat dikirim sebagai teks biasa (tanpa template)
  const attWinBadge = (e) => (e.windowOpen ? `<span class="badge badge-green" title="Jendela 24 jam terbuka sampai ${esc(fmtDT(e.windowExpiresAt))}">Teks · s.d. ${esc(fmtTime(e.windowExpiresAt))}</span>` : '');
  const attTime = (v) => (v && v !== '-' ? esc(String(v).slice(0, 5).replace(':', '.')) : '<span class="ink-3">—</span>');

  async function viewAttendance(tab) {
    const v = $('#view'), tok = location.hash;
    const cur = ['employees', 'history', 'settings'].includes(tab) ? tab : 'employees';
    if (!S.att) S.att = { q: '', filter: 'all', emp: null };
    v.innerHTML = '<div class="p-4 md:p-6"><div class="card p-4 text-xs ink-3">Memuat…</div></div>';
    let cfg; try { cfg = await api('GET', '/api/addons/attendance/config'); } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (location.hash !== tok) return;
    S.att.cfg = cfg; S.att.tab = cur; S.att.emp = null;
    const ts = cfg.templateStatus;
    const warn = (html) => `<div class="card p-3 flex flex-wrap items-center gap-3" style="background:var(--warn-soft);border-color:transparent"><span class="w-4 h-4 block" style="color:var(--warn)">${ICON.info}</span><div class="flex-1 min-w-0 text-[13px]">${html}</div></div>`;
    v.innerHTML = `<div class="p-4 md:p-6 space-y-4 max-w-6xl">
      ${!ts ? warn(`Template <b class="mono">${esc(cfg.template.name)}</b> belum ditemukan. Sinkronkan di menu <a class="underline" href="#/templates">Template</a> setelah disetujui Meta.`)
        : ts.status !== 'APPROVED' ? warn(`Template <b class="mono">${esc(cfg.template.name)}</b> berstatus <b>${esc(ts.status)}</b>. Pengingat baru dapat dikirim setelah template APPROVED.`) : ''}
      <div class="flex flex-wrap items-end gap-3">
        <nav class="tabs flex-1 min-w-[16rem]">${[['employees', 'Pegawai'], ['history', 'Riwayat kirim'], ['settings', 'Pengaturan']].map(([k, l]) => `<a href="#/attendance/${k}" class="tab ${k === cur ? 'active' : ''}">${l}</a>`).join('')}</nav>
        <div class="flex gap-2 pb-1">${Object.entries(ATT_TYPE).map(([k, l]) => `<button class="btn btn-sm" data-att-send="${k}">${ICON.send}<span>Kirim manual · ${l}</span></button>`).join('')}</div>
      </div>
      <div class="text-xs ink-3 flex flex-wrap gap-x-4 gap-y-1">${Object.entries(ATT_TYPE).map(([k, l]) => `<span>${l}: <b class="ink-2">${esc(attSchedText(cfg.schedule[k]))}</b></span>`).join('')}<span>Zona waktu: ${esc(cfg.timezone)}</span>${cfg.skipDates.includes(cfg.today) ? '<span class="badge badge-amber">Hari ini libur — tidak dikirim otomatis</span>' : ''}</div>
      <div id="att-body"></div></div>`;
    $$('[data-att-send]', v).forEach((b) => b.addEventListener('click', () => attSendModal(b.dataset.attSend)));
    ({ employees: attEmployees, history: attHistory, settings: attSettings })[cur]();
  }

  async function attLoadEmployees(refresh) {
    S.att.emp = await api('GET', '/api/addons/attendance/employees' + (refresh ? '?refresh=1' : ''));
    return S.att.emp;
  }
  async function attEmployees(refresh) {
    const el = $('#att-body'), tok = location.hash;
    if (!S.att.emp || refresh !== undefined) {
      el.innerHTML = '<div class="card p-4 text-xs ink-3">Mengambil data pegawai & presensi hari ini…</div>';
      try { await attLoadEmployees(refresh); } catch (e) { el.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
      if (location.hash !== tok) return;
    }
    const d = S.att.emp, list = d.employees, hasAbs = !d.absensiError;
    const n = (f) => list.filter(f).length;
    const tile = (label, value, sub) => `<div class="card p-4"><div class="text-xs ink-3">${label}</div><div class="text-2xl font-semibold tracking-tight mt-1">${value}</div>${sub ? `<div class="text-[11px] ink-3 mt-0.5">${sub}</div>` : ''}</div>`;
    const FILTERS = { all: 'Semua pegawai', datang: 'Belum presensi datang', pulang: 'Belum presensi pulang', off: 'Notifikasi mati', nophone: 'Tanpa nomor WA' };
    const match = (e) => {
      const q = S.att.q.toLowerCase();
      if (q && !`${e.nama} ${e.nip} ${e.jabatan} ${e.waPhone}`.toLowerCase().includes(q)) return false;
      return { all: true, datang: e.presensi?.belum.datang, pulang: e.presensi?.belum.pulang, off: !e.notify, nophone: !e.waPhone }[S.att.filter];
    };
    const rows = list.filter(match);
    el.innerHTML = `<div class="space-y-4">
      ${d.absensiError ? `<div class="card p-3 text-[13px]" style="background:var(--danger-soft);border-color:transparent;color:var(--danger)">Presensi hari ini tidak dapat diambil: ${esc(d.absensiError)}</div>` : ''}
      ${d.directoryError ? `<div class="card p-3 text-[13px]" style="background:var(--warn-soft);border-color:transparent">Data pegawai tidak dapat diperbarui (${esc(d.directoryError)}). Memakai salinan terakhir${d.directoryAt ? ' ' + esc(fmtDT(d.directoryAt)) : ''}.</div>` : ''}
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        ${tile('Pegawai', fmtNum(list.length), `${fmtNum(n((e) => e.waPhone))} punya nomor WA`)}
        ${tile('Belum presensi datang', hasAbs ? fmtNum(n((e) => e.presensi?.belum.datang)) : '—', `${fmtNum(n((e) => e.sentToday.datang))} sudah diingatkan`)}
        ${tile('Belum presensi pulang', hasAbs ? fmtNum(n((e) => e.presensi?.belum.pulang)) : '—', `${fmtNum(n((e) => e.sentToday.pulang))} sudah diingatkan`)}
        ${tile('Notifikasi aktif', fmtNum(n((e) => e.notify)), `${fmtNum(n((e) => !e.notify))} dimatikan`)}
      </div>
      <section class="card">
        <div class="flex flex-wrap items-center gap-2 p-3 border-b bd">
          <input class="input h-8 text-xs flex-1 min-w-[12rem]" id="att-q" placeholder="Cari nama, NIP, jabatan, nomor…" value="${esc(S.att.q)}">
          <select class="select h-8 text-xs w-48" id="att-filter" aria-label="Filter">${Object.entries(FILTERS).map(([k, l]) => `<option value="${k}" ${S.att.filter === k ? 'selected' : ''}>${l}</option>`).join('')}</select>
          <button class="btn btn-sm" id="att-all-on" title="Nyalakan notifikasi semua pegawai">${ICON.bell}<span>Semua aktif</span></button>
          <button class="btn btn-sm" id="att-all-off" title="Matikan notifikasi semua pegawai">${ICON.bellOff}<span>Semua mati</span></button>
          <button class="btn btn-sm btn-icon" id="att-refresh" title="Muat ulang presensi & data pegawai" aria-label="Muat ulang">${ICON.refresh}</button>
        </div>
        <div class="overflow-x-auto"><table class="tbl"><thead><tr><th>Pegawai</th><th>WhatsApp</th><th>Presensi hari ini</th><th>Diingatkan hari ini</th><th class="text-center">Notifikasi</th><th class="text-right">Kirim</th></tr></thead><tbody>
        ${rows.map((e) => `<tr>
          <td class="min-w-[14rem]"><div class="font-medium">${esc(e.nama)}</div><div class="text-[11px] ink-3">${e.jabatan ? esc(e.jabatan) + ' · ' : ''}<span class="mono">${esc(e.nip)}</span>${e.inDirectory ? '' : ' · <span class="danger-ink">tidak ada di data pegawai</span>'}</div></td>
          <td class="whitespace-nowrap"><button class="btn btn-ghost btn-sm" data-att-phone="${esc(e.nip)}" title="Ubah nomor WhatsApp">${e.waPhone ? `<span class="mono">+${esc(e.waPhone)}</span>` : '<span class="danger-ink">Belum ada</span>'}${e.phoneOverride ? ' <span class="badge">manual</span>' : ''}<span class="w-3.5 h-3.5 block ink-3">${ICON.edit}</span></button>${attWinBadge(e)}<div class="text-[11px] ink-3 px-2">CS: ${e.cs ? `<a class="underline" href="#/inbox/${esc(e.conversationId)}">${esc(e.cs)}</a>` : 'belum ditugaskan'}</div></td>
          <td class="whitespace-nowrap text-xs">${e.presensi ? `<div>${esc(e.presensi.status)}</div><div class="ink-3">Datang ${e.presensi.belum.datang ? '<span class="danger-ink">belum</span>' : attTime(e.presensi.jamMasuk)} · Pulang ${e.presensi.belum.pulang ? '<span class="danger-ink">belum</span>' : attTime(e.presensi.jamPulang)}</div>` : '<span class="ink-3">—</span>'}</td>
          <td class="whitespace-nowrap text-xs">${Object.entries(ATT_TYPE).filter(([k]) => e.sentToday[k]).map(([k, l]) => `<span class="badge badge-green">${l} ${esc(fmtTime(e.sentToday[k]))}</span>`).join(' ') || '<span class="ink-3">—</span>'}</td>
          <td class="text-center"><label class="switch ${e.notify ? 'on' : ''}" title="Notifikasi pengingat"><input type="checkbox" class="sr-only" data-att-notify="${esc(e.nip)}" ${e.notify ? 'checked' : ''} role="switch" aria-label="Notifikasi ${esc(e.nama)}"><span></span></label></td>
          <td class="text-right whitespace-nowrap">${Object.entries(ATT_TYPE).map(([k, l]) => `<button class="btn btn-sm" data-att-one="${k}" data-nip="${esc(e.nip)}" ${e.presensi?.belum[k] ? '' : 'disabled'} title="${e.presensi?.belum[k] ? 'Kirim pengingat presensi ' + k : 'Sudah presensi ' + k}">${l}</button>`).join(' ')}</td>
        </tr>`).join('') || `<tr><td colspan="6" class="empty">${list.length ? 'Tidak ada pegawai yang cocok.' : 'Belum ada data pegawai.'}</td></tr>`}
        </tbody></table></div>
        <div class="px-3 py-2 border-t bd text-[11px] ink-3">Data pegawai diperbarui ${d.directoryAt ? esc(fmtDT(d.directoryAt)) : '—'} · Presensi diambil langsung saat halaman dimuat. Pengingat terjadwal hanya dikirim ke pegawai dengan notifikasi aktif.</div>
      </section></div>`;
    let qt;
    $('#att-q').addEventListener('input', (ev) => { clearTimeout(qt); qt = setTimeout(() => { S.att.q = ev.target.value; attEmployees(); $('#att-q').focus(); $('#att-q').setSelectionRange(S.att.q.length, S.att.q.length); }, 250); });
    $('#att-filter').addEventListener('change', (ev) => { S.att.filter = ev.target.value; attEmployees(); });
    $('#att-refresh').addEventListener('click', () => attEmployees(true));
    [['#att-all-on', true], ['#att-all-off', false]].forEach(([id, on]) => $(id).addEventListener('click', async (ev) => {
      if (!await confirmBox(on ? 'Nyalakan notifikasi pengingat untuk semua pegawai?' : 'Matikan notifikasi pengingat untuk semua pegawai? Pengingat terjadwal tidak akan terkirim ke siapa pun.', on ? 'Nyalakan semua' : 'Matikan semua', !on)) return;
      busy(ev.currentTarget, async () => { await api('POST', '/api/addons/attendance/employees/notify-all', { notify: on }); toast('Notifikasi diperbarui.'); attEmployees(false); });
    }));
    $$('[data-att-notify]', el).forEach((i) => i.addEventListener('change', async () => {
      const e = list.find((x) => x.nip === i.dataset.attNotify);
      i.closest('.switch').classList.toggle('on', i.checked);
      try { const r = await api('PUT', `/api/addons/attendance/employees/${e.nip}`, { notify: i.checked }); e.notify = r.notify; }
      catch (err) { i.checked = !i.checked; i.closest('.switch').classList.toggle('on', i.checked); fail(err); }
    }));
    $$('[data-att-phone]', el).forEach((b) => b.addEventListener('click', () => attPhoneModal(list.find((x) => x.nip === b.dataset.attPhone))));
    $$('[data-att-one]', el).forEach((b) => b.addEventListener('click', () => attSendModal(b.dataset.attOne, [b.dataset.nip])));
  }

  function attPhoneModal(e) {
    modal('Nomor WhatsApp pegawai', `<form id="att-ph" class="space-y-3">
      <div><div class="font-medium">${esc(e.nama)}</div><div class="text-xs ink-3 mono">${esc(e.nip)}</div></div>
      <div><label class="label">Nomor dari data pegawai</label><div class="mono text-xs">${e.phone ? '+' + esc(e.phone) : '<span class="ink-3">Tidak ada</span>'}</div></div>
      <div><label class="label">Nomor WhatsApp pengganti (opsional)</label><input class="input mono" name="phone" inputmode="tel" value="${esc(e.phoneOverride)}" placeholder="08xxxxxxxxxx atau 628xxxxxxxxxx"><p class="hint">Isi bila nomor WhatsApp pegawai berbeda dari data pegawai. Kosongkan untuk memakai nomor dari data pegawai.</p></div>
    </form>`, { footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" form="att-ph" type="submit">Simpan</button>' });
    $('#att-ph').addEventListener('submit', (ev) => { ev.preventDefault(); busy(ev.submitter, async () => {
      const r = await api('PUT', `/api/addons/attendance/employees/${e.nip}`, { phone: ev.target.phone.value });
      e.phoneOverride = r.phoneOverride; e.waPhone = r.phoneOverride || e.phone;
      closeModal(); toast('Nomor disimpan.'); attEmployees();
    }); });
  }

  // Kirim manual: pilih pegawai yang belum presensi (data presensi diambil ulang agar terbaru)
  async function attSendModal(type, only) {
    modal(`Kirim pengingat presensi ${type}`, '<div class="text-xs ink-3">Mengambil presensi terbaru…</div>', { wide: true });
    let d; try { d = await attLoadEmployees(); } catch (e) { $('#modal-body').innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (!$('#modal-body')) return;
    if (d.absensiError) { $('#modal-body').innerHTML = `<div class="empty">Presensi tidak dapat diambil: ${esc(d.absensiError)}</div>`; return; }
    const list = d.employees.filter((e) => e.presensi?.belum[type] && (!only || only.includes(e.nip)));
    const pre = (e) => !!e.waPhone && (only ? true : e.notify);
    const body = list.length ? `<div class="space-y-3">
      <p class="text-xs ink-3">${only ? '' : 'Terpilih otomatis: pegawai yang belum presensi ' + esc(type) + ', punya nomor WA, dan notifikasinya aktif. '}${S.att.cfg.routing === 'smart' ? 'Mode pintar: pegawai dengan jendela 24 jam terbuka menerima pesan teks biasa, selain itu template' : 'Pesan memakai template'} <span class="mono">${esc(S.att.cfg.template.name)}</span>.</p>
      ${only ? '' : `<label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" id="att-sel-all">Pilih semua yang punya nomor</label>`}
      <div class="border rounded-lg bd divide-y max-h-[50vh] overflow-y-auto scroll-thin">${list.map((e) => `<label class="flex items-center gap-3 px-3 py-2 ${e.waPhone ? 'cursor-pointer' : 'opacity-60'}">
        <input type="checkbox" class="check" data-att-pick="${esc(e.nip)}" ${pre(e) ? 'checked' : ''} ${e.waPhone ? '' : 'disabled'}>
        <div class="flex-1 min-w-0"><div class="truncate">${esc(e.nama)}</div><div class="text-[11px] ink-3">${e.waPhone ? '+' + esc(e.waPhone) : 'Tanpa nomor WA'}${e.notify ? '' : ' · notifikasi mati'}</div></div>
        ${S.att.cfg.routing === 'smart' ? attWinBadge(e) : ''}
        ${e.sentToday[type] ? `<span class="badge badge-amber">Sudah diingatkan ${esc(fmtTime(e.sentToday[type]))}</span>` : ''}
      </label>`).join('')}</div></div>` : `<div class="empty">${only ? 'Pegawai ini sudah presensi ' + esc(type) + '.' : 'Semua pegawai sudah presensi ' + esc(type) + '. 🎉'}</div>`;
    modal(`Kirim pengingat presensi ${type}`, body, { wide: true, footer: list.length ? `<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="att-go"></button>` : '<button class="btn" data-act="modal-close">Tutup</button>' });
    if (!list.length) return;
    const picks = () => $$('[data-att-pick]').filter((x) => x.checked).map((x) => x.dataset.attPick);
    const upd = () => {
      const n = picks().length;
      $('#att-go').innerHTML = `${ICON.send}<span>Kirim ke ${n} pegawai</span>`; $('#att-go').disabled = !n;
      const all = $('#att-sel-all'), avail = $$('[data-att-pick]').filter((x) => !x.disabled);
      if (all) all.checked = avail.length > 0 && avail.every((x) => x.checked);
    };
    $$('[data-att-pick]').forEach((x) => x.addEventListener('change', upd));
    $('#att-sel-all')?.addEventListener('change', (ev) => { $$('[data-att-pick]').filter((x) => !x.disabled).forEach((x) => { x.checked = ev.target.checked; }); upd(); });
    upd();
    $('#att-go').addEventListener('click', (ev) => busy(ev.currentTarget, async () => {
      const run = await api('POST', '/api/addons/attendance/send', { type, nips: picks() });
      toast(`Mengirim pengingat ke ${run.items.filter((i) => i.status === 'pending').length} pegawai…`);
      attRunModal(run.id);
    }));
  }

  const attRunStatus = (r) => (r.status === 'running' ? statusBadge('running') : r.status === 'failed' ? statusBadge('failed') : r.failed ? '<span class="badge badge-amber"><span class="dot"></span>Sebagian gagal</span>' : statusBadge('done'));
  const attTrigger = (r) => (r.trigger === 'auto' ? `Terjadwal${r.slot ? ' ' + esc(r.slot.replace(':', '.')) : ''}` : `Manual · ${esc(r.userName)}`);
  async function attRunModal(id) {
    let r; try { r = await api('GET', `/api/addons/attendance/runs/${id}`); } catch (e) { fail(e); return; }
    S.att.openRun = id;
    const counts = `<span class="badge badge-green">${r.sent} terkirim</span> ${r.viaText ? `<span class="badge">${r.viaText} via teks · ${r.sent - r.viaText} via template</span>` : ''} ${r.failed ? `<span class="badge badge-red">${r.failed} gagal</span>` : ''} ${r.skipped ? `<span class="badge">${r.skipped} dilewati</span>` : ''}`;
    modal(`Pengingat presensi ${r.type} · ${fmtDT(r.at)}`, `<div class="space-y-3" data-att-run="${esc(r.id)}">
      <div class="flex flex-wrap items-center gap-2 text-xs">${attRunStatus(r)}<span class="ink-3">${attTrigger(r)}</span><span class="flex-1"></span>${counts}</div>
      ${r.error ? `<p class="text-[13px] danger-ink">${esc(r.error)}</p>` : ''}
      ${r.items.length ? `<div class="overflow-x-auto"><table class="tbl"><thead><tr><th>Pegawai</th><th>Nomor</th><th>Status</th><th>Jalur</th><th>Keterangan</th></tr></thead><tbody>
        ${r.items.map((i) => `<tr><td>${esc(i.nama)}</td><td class="mono text-xs whitespace-nowrap">${i.phone ? '+' + esc(i.phone) : '—'}</td><td>${statusBadge(i.status)}</td><td class="text-xs">${i.via === 'text' ? 'Teks' : i.via === 'template' ? 'Template' : '<span class="ink-3">—</span>'}</td><td class="text-xs ${i.status === 'failed' ? 'danger-ink' : 'ink-3'}">${esc(i.detail) || (i.at ? esc(fmtTime(i.at)) : '')}</td></tr>`).join('')}
      </tbody></table></div>` : `<div class="empty">${r.status === 'failed' ? 'Tidak ada pesan yang dikirim.' : 'Tidak ada pegawai yang perlu diingatkan.'}</div>`}
    </div>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Tutup</button>' });
  }
  // Pembaruan run dari server: segarkan riwayat & modal detail yang sedang terbuka
  let attRunTimer;
  function attRunUpdate(r) {
    if (S.view !== 'attendance' || !S.att?.cfg) return;
    const runs = S.att.cfg.runs, i = runs.findIndex((x) => x.id === r.id);
    if (i >= 0) runs[i] = r; else runs.unshift(r);
    clearTimeout(attRunTimer);
    attRunTimer = setTimeout(() => {
      if ($(`[data-att-run="${r.id}"]`)) attRunModal(r.id);
      if (S.att.tab === 'history' && $('#att-body')) attHistory();
      if (r.status === 'done' && S.att.tab === 'employees' && $('#att-body') && !$('#modal-root').innerHTML) attEmployees(false);
    }, 400);
  }

  function attHistory() {
    const el = $('#att-body'), runs = S.att.cfg.runs;
    el.innerHTML = `<section class="card"><div class="overflow-x-auto"><table class="tbl"><thead><tr><th>Waktu</th><th>Presensi</th><th>Pemicu</th><th>Status</th><th class="text-right">Terkirim</th><th class="text-right">Gagal</th><th class="text-right">Dilewati</th></tr></thead><tbody>
      ${runs.map((r) => `<tr class="cursor-pointer" data-att-open="${esc(r.id)}"><td class="whitespace-nowrap">${esc(fmtDT(r.at))}</td><td>${ATT_TYPE[r.type]}</td><td class="text-xs">${attTrigger(r)}</td><td>${attRunStatus(r)}${r.error ? `<div class="text-[11px] danger-ink max-w-[18rem] truncate" title="${esc(r.error)}">${esc(r.error)}</div>` : ''}</td><td class="text-right">${fmtNum(r.sent)}</td><td class="text-right ${r.failed ? 'danger-ink' : ''}">${fmtNum(r.failed)}</td><td class="text-right">${fmtNum(r.skipped)}</td></tr>`).join('')
