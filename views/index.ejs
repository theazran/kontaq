  // Potong tengah menjadi persegi lalu JPEG (syarat foto grup: JPEG persegi, min. 192 px)
  async function squareJpeg(file, size) {
    const img = await new Promise((ok, no) => { const i = new Image(); i.onload = () => ok(i); i.onerror = () => no(new Error('Gambar tidak dapat dibaca.')); i.src = URL.createObjectURL(file); });
    const s = Math.min(img.naturalWidth, img.naturalHeight);
    if (s < 192) throw new Error('Foto minimal 192×192 piksel.');
    const c = document.createElement('canvas'); c.width = c.height = Math.min(size, s);
    c.getContext('2d').drawImage(img, (img.naturalWidth - s) / 2, (img.naturalHeight - s) / 2, s, s, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.88);
  }

