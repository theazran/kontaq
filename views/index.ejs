  async function patchConv(body) {
    const c = activeConv();
    try {
      const upd = await api('PATCH', `/api/conversations/${c.id}`, body);
      applyConv(upd); toast('Percakapan diperbarui.');
    } catch (e) { fail(e); renderChat(); }
  }
  function msgBody(m) {
    const c = m.content || {}, media = c.mediaId ? `/api/media/${encodeURIComponent(c.mediaId)}` : '';
    switch (m.type) {
      case 'text': case 'unsupported': return waFormat(c.body);
      case 'image': if (c.arImage) return `<img src="/api/autoreply/media/${c.arImage}" alt="Gambar" loading="lazy" class="mb-1">${c.caption ? waFormat(c.caption) : ''}`;
        return `<a href="${media}" target="_blank" rel="noopener"><img src="${media}" alt="Gambar" loading="lazy" class="mb-1"></a>${c.caption ? waFormat(c.caption) : ''}`;
      case 'sticker': return `<img src="${media}" alt="Stiker" loading="lazy" style="width:120px">`;
      case 'video': return `<video src="${media}" controls preload="none" class="mb-1 w-full"></video>${c.caption ? waFormat(c.caption) : ''}`;
      case 'audio': return `<audio src="${media}" controls preload="none" style="max-width:260px"></audio>${c.voice ? '<div class="text-[11px] ink-3">Pesan suara</div>' : ''}`;
      case 'document': return `<a class="flex items-center gap-2 p-2 rounded-md surface-2" href="${media}?download=1">${ICON.tpl.replace('<svg', '<svg width="18" height="18"')}<span class="truncate font-medium">${esc(c.filename || 'Dokumen')}</span></a>${c.caption ? `<div class="mt-1">${waFormat(c.caption)}</div>` : ''}`;
      case 'location': return `<a class="underline" style="color:var(--info)" target="_blank" rel="noopener noreferrer" href="https://maps.google.com/?q=${encodeURIComponent(c.latitude + ',' + c.longitude)}">📍 ${esc(c.name || `${c.latitude}, ${c.longitude}`)}</a>${c.address ? `<div class="text-xs ink-3">${esc(c.address)}</div>` : ''}`;
      case 'interactive': return `${c.arImage ? `<img src="/api/autoreply/media/${c.arImage}" alt="Gambar" loading="lazy" class="mb-1">` : ''}${c.header ? `<div class="font-semibold">${esc(c.header)}</div>` : ''}<div>${waFormat(c.body)}</div>${c.footer ? `<div class="text-[11px] ink-3 mt-0.5">${esc(c.footer)}</div>` : ''}
        ${c.kind === 'call_permission_request' ? `<span class="ib-btn">${ICON.phone.replace('<svg', '<svg width="12" height="12" style="display:inline;vertical-align:-1px"')} Permintaan izin telepon</span>`
          : c.kind === 'button' ? c.buttons.map((b) => `<span class="ib-btn">${esc(b)}</span>`).join('') : `<span class="ib-btn">☰ ${esc(c.button)}</span><div class="text-[11px] ink-3 mt-1">${c.rows.map((r) => esc(r.title)).join(' · ')}</div>`}`;
      case 'call_permission': return `<div class="flex items-center gap-2"><span class="${c.response === 'accept' ? 'accent-ink' : 'danger-ink'}">${ICON.phone.replace('<svg', '<svg width="16" height="16"')}</span><div><div class="font-medium">${c.response === 'accept' ? 'Bersedia ditelepon balik' : 'Menolak ditelepon'}</div>${c.response === 'accept' ? `<div class="text-[11px] ink-3">${c.permanent ? 'Izin permanen' : c.expiresAt ? 'Berlaku sampai ' + esc(fmtDT(c.expiresAt)) : ''}</div>` : ''}</div></div>`;
      case 'interactive_reply': return `<div class="text-[11px] ink-3">Balasan pilihan</div><div class="font-medium">${esc(c.title)}</div>${c.description ? `<div class="text-xs ink-3">${esc(c.description)}</div>` : ''}`;
      case 'button': return `<div class="text-[11px] ink-3">Tombol template</div><div class="font-medium">${esc(c.text)}</div>`;
      case 'template': return `<div class="text-[11px] ink-3 mb-0.5">Template · ${esc(c.name)} (${esc(c.language)})</div>${waFormat(c.body || '')}`;
      case 'contacts': return (c.contacts || []).map((k) => `👤 <b>${esc(k.name)}</b> ${esc((k.phones || []).join(', '))}`).join('<br>');
      default: return esc(m.type);
    }
  }
  // Ringkasan singkat isi pesan untuk kutipan balasan
  function quoteText(m) {
    const c = m.content || {};
    return String({ text: c.body, interactive_reply: c.title, button: c.text, interactive: c.body, template: c.body, image: c.caption || '📷 Gambar', video: c.caption || '🎬 Video',
      audio: '🎵 Audio', document: '📄 ' + (c.filename || 'Dokumen'), sticker: 'Stiker', location: '📍 ' + (c.name || 'Lokasi'), contacts: '👤 Kontak' }[m.type] || c.body || 'Pesan');
  }
  function msgHtml(m) {
    const out = m.direction === 'out';
    const quoted = m.contextId ? S.inbox.messages.find((x) => x.wamid === m.contextId) : null;
    return `<div class="msg-row flex ${out ? 'justify-end' : 'justify-start'} group" data-mid="${m.id}">
      ${out ? `<button class="reply-btn opacity-0 group-hover:opacity-100 ink-3 self-center p-1 mr-1" data-reply="${m.id}" title="Balas" aria-label="Balas">${ICON.reply.replace('<svg', '<svg width="14" height="14"')}</button>` : ''}
      <div class="bubble ${out ? 'out' : 'in'} ${m.reaction ? 'mb-3' : ''}">
        ${quoted ? `<div class="text-[11px] ink-3 border-l-2 pl-2 mb-1" style="border-color:var(--accent)">${esc(quoteText(quoted).slice(0, 80))}</div>` : ''}
        ${msgBody(m)}
        <div class="meta">${out && m.userName ? `<span>${m.auto ? '⚡ ' : ''}${esc(m.userName)} ·</span>` : ''}<span>${fmtTime(m.timestamp)}</span>${out ? tick(m.status) : ''}</div>
        ${m.status === 'failed' ? `<div class="text-[11px] danger-ink mt-1">${esc(m.error || 'Gagal terkirim')}</div>` : ''}
        ${m.reaction ? `<span class="reaction">${esc(m.reaction)}</span>` : ''}
      </div>
      ${!out ? `<button class="reply-btn opacity-0 group-hover:opacity-100 ink-3 self-center p-1 ml-1" data-reply="${m.id}" title="Balas" aria-label="Balas">${ICON.reply.replace('<svg', '<svg width="14" height="14"')}</button>` : ''}
    </div>`;
  }
  function renderMessages(scroll) {
    const el = $('#msgs'); if (!el) return;
    const nearBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 120;
    let lastDay = '';
    el.innerHTML = S.inbox.messages.map((m) => {
      const day = new Date(m.timestamp).toDateString();
      const sep = day !== lastDay ? `<div class="flex justify-center py-2"><span class="day-sep">${esc(fmtDate(m.timestamp))}</span></div>` : '';
      lastDay = day; return sep + msgHtml(m);
    }).join('') || '<div class="empty">Belum ada pesan. Di luar jendela 24 jam, mulai dengan template.</div>';
    $$('[data-reply]', el).forEach((b) => b.addEventListener('click', () => { S.inbox.replyTo = b.dataset.reply; renderComposer(); }));
    if (scroll || nearBottom) el.scrollTop = el.scrollHeight;
  }
  // Geser pesan ke kanan untuk membalas (layar sentuh)
  function bindSwipeReply(el) {
    let row = null, x0 = 0, y0 = 0, dx = 0;
    el.addEventListener('touchstart', (e) => { row = e.target.closest('.msg-row'); if (!row) return; x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; dx = 0; }, { passive: true });
    el.addEventListener('touchmove', (e) => {
      if (!row) return;
      const mx = e.touches[0].clientX - x0, my = e.touches[0].clientY - y0;
      if (dx === 0 && Math.abs(my) > Math.abs(mx)) { row = null; return; }
      dx = Math.max(0, Math.min(80, mx)); row.classList.add('swiping'); row.style.transform = `translateX(${dx}px)`;
    }, { passive: true });
    el.addEventListener('touchend', () => {
      if (!row) return;
      row.classList.remove('swiping'); row.style.transform = '';
      if (dx > 56) { S.inbox.replyTo = row.dataset.mid; renderComposer(); navigator.vibrate?.(15); $('#cmp-text')?.focus(); }
      row = null;
    });
  }
  function renderComposer() {
    const c = activeConv(), el = $('#composer'); if (!c || !el) return;
    const draft = $('#cmp-text')?.value || '';
    if (!c.windowOpen) {
      el.innerHTML = `<div class="p-3 flex flex-wrap items-center gap-3"><div class="flex-1 min-w-[12rem] text-xs ink-2">Jendela layanan 24 jam tertutup. Sesuai kebijakan Meta, hanya <b>template yang disetujui</b> yang dapat dikirim sampai pelanggan membalas.</div><button class="btn btn-primary max-sm:w-full" id="cmp-tpl">${ICON.tpl} Kirim template</button></div>`;
      $('#cmp-tpl').addEventListener('click', () => templateSendModal(c));
      return;
    }
    const rep = S.inbox.replyTo ? S.inbox.messages.find((m) => m.id === S.inbox.replyTo) : null;
    el.innerHTML = `${rep ? `<div class="px-3 pt-2 flex items-center gap-2 text-xs ink-3"><span class="border-l-2 pl-2 truncate flex-1" style="border-color:var(--accent)">Membalas: ${esc(quoteText(rep).slice(0, 100))}</span><button class="btn btn-ghost btn-sm" id="cmp-unreply" aria-label="Batal balas">${ICON.x}</button></div>` : ''}
      <div class="p-2 flex items-end gap-1.5">
        <button class="btn btn-ghost btn-icon sm:hidden" data-cmp="sheet" title="Lampiran" aria-label="Lampiran">${ICON.plus}</button>
        <div class="hidden sm:flex items-center">
          <button class="btn btn-ghost btn-icon" data-cmp="media" title="Media (gambar, video, audio, dokumen)" aria-label="Lampirkan media">${ICON.clip}</button>
          <button class="btn btn-ghost btn-icon hidden sm:inline-flex" data-cmp="location" title="Lokasi" aria-label="Kirim lokasi">${ICON.pin}</button>
          <button class="btn btn-ghost btn-icon hidden sm:inline-flex" data-cmp="buttons" title="Tombol interaktif" aria-label="Kirim tombol interaktif">${ICON.btns}</button>
          <button class="btn btn-ghost btn-icon hidden sm:inline-flex" data-cmp="list" title="Daftar interaktif" aria-label="Kirim daftar interaktif">${ICON.list}</button>
          <button class="btn btn-ghost btn-icon" data-cmp="template" title="Template" aria-label="Kirim template">${ICON.tpl}</button>
        </div>
        <textarea id="cmp-text" rows="1" class="textarea flex-1 max-h-40" placeholder="${isTouch ? 'Tulis pesan…' : 'Tulis pesan…  (Enter kirim, Shift+Enter baris baru)'}" aria-label="Pesan">${esc(draft)}</textarea>
        <button class="btn btn-accent btn-icon h-[34px] w-[34px] max-md:h-10 max-md:w-10 max-md:rounded-full" id="cmp-send" title="Kirim" aria-label="Kirim">${ICON.send}</button>
      </div>`;
    const ta = $('#cmp-text');
    const grow = () => { ta.style.height = 'auto'; ta.style.height = Math.min(160, ta.scrollHeight) + 'px'; };
    ta.addEventListener('input', () => { grow(); if (ta.value.trim()) emitTyping(c.id); }); grow();
    ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && !isTouch) { e.preventDefault(); $('#cmp-send').click(); } });
    $('#cmp-send').addEventListener('click', (e) => {
      const body = ta.value.trim(); if (!body) return;
      busy(e.currentTarget, async () => { await sendMsg({ type: 'text', body }); ta.value = ''; grow(); if (isTouch) ta.focus(); });
    });
    $('#cmp-unreply')?.addEventListener('click', () => { S.inbox.replyTo = null; renderComposer(); });
    $$('[data-cmp]', el).forEach((b) => b.addEventListener('click', () => ({ sheet: attachSheet, media: () => mediaModal(), location: locationModal, buttons: buttonsModal, list: listModal, template: () => templateSendModal(c) })[b.dataset.cmp]()));
    if (!isTouch) ta.focus();
  }
  async function sendMsg(body) {
    const c = activeConv();
    if (S.inbox.replyTo) body.replyTo = S.inbox.replyTo;
    const msg = await api('POST', `/api/conversations/${c.id}/messages`, body);
    S.inbox.replyTo = null;
    if (S.typingEmitAt) delete S.typingEmitAt[c.id]; // ketikan berikutnya langsung terlihat lagi
    if (!S.inbox.messages.some((m) => m.id === msg.id)) { S.inbox.messages.push(msg); renderMessages(true); }
    if ($('#cmp-unreply')) renderComposer();
    return msg;
  }
  // Lembar lampiran (HP): pilihan besar seperti aplikasi chat
  function attachSheet() {
    const items = [['camera', 'Kamera', ICON.camera], ['image', 'Galeri', ICON.image], ['document', 'Dokumen', ICON.doc], ['audio', 'Audio', ICON.mic],
      ['location', 'Lokasi', ICON.pin], ['buttons', 'Tombol', ICON.btns], ['list', 'Daftar', ICON.list], ['template', 'Template', ICON.tpl]];
    modal('Lampiran', `<div class="sheet-grid">${items.map(([k, l, ic]) => `<button class="sheet-btn" data-sheet="${k}"><span class="ic">${ic}</span>${l}</button>`).join('')}</div>`);
    $$('[data-sheet]').forEach((b) => b.addEventListener('click', () => {
      const c = activeConv();
      ({ camera: () => mediaModal('image', true), image: () => mediaModal('image'), document: () => mediaModal('document'), audio: () => mediaModal('audio'),
        location: locationModal, buttons: buttonsModal, list: listModal, template: () => templateSendModal(c) })[b.dataset.sheet]();
    }));
  }
  function mediaModal(kind = 'image', camera = false) {
    modal('Kirim media', `<form id="f-media" class="space-y-3">
      <div><label class="label">Jenis</label><select class="select" name="kind">
        <option value="image">Gambar (JPEG/PNG, maks 5 MB)</option><option value="video">Video (MP4/3GPP, maks 16 MB)</option>
        <option value="audio">Audio (AAC/AMR/MP3/M4A/OGG, maks 16 MB)</option><option value="document">Dokumen (maks 100 MB)</option></select></div>
      <div><label class="label">File</label><input class="input pt-1" type="file" name="file" required></div>
      <div id="media-cap"><label class="label">Keterangan (opsional)</label><textarea class="textarea" name="caption" rows="2" maxlength="1024"></textarea></div>
    </form>`, { footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="media-go">Unggah & kirim</button>' });
    const f = $('#f-media');
    f.kind.value = kind;
    f.kind.addEventListener('change', () => { $('#media-cap').classList.toggle('hidden', f.kind.value === 'audio'); f.file.accept = { image: 'image/jpeg,image/png', video: 'video/mp4,video/3gpp', audio: 'audio/*', document: '' }[f.kind.value]; f.file.removeAttribute('capture'); });
    f.kind.dispatchEvent(new Event('change'));
    if (camera) { f.file.accept = 'image/*'; f.file.setAttribute('capture', 'environment'); f.file.click(); }
    f.file.addEventListener('change', () => {
      const file = f.file.files[0]; $('#media-prev')?.remove();
      if (file && file.type.startsWith('image/')) f.file.insertAdjacentHTML('afterend', `<img id="media-prev" class="mt-2 rounded-md max-h-48" alt="Pratinjau" src="${URL.createObjectURL(file)}">`);
    });
    $('#media-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!f.file.files[0]) throw new Error('Pilih file terlebih dahulu.');
      const fd = new FormData(); fd.append('kind', f.kind.value); fd.append('file', f.file.files[0]);
      const up = await api('POST', '/api/media', fd);
      await sendMsg({ type: f.kind.value, mediaId: up.id, mime: up.mime, filename: up.filename, caption: f.caption.value });
      closeModal();
    }));
  }
  function locationModal() {
    modal('Kirim lokasi', `<form id="f-loc" class="grid grid-cols-2 gap-3">
      <button type="button" class="btn col-span-2" id="loc-me">${ICON.pin} Pakai lokasi saya saat ini</button>
      <div><label class="label">Latitude</label><input class="input" name="latitude" required inputmode="decimal" placeholder="-6.2088"></div>
      <div><label class="label">Longitude</label><input class="input" name="longitude" required inputmode="decimal" placeholder="106.8456"></div>
      <div class="col-span-2"><label class="label">Nama tempat</label><input class="input" name="name" maxlength="1000"></div>
      <div class="col-span-2"><label class="label">Alamat</label><input class="input" name="address" maxlength="1000"></div>
    </form>`, { footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="loc-go">Kirim</button>' });
    $('#loc-me').addEventListener('click', (e) => {
      if (!navigator.geolocation) return fail(new Error('Perangkat tidak mendukung lokasi.'));
      const btn = e.currentTarget; btn.disabled = true;
      navigator.geolocation.getCurrentPosition((p) => {
        const f = $('#f-loc'); f.latitude.value = p.coords.latitude.toFixed(6); f.longitude.value = p.coords.longitude.toFixed(6); btn.disabled = false;
      }, (err) => { btn.disabled = false; fail(new Error('Lokasi tidak tersedia: ' + err.message)); }, { enableHighAccuracy: true, timeout: 10000 });
    });
    $('#loc-go').addEventListener('click', (e) => busy(e.currentTarget, async () => { await sendMsg({ type: 'location', ...formData($('#f-loc')) }); closeModal(); }));
  }
