              <label class="flex items-center gap-2 text-xs ink-2 flex-none">Aktif ${sw('fe-on', f.enabled, 'Aktifkan flow')}</label>
            </div>
            <div class="px-4 py-2 border-b bd text-[11px] ink-3">Klik langkah untuk mengubah, <span class="kbd">+</span> untuk menambah langkah. Kondisi membuat dua cabang: <b class="ink-2">Ya</b> dan <b class="ink-2">Tidak</b>.</div>
            <div id="fe-canvas" class="fl-canvas overflow-auto scroll-thin p-4 md:p-6"></div>
