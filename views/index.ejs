    const f = $('#f-tc'), btns = $('#tc-btns');
    const addBtn = () => {
      if (btns.children.length >= 10) return;
      const row = document.createElement('div'); row.className = 'grid grid-cols-[7rem_1fr_auto] gap-2';
      row.innerHTML = `<select class="select" data-k="type"><option value="QUICK_REPLY">Balasan cepat</option><option value="URL">URL</option><option value="PHONE_NUMBER">Telepon</option></select>
        <div class="space-y-1"><input class="input" data-k="text" maxlength="25" placeholder="Teks tombol"><input class="input hidden" data-k="extra" placeholder=""></div>
        <button type="button" class="btn btn-ghost btn-icon" aria-label="Hapus tombol">${ICON.x}</button>`;
      const sel = row.querySelector('[data-k=type]'), ex = row.querySelector('[data-k=extra]');
      sel.addEventListener('change', () => { ex.classList.toggle('hidden', sel.value === 'QUICK_REPLY'); ex.placeholder = sel.value === 'URL' ? 'https://contoh.com' : '6281234567890'; });
      row.querySelector('button').addEventListener('click', () => { row.remove(); draw(); });
      btns.appendChild(row);
    };
    const collect = () => {
      const d = formData(f);
      d.buttons = [...btns.children].map((r) => { const type = r.querySelector('[data-k=type]').value, text = r.querySelector('[data-k=text]').value, extra = r.querySelector('[data-k=extra]').value; return { type, text, url: extra, phone: extra }; });
      return d;
    };
    const draw = () => {
      const d = collect();
      $('#tc-hex').classList.toggle('hidden', !tplVars(d.headerText).length);
      $('#tc-bex').classList.toggle('hidden', !tplVars(d.body).length);
      const t = { components: [d.headerText && { type: 'HEADER', format: 'TEXT', text: d.headerText }, { type: 'BODY', text: d.body || 'Isi pesan…' }, d.footer && { type: 'FOOTER', text: d.footer }, d.buttons.length && { type: 'BUTTONS', buttons: d.buttons.filter((b) => b.text) }].filter(Boolean) };
