    </div>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="ct-go">Kirim</button>' });
    const drawPicked = () => {
      $('#ct-picked').innerHTML = [...picked.values()].map((k, i) => `<span class="badge">${esc(k.name)}<button type="button" data-unpick="${esc(k.key)}" aria-label="Hapus">${ICON.x.replace('<svg', '<svg width="10" height="10"')}</button></span>`).join('') || '<span class="text-xs ink-3">Belum ada kontak dipilih.</span>';
      $$('[data-unpick]').forEach((b) => b.addEventListener('click', () => { picked.delete(b.dataset.unpick); drawPicked(); search(); }));
    };
    let timer;
    const search = async () => {
      const r = await api('GET', `/api/contacts?q=${encodeURIComponent($('#ct-q').value.trim())}&page=1`).catch(() => ({ rows: [] }));
      $('#ct-list').innerHTML = r.rows.slice(0, 40).map((c) => `<label class="flex items-center gap-2.5 px-3 py-2 border-b bd last:border-0 text-[13px] cursor-pointer">
          <input type="checkbox" class="check" data-pk="${esc(c.id)}" ${picked.has('c' + c.id) ? 'checked' : ''}>${avatar(c, 28)}<span class="min-w-0 flex-1 truncate">${esc(c.name || c.waName || 'Tanpa nama')} <span class="ink-3">+${esc(c.phone)}</span></span></label>`).join('') || '<div class="p-3 text-xs ink-3">Tidak ada kontak.</div>';
      $$('[data-pk]').forEach((x) => x.addEventListener('change', () => {
        const c = r.rows.find((y) => y.id === x.dataset.pk), key = 'c' + c.id;
        if (x.checked) { if (picked.size >= 10) { x.checked = false; return fail(new Error('Maksimal 10 kontak per pesan.')); } picked.set(key, { key, name: c.name || c.waName || '+' + c.phone, phones: [c.phone], whatsapp: true }); }
        else picked.delete(key);
        drawPicked();
      }));
    };
    $('#ct-q').addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(search, 250); });
    $$('[data-ct-tab]').forEach((b) => b.addEventListener('click', () => {
      $$('[data-ct-tab]').forEach((x) => x.classList.toggle('active', x === b));
      $$('[data-ct-pane]').forEach((p) => p.classList.toggle('hidden', p.dataset.ctPane !== b.dataset.ctTab));
    }));
    $('#ct-man').addEventListener('submit', (e) => {
      e.preventDefault();
      const name = $('#ct-n').value.trim(), phone = $('#ct-p').value.replace(/\D/g, ''), email = $('#ct-e').value.trim();
      if (!phone && !email) return fail(new Error('Isi nomor telepon atau email.'));
      if (phone && !/^\d{8,15}$/.test(phone)) return fail(new Error('Nomor telepon tidak valid (8–15 digit, dengan kode negara).'));
      if (picked.size >= 10) return fail(new Error('Maksimal 10 kontak per pesan.'));
      const key = 'm' + Date.now();
      picked.set(key, { key, name, phones: phone ? [phone] : [], emails: email ? [email] : [], company: $('#ct-c').value.trim() });
      e.target.reset(); drawPicked();
    });
    drawPicked(); search();
    $('#ct-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!picked.size) throw new Error('Pilih minimal satu kontak.');
      await sendMsg({ type: 'contacts', contacts: [...picked.values()].map(({ key, ...k }) => k) });
      closeModal();
    }));
  }
