        </div>
        <div class="grid grid-cols-3 gap-2 mt-4">
          <div class="surface-2 rounded-md px-3 py-2"><div class="text-[11px] ink-3">Terkirim</div><div class="font-semibold mt-0.5">${fmtNum(a.sent)}</div></div>
          <div class="surface-2 rounded-md px-3 py-2"><div class="text-[11px] ink-3">Waktu sekarang</div><div class="font-semibold mt-0.5 leading-tight">${esc(AR_DAYS[a.now.day])} ${esc(a.now.time)}</div></div>
          <div class="surface-2 rounded-md px-3 py-2"><div class="text-[11px] ink-3">Status</div><div class="font-semibold mt-0.5 leading-tight ${a.now.open ? 'accent-ink' : ''}">${a.now.open ? 'Jam kerja' : 'Di luar jam kerja'}</div></div>
        </div>
        <div class="text-[11px] ink-3 mt-3">Urutan pengecekan: <b class="ink-2">kata kunci</b> → <b class="ink-2">di luar jam kerja</b> → <b class="ink-2">sambutan</b>. Satu pesan masuk dibalas paling banyak sekali.</div>
        ${a.lastError ? `<div class="mt-3 rounded-md px-3 py-2 text-xs" style="background:var(--danger-soft);color:var(--danger)">Gagal terakhir ${esc(fmtDT(a.lastError.at))}: ${esc(a.lastError.message)}</div>` : ''}
      </section>

      <section class="card">
        <div class="card-h"><div class="min-w-0"><div class="card-t">Balasan kata kunci</div><div class="text-[11px] ink-3">Dicek dari atas ke bawah. Aturan pertama yang cocok akan membalas.</div></div>
          <button class="btn btn-sm btn-primary flex-none" id="ar-add">${ICON.plus} Aturan</button></div>
        <div>${a.rules.map((x, i) => `<div class="px-4 py-3 border-b bd last:border-0 flex gap-3 ${x.enabled ? '' : 'opacity-60'}">
            <div class="pt-0.5">${sw('ar-rule-on-' + i, x.enabled, 'Aktifkan aturan ' + x.name)}</div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start gap-2">
                <div class="min-w-0 flex-1"><div class="font-medium truncate">${esc(x.name)}</div>
                  <div class="text-[11px] ink-3 mt-0.5">${esc(AR_MATCH[x.match])} · ${fmtNum(x.hits || 0)}× membalas${x.lastHitAt ? ' · ' + esc(fmtDT(x.lastHitAt)) : ''}</div></div>
                <div class="flex items-center -mr-1.5 -mt-1 flex-none">
                  ${iconBtn(`data-ar-up="${i}" ${i === 0 ? 'disabled' : ''}`, ICON.up, 'Naikkan')}
                  ${iconBtn(`data-ar-down="${i}" ${i === a.rules.length - 1 ? 'disabled' : ''}`, ICON.down, 'Turunkan')}
                  ${iconBtn(`data-ar-edit="${i}"`, ICON.edit, 'Ubah')}
                  ${iconBtn(`data-ar-del="${i}"`, ICON.trash, 'Hapus', 'btn-danger')}
                </div>
              </div>
              <div class="flex flex-wrap gap-1 mt-2">${x.keywords.map((k) => `<span class="badge">${esc(k)}</span>`).join('')}</div>
              <div class="mt-2 surface-2 rounded-md px-2.5 py-2 flex gap-2.5">
                ${x.image ? arImg(x.image, 'w-11 h-11 flex-none') : ''}
                <div class="min-w-0 flex-1"><div class="text-xs ink-2 line-clamp-2 whitespace-pre-line">${x.reply ? esc(x.reply) : '<span class="ink-3">(gambar tanpa teks)</span>'}</div>
                  ${(x.buttons || []).length ? `<div class="flex flex-wrap gap-1 mt-1.5">${x.buttons.map((t) => `<span class="badge" style="color:var(--info)">${esc(t)}</span>`).join('')}</div>` : ''}</div>
              </div>
            </div>
