        : `<div><div class="label">Mulai dari</div><div class="grid sm:grid-cols-2 gap-2">${Object.entries(WF_STARTERS).map(([k, [t]], i) => `<label class="fl-pick cursor-pointer"><input type="radio" class="check mt-0.5" name="starter" value="${k}" ${i === 1 ? 'checked' : ''}><span class="text-[13px] font-medium">${esc(t)}</span></label>`).join('')}</div></div>`}
