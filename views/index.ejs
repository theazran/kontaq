        ${k.notes ? `<div class="ink-2 line-clamp-2" title="${esc(k.notes)}">${esc(k.notes)}</div>` : ''}
        ${p.conversation?.preview ? `<div class="ink-3 truncate">Pesan terakhir: ${esc(p.conversation.preview)}</div>` : ''}
        <div class="grid grid-cols-3 gap-2 text-center pt-1">
          <div><div class="font-semibold text-sm">${fmtNum(s.messagesIn + s.messagesOut)}</div><div class="ink-3 text-[10px]">pesan</div></div>
          <div><div class="font-semibold text-sm">${fmtNum(s.calls)}</div><div class="ink-3 text-[10px]">panggilan</div></div>
          <div><div class="font-semibold text-sm">${esc(new Date(s.since).toLocaleDateString('id-ID', { month: 'short', year: 'numeric' }))}</div><div class="ink-3 text-[10px]">pelanggan sejak</div></div>
        </div>
        ${p.conversation ? `<div class="flex items-center justify-between gap-2 pt-1 border-t bd"><span class="ink-3 truncate pt-2">${esc(p.conversation.assignedName || 'Belum ditugaskan')}</span><button class="btn btn-sm mt-2" id="call-open-chat">${ICON.inbox} Buka chat</button></div>` : ''}
