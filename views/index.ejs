        <label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" name="optInOnly" checked> Hanya kontak yang sudah opt-in</label>
        <div class="pt-3 border-t bd space-y-3">
          <div><div class="label">Waktu kirim</div><div class="seg" id="cp-when"><button type="button" data-w="now" class="active">Draf, kirim manual</button><button type="button" data-w="later">Jadwalkan</button></div></div>
          <div id="cp-sched" class="hidden">${schedFieldsHtml({ repeat: true, maxRuns: true })}</div>
          <label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" name="win"> Hanya kirim pada jam tertentu</label>
          <div id="cp-win" class="hidden"><div class="grid grid-cols-2 gap-2"><div><label class="label">Dari</label><input type="time" class="input" name="w_start" value="08:00"></div><div><label class="label">Sampai</label><input type="time" class="input" name="w_end" value="20:00"></div></div>
            <p class="hint">Di luar jam ini antrean berhenti sementara dan otomatis lanjut saat jam kirim dibuka lagi.</p></div>
        </div>
      </div>
      <div><div class="label">Pratinjau (contoh)</div><div id="cp-prev"></div><p class="hint mt-3" id="cp-note">Campaign dibuat sebagai draf. Anda dapat meninjau jumlah penerima sebelum memulai.</p></div>
    </form>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="cp-go">Buat draf</button>' });
    const f = $('#f-cp'), cur = () => tpls[f.tpl.value];
    const draw = () => { $('#cp-fields').innerHTML = tplFieldsHtml(cur(), { campaign: true }); $('#cp-prev').innerHTML = tplPreview(cur(), f); };
    f.tpl.addEventListener('change', draw);
    f.addEventListener('input', (e) => { if (e.target.name !== 'tpl') $('#cp-prev').innerHTML = tplPreview(cur(), f); });
    draw();
    let when = 'now';
    $$('#cp-when [data-w]').forEach((b) => b.addEventListener('click', () => {
      when = b.dataset.w; $$('#cp-when [data-w]').forEach((x) => x.classList.toggle('active', x === b));
      $('#cp-sched').classList.toggle('hidden', when !== 'later');
      $('#cp-go').textContent = when === 'later' ? 'Jadwalkan' : 'Buat draf';
      $('#cp-note').textContent = when === 'later' ? 'Penerima dihitung ulang dari filter label & opt-in setiap kali jadwal berjalan, sehingga kontak baru ikut dan yang berhenti opt-in tidak dikirimi.' : 'Campaign dibuat sebagai draf. Anda dapat meninjau jumlah penerima sebelum memulai.';
    }));
    $$('input', $('#cp-sched')).forEach((x) => { x.required = false; });
    bindSched(f);
    f.win.addEventListener('change', () => $('#cp-win').classList.toggle('hidden', !f.win.checked));
    $('#cp-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!f.reportValidity()) return;
      const t = cur(), schedule = when === 'later' ? readSched(f) : null;
      if (schedule && (!schedule.date || !schedule.time)) throw new Error('Isi tanggal dan jam kirim.');
      if (schedule && !(await confirmBox(`${schedSummary(schedule)}. Template berbayar sesuai tarif Meta akan dikirim otomatis tanpa konfirmasi lagi. Lanjutkan?`, 'Jadwalkan'))) return;
      const c = await api('POST', '/api/campaigns', { name: f.name.value, templateName: t.name, language: t.language, values: readTplValues(t, f), labels: $$('input[name=label]:checked', f).map((x) => x.value), optInOnly: f.optInOnly.checked,
        schedule, sendWindow: { enabled: f.win.checked, start: f.w_start.value, end: f.w_end.value } });
      closeModal(); toast(schedule ? `Dijadwalkan: ${fmtTz(c.nextRunAt)} (±${c.total} penerima).` : `Draf dibuat: ${c.total} penerima.`); await viewCampaigns(); campaignDetail(c.id);
    }));
  }
  async function campaignDetail(id) {
    let c; try { c = await api('GET', `/api/campaigns/${id}`); } catch (e) { return fail(e); }
    const act = (a, label, cls = '') => `<button class="btn ${cls}" data-cact="${a}">${label}</button>`;
    if (c.series) return campaignSeriesDetail(c, act);
    modal(c.name, `<div class="space-y-4">
      ${c.status === 'scheduled' ? `<div class="sched-box">${ICON.clock}<div><div class="text-[13px] font-medium">Dijadwalkan ${fmtTz(c.nextRunAt, { weekday: 'long' })}</div><div class="text-[11px] ink-3">Penerima dihitung ulang dari filter saat jadwal berjalan. Daftar di bawah adalah perkiraan saat ini.</div></div></div>` : ''}
      ${c.sendWindow ? `<div class="text-xs ink-3">Jam kirim ${c.sendWindow.start.replace(':', '.')}–${c.sendWindow.end.replace(':', '.')} (${esc(TZ)})${c.waitingWindow ? ' · <span class="warn-ink">menunggu jam kirim</span>' : ''}</div>` : ''}
      ${c.parentId ? `<div class="text-xs ink-3">Bagian dari broadcast berulang · <button class="underline" data-parent="${c.parentId}">lihat seri</button></div>` : ''}
      <div class="flex flex-wrap items-center gap-2 text-xs">${statusBadge(c.status)}<span class="ink-3">Template <span class="mono">${esc(c.templateName)}</span> · ${esc(c.language)}</span><span class="ink-3">· ${c.labels.length ? 'Label: ' + esc(c.labels.join(', ')) : 'Semua kontak'}${c.optInOnly ? ' · opt-in saja' : ''}</span></div>
      ${c.lastError ? `<div class="text-xs danger-ink">${esc(c.lastError)}</div>` : ''}
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">${[['Total', c.total], ['Antre', c.counts.queued], ['Terkirim', c.counts.sent], ['Diterima', c.counts.delivered], ['Dibaca', c.counts.read], ['Gagal', c.counts.failed]].map(([l, n]) => `<div class="card p-2.5"><div class="text-[11px] ink-3">${l}</div><div class="text-lg font-semibold">${fmtNum(n)}</div></div>`).join('')}</div>
      <div class="card overflow-hidden max-h-72 overflow-y-auto scroll-thin"><table class="tbl"><thead><tr><th>Nomor</th><th>Nama</th><th>Status</th><th>Keterangan</th></tr></thead><tbody>
        ${c.recipients.map((r) => `<tr><td class="mono text-xs">+${esc(r.phone)}</td><td>${esc(r.name)}</td><td>${statusBadge(r.status)}</td><td class="text-[11px] danger-ink">${esc(r.error || '')}</td></tr>`).join('')}
      </tbody></table></div>${c.total > 1000 ? '<p class="hint">Menampilkan 1.000 penerima pertama. Unduh CSV untuk laporan lengkap.</p>' : ''}
    </div>`, { wide: true, footer: `<a class="btn" href="/api/campaigns/${c.id}/export.csv">Unduh laporan CSV</a><div class="flex-1"></div>
      ${c.status === 'scheduled' ? act('run', 'Kirim sekarang', 'btn-primary') : ''}${['draft', 'paused'].includes(c.status) ? act('start', c.status === 'draft' ? 'Mulai kirim' : 'Lanjutkan', 'btn-primary') : ''}${c.status === 'running' ? act('pause', 'Jeda') : ''}${!['done', 'cancelled'].includes(c.status) ? act('cancel', 'Batalkan', 'btn-danger') : ''}` });
    $$('[data-cact]').forEach((b) => b.addEventListener('click', async () => {
      const a = b.dataset.cact;
      if (a === 'start' && !(await confirmBox(`Kirim template "${c.templateName}" ke ${c.counts.queued} kontak? Pesan template berbayar sesuai tarif Meta.`, 'Kirim'))) return campaignDetail(id);
      if (a === 'run' && !(await confirmBox(`Kirim template "${c.templateName}" sekarang, tanpa menunggu jadwal?`, 'Kirim sekarang'))) return campaignDetail(id);
      if (a === 'cancel' && !(await confirmBox('Batalkan campaign? Penerima yang masih antre akan dilewati.', 'Batalkan', true))) return campaignDetail(id);
      busy(b, async () => { await api('POST', `/api/campaigns/${id}/${a}`); campaignDetail(id); if (S.view === 'campaigns') viewCampaigns(); });
    }));
    $('[data-parent]')?.addEventListener('click', (e) => campaignDetail(e.currentTarget.dataset.parent));
  }
  function campaignSeriesDetail(c, act) {
    const id = c.id;
    modal(c.name, `<div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2 text-xs">${statusBadge(c.status)}<span class="badge">Berulang</span><span class="ink-3">Template <span class="mono">${esc(c.templateName)}</span> · ${esc(c.language)} · ${c.labels.length ? 'Label: ' + esc(c.labels.join(', ')) : 'Semua kontak'}${c.optInOnly ? ' · opt-in saja' : ''}</span></div>
      <div class="sched-box">${ICON.clock}<div><div class="text-[13px] font-medium">${esc(c.scheduleText)}</div>
        <div class="text-[11px] ink-3">${c.status === 'scheduled' ? 'Berikutnya: ' + fmtTz(c.nextRunAt, { weekday: 'long' }) : c.status === 'paused' ? 'Seri dijeda — tidak ada kiriman baru.' : 'Seri berakhir.'}${c.sendWindow ? ` · Jam kirim ${c.sendWindow.start.replace(':', '.')}–${c.sendWindow.end.replace(':', '.')}` : ''} · Zona waktu ${esc(TZ)}</div></div></div>
      ${c.lastError ? `<div class="text-xs danger-ink">${esc(c.lastError)}</div>` : ''}
      <div class="grid grid-cols-3 gap-2">${[['Sudah dikirim', `${fmtNum(c.runCount || 0)}×${c.maxRuns ? ' / ' + c.maxRuns : ''}`], ['Perkiraan penerima', '±' + fmtNum(c.previewTotal)], ['Terakhir', c.lastRunAt ? fmtTz(c.lastRunAt) : '—']].map(([l, n]) => `<div class="card p-2.5"><div class="text-[11px] ink-3">${l}</div><div class="text-sm font-semibold">${n}</div></div>`).join('')}</div>
      <div><div class="text-xs font-semibold mb-2">Riwayat kiriman</div><div class="card overflow-x-auto"><table class="tbl"><thead><tr><th>Waktu</th><th>Status</th><th class="text-right">Penerima</th><th class="text-right">Terkirim</th><th class="text-right">Dibaca</th><th class="text-right">Gagal</th><th></th></tr></thead><tbody>
        ${(c.runs || []).map((r) => `<tr><td class="text-xs whitespace-nowrap">${fmtTz(r.startedAt)}</td><td>${statusBadge(r.status)}</td><td class="text-right">${fmtNum(r.total)}</td><td class="text-right">${fmtNum(r.counts.sent + r.counts.delivered + r.counts.read)}</td><td class="text-right">${fmtNum(r.counts.read)}</td><td class="text-right ${r.counts.failed ? 'danger-ink' : ''}">${fmtNum(r.counts.failed)}</td><td class="text-right"><button class="btn btn-sm" data-run="${r.id}">Detail</button></td></tr>`).join('') || '<tr><td colspan="7"><div class="empty">Belum ada kiriman.</div></td></tr>'}
      </tbody></table></div></div>
    </div>`, { wide: true, footer: `<div class="flex-1"></div>
      ${['scheduled', 'paused'].includes(c.status) ? act('run', 'Kirim sekarang') : ''}${c.status === 'scheduled' ? act('pause', 'Jeda seri') : ''}${c.status === 'paused' ? act('start', 'Lanjutkan seri', 'btn-primary') : ''}${!['done', 'cancelled'].includes(c.status) ? act('cancel', 'Hentikan seri', 'btn-danger') : ''}` });
    $$('[data-run]').forEach((b) => b.addEventListener('click', () => campaignDetail(b.dataset.run)));
    $$('[data-cact]').forEach((b) => b.addEventListener('click', async () => {
      const a = b.dataset.cact;
      if (a === 'run' && !(await confirmBox(`Kirim "${c.templateName}" ke ±${c.previewTotal} kontak sekarang? Jadwal berikutnya tidak berubah.`, 'Kirim sekarang'))) return campaignDetail(id);
      if (a === 'cancel' && !(await confirmBox('Hentikan seri? Tidak ada kiriman baru setelah ini. Kiriman yang sedang berjalan tetap dilanjutkan.', 'Hentikan', true))) return campaignDetail(id);
      busy(b, async () => { await api('POST', `/api/campaigns/${id}/${a}`); campaignDetail(id); if (S.view === 'campaigns') viewCampaigns(); });
    }));
  }

  /* ───────────── Jadwal (dipakai broadcast terjadwal & pengingat) ───────────── */
  // Semua jadwal memakai zona waktu aplikasi (Auto reply), bukan zona waktu browser
  const TZ = BOOT?.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone;
  const fmtTz = (t, o = {}) => (t ? new Intl.DateTimeFormat('id-ID', { timeZone: TZ, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', ...o }).format(new Date(t)) : '—');
  const tzParts = (t = Date.now()) => ({
    date: new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(t)),
    time: new Intl.DateTimeFormat('en-GB', { timeZone: TZ, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(t)),
  });
  const tzAddDays = (ymd, n) => new Date(Date.UTC(+ymd.slice(0, 4), +ymd.slice(5, 7) - 1, +ymd.slice(8, 10) + n)).toISOString().slice(0, 10);
  const ymdDow = (ymd) => new Date(ymd + 'T00:00:00Z').getUTCDay();
  function relDue(t) {
    const d = t - Date.now(), a = Math.abs(d);
    const s = a < 60e3 ? 'kurang dari 1 menit' : a < 3600e3 ? Math.round(a / 60e3) + ' menit' : a < 864e5 ? Math.round(a / 3600e3) + ' jam' : Math.round(a / 864e5) + ' hari';
    return d >= 0 ? 'dalam ' + s : s + ' lalu';
  }
  const SCHED_FREQ = { none: 'Tidak berulang', daily: 'Setiap hari', weekly: 'Setiap minggu', monthly: 'Setiap bulan' };
  function schedFieldsHtml({ repeat = true, maxRuns = false } = {}) {
    const n = tzParts(Date.now() + 3600e3), today = tzParts().date;
    return `<div class="space-y-3" data-sched>
      <div class="grid grid-cols-2 gap-2">
        <div><label class="label">Tanggal${repeat ? ' mulai' : ''}</label><input type="date" class="input" name="s_date" value="${n.date}" min="${today}" required></div>
        <div><label class="label">Jam</label><input type="time" class="input" name="s_time" value="${n.time.slice(0, 2)}:00" required></div>
      </div>
      ${repeat ? `<div><label class="label">Ulangi</label><select class="select" name="s_freq">${Object.entries(SCHED_FREQ).map(([k, l]) => `<option value="${k}">${l}</option>`).join('')}</select></div>
      <div data-s-show="weekly" class="hidden"><div class="label">Hari</div><div class="flex flex-wrap gap-x-3 gap-y-1.5">${AR_DAYS.map((d, i) => `<label class="flex items-center gap-1.5 text-[13px]"><input type="checkbox" class="check" name="s_day" value="${i}">${d}</label>`).join('')}</div></div>
      <div data-s-show="repeat" class="hidden grid grid-cols-2 gap-2">
        <div><label class="label">Sampai tanggal</label><input type="date" class="input" name="s_until" min="${today}"><p class="hint">Kosong = tanpa batas.</p></div>
        ${maxRuns ? '<div><label class="label">Maks. pengiriman</label><input type="number" class="input" name="s_max" min="0" max="1000" placeholder="Tanpa batas"></div>' : ''}
      </div>` : ''}
      <p class="hint" data-s-text></p>
    </div>`;
  }
  function readSched(f) {
    return { date: f.s_date.value, time: f.s_time.value, freq: f.s_freq?.value || 'none', days: $$('input[name=s_day]:checked', f).map((x) => +x.value),
      until: f.s_until?.value || '', maxRuns: f.s_max ? Number(f.s_max.value) || 0 : 0 };
  }
  function schedSummary(s) {
    if (!s.date || !s.time) return '';
    const t = s.time.replace(':', '.');
    const d = new Date(s.date + 'T00:00:00Z').toLocaleDateString('id-ID', { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    if (s.freq === 'none') return `Dikirim ${d}, pukul ${t}`;
    const base = s.freq === 'daily' ? `Setiap hari pukul ${t}` : s.freq === 'weekly' ? (s.days.length ? `Setiap ${s.days.map((x) => AR_DAYS[x]).join(', ')} pukul ${t}` : 'Pilih minimal satu hari')
      : `Setiap tanggal ${+s.date.slice(8, 10)} pukul ${t}${+s.date.slice(8, 10) > 28 ? ' (bulan yang lebih pendek: hari terakhir)' : ''}`;
    return `${base}, mulai ${d}${s.until ? ' sampai ' + new Date(s.until + 'T00:00:00Z').toLocaleDateString('id-ID', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' }) : ''}${s.maxRuns ? `, maks. ${s.maxRuns} kali` : ''}`;
  }
  function bindSched(f) {
    const box = $('[data-sched]', f); if (!box) return;
    const upd = () => {
      const s = readSched(f);
      $$('[data-s-show]', box).forEach((el) => el.classList.toggle('hidden', el.dataset.sShow === 'repeat' ? s.freq === 'none' : el.dataset.sShow !== s.freq));
      $('[data-s-text]', box).textContent = `${schedSummary(s)} · Zona waktu ${TZ}`;
    };
    f.s_freq?.addEventListener('change', () => {
      // Mingguan: centang hari dari tanggal mulai agar langsung valid
      if (f.s_freq.value === 'weekly' && !$$('input[name=s_day]:checked', f).length && f.s_date.value) { const cb = $(`input[name=s_day][value="${ymdDow(f.s_date.value)}"]`, f); if (cb) cb.checked = true; }
      upd();
    });
    box.addEventListener('input', upd); box.addEventListener('change', upd);
    upd();
  }

  /* ───────────── Pengingat ───────────── */
  const REM_STATUS = { pending: ['Terjadwal', 'amber'], due: ['Jatuh tempo', 'red'], done: ['Selesai', 'green'], sent: ['Terkirim', 'green'], failed: ['Gagal', 'red'], skipped: ['Dilewati', ''], cancelled: ['Dibatalkan', ''] };
  const remBadge = (s) => { const [l, c] = REM_STATUS[s] || [s, '']; return `<span class="badge ${c ? 'badge-' + c : ''}"><span class="dot"></span>${esc(l)}</span>`; };
  const remMine = (r) => (r.assigneeId || r.createdById) === S.user.id;
  const remActive = (r) => ['pending', 'due'].includes(r.status);
  const remDueCount = () => S.rem.list.filter((r) => r.status === 'due' && r.kind === 'self' && remMine(r)).length;
  async function loadReminders() {
    const d = await api('GET', '/api/reminders');
    S.rem.list = d.reminders; S.rem.users = d.users; S.rem.loaded = true;
    remChanged();
    // Tampilkan kembali pengingat jatuh tempo milik saya (12 jam terakhir) yang belum ditangani
    S.rem.list.filter((r) => r.status === 'due' && r.kind === 'self' && remMine(r) && Date.now() - (r.firedAt || 0) < 12 * 3600e3).slice(0, 3).forEach((r) => showRemDue(r, true));
  }
  function remUpsert(r) {
    const i = S.rem.list.findIndex((x) => x.id === r.id);
    if (i >= 0) S.rem.list[i] = r; else S.rem.list.unshift(r);
    if (!(r.status === 'due' && remMine(r))) $(`#rem-stack [data-rid="${r.id}"]`)?.remove();
    remChanged();
  }
  function remChanged() {
    renderNav();
    if (S.view === 'reminders') renderRemList();
    const c = activeConv();
    if (S.view === 'inbox' && c) {
      const box = $('#info-rem'); if (box && !box.contains(document.activeElement)) box.innerHTML = remInfoHtml(c);
      const b = $('#cv-rem'); if (b) b.innerHTML = remBtnInner(c);
    }
  }
  const remTitle = (r) => r.kind === 'self' ? (r.note || 'Tindak lanjut percakapan')
    : r.note || (r.mode === 'template' ? 'Template ' + r.template.templateName : remText(r).slice(0, 120));
  const remText = (r) => String(r.text || '').replace(/\{\{\s*name\s*\}\}/g, r.contactName || 'Kak');
  function remItemHtml(r, { contact = false } = {}) {
    const late = r.status === 'due' || (r.status === 'pending' && r.dueAt < Date.now());
    const who = r.kind === 'self' ? (remMine(r) ? '' : `Untuk ${esc(r.assigneeName)} · `) : `${r.mode === 'template' ? 'Template' : 'Teks'}${r.fallback ? ' + cadangan' : ''} · `;
    const acts = [];
    if (r.kind === 'self' && remActive(r)) acts.push(`<button class="btn btn-sm btn-primary" data-ra="done">${ICON.check} Selesai</button>`, `<div class="relative"><button class="btn btn-sm" data-ra="snooze-menu">Tunda</button></div>`);
    if (remActive(r)) acts.push(`<button class="btn btn-sm btn-ghost" data-ra="cancel">Batalkan</button>`);
    if (r.kind === 'self' && r.status === 'done') acts.push(`<button class="btn btn-sm btn-ghost" data-ra="reopen">Buka lagi</button>`);
    if (!remActive(r)) acts.push(`<button class="btn btn-sm btn-ghost btn-icon" data-ra="delete" title="Hapus" aria-label="Hapus">${ICON.trash}</button>`);
    return `<div class="rem-item ${r.status === 'due' ? 'is-due' : ''}" data-rid="${r.id}">
      <div class="rem-ic">${r.kind === 'self' ? ICON.bell : ICON.send}</div>
      <div class="min-w-0 flex-1">
        <div class="flex items-start gap-2"><div class="text-[13px] font-medium flex-1 min-w-0 break-words">${r.kind === 'customer' && !r.note && r.mode === 'text' ? waFormat(remTitle(r)) : esc(remTitle(r))}</div>${remBadge(r.status)}</div>
        ${contact ? `<a class="text-xs accent-ink hover:underline" href="#/inbox/${r.conversationId}">${esc(r.contactName || '+' + r.phone)}</a>` : ''}
        ${r.kind === 'customer' && r.note && r.mode === 'text' ? `<div class="text-xs ink-2 truncate">${esc(remText(r))}</div>` : ''}
        <div class="text-[11px] ink-3 mt-0.5">${who}${remActive(r) ? `<span class="${late ? 'danger-ink' : ''}">${fmtTz(r.dueAt)} · ${relDue(r.dueAt)}</span>` : [r.lastDetail || REM_STATUS[r.status]?.[0], fmtTz(r.finishedAt || r.lastRunAt)].map(esc).join(' · ')}${r.scheduleText && r.schedule?.freq !== 'none' ? ` · ${esc(r.scheduleText)}` : ''}</div>
        ${r.kind === 'customer' && r.lastStatus && remActive(r) ? `<div class="text-[11px] ${r.lastStatus === 'sent' ? 'ink-3' : 'danger-ink'}">Terakhir: ${esc(REM_STATUS[r.lastStatus]?.[0] || r.lastStatus)} — ${esc(r.lastDetail || '')}</div>` : ''}
        <div class="flex flex-wrap items-center gap-1.5 mt-2">${acts.join('')}
          <details class="rem-hist"><summary class="text-[11px] ink-3 cursor-pointer">Riwayat</summary><ol class="mt-1 space-y-0.5">${(r.history || []).slice().reverse().map((h) => `<li class="text-[11px]"><span class="ink-3">${fmtTz(h.at)}</span> · ${esc(h.detail)}</li>`).join('')}</ol></details>
        </div>
      </div></div>`;
  }
  const SNOOZE = [[15, '15 menit'], [60, '1 jam'], [180, '3 jam'], ['tomorrow', 'Besok 09.00']];
  // Menit dari sekarang sampai besok 09.00 waktu aplikasi
  function snoozeMinutes(v) {
    if (v !== 'tomorrow') return v;
    const [h, m] = tzParts().time.split(':').map(Number);
    return (24 * 60 - (h * 60 + m)) + 9 * 60;
  }
  // Delegasi tombol pengingat (daftar, panel info, kartu jatuh tempo)
  document.addEventListener('click', (e) => {
    const b = e.target.closest('[data-ra]'); if (!b) return;
    const item = b.closest('[data-rid]'), r = S.rem.list.find((x) => x.id === item?.dataset.rid); if (!r) return;
    const a = b.dataset.ra;
    if (a === 'snooze-menu') {
      e.stopPropagation();
      $$('.rem-snooze').forEach((x) => x.remove());
      const m = document.createElement('div'); m.className = 'rem-snooze pop';
      m.innerHTML = SNOOZE.map(([v, l]) => `<button data-ra="snooze" data-min="${v}">${l}</button>`).join('');
      b.parentElement.appendChild(m);
      setTimeout(() => document.addEventListener('click', () => m.remove(), { once: true }));
      return;
    }
    if (a === 'open') { location.hash = '#/inbox/' + r.conversationId; b.closest('#rem-stack [data-rid]')?.remove(); return; }
    if (a === 'dismiss') { item.remove(); return; }
    busy(b, async () => {
      if (a === 'delete') { await api('DELETE', `/api/reminders/${r.id}`); S.rem.list = S.rem.list.filter((x) => x.id !== r.id); remChanged(); return; }
      if (a === 'cancel' && !(await confirmBox(r.kind === 'customer' ? 'Batalkan pesan terjadwal ini? Pesan tidak akan dikirim.' : 'Batalkan pengingat ini?', 'Batalkan', true))) return;
      const n = await api('POST', `/api/reminders/${r.id}/${a}`, a === 'snooze' ? { minutes: snoozeMinutes(b.dataset.min === 'tomorrow' ? 'tomorrow' : +b.dataset.min) } : undefined);
      remUpsert(n);
      if (a === 'snooze') toast(`Ditunda sampai ${fmtTz(n.dueAt)}.`);
    });
  });
  // Kartu "jatuh tempo" di pojok layar: tetap tampil sampai ditangani atau ditutup
  function showRemDue(r, quiet) {
    let root = $('#rem-stack');
    if (!root) { root = document.createElement('div'); root.id = 'rem-stack'; root.setAttribute('aria-live', 'polite'); document.body.appendChild(root); }
    $(`[data-rid="${r.id}"]`, root)?.remove();
    const el = document.createElement('div'); el.className = 'rem-due'; el.dataset.rid = r.id; el.setAttribute('role', 'alert');
    el.innerHTML = `<div class="flex items-start gap-2"><span class="accent-ink mt-0.5">${ICON.bell}</span><div class="min-w-0 flex-1">
        <div class="text-[11px] ink-3">Pengingat · ${fmtTz(r.dueAt, { weekday: undefined })}</div>
        <div class="text-[13px] font-medium break-words">${esc(remTitle(r))}</div><div class="text-xs ink-2 truncate">${esc(r.contactName || '+' + r.phone)}</div></div>
        <button class="btn btn-ghost btn-icon" data-ra="dismiss" aria-label="Tutup">${ICON.x}</button></div>
      <div class="flex flex-wrap gap-1.5 mt-2"><button class="btn btn-sm btn-primary" data-ra="open">Buka chat</button><button class="btn btn-sm" data-ra="done">Selesai</button><div class="relative"><button class="btn btn-sm" data-ra="snooze-menu">Tunda</button></div></div>`;
    root.appendChild(el);
    while (root.children.length > 3) root.firstElementChild.remove();
    if (!quiet) { playChime(true); notifyBrowser('⏰ Pengingat', `${remTitle(r)} — ${r.contactName || '+' + r.phone}`); }
  }

  // Panel info Inbox
  function remBtnInner(c) {
    const act = S.rem.list.filter((r) => r.conversationId === c.id && remActive(r));
    const due = act.some((r) => r.status === 'due');
    return ICON.clock + (act.length ? `<span class="rem-dot ${due ? 'due' : ''}">${act.length}</span>` : '');
  }
  function remInfoHtml(c) {
    const list = S.rem.list.filter((r) => r.conversationId === c.id);
    const act = list.filter(remActive), past = list.filter((r) => !remActive(r)).slice(0, 3);
    return `<div class="flex items-center justify-between mb-2"><div class="text-xs font-semibold">Pengingat</div><button class="btn btn-sm" data-act="rem-new">${ICON.plus} Buat</button></div>
      <div class="space-y-2">${act.map((r) => remItemHtml(r)).join('') || '<p class="text-xs ink-3">Tidak ada pengingat aktif.</p>'}</div>
      ${past.length ? `<details class="mt-2"><summary class="text-[11px] ink-3 cursor-pointer">Riwayat (${list.length - act.length})</summary><div class="space-y-2 mt-2">${past.map((r) => remItemHtml(r)).join('')}</div></details>` : ''}`;
  }
  ACT['rem-new'] = () => { const c = activeConv(); if (c) reminderModal(c); };

  async function reminderModal(conv, kind = 'self') {
    const k = conv.contact;
    const tpls = (await ensureTemplates().catch(() => [])).filter((t) => t.status === 'APPROVED');
    const tplOpts = (none) => (none ? '<option value="">— Tidak ada (lewati bila jendela tertutup) —</option>' : '') + tpls.map((t, i) => {
      const blocked = t.category === 'MARKETING' && !k.optIn;
      return `<option value="${i}" ${blocked ? 'disabled' : ''}>${esc(t.name)} · ${esc(t.language)} · ${esc(t.category)}${blocked ? ' (perlu opt-in)' : ''}</option>`;
    }).join('');
    const firstOk = tpls.findIndex((t) => !(t.category === 'MARKETING' && !k.optIn));
    const p = tzParts(), tomorrow = tzAddDays(p.date, 1);
    const nextMon = tzAddDays(p.date, ((8 - ymdDow(p.date)) % 7) || 7);
    const presets = [['30m', '30 menit'], ['60m', '1 jam'], ['180m', '3 jam'], [`${tomorrow} 09:00`, 'Besok 09.00'], [`${nextMon} 09:00`, 'Senin 09.00']];
    const winEnd = conv.windowOpen ? conv.windowExpiresAt : 0;
    modal('Pengingat · ' + contactName(k), `
      <div class="seg mb-4" role="tablist"><button type="button" data-rk="self" class="${kind === 'self' ? 'active' : ''}">Ingatkan saya</button><button type="button" data-rk="customer" class="${kind === 'customer' ? 'active' : ''}">Kirim ke pelanggan</button></div>
      <form id="f-rem-self" class="space-y-3 ${kind === 'self' ? '' : 'hidden'}">
        <div><div class="label">Kapan</div><div class="flex flex-wrap gap-1.5">${presets.map(([v, l]) => `<button type="button" class="btn btn-sm" data-preset="${v}">${l}</button>`).join('')}</div></div>
        <div class="grid grid-cols-2 gap-2"><div><label class="label">Tanggal</label><input type="date" class="input" name="date" min="${p.date}" value="${p.date}" required></div>
          <div><label class="label">Jam</label><input type="time" class="input" name="time" value="${tzParts(Date.now() + 3600e3).time}" required></div></div>
        <input type="hidden" name="inMinutes" value="">
        <div><label class="label">Catatan</label><textarea class="textarea" name="note" rows="2" maxlength="500" placeholder="mis. Tanyakan konfirmasi pembayaran"></textarea></div>
        ${S.isAdmin && S.rem.users.length > 1 ? `<div><label class="label">Ingatkan</label><select class="select" name="assigneeId">${S.rem.users.map((u) => `<option value="${u.id}" ${u.id === S.user.id ? 'selected' : ''}>${esc(u.name)}${u.id === S.user.id ? ' (saya)' : ''}</option>`).join('')}</select></div>` : ''}
        <label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" name="reopen" checked> Buka kembali percakapan bila sudah selesai</label>
        <p class="hint">Pada waktunya muncul notifikasi di Kontaq (dan WhatsApp pribadi bila diaktifkan di Pengaturan › Notifikasi). Zona waktu ${esc(TZ)}.</p>
      </form>
      <div id="rem-cust" class="${kind === 'customer' ? '' : 'hidden'}">
        <form id="f-rem-cust" class="space-y-3">
          <div class="seg" id="rem-mode"><button type="button" data-mode="text" class="active">Pesan teks</button><button type="button" data-mode="template" ${tpls.length ? '' : 'disabled title="Belum ada template APPROVED"'}>Template</button></div>
          <div data-m="text" class="space-y-3">
            <div><label class="label">Pesan</label><textarea class="textarea" name="text" rows="3" maxlength="4096" placeholder="Halo {{name}}, mengingatkan jadwal Anda besok pukul 10.00."></textarea>
              <p class="hint"><span class="kbd">{{name}}</span> nama kontak. Pesan teks hanya terkirim bila jendela 24 jam masih terbuka saat jadwal — ${winEnd ? `jendela saat ini berakhir ${fmtTz(winEnd)}` : '<span class="danger-ink">jendela saat ini sudah tertutup</span>'}.</p></div>
            <div><label class="label">Bila jendela 24 jam tertutup, kirim template</label><select class="select" name="fb">${tplOpts(true)}</select></div>
          </div>
          <div data-m="template" class="hidden space-y-3"><div><label class="label">Template</label><select class="select" name="tpl">${tplOpts(false)}</select></div></div>
        </form>
        <form id="f-rem-tpl" class="space-y-3 mt-3"></form>
        <form id="f-rem-when" class="space-y-3 mt-3 pt-3 border-t bd">${schedFieldsHtml({ repeat: true })}
          <div><label class="label">Label internal (opsional)</label><input class="input" name="note" maxlength="200" placeholder="mis. Pengingat cicilan"></div></form>
        <div id="rem-prev" class="mt-3"></div>
      </div>`, { footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="rem-go">Simpan pengingat</button>' });
    let cur = kind, mode = 'text';
    const fs = $('#f-rem-self'), fc = $('#f-rem-cust'), ft = $('#f-rem-tpl'), fw = $('#f-rem-when');
    if (firstOk >= 0) fc.tpl.value = firstOk;
    $$('[data-rk]').forEach((b) => b.addEventListener('click', () => {
      cur = b.dataset.rk; $$('[data-rk]').forEach((x) => x.classList.toggle('active', x === b));
      fs.classList.toggle('hidden', cur !== 'self'); $('#rem-cust').classList.toggle('hidden', cur !== 'customer');
    }));
    $$('[data-preset]', fs).forEach((b) => b.addEventListener('click', () => {
      $$('[data-preset]', fs).forEach((x) => x.classList.toggle('btn-primary', x === b));
      const v = b.dataset.preset;
      if (v.endsWith('m')) { const t = tzParts(Date.now() + parseInt(v) * 60e3); fs.date.value = t.date; fs.time.value = t.time; fs.inMinutes.value = parseInt(v); }
      else { const [d, t] = v.split(' '); fs.date.value = d; fs.time.value = t; fs.inMinutes.value = ''; }
    }));
    fs.addEventListener('input', (e) => { if (['date', 'time'].includes(e.target.name)) { fs.inMinutes.value = ''; $$('[data-preset]', fs).forEach((x) => x.classList.remove('btn-primary')); } });
    // Template (utama atau cadangan) memakai form terpisah agar nama field variabel tidak bentrok
    const activeTpl = () => (mode === 'template' ? tpls[fc.tpl.value] : fc.fb.value !== '' ? tpls[fc.fb.value] : null);
    const drawTpl = () => {
      const t = activeTpl();
      ft.innerHTML = t ? `<div class="text-[11px] ink-3">${mode === 'template' ? 'Variabel template' : 'Variabel template cadangan'}</div>${tplFieldsHtml(t, { campaign: true })}` : '';
      drawPrev();
    };
    const drawPrev = () => {
      const t = activeTpl();
      $('#rem-prev').innerHTML = mode === 'text' && fc.text.value.trim() ? `<div class="chat-bg rounded-md p-3"><div class="bubble out">${waFormat(fc.text.value.replace(/\{\{\s*name\s*\}\}/g, contactName(k)))}</div></div>`
        : t && mode === 'template' ? tplPreview(t, ft) : '';
    };
    $$('#rem-mode [data-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode; $$('#rem-mode [data-mode]').forEach((x) => x.classList.toggle('active', x === b));
      $$('[data-m]', fc).forEach((x) => x.classList.toggle('hidden', x.dataset.m !== mode)); drawTpl();
    }));
    fc.addEventListener('change', (e) => { if (['tpl', 'fb'].includes(e.target.name)) drawTpl(); });
    fc.addEventListener('input', drawPrev); ft.addEventListener('input', drawPrev);
    bindSched(fw); drawTpl();
    $('#rem-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      let body;
      if (cur === 'self') {
        if (!fs.reportValidity()) return;
        body = { kind: 'self', conversationId: conv.id, note: fs.note.value, reopen: fs.reopen.checked, assigneeId: fs.assigneeId?.value || undefined,
          ...(fs.inMinutes.value ? { inMinutes: +fs.inMinutes.value } : { date: fs.date.value, time: fs.time.value }) };
      } else {
        if (mode === 'text' && !fc.text.value.trim()) { fc.text.focus(); throw new Error('Isi pesan wajib diisi.'); }
        if (!ft.reportValidity() || !fw.reportValidity()) return;
        const t = activeTpl(), tv = t && { templateName: t.name, language: t.language, values: readTplValues(t, ft) };
        body = { kind: 'customer', conversationId: conv.id, mode, note: fw.note.value, ...readSched(fw),
          ...(mode === 'text' ? { text: fc.text.value, fallback: tv || null } : { template: tv }) };
      }
      const r = await api('POST', '/api/reminders', body);
      remUpsert(r); closeModal();
      toast(r.kind === 'self' ? `Pengingat diatur: ${fmtTz(r.dueAt)}.` : `Pesan dijadwalkan: ${fmtTz(r.dueAt)}.`);
    }));
  }

  // Halaman Pengingat
  const REM_TABS = [['due', 'Jatuh tempo'], ['upcoming', 'Akan datang'], ['customer', 'Pesan terjadwal'], ['history', 'Riwayat']];
  async function viewReminders() {
    const v = $('#view');
    v.innerHTML = `<div class="p-4 md:p-6 max-w-4xl space-y-3">
      <div class="flex flex-wrap items-center gap-2"><div class="seg" id="rem-tabs">${REM_TABS.map(([k, l]) => `<button data-tab="${k}" class="${S.rem.tab === k ? 'active' : ''}">${l}<span class="ml-1 ink-3" data-cnt="${k}"></span></button>`).join('')}</div>
        <div class="flex-1"></div>
        ${S.isAdmin ? `<label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" id="rem-all" ${S.rem.all ? 'checked' : ''}> Semua pengguna</label>` : ''}
        <input class="input h-8 w-full sm:w-44" id="rem-q" placeholder="Cari kontak/catatan" value="${esc(S.rem.q || '')}" aria-label="Cari pengingat">
      </div>
      <p class="text-xs ink-3">Buat pengingat dari Inbox (ikon jam di atas chat atau panel info kontak). Jadwal memakai zona waktu ${esc(TZ)}.</p>
      <div id="rem-list" class="space-y-2"><div class="empty">Memuat…</div></div></div>`;
    $$('#rem-tabs [data-tab]').forEach((b) => b.addEventListener('click', () => { S.rem.tab = b.dataset.tab; $$('#rem-tabs [data-tab]').forEach((x) => x.classList.toggle('active', x === b)); renderRemList(); }));
    $('#rem-all')?.addEventListener('change', (e) => { S.rem.all = e.target.checked; renderRemList(); });
    $('#rem-q').addEventListener('input', (e) => { S.rem.q = e.target.value; renderRemList(); });
    try { await loadReminders(); } catch (e) { $('#rem-list').innerHTML = `<div class="empty">${esc(e.message)}</div>`; }
  }
  function renderRemList() {
    const box = $('#rem-list'); if (!box || !S.rem.loaded) return;
    const q = (S.rem.q || '').toLowerCase();
    const base = S.rem.list.filter((r) => (S.rem.all || remMine(r) || r.createdById === S.user.id)
      && (!q || [r.contactName, r.phone, r.note, r.text].some((x) => String(x || '').toLowerCase().includes(q))));
    const groups = {
      due: base.filter((r) => r.kind === 'self' && r.status === 'due'),
      upcoming: base.filter((r) => r.kind === 'self' && r.status === 'pending').sort((a, b) => a.dueAt - b.dueAt),
      customer: base.filter((r) => r.kind === 'customer' && r.status === 'pending').sort((a, b) => a.dueAt - b.dueAt),
      history: base.filter((r) => !remActive(r)).sort((a, b) => (b.finishedAt || 0) - (a.finishedAt || 0)),
    };
    REM_TABS.forEach(([k]) => { const el = $(`[data-cnt="${k}"]`); if (el) el.textContent = k === 'history' ? '' : groups[k].length || ''; });
    const rows = groups[S.rem.tab] || [];
    const empty = { due: 'Tidak ada pengingat jatuh tempo.', upcoming: 'Belum ada pengingat terjadwal.', customer: 'Belum ada pesan terjadwal ke pelanggan.', history: 'Belum ada riwayat.' }[S.rem.tab];
    box.innerHTML = rows.slice(0, 300).map((r) => `<div class="card p-3">${remItemHtml(r, { contact: true })}</div>`).join('') || `<div class="card"><div class="empty">${empty}</div></div>`;
  }

  /* ───────────── Auto reply ───────────── */
  const AR_DAYS = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  const AR_MATCH = { contains: 'Mengandung kata', exact: 'Sama persis', starts: 'Diawali dengan' };
  const TZ_LIST = ['Asia/Jakarta', 'Asia/Makassar', 'Asia/Jayapura', 'Asia/Singapore', 'Asia/Kuala_Lumpur', 'UTC'];
  const sw = (id, on, label) => `<label class="switch ${on ? 'on' : ''}" title="${esc(label)}"><input type="checkbox" class="sr-only" id="${id}" ${on ? 'checked' : ''} role="switch" aria-label="${esc(label)}"><span></span></label>`;
  // Perkecil gambar (sisi terpanjang maks 1600px, JPEG) sebelum diunggah
  async function resizeMedia(file, max = 1600) {
    const img = await createImageBitmap(file);
    const k = Math.min(1, max / Math.max(img.width, img.height));
    const c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.85);
  }
  const arImg = (key, cls = '') => `<img src="/api/autoreply/media/${key}" alt="" class="object-cover rounded-md border bd ${cls}">`;
  function imgPickerHtml(p, key) {
    return `${key ? arImg(key, 'w-20 h-20') : `<div class="w-20 h-20 rounded-md border border-dashed flex items-center justify-center ink-3" style="border-color:var(--border-strong)">${ICON.image.replace('<svg', '<svg width="22" height="22"')}</div>`}
      <div class="flex flex-col items-start gap-1.5">
        <label class="btn btn-sm cursor-pointer">${key ? 'Ganti gambar' : 'Pilih gambar'}<input type="file" accept="image/jpeg,image/png" class="hidden" data-ar-img="${p}"></label>
        ${key ? `<button type="button" class="btn btn-sm btn-ghost btn-danger" data-ar-img-del="${p}">Hapus gambar</button>` : '<span class="text-[11px] ink-3">JPEG/PNG, diperkecil otomatis</span>'}
      </div>`;
  }
  function replyExtrasHtml(p, src) {
    return `<div class="grid sm:grid-cols-[auto_1fr] gap-4 rounded-md surface-2 p-3">
        <div><div class="label">Gambar <span class="ink-3 font-normal">(opsional)</span></div><div class="flex items-center gap-3" id="${p}-img">${imgPickerHtml(p, src.image)}</div></div>
        <div class="min-w-0"><div class="label">Tombol balasan <span class="ink-3 font-normal">(opsional, maks. 3 · 20 karakter)</span></div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">${[0, 1, 2].map((i) => `<input class="input" maxlength="20" data-ar-btn="${p}" value="${esc(src.buttons?.[i] || '')}" placeholder="Tombol ${i + 1}" aria-label="Tombol ${i + 1}">`).join('')}</div>
          <p class="hint">Bila memakai gambar atau tombol, teks maksimal 1024 karakter. Tombol yang ditekan pelanggan masuk sebagai pesan, jadi bisa memicu aturan lain (mis. aturan <i>Sama persis</i>: "Lihat harga").</p></div>
      </div>`;
  }
  const readButtons = (p, root = document) => $$(`[data-ar-btn="${p}"]`, root).map((x) => x.value.trim()).filter(Boolean);
  async function uploadArImage(file) {
    if (!file) return null;
    const r = await api('POST', '/api/autoreply/media', { dataUrl: await resizeMedia(file) });
    return r.key;
  }
  async function viewAutoReply() {
    const v = $('#view');
    try { S.ar = await api('GET', '/api/autoreply'); } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (S.view !== 'autoreply') return;
    S.arDirty = false;
    renderAutoReply();
  }
