  function templateCreateModal() {
    modal('Buat template', `<form id="f-tc" class="grid md:grid-cols-2 gap-4">
      <div class="space-y-3">
        <div><label class="label">Nama</label><input class="input mono" name="name" required pattern="[a-z0-9_]+" placeholder="promo_oktober"><p class="hint">Huruf kecil, angka, garis bawah.</p></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="label">Kategori</label><select class="select" name="category"><option>MARKETING</option><option>UTILITY</option><option>AUTHENTICATION</option></select></div>
          <div><label class="label">Bahasa</label><select class="select" name="language"><option value="id">Indonesia (id)</option><option value="en_US">English US (en_US)</option><option value="en">English (en)</option><option value="ms">Melayu (ms)</option></select></div>
        </div>
        <div><label class="label">Header teks (opsional)</label><input class="input" name="headerText" maxlength="60" placeholder="Halo {{1}}"></div>
