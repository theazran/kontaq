        <div class="grid grid-cols-2 gap-3">
          <div><label class="label" for="wfs-c">Teks tombol <span class="ink-3 font-normal">(maks. 30)</span></label><input class="input" id="wfs-c" name="cta" maxlength="30" required value="Isi formulir"></div>
          <div><label class="label" for="wfs-s">Screen pertama</label><input class="input mono" id="wfs-s" name="screen" list="wfs-screens" maxlength="80" required><datalist id="wfs-screens"></datalist></div></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="label" for="wfs-h">Header <span class="ink-3 font-normal">(opsional)</span></label><input class="input" id="wfs-h" name="header" maxlength="60"></div>
          <div><label class="label" for="wfs-ft">Footer <span class="ink-3 font-normal">(opsional)</span></label><input class="input" id="wfs-ft" name="footer" maxlength="60"></div></div>
        <p class="hint" id="wfs-hint"></p>
      </div>
      <div><div class="label">Pratinjau</div><div id="wfs-prev"></div></div></form>`
      : `<div class="empty">Belum ada flow yang terbit.<br>${S.isAdmin ? '<a href="#/waflows" class="accent-ink" data-act="modal-close">Buka WhatsApp Flows</a>' : '<span class="text-xs">Minta admin menerbitkan flow.</span>'}</div>`,
    { wide: true, footer: usable.length ? '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="wfs-go">Kirim</button>' : '' });
    if (!usable.length) return;
    const f = $('#f-wfs'), cur = () => usable.find((x) => x.id === f.flowId.value);
    const draw = () => {
      const x = cur();
      if (f.dataset.flow !== x.id) {
        $('#wfs-screens').innerHTML = x.screens.map((s) => `<option value="${esc(s.id)}">${esc(s.title)}</option>`).join('');
        f.screen.value = x.screens[0]?.id || '';
        f.screen.placeholder = x.screens.length ? '' : 'ID screen, mis. MULAI';
        f.dataset.flow = x.id;
      }
      $('#wfs-hint').textContent = (x.screens.length ? '' : 'Flow JSON belum dimuat — ketik ID screen pertama, atau buka flow di menu WhatsApp Flows. ')
        + (x.status === 'DRAFT' ? 'Mode draf hanya untuk uji internal; pelanggan biasa tidak dapat membukanya.' : 'Jawaban pelanggan muncul di chat dan di menu WhatsApp Flows.');
      $('#wfs-prev').innerHTML = `<div class="chat-bg rounded-md p-3"><div class="bubble out">${f.header.value ? `<div class="font-semibold">${esc(f.header.value)}</div>` : ''}${waFormat(f.body.value)}${f.footer.value ? `<div class="text-[11px] ink-3 mt-0.5">${esc(f.footer.value)}</div>` : ''}<span class="ib-btn">${ICON.form.replace('<svg', '<svg width="12" height="12" style="display:inline;vertical-align:-1px"')} ${esc(f.cta.value)}</span></div></div>`;
    };
    f.addEventListener('input', draw); f.addEventListener('change', draw); draw();
    $('#wfs-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!f.reportValidity()) return;
      const x = cur();
      await sendMsg({ type: 'flow', flowId: x.id, body: f.body.value, cta: f.cta.value, header: f.header.value, footer: f.footer.value, screen: f.screen.value, mode: x.status === 'DRAFT' ? 'draft' : 'published' });
      closeModal(); toast('Formulir dikirim.');
    }));
  }

  /* ───────────── CSAT (kepuasan pelanggan) ───────────── */
  const CSAT_LABEL = { 5: { 5: 'Sangat puas', 4: 'Puas', 3: 'Cukup', 2: 'Kurang puas', 1: 'Sangat kecewa' }, 3: { 3: 'Puas', 2: 'Biasa saja', 1: 'Tidak puas' } };
  const CSAT_STATUS = { sent: ['amber', 'Menunggu jawaban'], answered: ['green', 'Dijawab'], expired: ['', 'Kedaluwarsa'], failed: ['red', 'Gagal'], skipped: ['', 'Dilewati'] };
  const csatBadge = (s) => { const [c, l] = CSAT_STATUS[s] || ['', s]; return `<span class="badge ${c ? 'badge-' + c : ''}">${esc(l)}</span>`; };
  const csatScoreText = (x) => (x.score ? `${x.scale === 5 ? '★'.repeat(x.score) + '☆'.repeat(5 - x.score) + ' ' : ''}${CSAT_LABEL[x.scale]?.[x.score] || x.score}` : '');
  const fmtPct = (n) => (n == null || n === '' ? '—' : String(n).replace('.', ',') + '%');
  function csatInfoHtml(c) {
    const x = c.csat;
    return `<div class="flex items-center justify-between mb-2"><div class="text-xs font-semibold">Survei kepuasan</div>${x ? csatBadge(x.status) : ''}</div>
      ${x ? `<div class="text-xs space-y-1">${x.score ? `<div class="font-medium">${esc(csatScoreText(x))}</div>` : ''}
          ${x.comment ? `<div class="ink-2 whitespace-pre-wrap">“${esc(x.comment)}”</div>` : ''}
          <div class="ink-3">${x.answeredAt ? 'Dijawab ' + esc(fmtDT(x.answeredAt)) : 'Dikirim ' + esc(fmtDT(x.sentAt))}${x.reason ? ' · ' + esc(x.reason) : ''}</div></div>`
        : '<p class="text-xs ink-3">Belum ada survei untuk percakapan ini.</p>'}
      <button class="btn btn-sm w-full mt-2" id="csat-send" ${c.windowOpen ? '' : 'disabled title="Jendela layanan 24 jam sudah tertutup"'}>${ICON.star} Kirim survei sekarang</button>
      ${c.windowOpen ? '' : '<p class="hint">Survei hanya dapat dikirim selama jendela layanan 24 jam terbuka.</p>'}`;
  }

  async function viewCsat() {
    const v = $('#view'), tok = location.hash;
    S.csat = S.csat || { range: '30', from: '', to: '', agent: '' };
    v.innerHTML = '<div class="p-4 md:p-6"><div class="card p-4 text-xs ink-3">Memuat laporan CSAT…</div></div>';
    try {
      const [r, users] = await Promise.all([api('GET', '/api/csat/report?' + csatQuery()), S.isAdmin && !S.users.length ? api('GET', '/api/users').catch(() => []) : S.users]);
      S.users = users; S.csat.report = r;
    } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (location.hash !== tok) return;
    renderCsat();
  }
  const isoDay = (t) => { const d = new Date(t); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
  function csatQuery() {
    const s = S.csat, p = new URLSearchParams();
    if (s.range === 'custom') { if (s.from) p.set('from', s.from); if (s.to) p.set('to', s.to); }
    else { p.set('from', isoDay(Date.now() - (Number(s.range) - 1) * 864e5)); p.set('to', isoDay(Date.now())); }
    if (s.agent) p.set('agent', s.agent);
    return p.toString();
  }
  function renderCsat() {
    const s = S.csat, r = s.report, v = $('#view');
    const tile = (label, value, sub) => `<div class="card p-4"><div class="text-xs ink-3">${label}</div><div class="text-2xl font-semibold tracking-tight mt-1">${value}</div>${sub ? `<div class="text-[11px] ink-3 mt-0.5">${sub}</div>` : ''}</div>`;
    const scale = r.settings.scale;
    // Distribusi nilai skala aktif; jawaban skala lain (bila pengaturan pernah diubah) dicatat terpisah
    const dist = Object.keys(CSAT_LABEL[scale]).map(Number).sort((a, b) => b - a).map((score) => ({ score, n: r.distribution[`${scale}:${score}`] || 0 }));
    const otherScale = Object.entries(r.distribution).filter(([k]) => !k.startsWith(scale + ':')).reduce((t, [, n]) => t + n, 0);
    const distTotal = dist.reduce((t, d) => t + d.n, 0) || 1;
    const days = r.daily.filter((d) => d.answered);
    v.innerHTML = `<div class="p-4 md:p-6 space-y-4 max-w-7xl">
      ${S.isAdmin && !r.settings.enabled ? `<div class="card p-3 flex flex-wrap items-center gap-3" style="background:var(--warn-soft);border-color:transparent"><span style="color:var(--warn)">${ICON.info}</span><div class="flex-1 min-w-0 text-[13px]">Survei otomatis saat percakapan ditutup belum aktif. Survei manual dari inbox tetap bisa dikirim.</div><button class="btn btn-sm" id="cs-settings-2">Atur survei</button></div>` : ''}
      <div class="flex flex-wrap items-center gap-2">
        <div class="seg" id="cs-range">${[['7', '7 hari'], ['30', '30 hari'], ['90', '90 hari'], ['custom', 'Pilih tanggal']].map(([k, l]) => `<button data-v="${k}" class="${s.range === k ? 'active' : ''}">${l}</button>`).join('')}</div>
        ${s.range === 'custom' ? `<input type="date" class="input h-8 w-auto" id="cs-from" value="${esc(s.from)}" aria-label="Dari tanggal"><span class="ink-3 text-xs">s.d.</span><input type="date" class="input h-8 w-auto" id="cs-to" value="${esc(s.to)}" aria-label="Sampai tanggal">` : ''}
        ${S.isAdmin ? `<select class="select h-8 w-auto" id="cs-agent" aria-label="Filter agen"><option value="">Semua agen</option>${S.users.map((u) => `<option value="${esc(u.id)}" ${s.agent === u.id ? 'selected' : ''}>${esc(u.name)}</option>`).join('')}</select>` : '<span class="text-xs ink-3">Menampilkan survei percakapan Anda.</span>'}
        <div class="flex-1"></div>
        ${S.isAdmin ? `<a class="btn btn-sm" href="/api/csat/export?${esc(csatQuery())}">Ekspor CSV</a><button class="btn btn-sm" id="cs-settings">${ICON.gear} Pengaturan survei</button>` : ''}
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        ${tile('Skor CSAT', fmtPct(r.csat), r.answered ? `${fmtNum(r.satisfied)} dari ${fmtNum(r.answered)} jawaban puas` : 'belum ada jawaban')}
        ${tile('Rata-rata nilai', r.avg == null ? '—' : String(r.avg).replace('.', ',') + ' <span class="text-sm ink-3 font-normal">/ 5</span>', scale === 3 || otherScale ? 'jawaban skala 3 dinormalkan ke 5' : 'dari 5 bintang')}
        ${tile('Tingkat respons', fmtPct(r.responseRate), `${fmtNum(r.answered)} dijawab dari ${fmtNum(r.sent)} terkirim`)}
        ${tile('Survei terkirim', fmtNum(r.sent), `${fmtNum(r.expired)} kedaluwarsa · ${fmtNum(r.failed)} gagal`)}
      </div>
      <div class="grid lg:grid-cols-3 gap-4">
        <section class="card lg:col-span-2">
          <div class="card-h"><div><div class="card-t">Skor CSAT harian</div><div class="text-[11px] ink-3">% jawaban puas, menurut hari survei dikirim</div></div><button class="btn btn-ghost btn-sm" id="cs-table-toggle">Tabel</button></div>
          <div class="p-4">
            <div id="cs-chart-wrap">${days.length ? `
              <div class="bar-chart" id="cs-chart" role="img" aria-label="Grafik skor CSAT harian">
                ${r.daily.map((d) => `<div class="bar-col" data-tip="${esc(fmtDate(d.t))}|${d.csat ?? ''}|${d.answered}"><div class="bar bar-csat" style="height:${d.csat ?? 0}%"></div></div>`).join('')}
              </div>
              <div class="flex justify-between text-[10px] ink-3 mt-2 border-t bd pt-1.5"><span>${esc(fmtDate(r.from))}</span><span>skala 0–100%</span><span>${esc(fmtDate(r.to - 864e5))}</span></div>`
              : '<div class="empty">Belum ada jawaban survei pada rentang ini.</div>'}</div>
            <div id="cs-table" class="hidden max-h-64 overflow-y-auto scroll-thin"><table class="tbl"><thead><tr><th>Tanggal</th><th class="text-right">Jawaban</th><th class="text-right">CSAT</th></tr></thead>
              <tbody>${days.map((d) => `<tr><td>${esc(fmtDate(d.t))}</td><td class="text-right">${d.answered}</td><td class="text-right">${fmtPct(d.csat)}</td></tr>`).join('') || '<tr><td colspan="3" class="ink-3">Belum ada data.</td></tr>'}</tbody></table></div>
          </div>
        </section>
        <section class="card">
          <div class="card-h"><div class="card-t">Distribusi nilai</div><span class="text-[11px] ink-3">skala ${scale}</span></div>
          <div class="p-4 space-y-3">
            ${dist.map((d) => `<div><div class="flex justify-between text-xs mb-1"><span class="ink-2">${esc(scale === 5 ? `${d.score} · ` : '')}${esc(CSAT_LABEL[scale][d.score])}</span><span class="font-medium">${fmtNum(d.n)} <span class="ink-3 font-normal">· ${Math.round((d.n / distTotal) * 100)}%</span></span></div>
              <div class="h-1.5 rounded-full surface-2 overflow-hidden"><div class="h-full rounded-full" style="width:${(d.n / distTotal) * 100}%;background:var(--accent)"></div></div></div>`).join('')}
            ${otherScale ? `<p class="hint">${fmtNum(otherScale)} jawaban memakai skala lain (sebelum pengaturan diubah) — tetap dihitung di skor CSAT dan rata-rata.</p>` : ''}
            <p class="hint">Puas = nilai ${scale === 5 ? '4–5' : '"Puas"'}. CSAT = jawaban puas ÷ semua jawaban.</p>
          </div>
        </section>
      </div>
      <div class="grid lg:grid-cols-2 gap-4">
        <section class="card overflow-hidden">
          <div class="card-h"><div class="card-t">Per agen</div><span class="text-[11px] ink-3">agen yang menangani saat survei dikirim</span></div>
          <div class="overflow-x-auto"><table class="tbl"><thead><tr><th>Agen</th><th class="text-right">Terkirim</th><th class="text-right">Dijawab</th><th class="text-right">Rata-rata</th><th class="text-right">CSAT</th></tr></thead>
            <tbody>${r.agents.map((a) => `<tr><td><div class="flex items-center gap-2"><span class="avatar" style="width:1.5rem;height:1.5rem;font-size:10px">${initials(a.name)}</span>${esc(a.name)}</div></td><td class="text-right">${fmtNum(a.sent)}</td><td class="text-right">${fmtNum(a.answered)}</td><td class="text-right">${a.avg == null ? '—' : String(a.avg).replace('.', ',')}</td><td class="text-right font-medium">${fmtPct(a.csat)}</td></tr>`).join('') || '<tr><td colspan="5" class="ink-3">Belum ada data.</td></tr>'}</tbody></table></div>
        </section>
        <section class="card">
          <div class="card-h"><div class="card-t">Masukan pelanggan</div><span class="text-[11px] ink-3">${fmtNum(r.comments.length)} terbaru</span></div>
          <div class="max-h-[22rem] overflow-y-auto scroll-thin">${r.comments.map((x) => `<a href="#/inbox/${esc(x.conversationId)}" class="block px-4 py-3 border-b bd last:border-0 hover:bg-[var(--surface-2)]">
              <div class="flex items-center gap-2 text-xs"><span class="font-medium">${esc(csatScoreText(x))}</span><span class="flex-1"></span><span class="ink-3">${esc(fmtDT(x.answeredAt))}</span></div>
              <div class="text-[13px] ink mt-1 whitespace-pre-wrap break-words">“${esc(x.comment)}”</div>
              <div class="text-[11px] ink-3 mt-1">${esc(x.contact)}${x.agentName ? ' · ' + esc(x.agentName) : ''}</div></a>`).join('') || '<div class="empty">Belum ada masukan tertulis.</div>'}</div>
        </section>
      </div>
      <section class="card overflow-hidden">
        <div class="card-h"><div class="card-t">Survei terbaru</div><span class="text-[11px] ink-3">100 terakhir pada rentang ini</span></div>
        <div class="overflow-x-auto"><table class="tbl"><thead><tr><th>Dikirim</th><th>Kontak</th><th>Agen</th><th>Pemicu</th><th>Status</th><th>Nilai</th></tr></thead>
          <tbody>${r.recent.map((x) => `<tr><td class="whitespace-nowrap">${esc(fmtDT(x.sentAt))}</td><td><a class="hover:underline" href="#/inbox/${esc(x.conversationId)}">${esc(x.contact)}</a></td><td>${esc(x.agentName || '—')}</td>
            <td>${esc({ close: 'Ditutup agen', flow: 'Flow', manual: 'Manual' }[x.trigger] || x.trigger)}</td><td>${csatBadge(x.status)}${x.status === 'failed' && x.reason ? `<div class="text-[11px] danger-ink">${esc(x.reason)}</div>` : ''}</td><td class="whitespace-nowrap">${esc(csatScoreText(x) || '—')}</td></tr>`).join('') || '<tr><td colspan="6" class="ink-3">Belum ada survei.</td></tr>'}</tbody></table></div>
      </section>
    </div>`;
    $$('#cs-range [data-v]').forEach((b) => b.addEventListener('click', () => {
      s.range = b.dataset.v;
      if (s.range === 'custom' && !s.from) { s.from = isoDay(Date.now() - 29 * 864e5); s.to = isoDay(Date.now()); }
      viewCsat();
    }));
    $('#cs-from')?.addEventListener('change', (e) => { s.from = e.target.value; viewCsat(); });
    $('#cs-to')?.addEventListener('change', (e) => { s.to = e.target.value; viewCsat(); });
    $('#cs-agent')?.addEventListener('change', (e) => { s.agent = e.target.value; viewCsat(); });
    $('#cs-settings')?.addEventListener('click', csatSettingsModal);
    $('#cs-settings-2')?.addEventListener('click', csatSettingsModal);
    $('#cs-table-toggle').addEventListener('click', (e) => {
      const showTable = $('#cs-table').classList.toggle('hidden') === false;
      $('#cs-chart-wrap').classList.toggle('hidden', showTable);
      e.target.textContent = showTable ? 'Grafik' : 'Tabel';
    });
    const tip = $('#chart-tip');
    $$('#cs-chart .bar-col').forEach((col) => {
      col.addEventListener('mousemove', (e) => {
        const [d, pct, n] = col.dataset.tip.split('|');
        tip.innerHTML = `<b>${esc(d)}</b><br>${Number(n) ? `CSAT: ${esc(fmtPct(pct))}<br>Jawaban: ${esc(n)}` : 'Belum ada jawaban'}`;
        tip.classList.remove('hidden'); tip.style.left = e.clientX + 12 + 'px'; tip.style.top = e.clientY - 40 + 'px';
      });
      col.addEventListener('mouseleave', () => tip.classList.add('hidden'));
    });
  }
  async function csatSettingsModal() {
    let s;
    try { s = await api('GET', '/api/csat/settings'); } catch (e) { return fail(e); }
    const preview = (x) => `<div class="chat-bg rounded-md p-3"><div class="bubble out">${waFormat(x.question.replace(/\{\{\s*name\s*\}\}/g, 'Budi'))}${x.footer ? `<div class="text-[11px] ink-3 mt-1">${esc(x.footer)}</div>` : ''}
      ${Number(x.scale) === 5 ? `<span class="ib-btn">☰ ${esc(x.button)}</span><div class="text-[11px] ink-3 mt-1">${Object.entries(CSAT_LABEL[5]).reverse().map(([k, l]) => `${k} · ${esc(l)}`).join(' / ')}</div>` : Object.values(CSAT_LABEL[3]).reverse().map((l) => `<span class="ib-btn">${esc(l)}</span>`).join('')}</div></div>`;
    modal('Pengaturan survei CSAT', `<form id="f-csat" class="grid md:grid-cols-[1fr_17rem] gap-5">
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-3"><span><span class="block font-medium text-[13px]">Kirim survei otomatis</span><span class="block text-[11px] ink-3">Saat percakapan ditandai Selesai.</span></span>${sw('cs-enabled', s.enabled, 'Aktifkan survei otomatis')}</div>
        <div class="space-y-1.5 pl-0.5">
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="sendOnClose" ${s.sendOnClose ? 'checked' : ''}> Saat agen menutup percakapan</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="sendOnFlowClose" ${s.sendOnFlowClose ? 'checked' : ''}> Saat flow otomatis menutup percakapan</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="onlyIfAgentReplied" ${s.onlyIfAgentReplied ? 'checked' : ''}> Hanya bila agen sudah membalas sejak survei terakhir</label>
        </div>
        <div><div class="label">Skala penilaian</div>
          <div class="seg" id="cs-scale"><button type="button" data-v="5" class="${s.scale === 5 ? 'active' : ''}">1–5 (daftar pilihan)</button><button type="button" data-v="3" class="${s.scale === 3 ? 'active' : ''}">3 tombol</button></div></div>
        <div><label class="label" for="cs-q">Pertanyaan</label><textarea class="textarea" id="cs-q" name="question" rows="3" maxlength="1024">${esc(s.question)}</textarea><p class="hint">Variabel <span class="kbd">{{name}}</span>.</p></div>
        <div class="grid sm:grid-cols-2 gap-3">
          <div id="cs-button-wrap" class="${s.scale === 5 ? '' : 'hidden'}"><label class="label" for="cs-b">Teks tombol daftar</label><input class="input" id="cs-b" name="button" maxlength="20" value="${esc(s.button)}"></div>
          <div><label class="label" for="cs-f">Footer (opsional)</label><input class="input" id="cs-f" name="footer" maxlength="60" value="${esc(s.footer)}"></div>
        </div>
        <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="askComment" id="cs-ask" ${s.askComment ? 'checked' : ''}> Minta masukan tertulis setelah menilai</label>
        <div id="cs-comment-wrap" class="${s.askComment ? '' : 'hidden'} grid sm:grid-cols-[1fr_9rem] gap-3">
          <div><label class="label" for="cs-cp">Pesan permintaan masukan</label><textarea class="textarea" id="cs-cp" name="commentPrompt" rows="2" maxlength="1024">${esc(s.commentPrompt)}</textarea></div>
          <div><label class="label" for="cs-cm">Tunggu masukan (menit)</label><input class="input" type="number" min="1" max="1440" id="cs-cm" name="commentMinutes" value="${s.commentMinutes}"></div>
        </div>
        <div><label class="label" for="cs-t">Pesan terima kasih</label><textarea class="textarea" id="cs-t" name="thanks" rows="2" maxlength="1024">${esc(s.thanks)}</textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="label" for="cs-exp">Masa berlaku survei (jam)</label><input class="input" type="number" min="1" max="24" id="cs-exp" name="expireHours" value="${s.expireHours}"></div>
          <div><label class="label" for="cs-cd">Jeda per kontak (jam)</label><input class="input" type="number" min="0" max="720" id="cs-cd" name="cooldownHours" value="${s.cooldownHours}"></div>
        </div>
        <p class="hint">Survei dan balasannya hanya dikirim selama jendela layanan 24 jam terbuka. Jawaban survei tidak membuka kembali percakapan yang sudah selesai dan tidak memicu flow maupun auto reply.</p>
      </div>
      <div><div class="label">Pratinjau</div><div id="cs-prev">${preview(s)}</div></div>
    </form>`, { wide: true, footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="cs-save">Simpan</button>' });
    const f = $('#f-csat');
    let scale = s.scale;
    const read = () => {
      const d = formData(f);
      return { ...d, enabled: $('#cs-enabled').checked, scale, sendOnClose: !!d.sendOnClose, sendOnFlowClose: !!d.sendOnFlowClose, onlyIfAgentReplied: !!d.onlyIfAgentReplied,
        askComment: !!d.askComment, commentMinutes: Number(d.commentMinutes), expireHours: Number(d.expireHours), cooldownHours: Number(d.cooldownHours) };
    };
    const redraw = () => { $('#cs-prev').innerHTML = preview(read()); };
    f.addEventListener('input', redraw);
    f.addEventListener('change', (e) => {
      if (e.target.id === 'cs-enabled') e.target.closest('.switch').classList.toggle('on', e.target.checked);
      if (e.target.id === 'cs-ask') $('#cs-comment-wrap').classList.toggle('hidden', !e.target.checked);
    });
    $$('#cs-scale [data-v]').forEach((b) => b.addEventListener('click', () => {
      scale = Number(b.dataset.v);
      $$('#cs-scale [data-v]').forEach((x) => x.classList.toggle('active', x === b));
      $('#cs-button-wrap').classList.toggle('hidden', scale !== 5); redraw();
    }));
    $('#cs-save').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      await api('PUT', '/api/csat/settings', read()); closeModal(); toast('Pengaturan survei disimpan.');
      if (S.view === 'csat') viewCsat();
    }));
  }

  /* ───────────── Grup WhatsApp (Groups API) ─────────────
   * Banyak aksi bersifat asinkron di Meta (buat, hapus, ubah pengaturan, keluarkan peserta): UI menampilkan
   * "Menunggu konfirmasi Meta" sampai webhook tiba, tidak langsung menganggap berhasil.
   */
  const GR_STATUS = { creating: ['amber', 'Menunggu Meta'], active: ['green', 'Aktif'], suspended: ['red', 'Ditangguhkan'], deleting: ['amber', 'Menghapus…'], deleted: ['', 'Dihapus'], failed: ['red', 'Gagal dibuat'] };
  const GR_TABS = [['chat', 'Pesan'], ['people', 'Peserta'], ['invite', 'Undangan'], ['settings', 'Pengaturan'], ['activity', 'Aktivitas']];
  const grBadge = (s) => { const [c, l] = GR_STATUS[s] || ['', s]; return `<span class="badge ${c ? 'badge-' + c : ''}"><span class="dot"></span>${esc(l)}</span>`; };
  const grActive = (g) => g && g.groupId && ['active', 'suspended'].includes(g.status);
  const grAvatar = (g, cls = 'w-9 h-9') => (g.hasPhoto && g.photoStatus !== 'failed'
    ? `<img src="/api/groups/${esc(g.id)}/photo?v=${g.photoAt || 0}" alt="" class="${cls} rounded-full object-cover flex-none">`
    : `<span class="${cls} rounded-full surface-2 flex items-center justify-center flex-none ink-2">${ICON.group.replace('<svg', '<svg width="16" height="16"')}</span>`);
  const grPerson = (key) => {
    const c = (S.gr.contacts || []).find((x) => x.phone === key);
    return c ? `${esc(c.name || c.waName || 'Kontak')} <span class="ink-3">+${esc(c.phone)}</span>` : `+${esc(key)}`;
  };

  async function viewGroups(arg) {
    const v = $('#view'), tok = location.hash;
    v.className = 'flex-1 min-h-0 overflow-hidden';
    S.gr = { tab: S.gr?.tab || 'chat', contacts: S.gr?.contacts || [], ...S.gr, activeId: arg || (isMobile() ? null : S.gr?.activeId || null), detail: null };
    v.innerHTML = '<div class="p-4"><div class="card p-4 text-xs ink-3">Memuat grup…</div></div>';
    try { Object.assign(S.gr, await api('GET', '/api/groups')); } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (location.hash !== tok) return;
    if (S.gr.activeId && !S.gr.groups.some((g) => g.id === S.gr.activeId)) S.gr.activeId = null;
    renderGroups();
    if (S.gr.activeId) loadGroup(S.gr.activeId);
  }
  async function loadGroup(id) {
    try {
      const d = await api('GET', '/api/groups/' + encodeURIComponent(id));
      if (S.view !== 'groups' || S.gr.activeId !== id) return;
      S.gr.detail = d; renderGroupDetail(true);
      if (d.unread) { api('POST', `/api/groups/${encodeURIComponent(id)}/read`).catch(() => {}); const row = S.gr.groups.find((g) => g.id === id); if (row) row.unread = 0; renderGroupList(); }
    } catch (e) { fail(e); }
  }
  function renderGroups() {
    const a = S.gr.activeId;
    $('#view').innerHTML = `<div class="h-full flex">
      <section id="gr-list" class="w-full md:w-80 flex-none border-r bd surface flex-col ${a ? 'hidden md:flex' : 'flex'}">
        <div class="p-3 border-b bd flex items-center gap-2">
          <div class="flex-1 min-w-0"><div class="text-[13px] font-semibold">Grup WhatsApp</div><div class="text-[11px] ink-3">${S.gr.groups.length} grup · maks. ${S.gr.maxParticipants} peserta/grup</div></div>
          <button class="btn btn-ghost btn-icon btn-sm" id="gr-sync" title="Sinkronkan dari Meta" aria-label="Sinkronkan dari Meta">${ICON.refresh}</button>
          <button class="btn btn-primary btn-sm" id="gr-new">${ICON.plus} Grup</button>
        </div>
        <div id="gr-rows" class="flex-1 overflow-y-auto scroll-thin"></div>
      </section>
      <section id="gr-detail" class="flex-1 min-w-0 flex-col ${a ? 'flex' : 'hidden md:flex'}"></section>
    </div>`;
    renderGroupList();
    renderGroupDetail();
    $('#gr-new').addEventListener('click', groupCreateModal);
    $('#gr-sync').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const r = await api('POST', '/api/groups/sync');
      S.gr.groups = r.groups; renderGroupList(); toast(`${r.total} grup aktif di Meta, ${r.added} baru ditambahkan.`);
    }));
  }
  function renderGroupList() {
    const el = $('#gr-rows'); if (!el) return;
    const rows = S.gr.groups.slice().sort((x, y) => (y.lastMessageAt || y.createdAt) - (x.lastMessageAt || x.createdAt));
    el.innerHTML = rows.map((g) => `<a href="#/groups/${esc(g.id)}" class="flex gap-3 px-3 py-2.5 border-b bd ${S.gr.activeId === g.id ? 'surface-2' : 'hover:bg-[var(--surface-2)]'}">
        ${grAvatar(g)}
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2"><span class="font-medium text-[13px] truncate flex-1">${esc(g.subject)}</span><span class="text-[11px] ink-3 flex-none">${esc(relTime(g.lastMessageAt || g.createdAt))}</span></div>
          <div class="flex items-center gap-2 mt-0.5"><span class="text-xs ink-3 truncate flex-1">${esc(g.preview || `${g.participants.length} peserta`)}</span>
            ${g.unread ? `<span class="badge badge-green flex-none">${g.unread}</span>` : g.status !== 'active' ? `<span class="flex-none">${grBadge(g.status)}</span>` : ''}
            ${g.joinRequests.length ? `<span class="badge badge-amber flex-none" title="Permintaan bergabung">${g.joinRequests.length}</span>` : ''}</div>
        </div></a>`).join('')
      || `<div class="empty">Belum ada grup.<br><span class="text-xs">Buat grup baru, atau klik ${ICON.refresh.replace('<svg', '<svg width="12" height="12" style="display:inline"')} untuk mengambil grup yang sudah ada di Meta.</span></div>`;
  }
  function renderGroupDetail(scroll) {
    const el = $('#gr-detail'); if (!el) return;
    const g = S.gr.detail;
    if (!S.gr.activeId || !g) {
      el.innerHTML = S.gr.activeId ? '<div class="p-6 text-xs ink-3">Memuat…</div>' : `<div class="m-auto max-w-md p-6 text-center">
        <div class="inline-flex w-10 h-10 rounded-lg surface-2 items-center justify-center ink-2 mb-3">${ICON.group.replace('<svg', '<svg width="20" height="20"')}</div>
        <div class="font-semibold">Kelola grup lewat Groups API resmi</div>
        <p class="text-xs ink-3 mt-1.5">Buat grup, bagikan tautan undangan, kirim pesan & media ke grup, serta kelola peserta dan permintaan bergabung.</p>
        <div class="text-left text-xs ink-2 surface-2 rounded-md p-3 mt-4 space-y-1.5">
          <div><b>Syarat:</b> nomor bisnis berstatus <i>Official Business Account</i> (OBA). Maks. ${S.gr.maxParticipants} peserta per grup.</div>
          <div><b>Webhook:</b> subscribe field ${S.gr.webhookFields.map((f) => `<span class="kbd">${esc(f)}</span>`).join(' ')} di Meta App Dashboard — ID grup, tautan undangan, dan perubahan peserta hanya datang lewat webhook.</div>
          <div><b>Peserta</b> bergabung lewat tautan undangan atau permintaan bergabung yang Anda setujui; bisnis tidak dapat menambahkan peserta secara langsung.</div>
        </div></div>`;
      return;
    }
    const pendingText = [g.pending?.subject && `nama "${g.pending.subject}"`, g.pending?.description !== undefined && 'deskripsi', g.photoStatus === 'pending' && 'foto', g.pending?.remove && `${g.pending.remove.length} peserta dikeluarkan`].filter(Boolean);
    el.innerHTML = `<div class="flex items-center gap-3 px-3 md:px-4 py-2.5 border-b bd surface">
        <a href="#/groups" class="btn btn-ghost btn-icon btn-sm md:hidden" aria-label="Kembali">${ICON.back}</a>
        ${grAvatar(g)}
        <div class="min-w-0 flex-1"><div class="flex items-center gap-2"><span class="font-semibold text-[13px] truncate">${esc(g.subject)}</span>${grBadge(g.status)}</div>
          <div class="text-[11px] ink-3 truncate">${g.participants.length}/${S.gr.maxParticipants} peserta · ${g.joinApprovalMode === 'approval_required' ? 'Perlu persetujuan admin' : 'Langsung bergabung'}${g.syncedAt ? ' · disinkronkan ' + esc(fmtDT(g.syncedAt)) : ''}</div></div>
        ${grActive(g) ? `<button class="btn btn-sm" id="gr-refresh" title="Muat info, tautan undangan, dan permintaan bergabung dari Meta">${ICON.refresh}<span class="hidden sm:inline">Muat ulang</span></button>` : ''}
      </div>
      ${g.status === 'creating' ? `<div class="px-4 py-2 text-xs border-b bd" style="background:var(--warn-soft);color:var(--warn)">Permintaan diterima Meta. ID grup dan tautan undangan akan muncul setelah webhook <span class="kbd">group_lifecycle_update</span> tiba.</div>` : ''}
      ${g.error ? `<div class="px-4 py-2 text-xs border-b bd" style="background:var(--danger-soft);color:var(--danger)">${esc(g.error)}</div>` : ''}
      ${pendingText.length ? `<div class="px-4 py-2 text-xs border-b bd ink-2 surface-2">Menunggu konfirmasi Meta: ${esc(pendingText.join(', '))}.</div>` : ''}
      <div class="tabs px-4 surface flex-none">${GR_TABS.map(([k, l]) => `<button class="tab ${S.gr.tab === k ? 'active' : ''}" data-gr-tab="${k}">${l}${k === 'people' && g.joinRequests.length ? ` <span class="badge badge-amber ml-1">${g.joinRequests.length}</span>` : ''}</button>`).join('')}</div>
      <div id="gr-body" class="flex-1 min-h-0 flex flex-col"></div>`;
    $$('[data-gr-tab]', el).forEach((b) => b.addEventListener('click', () => { S.gr.tab = b.dataset.grTab; renderGroupDetail(true); }));
    $('#gr-refresh')?.addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const d = await api('POST', `/api/groups/${encodeURIComponent(g.id)}/refresh`);
      S.gr.detail = d; grSyncRow(d); renderGroupDetail();
      toast(d.warnings?.length ? 'Dimuat ulang dengan catatan: ' + d.warnings.join('; ') : 'Info grup dimuat ulang dari Meta.', !!d.warnings?.length);
    }));
    ({ chat: grChatTab, people: grPeopleTab, invite: grInviteTab, settings: grSettingsTab, activity: grActivityTab })[S.gr.tab](g, scroll);
  }
  function grSyncRow(d) {
    const i = S.gr.groups.findIndex((x) => x.id === d.id);
    const { messages, events, invites, ...row } = d;
    if (i >= 0) S.gr.groups[i] = { ...S.gr.groups[i], ...row }; else S.gr.groups.unshift(row);
    renderGroupList();
  }
  const grApply = (d) => { S.gr.detail = d; grSyncRow(d); renderGroupDetail(); };
  const grApi = (method, path, body) => api(method, `/api/groups/${encodeURIComponent(S.gr.detail.id)}${path}`, body);
  const grNotActive = (g) => `<div class="empty">${g.status === 'creating' ? 'Menunggu Meta selesai membuat grup.' : g.status === 'deleted' ? 'Grup sudah dihapus.' : 'Grup tidak aktif.'}</div>`;

  /* Tab: pesan grup */
  function grChatTab(g, scroll) {
    const body = $('#gr-body');
    body.innerHTML = `<div id="gr-msgs" class="flex-1 min-h-0 overflow-y-auto scroll-thin chat-bg px-3 md:px-6 py-3 space-y-1"></div>
      ${grActive(g) ? `<div class="border-t bd surface p-2">
        ${S.gr.replyTo ? `<div class="flex items-center gap-2 px-2 pb-2 text-xs"><span class="ink-3 flex-1 truncate">Membalas: ${esc(quoteText(g.messages.find((m) => m.id === S.gr.replyTo) || {}).slice(0, 80))}</span><button class="btn btn-ghost btn-icon btn-sm" id="gr-reply-x" aria-label="Batal membalas">${ICON.x}</button></div>` : ''}
        <div class="flex items-end gap-1.5">
          <button class="btn btn-ghost btn-icon flex-none" id="gr-attach" title="Kirim media" aria-label="Kirim media">${ICON.clip}</button>
          <button class="btn btn-ghost btn-icon flex-none" id="gr-tpl" title="Kirim template" aria-label="Kirim template">${ICON.tpl}</button>
          <textarea class="textarea flex-1 min-w-0" id="gr-text" rows="1" maxlength="4096" placeholder="${g.status === 'suspended' ? 'Grup ditangguhkan — pesan tidak dapat dikirim' : 'Tulis pesan ke grup…'}" ${g.status === 'suspended' ? 'disabled' : ''} style="max-height:8rem"></textarea>
          <button class="btn btn-primary btn-icon flex-none" id="gr-send" aria-label="Kirim" ${g.status === 'suspended' ? 'disabled' : ''}>${ICON.send}</button>
        </div>
        <p class="hint px-2">Grup mendukung teks, media, dan template. Pesan interaktif, lokasi, dan panggilan tidak tersedia di grup. Status terkirim/dibaca dari webhook (gabungan semua peserta).</p>
      </div>` : ''}`;
    grRenderMsgs(true);
    bindMsgActions($('#gr-msgs'), () => S.gr.detail?.messages || []);
    if (!grActive(g)) return;
    const ta = $('#gr-text');
    const send = () => busy($('#gr-send'), async () => {
      const text = ta.value.trim(); if (!text) return;
      await grSend({ type: 'text', body: text }); ta.value = '';
    });
    $('#gr-send').addEventListener('click', send);
    ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey && !isTouch) { e.preventDefault(); send(); } });
    ta.addEventListener('input', () => { ta.style.height = 'auto'; ta.style.height = ta.scrollHeight + 'px'; });
    $('#gr-reply-x')?.addEventListener('click', () => { S.gr.replyTo = null; grChatTab(g); });
    $('#gr-attach').addEventListener('click', grMediaModal);
    $('#gr-tpl').addEventListener('click', grTemplateModal);
    if (!isTouch) ta.focus();
  }
  // Pesan yang gagal tetap dicatat server (status failed) dan tiba lewat socket; error-nya diteruskan ke pemanggil (toast)
  async function grSend(body) {
    const g = S.gr.detail;
    const msg = await grApi('POST', '/messages', { ...body, replyTo: S.gr.replyTo || undefined });
    if (!g.messages.some((m) => m.id === msg.id)) g.messages.push(msg);
    S.gr.replyTo = null;
    if (S.gr.tab === 'chat') grChatTab(g);
  }
  function grRenderMsgs(scroll) {
    const el = $('#gr-msgs'); if (!el) return;
    const g = S.gr.detail, near = el.scrollHeight - el.scrollTop - el.clientHeight < 120;
    let lastDay = '';
    el.innerHTML = g.messages.map((m) => {
      const out = m.direction === 'out', day = new Date(m.timestamp).toDateString();
      const sep = day !== lastDay ? `<div class="flex justify-center py-2"><span class="day-sep">${esc(fmtDate(m.timestamp))}</span></div>` : '';
      lastDay = day;
      const quoted = m.contextId ? g.messages.find((x) => x.wamid === m.contextId) : null;
      return sep + `<div class="msg-row flex ${out ? 'justify-end' : 'justify-start'} group">
        ${out ? `<button class="reply-btn opacity-0 group-hover:opacity-100 ink-3 self-center p-1 mr-1" data-gr-reply="${m.id}" title="Balas" aria-label="Balas">${ICON.reply.replace('<svg', '<svg width="14" height="14"')}</button>` : ''}
        <div class="bubble ${out ? 'out' : 'in'} ${m.reaction ? 'mb-3' : ''}">
          ${!out ? `<div class="text-[11px] font-semibold mb-0.5" style="color:var(--info)">${esc(m.fromName || '+' + m.from)}</div>` : ''}
          ${quoted ? `<div class="text-[11px] ink-3 border-l-2 pl-2 mb-1" style="border-color:var(--accent)">${esc(quoteText(quoted).slice(0, 80))}</div>` : ''}
          ${msgBody(m)}
          <div class="meta">${out && m.userName ? `<span>${esc(m.userName)} ·</span>` : ''}<span>${fmtTime(m.timestamp)}</span>${out ? tick(m.status) : ''}</div>
          ${m.status === 'failed' ? `<div class="text-[11px] danger-ink mt-1">${esc(m.error || 'Gagal terkirim')}</div>` : ''}
          ${m.reaction ? `<span class="reaction">${esc(m.reaction)}</span>` : ''}
        </div>
        ${!out ? `<button class="reply-btn opacity-0 group-hover:opacity-100 ink-3 self-center p-1 ml-1" data-gr-reply="${m.id}" title="Balas" aria-label="Balas">${ICON.reply.replace('<svg', '<svg width="14" height="14"')}</button>` : ''}
      </div>`;
    }).join('') || '<div class="empty">Belum ada pesan di grup ini.</div>';
    $$('[data-gr-reply]', el).forEach((b) => b.addEventListener('click', () => { S.gr.replyTo = b.dataset.grReply; grChatTab(g); }));
    afterRenderMsgs(el);
    if (scroll || near) el.scrollTop = el.scrollHeight;
  }
  function grMediaModal() {
    modal('Kirim media ke grup', `<form id="f-grm" class="space-y-3">
      <div><label class="label">Jenis</label><select class="select" name="kind"><option value="image">Gambar (JPEG/PNG, maks. 5 MB)</option><option value="video">Video (MP4/3GP, maks. 16 MB)</option><option value="audio">Audio (maks. 16 MB)</option><option value="document">Dokumen (maks. 100 MB)</option></select></div>
      <div><label class="label">File</label><input type="file" name="file" class="text-xs"></div>
      <div id="grm-cap"><label class="label">Keterangan (opsional)</label><textarea class="textarea" name="caption" rows="2" maxlength="1024"></textarea></div>
    </form>`, { footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="grm-go">Unggah & kirim</button>' });
    const f = $('#f-grm');
    const sync = () => { $('#grm-cap').classList.toggle('hidden', f.kind.value === 'audio'); f.file.accept = { image: 'image/jpeg,image/png', video: 'video/mp4,video/3gpp', audio: 'audio/*', document: '' }[f.kind.value]; };
    f.kind.addEventListener('change', sync); sync();
    $('#grm-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!f.file.files[0]) throw new Error('Pilih file terlebih dahulu.');
      const fd = new FormData(); fd.append('kind', f.kind.value); fd.append('file', f.file.files[0]);
      // Unggah dan kirim ditangani terpisah: unggahan gagal tidak membuat pesan
      const up = await api('POST', '/api/media', fd);
      closeModal();
      await grSend({ type: f.kind.value, mediaId: up.id, mime: up.mime, filename: up.filename, caption: f.kind.value === 'audio' ? '' : f.caption.value });
    }));
  }
  async function grTemplateModal() {
    const rows = (await ensureTemplates().catch((e) => { fail(e); return []; })).filter((t) => t.status === 'APPROVED');
    modal('Kirim template ke grup', rows.length ? `<form id="f-grt" class="grid md:grid-cols-2 gap-4">
      <div class="space-y-3"><div><label class="label">Template</label><select class="select" name="tpl">${rows.map((t, i) => `<option value="${i}">${esc(t.name)} · ${esc(t.language)} · ${esc(t.category)}</option>`).join('')}</select></div><div id="grt-fields" class="space-y-3"></div></div>
      <div><div class="label">Pratinjau</div><div id="grt-prev"></div></div></form>`
      : '<div class="empty">Belum ada template APPROVED. Buka menu Template lalu klik Sinkronkan.</div>',
    { wide: true, footer: rows.length ? '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="grt-go">Kirim template</button>' : '' });
    if (!rows.length) return;
    const f = $('#f-grt'), cur = () => rows[f.tpl.value];
    const draw = () => { $('#grt-fields').innerHTML = tplFieldsHtml(cur()); $('#grt-prev').innerHTML = tplPreview(cur(), f); };
    f.tpl.addEventListener('change', draw); f.addEventListener('input', () => { $('#grt-prev').innerHTML = tplPreview(cur(), f); }); draw();
    $('#grt-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!f.reportValidity()) return;
      const t = cur();
      await grSend({ type: 'template', name: t.name, language: t.language, values: readTplValues(t, f) });
      closeModal();
    }));
  }

  /* Tab: peserta & permintaan bergabung */
  function grPeopleTab(g) {
    const body = $('#gr-body'), act = grActive(g);
    body.innerHTML = `<div class="flex-1 overflow-y-auto scroll-thin p-4 space-y-4">
      <section class="card">
        <div class="card-h"><div class="min-w-0"><div class="card-t">Permintaan bergabung (${g.joinRequests.length})</div><div class="text-[11px] ink-3">${g.joinApprovalMode === 'approval_required' ? 'Grup ini memerlukan persetujuan admin.' : 'Grup ini langsung menerima peserta lewat tautan; permintaan hanya muncul bila mode persetujuan aktif.'}</div></div>
          ${act && g.joinRequests.length ? `<div class="flex gap-1.5 flex-none"><button class="btn btn-sm" data-jr-all="reject">Tolak terpilih</button><button class="btn btn-sm btn-primary" data-jr-all="approve">Setujui terpilih</button></div>` : ''}</div>
        <div>${g.joinRequests.map((r) => `<label class="flex items-center gap-3 px-4 py-2.5 border-b bd last:border-0">
            ${act ? `<input type="checkbox" class="check" data-jr="${esc(r.id)}">` : ''}
            <div class="min-w-0 flex-1 text-[13px]">${grPerson(r.waId)}<div class="text-[11px] ink-3">${r.at ? esc(fmtDT(r.at)) : ''}</div></div>
            ${act ? `<button type="button" class="btn btn-sm btn-ghost btn-danger" data-jr-one="reject:${esc(r.id)}">Tolak</button><button type="button" class="btn btn-sm" data-jr-one="approve:${esc(r.id)}">Setujui</button>` : ''}
          </label>`).join('') || '<div class="p-4 text-xs ink-3">Tidak ada permintaan yang menunggu.</div>'}</div>
      </section>
      <section class="card">
        <div class="card-h"><div class="min-w-0"><div class="card-t">Peserta (${g.participants.length}/${S.gr.maxParticipants})</div><div class="text-[11px] ink-3">Peserta bergabung lewat tautan undangan. Bisnis hanya dapat mengeluarkan peserta.</div></div>
          ${act && g.participants.length ? `<button class="btn btn-sm btn-danger flex-none" id="gr-remove" disabled>${ICON.userX} Keluarkan</button>` : ''}</div>
        <div>${g.participants.map((p) => {
          const pending = g.pending?.remove?.includes(p.waId) || g.pending?.remove?.includes(p.phone);
          return `<label class="flex items-center gap-3 px-4 py-2.5 border-b bd last:border-0">
            ${act ? `<input type="checkbox" class="check" data-pp="${esc(p.waId)}" ${pending ? 'disabled' : ''}>` : ''}
