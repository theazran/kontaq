            <div><label class="label">API key (x-api-key)</label><input class="input mono" name="apiKey" type="password" autocomplete="off" placeholder="${g.apiKeyMasked ? 'Tersimpan ' + esc(g.apiKeyMasked) + ' — isi untuk mengganti' : 'API key gateway'}"></div>
          </div>
          <p class="hint">Dipakai hanya untuk notifikasi internal ke nomor WA pribadi anggota tim, bukan untuk membalas pelanggan. API key disimpan terenkripsi di server.</p>
        </div>
        <div class="flex justify-end px-4 py-3 border-t bd"><button class="btn btn-primary" type="submit">Simpan</button></div>
      </form>
      <div class="lg:col-span-2 space-y-4">
        <form id="f-gwt" class="card"><div class="card-h"><div class="card-t">Uji kirim</div></div><div class="p-4 space-y-3 text-xs">
          <div><label class="label">Nomor tujuan</label><input class="input mono" name="to" required inputmode="numeric" placeholder="6281234567890"></div>
          <button class="btn btn-sm w-full" type="submit">Kirim pesan tes</button>
          <p class="hint">${g.users} pengguna mengaktifkan notifikasi WhatsApp. Setiap pengguna mengatur nomornya di Pengaturan › Notifikasi & keamanan.</p>
        </div></form>
      </div></div>`;
    $('#f-gw').addEventListener('submit', (e) => { e.preventDefault(); busy(e.submitter, async () => {
      const d = formData(e.target); if (!d.apiKey) delete d.apiKey;
      await api('PUT', '/api/settings/wa-gateway', d); toast('Gateway disimpan.'); setGateway();
    }); });
    $('#f-gwt').addEventListener('submit', (e) => { e.preventDefault(); busy(e.submitter, async () => {
      await api('POST', '/api/settings/wa-gateway/test', formData(e.target)); toast('Pesan tes terkirim lewat gateway.');
    }); });
  }
  async function setTeam() {
    const el = $('#set-body');
    S.users = await api('GET', '/api/users').catch((e) => { fail(e); return []; });
    el.innerHTML = `<div class="space-y-3"><div class="flex items-center"><p class="text-xs ink-3 flex-1"><b>Admin</b>: akses penuh. <b>Agen</b>: inbox (percakapan miliknya & belum ditugaskan), kontak, kirim template.</p><button class="btn btn-primary" id="tm-add">${ICON.plus} Tambah anggota</button></div>
      <div class="card overflow-x-auto"><table class="tbl"><thead><tr><th>Nama</th><th>Email</th><th>Peran</th><th>Status</th><th>Login terakhir</th><th></th></tr></thead><tbody>
      ${S.users.map((u) => `<tr><td class="font-medium">${esc(u.name)}${u.id === S.user.id ? ' <span class="ink-3 text-xs">(Anda)</span>' : ''}</td><td class="text-xs">${esc(u.email)}</td><td class="capitalize text-xs">${esc(u.role)}</td><td>${u.active ? '<span class="badge badge-green">Aktif</span>' : '<span class="badge">Nonaktif</span>'}</td><td class="text-xs ink-3">${fmtDT(u.lastLoginAt)}</td>
        <td class="text-right"><button class="btn btn-sm btn-ghost" data-uedit="${u.id}">Ubah</button></td></tr>`).join('')}
      </tbody></table></div></div>`;
    $('#tm-add').addEventListener('click', () => userModal());
    $$('[data-uedit]').forEach((b) => b.addEventListener('click', () => userModal(S.users.find((u) => u.id === b.dataset.uedit))));
  }
  function userModal(u) {
    modal(u ? 'Ubah anggota' : 'Tambah anggota', `<form id="f-u" class="space-y-3">
      <div><label class="label">Nama</label><input class="input" name="name" value="${esc(u?.name || '')}" required maxlength="80"></div>
      <div><label class="label">Email</label><input class="input" name="email" type="email" value="${esc(u?.email || '')}" ${u ? 'disabled' : 'required'}></div>
      <div><label class="label">Peran</label><select class="select" name="role"><option value="agent" ${u?.role === 'agent' ? 'selected' : ''}>Agen</option><option value="admin" ${u?.role === 'admin' ? 'selected' : ''}>Admin</option></select></div>
      <div><label class="label">${u ? 'Reset kata sandi (opsional)' : 'Kata sandi awal'}</label><input class="input" name="password" type="password" minlength="10" autocomplete="new-password" ${u ? '' : 'required'}><p class="hint">Minimal 10 karakter.${u ? ' Mengganti kata sandi akan mengeluarkan semua sesi pengguna.' : ''}</p></div>
      ${u ? `<label class="flex items-center gap-2 text-xs"><input type="checkbox" class="check" name="active" ${u.active ? 'checked' : ''}> Akun aktif</label>` : ''}
    </form>`, { footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="u-save">Simpan</button>' });
    $('#u-save').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const f = $('#f-u'); if (!f.reportValidity()) return;
      const d = formData(f);
      if (u) { const body = { name: d.name, role: d.role, active: !!d.active }; if (d.password) body.password = d.password; await api('PATCH', `/api/users/${u.id}`, body); }
      else await api('POST', '/api/users', d);
      closeModal(); toast('Tersimpan.'); setTeam();
    }));
  }
  function setSecurity() {
    $('#set-body').innerHTML = `<div class="grid lg:grid-cols-2 gap-4">
      <section class="card"><div class="card-h"><div class="card-t">Notifikasi di perangkat ini</div></div><div class="p-4 space-y-3 text-xs">
        <label class="flex items-center gap-2"><input type="checkbox" class="check" id="pf-sound" ${pref('sound') ? 'checked' : ''}> Bunyikan suara saat ada chat masuk</label>
        <label class="flex items-center gap-2"><input type="checkbox" class="check" id="pf-open" ${pref('soundOpen') ? 'checked' : ''}> Tetap bunyi walau percakapan sedang dibuka</label>
        <label class="flex items-center gap-2"><input type="checkbox" class="check" id="pf-typing" ${pref('typingCustomer') ? 'checked' : ''}> Tampilkan "sedang mengetik…" ke pelanggan saat saya mengetik</label>
        <div class="flex flex-wrap gap-2"><button class="btn btn-sm" id="pf-test">${ICON.bell} Tes suara</button><button class="btn btn-sm" id="pf-notif">Izinkan notifikasi browser</button></div>
        <p class="hint">Suara hanya berbunyi selama Kontaq terbuka. Pastikan HP tidak dalam mode senyap. Pengaturan ini tersimpan di browser ini saja.</p>
      </div></section>
      <section class="card" id="wa-notif"><div class="card-h"><div class="card-t">Notifikasi WhatsApp</div></div><div class="p-4 text-xs ink-3">Memuat…</div></section>
      <form id="f-pw" class="card"><div class="card-h"><div class="card-t">Ganti kata sandi</div></div><div class="p-4 space-y-3">
        <div><label class="label">Kata sandi saat ini</label><input class="input" type="password" name="current" required autocomplete="current-password"></div>
        <div><label class="label">Kata sandi baru</label><input class="input" type="password" name="password" required minlength="10" autocomplete="new-password"></div>
        <div><label class="label">Ulangi kata sandi baru</label><input class="input" type="password" name="password2" required minlength="10" autocomplete="new-password"></div>
      </div><div class="flex justify-end px-4 py-3 border-t bd"><button class="btn btn-primary" type="submit">Perbarui</button></div></form>
      <section class="card"><div class="card-h"><div class="card-t">Sesi</div></div><div class="p-4 space-y-3 text-xs ink-2">
        <p>Sesi berlaku 7 hari menggunakan cookie HttpOnly. Keluarkan semua perangkat lain bila Anda curiga akun disalahgunakan.</p>
        <button class="btn" id="sec-all">Keluarkan semua sesi lain</button>
        <div class="border-t bd pt-3 space-y-1"><div class="flex justify-between"><span class="ink-3">Akun</span><span>${esc(S.user.email)}</span></div><div class="flex justify-between"><span class="ink-3">Peran</span><span class="capitalize">${esc(S.user.role)}</span></div></div>
      </div></section></div>`;
    $('#f-pw').addEventListener('submit', (e) => { e.preventDefault(); busy(e.submitter, async () => {
      const d = formData(e.target); if (d.password !== d.password2) throw new Error('Konfirmasi kata sandi tidak sama.');
      await api('POST', '/api/me/password', { current: d.current, password: d.password }); e.target.reset(); toast('Kata sandi diperbarui.');
    }); });
    $('#pf-sound').addEventListener('change', (e) => { setPref('sound', e.target.checked); renderSoundBtn(); });
    $('#pf-typing').addEventListener('change', (e) => setPref('typingCustomer', e.target.checked));
    $('#pf-open').addEventListener('change', (e) => setPref('soundOpen', e.target.checked));
    $('#pf-test').addEventListener('click', () => playChime(true));
    $('#pf-notif').addEventListener('click', async () => {
      if (!('Notification' in window)) return fail(new Error('Browser ini tidak mendukung notifikasi.'));
      const p = await Notification.requestPermission();
      toast(p === 'granted' ? 'Notifikasi browser diizinkan.' : 'Notifikasi browser ditolak. Ubah di pengaturan situs browser.', p !== 'granted');
    });
    $('#sec-all').addEventListener('click', (e) => busy(e.currentTarget, async () => { await api('POST', '/api/me/logout-all'); toast('Sesi lain telah dikeluarkan.'); }));
    renderWaNotify();
  }
  // Notifikasi ke WhatsApp pribadi pengguna (lewat gateway), tersimpan di akun — berlaku di semua perangkat
  async function renderWaNotify() {
    const box = $('#wa-notif'); if (!box) return;
    let n; try { n = await api('GET', '/api/me/wa-notify'); } catch (e) { box.querySelector('.p-4').textContent = e.message; return; }
    const ev = (k, l) => `<label class="flex items-center gap-2"><input type="checkbox" class="check" name="ev_${k}" ${n.events[k] ? 'checked' : ''}> ${l}</label>`;
    box.innerHTML = `<form id="f-wan"><div class="card-h"><div class="card-t">Notifikasi WhatsApp</div>
        <label class="switch ${n.enabled ? 'on' : ''} ${n.gatewayReady ? 'cursor-pointer' : ''}" title="${n.gatewayReady ? 'Aktifkan/nonaktifkan' : 'Gateway WA belum dikonfigurasi'}"><input type="checkbox" class="sr-only" name="enabled" ${n.enabled ? 'checked' : ''} ${n.gatewayReady ? '' : 'disabled'} role="switch" aria-label="Aktifkan notifikasi WhatsApp"><span></span></label></div>
      <div class="p-4 space-y-3 text-xs">
        ${n.gatewayReady ? '' : `<p class="p-2 rounded" style="background:var(--warn-soft)">Gateway WA belum dikonfigurasi.${S.isAdmin ? ' <a class="underline" href="#/settings/gateway">Atur gateway</a>' : ' Hubungi admin.'}</p>`}
        <div><label class="label">Nomor WhatsApp Anda</label><input class="input mono" name="phone" value="${esc(n.phone)}" inputmode="numeric" placeholder="6281234567890"></div>
        <div class="space-y-2">${ev('message', 'Pesan masuk (percakapan milik saya / belum ditugaskan)')}${ev('assign', 'Percakapan ditugaskan ke saya')}${ev('call', 'Panggilan masuk')}${ev('reminder', 'Pengingat yang jatuh tempo')}</div>
        <label class="flex items-center gap-2"><input type="checkbox" class="check" name="onlyOffline" ${n.onlyOffline ? 'checked' : ''}> Hanya kirim saat Kontaq tidak sedang terbuka</label>
        <p class="hint">Notifikasi pesan dari percakapan yang sama dibatasi maksimal satu tiap 2 menit. Pengaturan ini tersimpan di akun Anda.</p>
      </div>
      <div class="flex justify-end gap-2 px-4 py-3 border-t bd"><button type="button" class="btn" id="wan-test" ${n.gatewayReady ? '' : 'disabled'}>Kirim tes</button><button class="btn btn-primary" type="submit">Simpan</button></div></form>`;
    const f = $('#f-wan');
    const body = () => ({ enabled: f.enabled.checked, phone: f.phone.value, onlyOffline: f.onlyOffline.checked, events: { message: f.ev_message.checked, assign: f.ev_assign.checked, call: f.ev_call.checked, reminder: f.ev_reminder.checked } });
    f.enabled.addEventListener('change', () => {
      const on = f.enabled.checked; f.enabled.closest('.switch').classList.toggle('on', on);
      busy(null, async () => {
        try { await api('PUT', '/api/me/wa-notify', body()); toast(on ? 'Notifikasi WhatsApp aktif.' : 'Notifikasi WhatsApp dinonaktifkan.'); }
        catch (e) { f.enabled.checked = !on; f.enabled.closest('.switch').classList.toggle('on', !on); throw e; }
      });
    });
    f.addEventListener('submit', (e) => { e.preventDefault(); busy(e.submitter, async () => { await api('PUT', '/api/me/wa-notify', body()); toast('Notifikasi WhatsApp disimpan.'); renderWaNotify(); }); });
    $('#wan-test').addEventListener('click', (e) => busy(e.currentTarget, async () => { await api('PUT', '/api/me/wa-notify', body()); await api('POST', '/api/me/wa-notify/test'); toast('Pesan tes terkirim ke WhatsApp Anda.'); }));
  }
  async function setAudit(q = '') {
    const el = $('#set-body');
    const rows = await api('GET', `/api/audit?q=${encodeURIComponent(q)}`).catch((e) => { fail(e); return []; });
    const focused = document.activeElement?.id === 'au-q';
    el.innerHTML = `<div class="space-y-3"><input class="input w-72" id="au-q" placeholder="Cari aksi, pengguna, IP…" value="${esc(q)}" aria-label="Cari audit log">
      <div class="card overflow-x-auto max-h-[65vh] overflow-y-auto scroll-thin"><table class="tbl"><thead><tr><th>Waktu</th><th>Pengguna</th><th>Aksi</th><th>Detail</th><th>IP</th></tr></thead><tbody>
      ${rows.map((a) => `<tr><td class="text-xs whitespace-nowrap ink-3">${fmtDT(a.at)}</td><td class="text-xs">${esc(a.userName)}</td><td class="mono text-xs">${esc(a.action)}</td><td class="text-xs ink-2 max-w-md truncate" title="${esc(a.detail)}">${esc(a.detail)}</td><td class="mono text-[11px] ink-3">${esc(a.ip)}</td></tr>`).join('') || '<tr><td colspan="5"><div class="empty">Tidak ada entri.</div></td></tr>'}
      </tbody></table></div><p class="hint">Menampilkan maksimal 500 entri terbaru.</p></div>`;
    const inp = $('#au-q'); if (focused) { inp.focus(); inp.setSelectionRange(q.length, q.length); }
    let t; inp.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => setAudit(inp.value), 300); });
  }

  /* ───────────── Real-time ───────────── */
  // Mulai dengan long-polling lalu upgrade ke WebSocket bila proxy mendukung. Urutan ini tetap tersambung
  // di belakang reverse proxy yang tidak meneruskan header Upgrade (mis. Apache tanpa mod_proxy_wstunnel).
  const socket = io({ transports: ['polling', 'websocket'], tryAllTransports: true });
  const live = (ok, text) => { const el = $('#live'); el.className = 'badge ' + (ok ? 'badge-green' : 'badge-amber'); el.innerHTML = `<span class="dot"></span><span>${text}</span>`; };
  socket.on('connect', () => { live(true, 'Live'); loadReminders().catch(() => {}); checkRingingCall(); if (S.view === 'inbox') loadConvs().then(renderConvList).catch(() => {}); });
  socket.on('disconnect', () => live(false, 'Terputus'));
  socket.on('connect_error', (e) => { live(false, 'Terputus'); if (e.message === 'unauthorized') location.reload(); });
  socket.on('message:new', ({ message, conversation }) => {
    if (message.userId) setTyping(conversation.id, message.userId, null);
    if (message.direction === 'in') {
      const viewing = conversation.id === S.inbox.activeId && S.view === 'inbox' && document.visibilityState === 'visible';
      if (!viewing || pref('soundOpen')) playChime();
      if (conversation.id !== S.inbox.activeId) notifyIncoming(conversation);
    }
    if (conversation.id === S.inbox.activeId) {
      if (!S.inbox.messages.some((m) => m.id === message.id)) { S.inbox.messages.push(message); if (S.view === 'inbox') renderMessages(false); }
      if (message.direction === 'in' && S.view === 'inbox' && document.visibilityState === 'visible') { conversation.unread = 0; api('POST', `/api/conversations/${conversation.id}/read`).catch(() => {}); }
    }
    applyConv(conversation);
  });
  let mlogTimer;
  const mlogLive = () => { if (S.view === 'messagelog' && !$('#modal-root').innerHTML) { clearTimeout(mlogTimer); mlogTimer = setTimeout(viewMessageLog, 1500); } };
  socket.on('message:new', ({ message }) => { if (message.direction === 'out') mlogLive(); });
  socket.on('message:update', mlogLive);
  socket.on('message:update', ({ message }) => {
    const i = S.inbox.messages.findIndex((m) => m.id === message.id);
    if (i >= 0) {
      S.inbox.messages[i] = message;
      const node = $(`.msg-row[data-mid="${message.id}"]`);
      if (node) { node.outerHTML = msgHtml(message); audSync(); } // aksi pesan ditangani delegasi di #msgs
    }
  });
  socket.on('conversation:update', applyConv);
  socket.on('group:update', grOnUpdate);
  socket.on('waflow:submission', ({ flowId }) => { if (S.view === 'waflows' && S.wfd?.flow?.id === flowId && S.wfd.tab === 'responses') wfResponsesTab(); });
  socket.on('waflow:update', (f) => { if (S.view === 'waflows' && S.wfd?.flow?.id === f.id && !S.wfd.draft && !wfbUnsaved()) { Object.assign(S.wfd.flow, f); renderWaFlowDetail(); } });
  socket.on('group:message', grOnMessage);
  socket.on('typing', (t) => { if (t.userId !== S.user.id) setTyping(t.conversationId, t.userId, { name: t.name, seen: Date.now() }); });
  socket.on('conversation:removed', ({ id }) => {
    if (S.isAdmin) return;
    S.inbox.convs = S.inbox.convs.filter((c) => c.id !== id);
    if (S.inbox.activeId === id) { S.inbox.activeId = null; if (S.view === 'inbox') { toast('Percakapan dialihkan ke agen lain.'); location.hash = '#/inbox'; } }
    if (S.view === 'inbox') renderConvList(); renderNav();
  });
  socket.on('template:update', (t) => {
    const row = S.templates.rows.find((x) => String(x.id) === String(t.id) || (x.name === t.name && x.language === t.language));
    if (row) { row.status = t.status; if (t.reason && t.reason !== 'NONE') row.rejected_reason = t.reason; }
    toast(`Template ${t.name}: ${t.status}`);
    if (S.view === 'templates') viewTemplates();
  });
  socket.on('campaign:update', (c) => {
    const tr = $(`#cp-rows tr[data-cid="${c.id}"]`);
    if (tr && S.view === 'campaigns') tr.outerHTML = campaignRow(c);
    else if (!tr && S.view === 'campaigns' && !$('#modal-root').innerHTML) viewCampaigns();
  });
  socket.on('reminder:due', (r) => { remUpsert(r); if (remMine(r)) showRemDue(r); });
  socket.on('reminder:update', remUpsert);
  socket.on('reminder:removed', ({ id }) => { S.rem.list = S.rem.list.filter((x) => x.id !== id); remChanged(); });
  socket.on('notice', (n) => toast(n.text, n.level === 'error'));
  socket.on('addons:update', (a) => {
    S.addons = a;
    if (S.view === 'attendance' && !a.attendance?.enabled) route(); else renderNav();
  });
  socket.on('attendance:run', attRunUpdate);
  socket.on('call:incoming', showIncomingCall);
  socket.on('call:answer', applyAnswer);
  socket.on('call:update', (c) => {
    if (S.call?.id !== c.id) { if (S.view === 'calls') viewCalls(); return; }
    if (S.call.direction === 'BUSINESS_INITIATED') {
      if (['calling', 'ringing', 'accepted'].includes(c.status)) { if (S.call.status !== 'accepted') { S.call.status = c.status; renderCallBar(); } }
      else { endCallLocal(); toast(c.status === 'rejected' ? 'Pelanggan menolak panggilan.' : 'Panggilan berakhir.'); }
      if (S.view === 'calls') viewCalls();
      return;
    }
    if (c.status === 'accepted' && c.answeredBy !== S.user.id) { endCallLocal(); toast(`Panggilan diangkat oleh ${c.answeredName}.`); }
    else if (!['ringing', 'accepted'].includes(c.status)) { endCallLocal(); toast('Panggilan berakhir.'); }
    if (S.view === 'calls') viewCalls();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') return;
    if (!socket.connected) socket.connect();
    checkRingingCall();
    if (S.view === 'inbox') loadConvs().then(renderConvList).catch(() => {});
  });
  function notifyBrowser(title, body) {
    if (document.visibilityState === 'visible' || !('Notification' in window) || Notification.permission !== 'granted') return;
    try { new Notification(title, { body }); } catch (e) {}
  }
  function notifyIncoming(conv) {
    notifyBrowser(contactName(conv.contact), conv.preview);
    if (document.visibilityState === 'visible' && S.view !== 'inbox') toast(`Pesan baru dari ${contactName(conv.contact)}`);
  }
  document.addEventListener('click', function askNotif() { if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission(); document.removeEventListener('click', askNotif); });
  // Perbarui label sisa jendela 24 jam tiap menit
  setInterval(() => {
    const c = activeConv(); if (!c || S.view !== 'inbox') return;
    const wasOpen = c.windowOpen; c.windowOpen = c.windowExpiresAt > Date.now();
    renderChatHeaderOnly(c); if (wasOpen !== c.windowOpen) renderComposer();
  }, 60000);

  /* ───────────── Mulai ───────────── */
  renderSoundBtn();
  $('#me-name').textContent = S.user.name; $('#me-role').textContent = S.user.role === 'admin' ? 'Admin' : 'Agen'; $('#me-avatar').innerHTML = initials(S.user.name);
  loadConvs().catch(() => {}).finally(renderNav);
  route();
  </script>
<% } %>
</body>
</html>
