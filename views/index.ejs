                  <div class="text-[11px] ink-3 mt-0.5">${esc(AR_MATCH[x.match])} · ${fmtNum(x.hits || 0)}× membalas${x.lastHitAt ? ' · ' + esc(fmtDT(x.lastHitAt)) : ''}</div></div>
                <div class="flex items-center -mr-1.5 -mt-1 flex-none">
                  ${iconBtn(`data-ar-up="${i}" ${i === 0 ? 'disabled' : ''}`, ICON.up, 'Naikkan')}
                  ${iconBtn(`data-ar-down="${i}" ${i === a.rules.length - 1 ? 'disabled' : ''}`, ICON.down, 'Turunkan')}
                  ${iconBtn(`data-ar-edit="${i}"`, ICON.edit, 'Ubah')}
                  ${iconBtn(`data-ar-del="${i}"`, ICON.trash, 'Hapus', 'btn-danger')}
                </div>
              </div>
              <div class="flex flex-wrap gap-1 mt-2">${x.keywords.map((k) => `<span class="badge">${esc(k)}</span>`).join('')}</div>
              <div class="mt-2 surface-2 rounded-md px-2.5 py-2 flex gap-2.5">
                ${x.image ? arImg(x.image, 'w-11 h-11 flex-none') : ''}
                <div class="min-w-0 flex-1"><div class="text-xs ink-2 line-clamp-2 whitespace-pre-line">${x.reply ? esc(x.reply) : '<span class="ink-3">(gambar tanpa teks)</span>'}</div>
                  ${(x.buttons || []).length ? `<div class="flex flex-wrap gap-1 mt-1.5">${x.buttons.map((t) => `<span class="badge" style="color:var(--info)">${esc(t)}</span>`).join('')}</div>` : ''}</div>
              </div>
            </div>
          </div>`).join('') || '<div class="empty">Belum ada aturan.<br><span class="text-xs">Contoh kata kunci: <span class="kbd">harga</span> <span class="kbd">jam buka</span> <span class="kbd">alamat</span></span></div>'}</div>
      </section>

      <section class="card">
        <div class="card-h"><div class="min-w-0"><div class="card-t">Di luar jam kerja</div><div class="text-[11px] ink-3">Dikirim bila pesan masuk di luar jadwal berikut.</div></div>${sw('ar-away-on', a.away.enabled, 'Aktifkan pesan di luar jam kerja')}</div>
        <div class="p-4 space-y-4">
          <div><label class="label" for="ar-away-text">Pesan</label><textarea class="textarea" id="ar-away-text" rows="3" maxlength="4096">${esc(a.away.text)}</textarea>
            <p class="hint">Variabel: <span class="kbd">{{name}}</span> <span class="kbd">{{phone}}</span></p></div>
          ${replyExtrasHtml('away', a.away)}
          <div>
            <div class="flex flex-wrap items-end justify-between gap-3 mb-2">
              <div class="label mb-0">Jam kerja</div>
              <label class="flex items-center gap-2 text-xs ink-2">Zona waktu
                <select class="select h-8 text-xs w-44" id="ar-tz">${tzOpts.map((t) => `<option ${t === a.timezone ? 'selected' : ''}>${esc(t)}</option>`).join('')}</select></label>
            </div>
            <div class="rounded-md border bd divide-y" id="ar-hours" style="border-color:var(--border)">${a.away.hours.map((h) => `<div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-3 py-2 min-h-[3rem] border-b bd last:border-0">
                <label class="flex items-center gap-2 w-24 flex-none text-[13px]"><input type="checkbox" class="check" data-h-on="${h.day}" ${h.enabled ? 'checked' : ''}>${AR_DAYS[h.day]}</label>
                <div class="flex items-center gap-2 max-[420px]:w-full max-[420px]:pl-6 ${h.enabled ? '' : 'hidden'}" data-h-times="${h.day}">
                  <input class="input h-8 text-xs w-[6.5rem]" type="time" data-h-open="${h.day}" value="${h.open}" aria-label="Jam buka ${AR_DAYS[h.day]}"><span class="ink-3 text-xs">s.d.</span>
                  <input class="input h-8 text-xs w-[6.5rem]" type="time" data-h-close="${h.day}" value="${h.close}" aria-label="Jam tutup ${AR_DAYS[h.day]}"></div>
                <span class="text-xs ink-3 ${h.enabled ? 'hidden' : ''}" data-h-closed="${h.day}">Tutup</span>
              </div>`).join('')}</div>
          </div>
          <div class="max-w-xs"><label class="label" for="ar-away-cd">Kirim ulang ke pelanggan yang sama setelah (jam)</label><input class="input" type="number" min="0" max="168" id="ar-away-cd" value="${a.away.cooldownHours}"></div>
        </div>
      </section>

      <section class="card">
        <div class="card-h"><div class="min-w-0"><div class="card-t">Pesan sambutan</div><div class="text-[11px] ink-3">Untuk pelanggan baru, atau yang lama tidak menghubungi.</div></div>${sw('ar-wel-on', a.welcome.enabled, 'Aktifkan pesan sambutan')}</div>
        <div class="p-4 space-y-4">
          <div><label class="label" for="ar-wel-text">Pesan</label><textarea class="textarea" id="ar-wel-text" rows="3" maxlength="4096">${esc(a.welcome.text)}</textarea></div>
