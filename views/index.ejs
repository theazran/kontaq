  /* Aksi pada pesan (delegasi): lightbox, audio, reaksi, kontak, stiker. getMsgs = daftar pesan sumber. */
  function bindMsgActions(el, getMsgs, opts = {}) {
    el.addEventListener('click', (e) => {
      const t = e.target.closest('[data-lightbox],[data-aud-play],[data-aud-speed],[data-aud-seek],[data-react-open],[data-react-remove],[data-ct-chat],[data-ct-save],[data-sticker-save],[data-reply]');
