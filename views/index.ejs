      $('#att-tpl-name').innerHTML = (names.includes(f.template.name) ? names : [f.template.name, ...names]).map((x) => `<option ${x === f.template.name ? 'selected' : ''}>${esc(x)}</option>`).join('');
      if (!t) { box.innerHTML = `<p class="text-xs danger-ink">Template ini belum ada di daftar template (belum disetujui atau belum disinkronkan).</p>`; return; }
      const field = (part, i, name) => `<div><label class="label">${part === 'header' ? 'Judul' : 'Isi'} · <span class="mono">{{${esc(name)}}}</span></label><input class="input text-xs mono" data-tv="${part}" data-i="${i}" value="${esc(f.template[part][i] || '')}" placeholder="${esc(t.defaults[part][i])}"></div>`;
      box.innerHTML = `<div class="rounded-lg p-3 text-xs space-y-1" style="background:var(--surface-2)">${t.header ? `<div class="font-semibold">${esc(t.header)}</div>` : ''}<div class="whitespace-pre-wrap">${esc(t.body)}</div><div class="ink-3 pt-1">${esc(t.language)} · ${esc(t.category || '')} · ${esc(t.status)}</div></div>
        ${t.vars.header.length + t.vars.body.length ? `<div class="grid sm:grid-cols-2 gap-3">${t.vars.header.map((n, i) => field('header', i, n)).join('')}${t.vars.body.map((n, i) => field('body', i, n)).join('')}</div>
        <p class="hint">Kosongkan untuk memakai isian bawaan (abu-abu). Variabel yang tersedia: ${varHelp}</p>` : '<p class="hint">Template ini tidak memiliki variabel.</p>'}`;
      $$('[data-tv]', box).forEach((i) => i.addEventListener('input', () => { f.template[i.dataset.tv][+i.dataset.i] = i.value; }));
    };
    const renderSched = (type) => {
      const s = f.schedule[type], box = $(`#att-sch-${type}`);
      box.innerHTML = `${s.slots.map((x, i) => `<div class="flex flex-wrap items-center gap-x-3 gap-y-2 py-2 ${i ? 'border-t bd' : ''}">
          <input type="time" class="input h-8 text-xs w-28" data-slot-time="${i}" value="${esc(x.time)}" aria-label="Jam kirim">
          <div class="flex flex-wrap gap-x-3 gap-y-1 flex-1">${ATT_DAYS.map(([k, l]) => `<label class="flex items-center gap-1.5 text-xs"><input type="checkbox" class="check" data-slot-day="${i}" value="${k}" ${x.days.includes(k) ? 'checked' : ''}>${l}</label>`).join('')}</div>
          <button type="button" class="btn btn-ghost btn-sm btn-icon" data-slot-del="${i}" title="Hapus jam" aria-label="Hapus jam">${ICON.trash}</button>
        </div>`).join('') || '<p class="text-xs ink-3 py-2">Belum ada jam kirim.</p>'}
        <button type="button" class="btn btn-sm mt-1" data-slot-add>${ICON.plus}<span>Tambah jam</span></button>`;
      $$('[data-slot-time]', box).forEach((i) => i.addEventListener('change', () => { s.slots[+i.dataset.slotTime].time = i.value; }));
      $$('[data-slot-day]', box).forEach((i) => i.addEventListener('change', () => {
        const sl = s.slots[+i.dataset.slotDay], d = +i.value;
        sl.days = i.checked ? [...new Set([...sl.days, d])] : sl.days.filter((x) => x !== d);
      }));
      $$('[data-slot-del]', box).forEach((b) => b.addEventListener('click', () => { s.slots.splice(+b.dataset.slotDel, 1); renderSched(type); }));
      $('[data-slot-add]', box).addEventListener('click', () => { s.slots.push({ days: [1, 2, 3, 4, 5], time: type === 'datang' ? '07:45' : '16:05' }); renderSched(type); });
    };
    const renderSkip = () => {
      $('#att-skip-list').innerHTML = f.skipDates.map((d) => `<span class="badge">${esc(fmtDate(new Date(d + 'T00:00:00')))}<button type="button" class="ml-1" data-skip-del="${d}" aria-label="Hapus tanggal">✕</button></span>`).join(' ') || '<span class="text-xs ink-3">Tidak ada.</span>';
      $$('[data-skip-del]').forEach((b) => b.addEventListener('click', () => { f.skipDates = f.skipDates.filter((x) => x !== b.dataset.skipDel); renderSkip(); }));
    };
    el.innerHTML = `<form id="att-form" class="grid lg:grid-cols-5 gap-4">
