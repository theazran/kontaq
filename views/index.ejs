            : `<p class="text-xs ink-2">Data yang dikirim ke Kontaq: ${[...new Set([...carry, ...s.children.filter(isField).map((x) => x.p.name)])].map((n) => `<span class="kbd">${esc(n)}</span>`).join(' ') || '<span class="ink-3">belum ada field</span>'}</p>`}
          <details class="wfb-adv"><summary>Keterangan di atas tombol</summary><div class="grid grid-cols-3 gap-2 pt-2">
            ${[['left-caption', 'Kiri'], ['center-caption', 'Tengah'], ['right-caption', 'Kanan']].map(([k, l]) => `<div><label class="label">${l}</label><input class="input" data-fk="${k}" value="${esc(s.footer.rest[k] || '')}" maxlength="15"></div>`).join('')}
