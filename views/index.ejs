    const errs = local.filter((x) => x.level === 'error'), warns = local.filter((x) => x.level === 'warn');
    const where = (x) => { const s = b.m.screens.find((y) => y.uid === x.s), c = s?.children.find((y) => y.uid === x.c); return [s && `${b.m.screens.indexOf(s) + 1}. ${s.title || s.id}`, c && (WFB_COMP[c.type]?.n || c.type)].filter(Boolean).join(' › '); };
    const row = (x, i) => `<button type="button" class="wfb-vrow ${x.level}" data-vi="${i}"><span class="wfb-vic">${x.level === 'error' ? '!' : 'i'}</span><span class="min-w-0"><span class="block text-[13px]">${esc(x.msg)}</span>${where(x) ? `<span class="block text-[11px] ink-3">${esc(where(x))}</span>` : ''}</span></button>`;
    const all = [...errs, ...warns];
    modal('Validasi flow', `<div class="space-y-4">
      <section><div class="flex items-center gap-2 mb-2"><div class="text-xs font-semibold">Pemeriksaan editor</div>${errs.length ? `<span class="badge badge-red">${errs.length} error</span>` : '<span class="badge badge-green">Tidak ada error</span>'}${warns.length ? `<span class="badge badge-amber">${warns.length} peringatan</span>` : ''}</div>
        <div class="space-y-1">${all.map(row).join('') || '<p class="text-xs ink-3">Struktur, batas karakter, jumlah pilihan, nama field, dan navigasi sudah sesuai.</p>'}</div></section>
      <section><div class="flex items-center gap-2 mb-2"><div class="text-xs font-semibold">Validasi Meta</div>${b?.dirty ? '<span class="badge">perlu disimpan</span>' : metaErrs.length ? `<span class="badge badge-red">${metaErrs.length} error</span>` : '<span class="badge badge-green">OK</span>'}</div>
        ${b?.dirty ? '<p class="text-xs ink-2">Ada perubahan yang belum disimpan. Meta memvalidasi Flow JSON saat disimpan.</p>' : ''}
        <div class="space-y-1">${(b?.dirty ? [] : metaErrs).map((e) => `<div class="wfb-vrow error"><span class="wfb-vic">!</span><span class="min-w-0"><span class="block text-[13px]">${esc(e.message || e.error || 'Error')}</span><span class="block text-[11px] ink-3">${esc([e.error_type || e.error, e.line_start ? 'baris ' + e.line_start : '', e.pointers?.map((p) => p.path).join(', ')].filter(Boolean).join(' · '))}</span></span></div>`).join('') || (b?.dirty ? '' : '<p class="text-xs ink-3">Meta tidak menemukan error pada penyimpanan terakhir.</p>')}</div></section>
    </div>`, { footer: `<button class="btn" data-act="modal-close">Tutup</button>${b?.dirty && !wfbRO() ? '<button class="btn btn-primary" id="wfv-save">Simpan & validasi di Meta</button>' : ''}` });
    $$('[data-vi]').forEach((x) => x.addEventListener('click', () => {
