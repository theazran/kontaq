    try { d = await api('GET', '/api/message-log?' + mlogQuery(st)); } catch (e) { v.innerHTML = `<div class="empty">${esc(e.message)}</div>`; return; }
    if (S.view !== 'messagelog') return;
    const t = d.totals, cur = d.currency, src = d.options.sources;
    const keepFocus = document.activeElement?.id === 'ml-q';
    const tile = (label, value, sub, key) => `<button class="card p-3 text-left ${key && st.status === key ? 'ring-1' : ''}" ${key ? `data-ml-status="${key}"` : ''} style="${key && st.status === key ? 'border-color:var(--accent)' : ''}"><div class="text-[11px] ink-3">${label}</div><div class="text-xl font-semibold tracking-tight mt-0.5">${value}</div>${sub ? `<div class="text-[11px] ink-3 mt-0.5">${sub}</div>` : ''}</button>`;
