  /* Template: pengisian variabel (dipakai inbox & campaign) */
  const tplVars = (text) => [...new Set([...String(text || '').matchAll(/\{\{\s*(\w+)\s*\}\}/g)].map((m) => m[1]))];
  const comp = (t, type) => (t.components || []).find((c) => c.type === type);
  function tplFieldsHtml(t, { campaign, invite } = {}) {
    if (!t) return '';
    const h = comp(t, 'HEADER'), b = comp(t, 'BODY');
    const hint = invite ? '<p class="hint">Gunakan <span class="kbd">{{link}}</span> untuk tautan undangan grup, <span class="kbd">{{name}}</span> untuk nama kontak. Tombol URL undangan diisi otomatis.</p>'
      : campaign ? '<p class="hint">Gunakan <span class="kbd">{{name}}</span> atau <span class="kbd">{{phone}}</span> untuk nilai per kontak.</p>' : '';
    let out = '';
    if (h?.format === 'TEXT') out += tplVars(h.text).map((v, i) => `<div><label class="label">Header {{${esc(v)}}}</label><input class="input" name="header_${i}" required></div>`).join('');
    if (h && ['IMAGE', 'VIDEO', 'DOCUMENT'].includes(h.format)) out += `<div><label class="label">URL ${h.format.toLowerCase()} header (HTTPS publik)</label><input class="input" name="headerMedia" type="url" required placeholder="https://…"></div>`;
    out += tplVars(b?.text).map((v, i) => `<div><label class="label">Body {{${esc(v)}}}</label><input class="input" name="body_${i}" required ${invite && i === 0 ? 'value="{{link}}"' : ''}></div>`).join('');
    if (!invite) out += urlButtons(t).map(({ btn, i }) => `<div><label class="label">Tombol "${esc(btn.text)}" — akhiran URL</label><input class="input" name="btn_${i}" required placeholder="${esc(btn.url.replace(/\{\{.*$/, ''))}…"></div>`).join('');
    return (out ? out + hint : '<p class="text-xs ink-3">Template ini tidak memiliki variabel.</p>');
  }
  // Tombol URL dengan variabel, mis. https://contoh.com/pesanan/{{1}}
  const urlButtons = (t) => (comp(t, 'BUTTONS')?.buttons || []).map((btn, i) => ({ btn, i })).filter(({ btn }) => btn.type === 'URL' && /\{\{/.test(btn.url || ''));
  function tplPreview(t, form) {
    if (!t) return '';
    const h = comp(t, 'HEADER'), b = comp(t, 'BODY'), f = comp(t, 'FOOTER'), btns = comp(t, 'BUTTONS');
    const val = (name) => form?.[name]?.value || '';
    let i = 0, j = 0;
    const header = h ? (h.format === 'TEXT' ? `<div class="font-semibold mb-1">${esc(String(h.text).replace(/\{\{\s*\w+\s*\}\}/g, () => val('header_' + j++) || '{{…}}'))}</div>` : `<div class="text-[11px] ink-3 mb-1">[${esc(h.format)}]</div>`) : '';
    const body = waFormat(String(b?.text || '').replace(/\{\{\s*\w+\s*\}\}/g, () => val('body_' + i++) || '{{…}}'));
    return `<div class="chat-bg rounded-md p-3"><div class="bubble out">${header}${body}${f ? `<div class="text-[11px] ink-3 mt-1">${esc(f.text)}</div>` : ''}${(btns?.buttons || []).map((x) => `<span class="ib-btn">${esc(x.text)}</span>`).join('')}</div></div>`;
  }
  function readTplValues(t, form) {
    const h = comp(t, 'HEADER'), b = comp(t, 'BODY');
    return {
      header: h?.format === 'TEXT' ? tplVars(h.text).map((_, i) => form['header_' + i].value) : [],
      headerMedia: form.headerMedia?.value || '',
      body: tplVars(b?.text).map((_, i) => form['body_' + i].value),
      buttonUrl: (comp(t, 'BUTTONS')?.buttons || []).map((_, i) => form['btn_' + i]?.value || ''),
    };
  }
  async function ensureTemplates() {
    if (!S.templates.loaded) { Object.assign(S.templates, await api('GET', '/api/templates'), { loaded: true }); }
    return S.templates.rows;
  }
  async function templateSendModal(conv) {
    const rows = (await ensureTemplates().catch((e) => { fail(e); return []; })).filter((t) => t.status === 'APPROVED');
    modal('Kirim template', rows.length ? `<form id="f-tpl" class="grid md:grid-cols-2 gap-4">
      <div class="space-y-3"><div><label class="label">Template</label><select class="select" name="tpl">${rows.map((t, i) => `<option value="${i}">${esc(t.name)} · ${esc(t.language)} · ${esc(t.category)}</option>`).join('')}</select></div><div id="tpl-fields" class="space-y-3"></div></div>
      <div><div class="label">Pratinjau</div><div id="tpl-prev"></div></div></form>`
      : `<div class="empty">Belum ada template APPROVED.<br><a href="#/templates" class="accent-ink" data-act="modal-close">Buka Template</a> lalu klik Sinkronkan.</div>`,
    { wide: true, footer: rows.length ? '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="tpl-go">Kirim template</button>' : '' });
    if (!rows.length) return;
    const f = $('#f-tpl'), cur = () => rows[f.tpl.value];
    const draw = () => { $('#tpl-fields').innerHTML = tplFieldsHtml(cur()); $('#tpl-prev').innerHTML = tplPreview(cur(), f); };
    f.tpl.addEventListener('change', draw);
    f.addEventListener('input', (e) => { if (e.target.name !== 'tpl') $('#tpl-prev').innerHTML = tplPreview(cur(), f); });
    draw();
    $('#tpl-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const t = cur();
      const msg = await api('POST', `/api/conversations/${conv.id}/messages`, { type: 'template', name: t.name, language: t.language, values: readTplValues(t, f) });
      if (S.inbox.activeId === conv.id && !S.inbox.messages.some((m) => m.id === msg.id)) { S.inbox.messages.push(msg); renderMessages(true); }
      closeModal(); toast('Template terkirim.');
    }));
  }

