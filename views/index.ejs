    const f = S.templates.filter || '';
    const rows = S.templates.rows.filter((t) => !f || t.status === f);
    const counts = S.templates.rows.reduce((a, t) => ((a[t.status] = (a[t.status] || 0) + 1), a), {});
    v.innerHTML = `<div class="p-4 md:p-6 max-w-7xl space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <div class="seg" id="tp-filter">${[['', 'Semua'], ['APPROVED', 'Disetujui'], ['PENDING', 'Ditinjau'], ['REJECTED', 'Ditolak']].map(([k, l]) => `<button data-v="${k}" class="${f === k ? 'active' : ''}">${l}${k ? ` <span class="ink-3">${counts[k] || 0}</span>` : ''}</button>`).join('')}</div>
        <span class="text-xs ink-3">${S.templates.syncedAt ? 'Sinkron ' + fmtDT(S.templates.syncedAt) : 'Belum disinkronkan'}</span>
