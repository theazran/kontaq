    notifyBrowser('Panggilan WhatsApp masuk', c.contactName || '+' + c.phone);
  }
  // Preferensi per perangkat (disimpan di browser ini saja)
  const PREF_DEFAULT = { sound: true, soundOpen: false, typingCustomer: true };
  function pref(k) { try { const v = localStorage.getItem('kq-' + k); return v === null ? PREF_DEFAULT[k] : v === '1'; } catch (e) { return PREF_DEFAULT[k]; } }
  function setPref(k, val) { try { localStorage.setItem('kq-' + k, val ? '1' : '0'); } catch (e) {} }
  function renderSoundBtn() { const b = $('#sound-btn'); if (b) { b.innerHTML = pref('sound') ? ICON.bell : ICON.bellOff; b.title = pref('sound') ? 'Suara notifikasi: aktif' : 'Suara notifikasi: mati'; } }
  // Browser memblokir audio sampai ada sentuhan/klik pertama: buka kunci AudioContext saat itu
  function audioCtx() {
    if (!S.audio) { try { S.audio = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return null; } }
    if (S.audio.state === 'suspended') S.audio.resume().catch(() => {});
