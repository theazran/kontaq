    const tzOpts = [...new Set([a.timezone, ...TZ_LIST])];
    const iconBtn = (attr, icon, label, extra = '') => `<button type="button" class="btn btn-ghost btn-icon btn-sm ${extra}" ${attr} title="${label}" aria-label="${label}">${icon}</button>`;
    v.innerHTML = `<div id="ar-root">
    <div id="ar-savebar" class="${S.arDirty ? '' : 'hidden'} sticky top-0 z-20 px-4 md:px-6 pt-3">
      <div class="max-w-4xl mx-auto surface border bd rounded-lg shadow-lg px-4 py-2.5 flex items-center gap-3">
        <span class="w-2 h-2 rounded-full flex-none" style="background:var(--warn)"></span>
        <span class="text-[13px] font-medium flex-1 min-w-0 truncate">Perubahan belum disimpan</span>
        <button class="btn btn-ghost btn-sm" id="ar-reset">Batalkan</button><button class="btn btn-primary btn-sm" id="ar-save">Simpan</button>
      </div>
