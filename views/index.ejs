      if (k === 'name') { const clean = t.value.replace(/[^A-Za-z0-9_]/g, '_'); if (clean !== t.value) t.value = clean; v = clean; c.p.nameAuto = false; const a = $('[data-pk="nameAuto"]'); if (a) a.checked = false; }
