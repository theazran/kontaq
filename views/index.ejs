      if (!await confirmBox(remote ? `Hapus grup "${g.subject}" di WhatsApp? Semua peserta dikeluarkan dan grup tidak dapat dipulihkan.` : `Hapus catatan grup "${g.subject}" dari Kontaq?`, 'Hapus', true)) return;
      busy($('#gr-del'), async () => {
        const r = await grApi('DELETE', '');
        if (r.removed) { S.gr.groups = S.gr.groups.filter((x) => x.id !== g.id); toast('Catatan grup dihapus.'); location.hash = '#/groups'; return; }
