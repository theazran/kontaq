      const q = $('#gi-q').value.trim();
      const r = await api('GET', `/api/contacts?q=${encodeURIComponent(q)}&page=1`).catch(() => ({ rows: [] }));
      S.gr.contacts = [...new Map([...(S.gr.contacts || []), ...r.rows].map((c) => [c.id, c])).values()];
