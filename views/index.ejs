            ${f.id ? `<section class="card"><div class="card-h"><div class="card-t">Riwayat jalan</div><button class="btn btn-ghost btn-sm" id="fe-runs-refresh">${ICON.refresh}</button></div>
              <div id="fe-runs" class="max-h-[28rem] overflow-y-auto scroll-thin">${flRunsHtml(S.fe.runs, false)}</div></section>` : ''}
          </aside>
        </div>
      </div>
    </div>`;
    renderFlowCanvas();
    bindFlowEditor();
  }
  function bindFlowEditor() {
    const root = $('#fe-root'), f = S.fe.flow;
    const markDirty = () => { S.fe.dirty = true; $('#fe-savebar').classList.remove('hidden'); };
    $('#fe-name').addEventListener('input', (e) => { f.name = e.target.value; markDirty(); });
    $('#fe-on').addEventListener('change', (e) => { e.target.closest('.switch').classList.toggle('on', e.target.checked); f.enabled = e.target.checked; markDirty(); });
    $('#fe-settings').addEventListener('input', () => {
      Object.assign(f.settings, { pauseIfHumanMin: Number($('#fe-pause').value), cooldownMin: Number($('#fe-cd').value), activeFrom: $('#fe-from').value, activeUntil: $('#fe-until').value });
      markDirty();
    });
    $('#fe-canvas').addEventListener('click', async (e) => {
      const del = e.target.closest('[data-fl-del]');
      if (del) return flDelete(del.dataset.flDel);
      const add = e.target.closest('[data-fl-add]');
      if (add) { const [pid, port] = add.dataset.flAdd.split(':'); return flPickStep(pid, port); }
      const ed = e.target.closest('[data-fl-edit]');
      if (ed) { const n = f.nodes[ed.dataset.flEdit]; flStepModal(n, (cfg) => { n.cfg = cfg; }); }
    });
    $('#fe-canvas').addEventListener('keydown', (e) => { if ((e.key === 'Enter' || e.key === ' ') && e.target.dataset.flEdit) { e.preventDefault(); e.target.click(); } });
    $('#fe-reset').addEventListener('click', () => { if (f.id) viewFlowEditor(f.id); else location.hash = '#/flows'; });
    $('#fe-save').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const body = { ...f, name: $('#fe-name').value };
      const saved = f.id ? await api('PUT', '/api/flows/' + encodeURIComponent(f.id), body) : await api('POST', '/api/flows', body);
      S.fe = { flow: { id: saved.id, name: saved.name, enabled: saved.enabled, root: saved.root, nodes: saved.nodes, settings: saved.settings }, runs: saved.runs || [], dirty: false, hit: null };
      if (!f.id) history.replaceState(null, '', '#/flows/' + saved.id);
      renderFlowEditor(); toast(saved.enabled ? 'Flow disimpan dan aktif.' : 'Flow disimpan (nonaktif).');
    }));
    $('#fe-t-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      const t = await api('POST', '/api/flows/test', {
        flow: { ...f, name: $('#fe-name').value || 'Uji' }, text: $('#fe-t-text').value, msgType: $('#fe-t-type').value, labels: $('#fe-t-labels').value,
        day: $('#fe-t-day').value, time: $('#fe-t-time').value, newContact: $('#fe-t-new').checked, assigned: $('#fe-t-assigned').checked,
      });
      S.fe.hit = new Set(t.steps.map((s) => s.nodeId)); renderFlowCanvas();
      const preview = (p) => (p?.text !== undefined
        ? `<div class="basis-full pl-5 mt-1"><div class="chat-bg rounded-md p-2"><div class="bubble out">${p.image ? `<img src="/api/autoreply/media/${esc(p.image)}" alt="" class="mb-1">` : ''}${waFormat(p.text)}${(p.buttons || []).map((b) => `<span class="ib-btn">${esc(b)}</span>`).join('')}<div class="meta"><span>⚡ Flow</span></div></div></div></div>`
        : p?.note ? `<div class="basis-full pl-5 mt-1 text-[11px] ink-3 italic whitespace-pre-line">${esc(p.note)}</div>` : '');
      $('#fe-t-out').innerHTML = `<div class="text-[11px] ink-3 mb-1.5">Simulasi ${esc(AR_DAYS[t.clock.day])} ${esc(t.clock.time)} · ${t.actions ? `${t.actions} aksi` : 'tidak ada aksi — flow berikutnya / Auto reply akan dicek'}</div>
        <ol class="space-y-1.5">${t.steps.map((s) => flStepLine(s).replace('</li>', preview(s.preview) + '</li>').replace('<li class="flex gap-2', '<li class="flex flex-wrap gap-x-2')).join('')}</ol>`;
    }));
    $('#fe-t-text').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('#fe-t-go').click(); });
    const reloadRuns = async () => { S.fe.runs = await api('GET', '/api/flows/runs?flowId=' + encodeURIComponent(f.id)); $('#fe-runs').innerHTML = flRunsHtml(S.fe.runs, false); };
    $('#fe-runs-refresh')?.addEventListener('click', (e) => busy(e.currentTarget, reloadRuns));
    root.addEventListener('click', (e) => { const c = e.target.closest('[data-fl-cancel]'); if (c) flCancelRun(c.dataset.flCancel, reloadRuns); });
  }
  async function flDelete(id) {
    const f = S.fe.flow, n = f.nodes[id], [pid, port] = flParent(id);
    let keep = n.next;
    if (n.type === 'condition') {
      const lost = flCount(n.no);
      if (!await confirmBox(lost ? `Hapus kondisi ini? Langkah di cabang "Ya" dipertahankan; ${lost} langkah di cabang "Tidak" ikut terhapus.` : 'Hapus kondisi ini? Langkah di cabang "Ya" dipertahankan.', 'Hapus', true)) return;
      flDrop(n.no); keep = n.yes;
    }
    f.nodes[pid][port] = keep || null;
    delete f.nodes[id];
    flChanged();
  }
  function flPickStep(parentId, port) {
    modal('Tambah langkah', `<div class="grid sm:grid-cols-2 gap-2">${Object.entries(FL_STEP).map(([k, s]) => `<button type="button" class="fl-pick" data-pick="${k}">
        <span class="fl-ic">${ICON[s.icon]}</span><span class="min-w-0"><span class="block text-[13px] font-medium">${s.label}</span><span class="block text-[11px] ink-3 mt-0.5">${s.desc}</span></span></button>`).join('')}</div>`, { wide: true });
    $$('#modal-root [data-pick]').forEach((b) => b.addEventListener('click', () => {
      const type = b.dataset.pick;
      flStepModal({ type, cfg: flDefaultCfg(type) }, (cfg) => {
        const nodes = S.fe.flow.nodes, p = nodes[parentId], id = flId(), child = p[port] || null;
        // Langkah lama di posisi ini menjadi lanjutan langkah baru (cabang "Ya" bila langkah baru berupa kondisi)
        nodes[id] = type === 'condition' ? { id, type, cfg, yes: child, no: null } : { id, type, cfg, next: child };
        p[port] = id;
      });
    }));
  }

  /* Form konfigurasi per jenis langkah */
  function flCondFields(c) {
    switch (c.kind) {
      case 'keyword': return `<div class="grid sm:grid-cols-[11rem_1fr] gap-3">
          <div><label class="label">Cocok bila pesan</label><select class="select" name="match">${Object.entries(AR_MATCH).map(([k, l]) => `<option value="${k}" ${c.match === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
          <div><label class="label">Kata kunci (pisahkan dengan koma)</label><input class="input" name="keywords" value="${esc((c.keywords || []).join(', '))}" placeholder="harga, promo, paket"></div></div>
        <p class="hint">"Mengandung kata" mencocokkan kata utuh tanpa membedakan huruf besar/kecil. Tombol yang ditekan pelanggan masuk sebagai teks judul tombol, jadi bisa dicek dengan <i>Sama persis</i>.</p>`;
      case 'schedule': return `<div><div class="label">Hari</div><div class="flex flex-wrap gap-x-3 gap-y-1.5">${AR_DAYS.map((d, i) => `<label class="flex items-center gap-1.5 text-[13px]"><input type="checkbox" class="check" name="days" value="${i}" ${c.days.includes(i) ? 'checked' : ''}>${d}</label>`).join('')}</div></div>
        <div class="grid grid-cols-2 gap-3 max-w-xs"><div><label class="label">Dari jam</label><input class="input" type="time" name="start" value="${esc(c.start)}"></div><div><label class="label">Sampai jam</label><input class="input" type="time" name="end" value="${esc(c.end)}"></div></div>
        <p class="hint">Zona waktu ${esc(S.fl.timezone)}. Rentang melewati tengah malam (mis. 22:00–06:00) didukung.</p>`;
      case 'business_hours': {
        const open = S.fl.hours.filter((h) => h.enabled);
        return `<div class="surface-2 rounded-md px-3 py-2 text-xs ink-2">${open.length ? open.map((h) => `${AR_DAYS[h.day]} ${h.open}–${h.close}`).join(' · ') : 'Belum ada hari kerja yang diatur.'}</div>
          <p class="hint">Memakai jadwal jam kerja di menu <a href="#/autoreply" class="underline">Auto reply</a> (berlaku walau Auto reply nonaktif).</p>`;
      }
      case 'label': return `<div><label class="label">Kontak memiliki label</label><input class="input" name="label" list="fl-labels" maxlength="32" value="${esc(c.label)}" placeholder="VIP">
        <datalist id="fl-labels">${(S.fl.labels || []).map((l) => `<option value="${esc(l)}">`).join('')}</datalist></div>`;
      case 'new_contact': return `<div class="max-w-xs"><label class="label">Dianggap baru bila tidak mengirim pesan selama (hari)</label><input class="input" type="number" min="1" max="365" name="days" value="${c.days}"></div>`;
      case 'message_type': return `<div><div class="label">Jenis pesan masuk</div><div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">${Object.entries(FL_MSG).map(([k, l]) => `<label class="flex items-center gap-1.5 text-[13px]"><input type="checkbox" class="check" name="types" value="${k}" ${c.types.includes(k) ? 'checked' : ''}>${l}</label>`).join('')}</div></div>`;
      case 'assigned': return '<p class="text-xs ink-2">Ya bila percakapan sudah ditugaskan ke agen; Tidak bila masih di antrean.</p>';
      default: return '';
    }
  }
  function flFormHtml(type, c) {
    switch (type) {
      case 'condition': return `<div class="max-w-xs"><label class="label">Jenis kondisi</label><select class="select" name="kind">${Object.entries(FL_COND).map(([k, l]) => `<option value="${k}" ${c.kind === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
        <div id="cond-fields" class="space-y-3">${flCondFields(c)}</div>
        <p class="hint">Bila kondisi terpenuhi flow lanjut ke cabang <b>Ya</b>, bila tidak ke cabang <b>Tidak</b>.</p>`;
      case 'send': return `<div><label class="label">Teks pesan</label><textarea class="textarea" name="text" rows="4" maxlength="4096" placeholder="Halo {{name}}, …">${esc(c.text)}</textarea>
          <p class="hint">Variabel: <span class="kbd">{{name}}</span> <span class="kbd">{{phone}}</span>. Format WhatsApp: *tebal* _miring_. Pesan hanya dikirim selama jendela layanan 24 jam masih terbuka.</p></div>
        ${replyExtrasHtml('fl', c)}`;
      case 'assign': return `<div><label class="label">Teruskan ke</label><select class="select" name="mode">${Object.entries(FL_ASSIGN).map(([k, l]) => `<option value="${k}" ${c.mode === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>
        <div id="assign-user" class="${c.mode === 'user' ? '' : 'hidden'}"><label class="label">Agen</label><select class="select" name="userId"><option value="">Pilih agen…</option>${S.users.filter((u) => u.active).map((u) => `<option value="${esc(u.id)}" ${c.userId === u.id ? 'selected' : ''}>${esc(u.name)}${u.role === 'admin' ? ' (admin)' : ''}</option>`).join('')}</select></div>
        <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="onlyIfUnassigned" ${c.onlyIfUnassigned ? 'checked' : ''}> Hanya bila percakapan belum ditugaskan</label>
        <p class="hint">Mode otomatis memilih dari pengguna aktif berperan agen (atau semua pengguna aktif bila belum ada agen). Agen menerima notifikasi penugasan seperti biasa.</p>`;
      case 'label': return `<div class="grid sm:grid-cols-[10rem_1fr] gap-3"><div><label class="label">Aksi</label><select class="select" name="remove"><option value="0">Tambah label</option><option value="1" ${c.remove ? 'selected' : ''}>Hapus label</option></select></div>
        <div><label class="label">Label</label><input class="input" name="label" list="fl-labels" maxlength="32" value="${esc(c.label)}" placeholder="Prospek"><datalist id="fl-labels">${(S.fl.labels || []).map((l) => `<option value="${esc(l)}">`).join('')}</datalist></div></div>`;
      case 'status': return `<div class="max-w-xs"><label class="label">Jadikan status percakapan</label><select class="select" name="status">${Object.entries(FL_STATUS).map(([k, l]) => `<option value="${k}" ${c.status === k ? 'selected' : ''}>${l}</option>`).join('')}</select></div>`;
      case 'note': return `<div><label class="label">Catatan</label><textarea class="textarea" name="text" rows="3" maxlength="2000" placeholder="Pelanggan menanyakan harga, mohon follow-up.">${esc(c.text)}</textarea>
        <p class="hint">Tidak dikirim ke pelanggan. Variabel <span class="kbd">{{name}}</span> <span class="kbd">{{phone}}</span> didukung.</p></div>`;
      case 'delay': {
        const hours = c.minutes % 60 === 0;
        return `<div class="grid grid-cols-[1fr_8rem] gap-2 max-w-xs"><div><label class="label">Tunggu selama</label><input class="input" type="number" min="1" name="amount" value="${hours ? c.minutes / 60 : c.minutes}"></div>
          <div><label class="label">Satuan</label><select class="select" name="unit"><option value="m">Menit</option><option value="h" ${hours ? 'selected' : ''}>Jam</option></select></div></div>
        <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" class="check" name="cancelOnReply" ${c.cancelOnReply ? 'checked' : ''}> Batalkan bila pelanggan mengirim pesan lagi atau CS membalas</label>
        <p class="hint">Maksimal 23 jam. Setelah menunggu, pesan hanya dikirim bila jendela layanan 24 jam masih terbuka.</p>`;
      }
      default: return '';
    }
  }
  function flReadForm(type, form) {
    const fd = new FormData(form), d = Object.fromEntries(fd), err = (m) => { throw new Error(m); };
    switch (type) {
      case 'condition': {
        const c = { kind: d.kind };
        if (d.kind === 'keyword') { c.match = d.match; c.keywords = d.keywords.split(',').map((k) => k.trim()).filter(Boolean); if (!c.keywords.length) err('Isi minimal satu kata kunci.'); }
        if (d.kind === 'schedule') { c.days = fd.getAll('days').map(Number); c.start = d.start; c.end = d.end; if (!c.days.length) err('Pilih minimal satu hari.'); if (!c.start || !c.end || c.start === c.end) err('Isi jam mulai dan selesai yang berbeda.'); }
        if (d.kind === 'label') { c.label = d.label.trim(); if (!c.label) err('Isi nama label.'); }
        if (d.kind === 'new_contact') c.days = Number(d.days);
        if (d.kind === 'message_type') { c.types = fd.getAll('types'); if (!c.types.length) err('Pilih minimal satu jenis pesan.'); }
        return c;
      }
      case 'send': {
        const text = d.text.trim(), buttons = readButtons('fl', form), image = S.flDraftImage || null;
        if (!text && !image) err('Isi teks pesan atau pilih gambar.');
        if (buttons.length && !text) err('Teks pesan wajib diisi bila memakai tombol.');
        if ((image || buttons.length) && text.length > 1024) err(`Teks maksimal 1024 karakter bila memakai gambar atau tombol (sekarang ${text.length}).`);
        if (new Set(buttons.map((t) => t.toLowerCase())).size !== buttons.length) err('Teks tombol harus berbeda satu sama lain.');
        return { text, image, buttons };
      }
      case 'assign': if (d.mode === 'user' && !d.userId) err('Pilih agen.'); return { mode: d.mode, userId: d.mode === 'user' ? d.userId : undefined, onlyIfUnassigned: fd.has('onlyIfUnassigned') };
      case 'label': if (!d.label.trim()) err('Isi nama label.'); return { label: d.label.trim(), remove: d.remove === '1' };
      case 'status': return { status: d.status };
      case 'note': if (!d.text.trim()) err('Isi catatan.'); return { text: d.text.trim() };
      case 'delay': {
        const minutes = Math.round(Number(d.amount) * (d.unit === 'h' ? 60 : 1));
        if (!(minutes >= 1 && minutes <= 1380)) err('Durasi tunggu harus antara 1 menit dan 23 jam.');
        return { minutes, cancelOnReply: fd.has('cancelOnReply') };
      }
      default: return {};
    }
  }
  function flStepModal(node, apply) {
    let cfg = structuredClone(node.cfg);
    S.flDraftImage = node.type === 'send' ? cfg.image || null : null;
    modal(`${node.id ? 'Ubah' : 'Tambah'}: ${FL_STEP[node.type].label}`, `<form id="f-step" class="space-y-3" novalidate>${flFormHtml(node.type, cfg)}</form>`,
      { wide: ['send', 'condition', 'label'].includes(node.type), footer: '<button class="btn" data-act="modal-close">Batal</button><button class="btn btn-primary" id="step-ok">Terapkan</button>' });
    const form = $('#f-step');
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('change', (e) => {
      const t = e.target;
      if (t.name === 'kind') { cfg = { kind: t.value, ...flCondDefaults(t.value) }; $('#cond-fields').innerHTML = flCondFields(cfg); }
      if (t.name === 'mode') $('#assign-user').classList.toggle('hidden', t.value !== 'user');
      if (t.dataset.arImg === 'fl') busy(null, async () => { const key = await uploadArImage(t.files[0]); if (key) { S.flDraftImage = key; $('#fl-img').innerHTML = imgPickerHtml('fl', key); } });
    });
    form.addEventListener('click', (e) => { if (e.target.closest('[data-ar-img-del="fl"]')) { S.flDraftImage = null; $('#fl-img').innerHTML = imgPickerHtml('fl', null); } });
    $('#step-ok').addEventListener('click', () => {
      try { apply(flReadForm(node.type, form)); closeModal(); flChanged(); toast('Langkah diterapkan — klik Simpan.'); } catch (e) { fail(e); }
    });
  }

  /* ───────────── Panggilan (Calling API) ───────────── */
  async function viewCalls() {
    const v = $('#view');
    v.innerHTML = `<div class="p-4 md:p-6 max-w-7xl space-y-4">
      <section class="card"><div class="card-h"><div class="card-t">WhatsApp Business Calling API</div><span id="cl-status" class="text-xs ink-3">Memeriksa…</span></div>
        <div class="p-4 text-xs ink-2 space-y-2" id="cl-body">
          <p>Panggilan suara memakai Calling API resmi Meta (WebRTC). Persyaratan: nomor terdaftar di Cloud API, fitur Calling tersedia untuk akun & negara Anda, webhook field <span class="kbd">calls</span> disubscribe, dan browser agen mengizinkan mikrofon via HTTPS.</p>
          <p>Kontaq mendukung <b>menerima panggilan</b> dari pelanggan (angkat, tolak, akhiri) dan <b>telepon balik</b> ke pelanggan yang sudah memberi izin.</p>
