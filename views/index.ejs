      if (e.target.name !== 'starter') return;
      const preset = WF_STARTERS[e.target.value][1];
      $$('input[name=categories]', f).forEach((x) => { x.checked = preset.includes(x.value); });
    });
    $('#wf-go').addEventListener('click', (e) => busy(e.currentTarget, async () => {
      if (!f.reportValidity()) return;
      const fd = new FormData(f), categories = fd.getAll('categories');
      if (!categories.length) throw new Error('Pilih minimal satu kategori.');
      const body = { name: fd.get('name'), categories };
