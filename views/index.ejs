          <div><label class="label">App Secret</label><input class="input mono" name="appSecret" type="password" autocomplete="off" placeholder="${m.appSecretMasked ? 'Tersimpan ' + esc(m.appSecretMasked) + ' — isi untuk mengganti' : 'Untuk verifikasi tanda tangan webhook'}"></div>
          <div class="grid sm:grid-cols-2 gap-3">
            <div><label class="label">Verify Token webhook</label><input class="input mono" name="verifyToken" value="${esc(m.verifyToken)}" placeholder="string acak buatan Anda"></div>
            <div><label class="label">Versi Graph API</label><input class="input mono" name="graphVersion" value="${esc(m.graphVersion)}"></div>
          </div>
        </div>
        <div class="flex flex-wrap justify-end gap-2 px-4 py-3 border-t bd"><button type="button" class="btn" id="mt-test">Uji koneksi</button><button class="btn btn-primary" type="submit">Simpan</button></div>
      </form>
      <div class="lg:col-span-2 space-y-4">
        <section class="card"><div class="card-h"><div class="card-t">Status koneksi</div>${conn?.ok ? statusBadge('ACTIVE') : '<span class="badge">Belum diuji</span>'}</div>
          <div class="p-4 text-xs space-y-1.5">${conn?.ok ? [
            ['Nomor', conn.phone.display_phone_number], ['Nama terverifikasi', conn.phone.verified_name], ['Status nama', conn.phone.name_status], ['Kualitas', conn.phone.quality_rating],
            ['Throughput', conn.phone.throughput?.level], ['WABA', conn.waba.name], ['Diuji', fmtDT(conn.checkedAt)],
            ['App ter-subscribe', conn.subscribedApps ? (conn.subscribedApps.length ? conn.subscribedApps.join(', ') : 'Tidak ada') : 'Tidak dapat dibaca'],
          ].map(([k, val]) => `<div class="flex justify-between gap-3"><span class="ink-3">${k}</span><span class="text-right">${esc(val ?? '—')}</span></div>`).join('') : '<p class="ink-3">Simpan kredensial lalu klik "Uji koneksi".</p>'}
          </div></section>
        <section class="card"><div class="card-h"><div class="card-t">Webhook</div></div>
          <div class="p-4 text-xs space-y-3">
            <div><div class="label">Callback URL</div><div class="flex gap-2"><input class="input mono text-xs" readonly value="${esc(m.webhookUrl)}" id="wh-url"><button class="btn btn-sm h-8" data-copy="wh-url">Salin</button></div></div>
            <div><div class="label">Field yang perlu disubscribe</div><div class="flex flex-wrap gap-1"><span class="kbd">messages</span><span class="kbd">message_template_status_update</span><span class="kbd">calls</span></div></div>
            <div class="flex justify-between"><span class="ink-3">Webhook terakhir diterima</span><span>${m.lastWebhookAt ? fmtDT(m.lastWebhookAt) : 'Belum pernah'}</span></div>
