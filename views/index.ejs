          <span class="inline-flex w-9 h-9 rounded-lg items-center justify-center flex-none ${a.enabled ? 'badge-green' : 'surface-2'}" style="border-radius:.5rem">${ICON.bolt.replace('<svg', '<svg width="18" height="18"')}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2"><span class="font-semibold">Auto reply</span>${a.enabled ? '<span class="badge badge-green">Aktif</span>' : '<span class="badge">Nonaktif</span>'}</div>
            <div class="text-xs ink-3 mt-0.5">Membalas pesan masuk 24 jam, walau tidak ada CS yang membuka Kontaq.</div>
