      S.call = { ...call, contactName: call.contactName || contact.name };
      try { S.wakeLock = await navigator.wakeLock?.request('screen'); } catch (e) {}
      renderCallBar();
      // Jawaban bisa tiba sebelum respons POST
      if (S.pendingAnswer?.id === call.id) applyAnswer(S.pendingAnswer);
    } catch (e) { endCallLocal(); fail(e); }
  }
  async function applyAnswer({ id, sdp }) {
    if (!S.pc || S.call?.id !== id) { S.pendingAnswer = { id, sdp }; return; }
    S.pendingAnswer = null;
    try { await S.pc.setRemoteDescription({ type: 'answer', sdp }); }
    catch (e) { fail(new Error('Gagal menyambungkan audio: ' + e.message)); return; }
    S.call.status = 'accepted'; S.callStart = Date.now();
    clearInterval(S.callTimer);
    S.callTimer = setInterval(() => { const el = $('#call-state'); if (el) el.textContent = fmtDur(S.callStart); }, 1000);
    navigator.vibrate?.(60);
    renderCallBar();
  }
  function endCallLocal() {
    stopRinging(); clearInterval(S.callTimer);
    S.pc?.close(); S.stream?.getTracks().forEach((t) => t.stop());
    S.wakeLock?.release?.().catch(() => {});
    S.pc = null; S.stream = null; S.call = null; S.wakeLock = null; S.muted = false; S.callStart = null; S.pendingAnswer = null; S.callProfile = null; S.callMin = false; renderCallBar();
  }
